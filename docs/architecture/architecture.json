    {
      "dot": "cyan",
      "title": "Presentation",
      "items": [
        "Blazor WASM pages: Board, Gantt, Workflow, Specs, VS Code, Terminal, Cockpit",
        "taskctl CLI + MCP server for agent access",
        "Global repo selector drives repo-scoped pages"
      ]
    },
    {
      "dot": "emerald",
      "title": "Realtime",
      "items": [
        "SignalR hubs: /harness-cockpit-hub, /terminal-hub, agent logs",
        "SSE /api/events for board updates",
        "Structured pipeline events replayed to late joiners"
      ]
    },
    {
      "dot": "violet",
      "title": "Harness (ADE)",
      "items": [
        "PipelineEngine: multi-agent DAG stages with approval gates",
        "Steer queue + HITL cockpit, Create-PR on success",
        "FinOps: per-run token/cost metrics; project memory + context synthesis"
      ]
    },
    {
      "dot": "amber",
      "title": "Security & Verification",
      "items": [
        "PermissionGateway: command risk classification, path jail, secret scrubbing",
        "VerificationLoop: build/test/coverage evidence per stage",
        "Git worktrees isolate every pipeline run"
      ]
    },
    {
      "dot": "rose",
      "title": "Local-first boundary",
      "items": [
        "All state in ~/.agent-harness SQLite \u2014 no required cloud",
        "Outbound only: GitHub API, optional Jira/Cloud companion",
        "code-server + PTY terminal hosted on the server"
      ]
    }
  ]
