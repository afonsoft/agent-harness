{
  "Taskboard": {
    "Port": 47823,
    "DataDir": ".data",
    "Database": {
      "ConnectionStringName": "Taskboard"
    },
    // SPEC-20260923-cockpit-run-hardening RF-002: auto-retry de estágios —
    // N falhas por CLI espaçadas por Interval, depois rotação, depois Failed.
    "Pipelines": {
      "AutoRetry": {
        "Enabled": true,
        "AttemptsPerAgent": 5,
        "Interval": "00:01:00"
      }
    },
    // SPEC-20261004-redis-hybrid-cache RF-001: HybridCache (L1 memory + L2 Redis).
    // ConnectionString ausente/vazio = L1-only. Env: HARNESS__CACHE__REDIS__CONNECTIONSTRING.
    "Cache": {
      "DefaultExpiration": "00:05:00",
      "LocalCacheExpiration": "00:01:00",
      "Redis": {
        "InstanceName": "harness:"
        // "ConnectionString": "localhost:6379" — vazio/ausente = L1-only
      }
    }
  },
  "ConnectionStrings": {
    "Taskboard": "Data Source=.data/harness.sqlite"
  },
  "Admin": {
    "Username": "admin"
    // "Password" must be provided in production via environment or user-secrets.
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF Core dumps every SQL statement at Information — saturates journald
      // on always-on hosts (issue #413). Development keeps Information.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
