@using Taskboard.Dtos

@*
    SPEC-20260928-ai-code-generic-cli RF-003: terminal-transport thread pane —
    PtyHostPane wired to TerminalHub.OpenForThread. The CLI argv and workdir
    are resolved server-side from the thread (builtin or custom CLI, host or
    docker exec). The session id is deterministic (t-<threadId>) so a browser
    refresh rebinds to the same PTY and replays the scrollback.
*@

<PtyHostPane ElementId="@ElementId"
             SessionKey="@SessionKey"
             ExpectedSessionId="@($"t-{Thread.Id}")"
             Open="@(hub => hub.InvokeAsync<string>("OpenForThread", Thread.Id))"
             ExitedMessage="CLI exited" />

@code {
    /// <summary>The terminal thread this pane renders — must have Kind == "terminal".</summary>
    [Parameter, EditorRequired] public AiChatThreadDto Thread { get; set; } = default!;

    private string ElementId => $"pty-thread-{Thread?.Id}";
    private string SessionKey => $"thread-{Thread?.Id}";
}
