<div class="alert alert-warning my-2 p-3 border-warning">
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="badge text-bg-warning">permission request</span>
        <strong>Tool: @Tool</strong>
    </div>
    <p class="mb-2 small font-monospace">@Detail</p>
    <div class="d-flex gap-2">
        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick='() => ReplyAsync("allow")'>
            Allow Once
        </Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick='() => ReplyAsync("always")'>
            Always in Session
        </Button>
        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick='() => ReplyAsync("deny")'>
            Deny
        </Button>
    </div>
</div>

@code {
    [Parameter] public string RequestId { get; set; } = string.Empty;
    [Parameter] public string Tool { get; set; } = string.Empty;
    [Parameter] public string Detail { get; set; } = string.Empty;
    [Parameter] public EventCallback<(string RequestId, string Outcome)> OnReply { get; set; }

    private Task ReplyAsync(string outcome) => OnReply.InvokeAsync((RequestId, outcome));
}
