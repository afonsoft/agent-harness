@using Taskboard.Application.Contracts.AiChat
@inject ILocaleService L

@*
    SPEC-20261004-permission-question-cards: interactive card for agent
    permission requests AND agent questions — each button replies with the
    literal optionId so arbitrary option sets (e.g. AskUserQuestion) round-trip
    correctly. Options that don't look like the canonical allow/reject set
    render as an "agent question" (info weight) instead of a permission
    warning.
*@

<div class="alert @(IsQuestion ? "alert-info border-info" : "alert-warning border-warning") my-2 p-3">
    <div class="d-flex align-items-center gap-2 mb-2">
        <Icon Name="@(IsQuestion ? IconName.QuestionCircle : IconName.ShieldLock)" />
        <span class="badge @(IsQuestion ? "text-bg-info" : "text-bg-warning")">
            @(IsQuestion ? L.T("chat.agentQuestion") : L.T("chat.permissionRequest"))
        </span>
        <strong>@Request.Tool</strong>
    </div>
    @if (!string.IsNullOrWhiteSpace(Request.Detail))
    {
        <pre class="mb-2 small font-monospace toolcall-output p-2">@Request.Detail</pre>
    }
    <div class="d-flex gap-2 flex-wrap">
        @foreach (var opt in Request.EffectiveOptions)
        {
            <Button Color="@OptionColor(opt)" Size="ButtonSize.Small" @onclick="() => ReplyAsync(opt.OptionId)">
                @opt.Label
            </Button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PermissionRequestInfo Request { get; set; } = default!;
    [Parameter] public EventCallback<(string RequestId, string Outcome)> OnReply { get; set; }

    // Requests whose options don't carry canonical permission kinds and don't
    // look allow/deny-ish are agent questions, not tool approvals.
    private bool IsQuestion =>
        Request.EffectiveOptions.Count > 0
        && Request.EffectiveOptions.All(o => !IsPermissionOption(o));

    private static bool IsPermissionOption(PermissionOptionInfo o) =>
        IsPermissionKind(o.Kind) || LooksPermissionId(o.OptionId);

    private static bool IsPermissionKind(string? kind) =>
        string.Equals(kind, "allow_once", StringComparison.OrdinalIgnoreCase)
        || string.Equals(kind, "allow_always", StringComparison.OrdinalIgnoreCase)
        || string.Equals(kind, "reject_once", StringComparison.OrdinalIgnoreCase)
        || string.Equals(kind, "reject_always", StringComparison.OrdinalIgnoreCase);

    private static bool LooksPermissionId(string id) =>
        id.StartsWith("allow", StringComparison.OrdinalIgnoreCase)
        || id.StartsWith("deny", StringComparison.OrdinalIgnoreCase)
        || id.StartsWith("reject", StringComparison.OrdinalIgnoreCase);

    private Task ReplyAsync(string optionId) => OnReply.InvokeAsync((Request.RequestId, optionId));

    private static ButtonColor OptionColor(PermissionOptionInfo o) =>
        (o.Kind ?? o.OptionId).ToLowerInvariant() switch
        {
            var key when key.Contains("always") => ButtonColor.Primary,
            var key when key.StartsWith("reject") || key.StartsWith("deny") => ButtonColor.Danger,
            var key when key.StartsWith("allow") => ButtonColor.Success,
            _ => ButtonColor.Secondary,
        };
}
