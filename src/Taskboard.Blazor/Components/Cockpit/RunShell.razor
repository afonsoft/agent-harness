@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject TaskboardClient Client
@implements IAsyncDisposable

@* SPEC-20260923-cockpit-run-hardening RF-006 + SPEC-20261021-worktree-setup
   -scripts RF-006: interactive PTYs rooted at the run's worktree — the
   "shell" tab plus one chip per `defaultTabs:` entry declared in
   .harness/worktree.yaml. Each tab lazily opens its own PTY via the hub
   (OpenForRun / OpenForWorktreeTab resolves path+command server-side). *@

@if (_tabs.Count > 1)
{
    <div class="btn-group btn-group-sm mb-1" role="group">
        @foreach (var tab in _tabs)
        {
            <button class="btn @(tab.Name == _active ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => ActivateAsync(tab.Name)">@tab.Name</button>
        }
    </div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <Alert Color="AlertColor.Danger" Dismissable="false" class="py-1 mb-1 small">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-1" />@_error
        @if (_canRetry)
        {
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" class="ms-2" @onclick="() => OpenTabAsync(_active)">Reopen</Button>
        }
    </Alert>
}
@foreach (var tab in _tabs)
{
    <div id="@tab.ElementId" class="terminal-host run-shell-host @(tab.Name == _active ? "" : "d-none")" @onclick="() => FocusAsync(tab)"></div>
}

@code {
    /// <summary>Pipeline execution id — the worktree is resolved server-side.</summary>
    [Parameter, EditorRequired] public string RunId { get; set; } = string.Empty;

    private sealed class TabState
    {
        public required string Name { get; init; }
        public string ElementId { get; init; } = string.Empty;
        public string? SessionId { get; set; }
        public bool Started { get; set; }
    }

    private HubConnection? _hub;
    private DotNetObjectReference<RunShell>? _selfRef;
    private readonly List<TabState> _tabs = [];
    private string _active = "shell";
    private string? _error;
    private bool _canRetry;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started)
        {
            return;
        }

        _started = true;
        _selfRef = DotNetObjectReference.Create(this);

        // defaultTabs arrive with the session — the shell tab always exists.
        _tabs.Add(new TabState { Name = "shell", ElementId = $"run-shell-{RunId}" });
        try
        {
            var session = await Client.GetWorktreeSessionAsync(RunId);
            if (session?.DefaultTabs is { Count: > 0 } tabs)
            {
                foreach (var tab in tabs)
                {
                    _tabs.Add(new TabState
                    {
                        Name = tab.Name,
                        ElementId = $"run-shell-{RunId}-{tab.Name}",
                    });
                }
            }
        }
        catch
        {
            // Tabs are optional — a session/yaml hiccup must not kill the shell.
        }

        // Render the tab hosts before any xterm init touches their divs.
        StateHasChanged();
        await Task.Yield();
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/terminal-hub"))
            .WithAutomaticReconnect([TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30)])
            .Build();

        _hub.On<string, string>("output", (sessionId, data) =>
        {
            var tab = _tabs.FirstOrDefault(t => t.SessionId == sessionId);
            return tab is not null
                ? JS.InvokeVoidAsync("taskboardTerminal.write", tab.ElementId, data).AsTask()
                : Task.CompletedTask;
        });

        _hub.On<string, string>("closed", (sessionId, reason) =>
        {
            var tab = _tabs.FirstOrDefault(t => t.SessionId == sessionId);
            if (tab is null)
            {
                return Task.CompletedTask;
            }

            tab.SessionId = null;
            _error = $"Session ended: {reason}";
            _canRetry = true;
            return InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += async _ =>
        {
            var tab = _tabs.FirstOrDefault(t => t.SessionId is not null);
            if (tab is null)
            {
                return;
            }

            var reattached = false;
            try
            {
                reattached = await _hub.InvokeAsync<bool>("Reattach", tab.SessionId);
            }
            catch
            {
                // Fall through — the operator can Reopen.
            }

            if (reattached)
            {
                await JS.InvokeVoidAsync("taskboardTerminal.fitNow", tab.ElementId);
            }
            else
            {
                tab.SessionId = null;
                _error = "Connection lost — the shell was reaped.";
                _canRetry = true;
                await InvokeAsync(StateHasChanged);
            }
        };

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            _error = $"Terminal unavailable: {ex.Message}";
            await InvokeAsync(StateHasChanged);
            return;
        }

        await OpenTabAsync(_active);
    }

    private async Task ActivateAsync(string name)
    {
        _active = name;
        // Un-hide the host div before xterm measures it.
        StateHasChanged();
        await Task.Yield();
        await OpenTabAsync(name);
    }

    /// <summary>Lazily initializes the tab's xterm host and opens its PTY —
    /// the first click materializes it; later clicks just show it.</summary>
    private async Task OpenTabAsync(string name)
    {
        var tab = _tabs.FirstOrDefault(t => t.Name == name);
        if (tab is null || _hub is not { State: HubConnectionState.Connected })
        {
            _error = tab is null ? _error : "No connection to the server.";
            return;
        }

        try
        {
            _error = null;
            _canRetry = false;
            if (!tab.Started)
            {
                var initialized = await JS.InvokeAsync<bool>(
                    "taskboardTerminal.init", tab.ElementId, _selfRef, tab.Name);
                if (!initialized)
                {
                    _error = "Terminal emulator failed to initialize.";
                    return;
                }

                tab.Started = true;
            }

            tab.SessionId = name == "shell"
                ? await _hub.InvokeAsync<string>("OpenForRun", RunId)
                : await _hub.InvokeAsync<string>("OpenForWorktreeTab", RunId, name);
            await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
        }
        catch (Exception ex)
        {
            // HubException("Run has no worktree") lands here — the run may not
            // have attached its worktree yet; offer a retry.
            _error = ex.Message;
            _canRetry = true;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task FocusAsync(TabState tab) =>
        await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);

    [JSInvokable]
    public async Task OnTerminalData(string tabKey, string data)
    {
        var tab = _tabs.FirstOrDefault(t => t.Name == tabKey);
        if (tab?.SessionId is not null && _hub is { State: HubConnectionState.Connected })
        {
            await _hub.InvokeAsync("Input", tab.SessionId, data);
        }
    }

    [JSInvokable]
    public async Task OnTerminalResize(string tabKey, int cols, int rows)
    {
        var tab = _tabs.FirstOrDefault(t => t.Name == tabKey);
        if (tab?.SessionId is not null && _hub is { State: HubConnectionState.Connected })
        {
            await _hub.InvokeAsync("Resize", tab.SessionId, cols, rows);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try
            {
                if (_hub.State == HubConnectionState.Connected)
                {
                    foreach (var tab in _tabs)
                    {
                        if (tab.SessionId is not null)
                        {
                            await _hub.InvokeAsync("Close", tab.SessionId);
                        }
                    }
                }
                await _hub.DisposeAsync();
            }
            catch
            {
                // Dispose is best-effort.
            }
        }

        foreach (var tab in _tabs)
        {
            try
            {
                await JS.InvokeVoidAsync("taskboardTerminal.dispose", tab.ElementId);
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
            {
                // JS interop unavailable during teardown.
            }
        }

        _selfRef?.Dispose();
    }
}
