@using Taskboard.Application.Contracts.Skills

@if (Skill is null)
{
    <Loading Message="Loading skill..." />
}
else
{
    <div class="mb-4">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
            <h2 class="h5 fw-bold mb-0">@Skill.Name</h2>
            <span class="source-badge @GetSourceBadgeClass(Skill.Source)">@Skill.Source</span>
        </div>
        <p class="small text-body-secondary mb-1">@Skill.Description</p>
        <p class="small text-body-secondary font-monospace mb-0" title="@Skill.Path">@Skill.Path</p>
    </div>

    @if (Skill.Tools.Any())
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Tools</h3>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tool in Skill.Tools)
                {
                    <span class="badge text-bg-secondary">@tool</span>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Skill.References))
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">References</h3>
            <div class="code-block small">@Skill.References</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Skill.Scripts))
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Scripts</h3>
            <div class="code-block small">@Skill.Scripts</div>
        </div>
    }

    <div>
        <h3 class="h6 fw-semibold mb-2">Content</h3>
        <div class="code-block small overflow-y-auto" style="max-height: 16rem;">@Skill.Content</div>
    </div>
}

@code {
    [Parameter]
    public SkillDetailDto Skill { get; set; } = default!;

    private static string GetSourceBadgeClass(string source) => $"source-badge-{source.ToLowerInvariant()}" switch
    {
        "source-badge-claude" => "source-badge-claude",
        "source-badge-devin" => "source-badge-devin",
        "source-badge-cursor" => "source-badge-cursor",
        "source-badge-opencode" => "source-badge-opencode",
        "source-badge-taskboard" => "source-badge-taskboard",
        _ => "source-badge-unknown"
    };
}
