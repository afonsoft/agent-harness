@using Taskboard.Application.Contracts.Skills
@using Taskboard.Rendering
@inject TaskboardClient Client
@inject ToastService ToastService
@inject IJSRuntime JSRuntime

@if (Skill is null)
{
    <Loading Message="Loading skill..." />
}
else
{
    <div class="mb-4">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
            <h2 class="h5 fw-bold mb-0">@Skill.Name</h2>
            <span class="source-badge @GetSourceBadgeClass(Skill.Source)">@Skill.Source</span>
        </div>
        <p class="small text-body-secondary mb-1">@Skill.Description</p>
        <p class="small text-body-secondary font-monospace mb-0" title="@Skill.Path">@Skill.Path</p>
    </div>

    @if (Skill.Tools.Any())
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Tools</h3>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tool in Skill.Tools)
                {
                    <span class="badge text-bg-secondary">@tool</span>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Skill.References))
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">References</h3>
            <div class="code-block small">@Skill.References</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Skill.Scripts))
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Scripts</h3>
            <div class="code-block small">@Skill.Scripts</div>
        </div>
    }

    <div>
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h3 class="h6 fw-semibold mb-0">Content</h3>
            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group" aria-label="Content view">
                    <button type="button" class="btn @(_showSource ? "btn-outline-secondary" : "btn-secondary")"
                            @onclick="() => _showSource = false">Rendered</button>
                    <button type="button" class="btn @(_showSource ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="() => _showSource = true">Source</button>
                </div>
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" Outline="true"
                        title="Copy content" @onclick="CopyContentAsync">
                    <Icon Name="IconName.Clipboard" class="me-1" />Copy
                </Button>
            </div>
        </div>
        @if (_showSource)
        {
            <div class="code-block small overflow-y-auto" style="max-height: 24rem;">@Skill.Content</div>
        }
        else
        {
            <div class="markdown-body overflow-y-auto border rounded p-3" style="max-height: 24rem;">
                @((MarkupString)MarkdownRenderer.ToSafeHtml(Skill.Content))
            </div>
        }
    </div>

    @if (_fileTree.Count > 0)
    {
        <div class="mt-4">
            <h3 class="h6 fw-semibold mb-2">Files</h3>
            <SkillFileTree Nodes="_fileTree" SelectedFile="_selectedFile" OnFileSelected="LoadFileAsync" />
            @if (_fileLoading)
            {
                <div class="small text-body-secondary mt-2">Loading file...</div>
            }
            else if (_fileError is not null)
            {
                <div class="small text-danger mt-2">@_fileError</div>
            }
            else if (_fileContent is not null)
            {
                <div class="mt-2">
                    <div class="small text-body-secondary font-monospace mb-1">@_selectedFile!.RelativePath</div>
                    <div class="code-block small overflow-y-auto" style="max-height: 16rem;">@_fileContent</div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public SkillDetailDto Skill { get; set; } = default!;

    private IReadOnlyList<SkillFileNode> _fileTree = [];
    private SkillFileDto? _selectedFile;
    private string? _fileContent;
    private string? _fileError;
    private bool _fileLoading;
    private bool _showSource;

    private async Task CopyContentAsync()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Skill.Content);
        ToastService.Notify(new(ToastType.Success, "Skill content copied to clipboard"));
    }

    protected override void OnParametersSet()
    {
        _fileTree = Skill is null ? [] : SkillFileNode.Build(Skill.Files);
    }

    private async Task LoadFileAsync(SkillFileDto file)
    {
        _selectedFile = file;
        _fileContent = null;
        _fileError = null;
        _fileLoading = true;

        try
        {
            _fileContent = await Client.GetSkillFileContentAsync(Skill.Source, Skill.Name, file.RelativePath);
            if (_fileContent is null)
            {
                _fileError = "Could not load file content.";
            }
        }
        catch (Exception ex)
        {
            _fileError = $"Could not load file content: {ex.Message}";
        }
        finally
        {
            _fileLoading = false;
        }
    }

    private static string GetSourceBadgeClass(string source) => $"source-badge-{source.ToLowerInvariant()}" switch
    {
        "source-badge-claude" => "source-badge-claude",
        "source-badge-devin" => "source-badge-devin",
        "source-badge-cursor" => "source-badge-cursor",
        "source-badge-opencode" => "source-badge-opencode",
        "source-badge-taskboard" => "source-badge-taskboard",
        _ => "source-badge-unknown"
    };
}
