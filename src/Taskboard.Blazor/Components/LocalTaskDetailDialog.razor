@using System.Globalization
@inject TaskboardClient Client
@inject ToastService ToastService

<Tabs EnableFadeEffect="true">
    <Tab Title="Detalhes" IsActive="true">
        <Content>
            <div class="pt-3">
                <h6 class="mb-2">@Task?.Title</h6>
                <p class="small text-body-secondary mb-2">
                    <strong>Identificador:</strong> @Task?.Identifier
                    <span class="ms-3"><strong>Status:</strong> @Task?.Status</span>
                    <span class="ms-3"><strong>Prioridade:</strong> @Task?.Priority</span>
                </p>
                @if (Task?.Labels.Count > 0)
                {
                    <p class="small text-body-secondary mb-2">
                        <strong>Labels:</strong> @string.Join(", ", Task.Labels)
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Task?.Description))
                {
                    <p class="mt-3">@Task.Description</p>
                }
            </div>
        </Content>
    </Tab>
    <Tab Title="@($"Comentários ({_comments?.Count ?? 0})")">
        <Content>
            <div class="pt-3">
                @if (_comments is null)
                {
                    <Loading Message="Carregando comentários..." />
                }
                else if (_comments.Count == 0)
                {
                    <p class="text-body-secondary small">Nenhum comentário.</p>
                }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var comment in _comments)
                        {
                            <li class="border-bottom py-2">
                                <div class="small text-body-secondary">
                                    <strong>@comment.Author.Name</strong> — @comment.CreatedAt.ToString("g", CultureInfo.CurrentCulture)
                                </div>
                                <div>@comment.Body</div>
                            </li>
                        }
                    </ul>
                }
                <div class="mt-3">
                    <textarea class="form-control" rows="2" placeholder="Escreva um comentário..." @bind="_newComment"></textarea>
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Class="mt-2"
                            Disabled="@(string.IsNullOrWhiteSpace(_newComment) || _isSavingComment)"
                            @onclick="AddCommentAsync">
                        Comentar
                    </Button>
                </div>
            </div>
        </Content>
    </Tab>
    <Tab Title="@($"Anexos ({_attachments?.Count ?? 0})")">
        <Content>
            <div class="pt-3">
                @if (_attachments is null)
                {
                    <Loading Message="Carregando anexos..." />
                }
                else if (_attachments.Count == 0)
                {
                    <p class="text-body-secondary small">Nenhum anexo.</p>
                }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var attachment in _attachments)
                        {
                            <li class="d-flex align-items-center border-bottom py-2">
                                <a href="/api/attachments/@attachment.Id/download" class="text-decoration-none">
                                    <Icon Name="IconName.Paperclip" class="me-1" />@attachment.Filename
                                </a>
                                <span class="small text-body-secondary ms-2">(@FormatSize(attachment.Size))</span>
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" Class="ms-auto"
                                        @onclick="() => DeleteAttachmentAsync(attachment.Id)">
                                    <Icon Name="IconName.Trash" />
                                </Button>
                            </li>
                        }
                    </ul>
                }
                <div class="mt-3">
                    <InputFile OnChange="UploadAttachmentAsync" class="form-control" />
                </div>
            </div>
        </Content>
    </Tab>
</Tabs>

@code {
    private const long MaxUploadSize = 20 * 1024 * 1024;

    [Parameter, EditorRequired]
    public TaskDto? Task { get; set; }

    private IReadOnlyList<CommentDto>? _comments;
    private IReadOnlyList<AttachmentDto>? _attachments;
    private string _newComment = string.Empty;
    private bool _isSavingComment;

    protected override async Task OnParametersSetAsync()
    {
        if (Task is null)
        {
            return;
        }

        var commentsTask = Client.GetTaskCommentsAsync(Task.Id);
        var attachmentsTask = Client.GetTaskAttachmentsAsync(Task.Id);
        _comments = await commentsTask;
        _attachments = await attachmentsTask;
    }

    private async Task AddCommentAsync()
    {
        if (Task is null || string.IsNullOrWhiteSpace(_newComment))
        {
            return;
        }

        _isSavingComment = true;
        try
        {
            var comment = await Client.AddCommentAsync(Task.Id, _newComment.Trim());
            if (comment is not null)
            {
                _comments = [.. (_comments ?? []), comment];
            }

            _newComment = string.Empty;
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao adicionar comentário: {ex.Message}"));
        }
        finally
        {
            _isSavingComment = false;
        }
    }

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs args)
    {
        if (Task is null)
        {
            return;
        }

        var file = args.File;
        try
        {
            await using var stream = file.OpenReadStream(MaxUploadSize);
            var attachment = await Client.UploadAttachmentAsync(Task.Id, stream, file.Name, file.ContentType);
            if (attachment is not null)
            {
                _attachments = [.. (_attachments ?? []), attachment];
            }

            ToastService.Notify(new(ToastType.Success, $"Anexo '{file.Name}' enviado."));
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao enviar anexo: {ex.Message}"));
        }
    }

    private async Task DeleteAttachmentAsync(string attachmentId)
    {
        try
        {
            await Client.DeleteAttachmentAsync(attachmentId);
            _attachments = _attachments?.Where(a => a.Id != attachmentId).ToList();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao remover anexo: {ex.Message}"));
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes} B"
    };
}
