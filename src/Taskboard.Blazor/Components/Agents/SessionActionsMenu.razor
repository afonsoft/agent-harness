@* SPEC-20261020-session-history-parity RF-004/RF-007/RF-008: per-session
   actions menu — only applicable actions render; delete asks confirmation
   with the path shown and stays disabled for live sessions and db-backed
   CLIs (devin/opencode/gemini/agy).
   SPEC-20261020-agent-hibernation RF-009: "Keep alive" pins live/hibernated
   sessions so the sweep never hibernates them. *@
@using Taskboard.Application.Contracts.Agents
@inject IJSRuntime JS
@inject ToastService ToastService
@inject TaskboardClient Client
@inject NavigationManager Navigation

<details class="session-actions dropdown">
    <summary class="btn btn-sm btn-outline-secondary" title="Session actions">
        <Icon Name="IconName.ThreeDotsVertical" />
    </summary>
    @if (_confirmDelete)
    {
        <ul class="dropdown-menu dropdown-menu-end show">
            <li class="px-3 py-1 small text-body-secondary">
                Delete this transcript?<br />
                <code class="text-break">@Entry.TranscriptPath</code>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <button class="dropdown-item text-danger" type="button"
                        @onclick="ConfirmDeleteAsync" disabled="@_busy">
                    <Icon Name="IconName.Trash" class="me-2" />Delete
                </button>
            </li>
            <li>
                <button class="dropdown-item" type="button"
                        @onclick="() => _confirmDelete = false">
                    Cancel
                </button>
            </li>
        </ul>
    }
    else
    {
        <ul class="dropdown-menu dropdown-menu-end show">
            @if (Entry.ResumeCommand is not null)
            {
                <li>
                    <a class="dropdown-item" href="@TerminalUrl(Entry.ResumeCommand)">
                        <Icon Name="IconName.Play" class="me-2" />Resume interactive
                    </a>
                </li>
            }
            @if (Entry.HasNativeChat)
            {
                <li>
                    <button class="dropdown-item" type="button"
                            @onclick="ResumeNativeChatAsync" disabled="@_busy">
                        <Icon Name="IconName.ChatDots" class="me-2" />Resume in native chat
                    </button>
                </li>
            }
            @if (Entry.ResumeCommand is not null)
            {
                <li>
                    <button class="dropdown-item" type="button" @onclick="CopyResumeCommandAsync">
                        <Icon Name="IconName.Clipboard" class="me-2" />Copy resume command
                    </button>
                </li>
            }
            <li>
                <button class="dropdown-item" type="button" @onclick="CopySessionIdAsync">
                    <Icon Name="IconName.Key" class="me-2" />Copy session ID
                </button>
            </li>
            @if (PinKey is not null)
            {
                <li>
                    <button class="dropdown-item" type="button"
                            @onclick="TogglePinAsync" disabled="@_busy"
                            title="@(Entry.Pinned
                                ? "Allow this session to hibernate when idle"
                                : "Never hibernate this session while idle")">
                        <Icon Name="@(Entry.Pinned ? IconName.PinAngleFill : IconName.PinAngle)"
                              class="me-2" />
                        @(Entry.Pinned ? "Unpin (allow hibernation)" : "Keep alive")
                    </button>
                </li>
            }
            @if (Entry.TranscriptPath is not null)
            {
                <li>
                    <button class="dropdown-item" type="button" @onclick="CopyLogPathAsync">
                        <Icon Name="IconName.FileEarmarkText" class="me-2" />Copy log path
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button"
                            @onclick="() => OpenPathAsync(Entry.TranscriptPath!)" disabled="@_busy">
                        <Icon Name="IconName.BoxArrowUpRight" class="me-2" />Open log
                    </button>
                </li>
            }
            @if (Entry.Cwd is not null)
            {
                <li>
                    <button class="dropdown-item" type="button"
                            @onclick="() => OpenPathAsync(Entry.Cwd!)" disabled="@_busy">
                        <Icon Name="IconName.Folder2Open" class="me-2" />Open working directory
                    </button>
                </li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <button class="dropdown-item text-danger @(Deletable ? "" : "disabled")"
                        type="button" disabled="@(!Deletable || _busy)"
                        title="@(Entry.Live
                            ? "Live sessions cannot be deleted"
                            : Deletable ? "Delete transcript file" : "History is db-backed for this CLI")"
                        @onclick="() => _confirmDelete = true">
                    <Icon Name="IconName.Trash" class="me-2" />Delete from history
                </button>
            </li>
        </ul>
    }
</details>

@code {
    /// <summary>Index row the menu acts on.</summary>
    [Parameter, EditorRequired]
    public required SessionIndexEntryDto Entry { get; set; }

    /// <summary>Fired after a delete so the parent can reload the index.</summary>
    [Parameter]
    public EventCallback OnDeleted { get; set; }

    /// <summary>Fired after a pin toggle so the parent can reload the index.</summary>
    [Parameter]
    public EventCallback OnPinnedChanged { get; set; }

    private bool _confirmDelete;
    private bool _busy;

    /// <summary>Runtime key the pin endpoint targets — live or hibernated.</summary>
    private string? PinKey => Entry.LiveKey ?? Entry.HibernationKey;

    /// <summary>File-per-session CLIs — same set as SessionActionService.</summary>
    private bool Deletable =>
        !Entry.Live && Entry.TranscriptPath is not null
        && Entry.Cli is "claude" or "codex";

    private static string TerminalUrl(string command) =>
        $"/terminal?cmd={Uri.EscapeDataString(command)}";

    private Task CopyResumeCommandAsync() =>
        CopyAsync(Entry.ResumeCommand!, "Resume command");

    private Task CopySessionIdAsync() =>
        CopyAsync(Entry.SessionId, "Session id");

    private Task CopyLogPathAsync() =>
        CopyAsync(Entry.TranscriptPath!, "Log path");

    private async Task CopyAsync(string text, string label)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await ToastService.NotifyAsync(new(ToastType.Success, $"{label} copied to clipboard"));
    }

    private async Task ResumeNativeChatAsync()
    {
        _busy = true;
        try
        {
            var result = await Client.ResumeSessionNativeChatAsync(
                Entry.Cli, Entry.SessionId, Entry.Cwd);
            if (result is not null)
            {
                Navigation.NavigateTo("/ai-chat");
            }
            else
            {
                await ToastService.NotifyAsync(
                    new(ToastType.Danger, "Native-chat resume failed"));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenPathAsync(string path)
    {
        _busy = true;
        try
        {
            if (!await Client.OpenSessionPathAsync(path))
            {
                await ToastService.NotifyAsync(
                    new(ToastType.Danger, "Could not open path"));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TogglePinAsync()
    {
        if (PinKey is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var pinned = !Entry.Pinned;
            if (await Client.SetSessionPinnedAsync(PinKey, pinned))
            {
                await ToastService.NotifyAsync(new(ToastType.Success,
                    pinned ? "Session pinned — keep alive" : "Session unpinned"));
                await OnPinnedChanged.InvokeAsync();
            }
            else
            {
                await ToastService.NotifyAsync(
                    new(ToastType.Danger, "Pin failed — session not found"));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        _busy = true;
        try
        {
            var error = await Client.DeleteSessionAsync(Entry.Cli, Entry.SessionId);
            if (error is null)
            {
                await ToastService.NotifyAsync(
                    new(ToastType.Success, "Session deleted from history"));
                await OnDeleted.InvokeAsync();
            }
            else
            {
                await ToastService.NotifyAsync(
                    new(ToastType.Danger, $"Delete failed: {error}"));
            }
        }
        finally
        {
            _busy = false;
            _confirmDelete = false;
        }
    }
}
