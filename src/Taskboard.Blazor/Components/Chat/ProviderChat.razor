    /// <summary>
    /// RF-005: 👍 saves immediately (no note needed); 👎 opens the popover
    /// so the reason lands in the log. Rating again on the same thumb clears.
    /// </summary>
    private async Task RateMessageAsync(ChatMessageDto message, string rating)
    {
        if (_conversationId is null)
        {
            return;
        }

        if (message.Feedback?.Rating == rating)
        {
            // Toggle off — DELETE the row.
            try
            {
                await Client.DeleteChatFeedbackAsync(_conversationId, message.Id);
                ReplaceFeedback(message.Id, null);
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
            {
                _error = $"Falha ao limpar feedback: {ex.Message}";
            }

            return;
        }

        if (rating == "negative")
        {
            _feedbackFor = _feedbackFor == message.Id ? null : message.Id;
            _feedbackNote = message.Feedback?.Note ?? string.Empty;
            _feedbackCategory = message.Feedback?.Category;
            if (_feedbackFor is null)
            {
                return;
            }
        }
        else
        {
            await SaveFeedbackAsync(message.Id, rating, note: null, category: null);
        }
    }

    /// <summary>RF-005: persists the popover state (👎 + category/note).</summary>
    private async Task SaveFeedbackAsync(string messageId) =>
        await SaveFeedbackAsync(messageId, "negative", _feedbackNote, _feedbackCategory);

    private async Task SaveFeedbackAsync(string messageId, string rating, string? note, string? category)
    {
        if (_conversationId is null)
        {
            return;
        }

        var message = _messages.FirstOrDefault(m => m.Id == messageId);
        try
        {
            var (feedback, conflict) = await Client.PutChatFeedbackAsync(
                _conversationId, messageId,
                new PutChatMessageFeedbackRequest(rating, category, note, message?.Feedback?.Version ?? 0));
            if (conflict)
            {
                // CAS lost — server returned the current row; adopt it.
                ReplaceFeedback(messageId, feedback);
                _notice = "Feedback já atualizado em outra aba — estado atual mostrado.";
            }
            else
            {
                ReplaceFeedback(messageId, feedback);
            }

            _feedbackFor = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = $"Falha no feedback: {ex.Message}";
        }
    }

    private void ReplaceFeedback(string messageId, ChatFeedbackDto? feedback)
    {
        var index = _messages.FindIndex(m => m.Id == messageId);
        if (index >= 0)
        {
            _messages[index] = _messages[index] with { Feedback = feedback };
        }
    }

