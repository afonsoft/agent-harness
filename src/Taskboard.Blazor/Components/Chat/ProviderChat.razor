    // ---- RF-003: background-job strip ----

    /// <summary>Restart the 4s jobs poll for the open conversation.</summary>
    private void StartJobsPoll()
    {
        _jobsPollCts?.Cancel();
        _jobsPollCts?.Dispose();
        _jobsPollCts = new CancellationTokenSource();
        var token = _jobsPollCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await LoadJobsAsync();
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(4000, token);
                }
            }
            catch (OperationCanceledException)
            {
                // Poll cancelado no dispose/troca de conversa.
            }
            catch (Exception)
            {
                // Poll is best-effort — a dead endpoint just empties the strip.
            }
        });
    }

