@using System.Text.Json
@using Taskboard.Application.Contracts.Chat
@using Taskboard.Rendering
@inject TaskboardClient Client
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@* SPEC-20260929-ai-code-provider-chat RF-010: provider chat mode inside AI
   Code — open-webui-like layout: collapsible history sidebar, provider/model
   pickers, streamed messages with tool cards and inline images. *@

<div class="provider-chat d-flex">
    <div class="provider-chat-sidebar @(_sidebarOpen ? "" : "collapsed")">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3">
            <span class="fw-semibold small text-body-secondary">Histórico</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleSidebar" title="Recolher/expandir">☰</button>
        </div>
        <div class="px-3 py-2">
            <button type="button" class="btn btn-primary btn-sm w-100" @onclick="StartNewChatAsync" disabled="@_busy">+ New chat</button>
        </div>
        <div class="px-3 pb-2">
            <input type="search" class="form-control form-control-sm" enterkeyhint="search" data-shortcut-search placeholder="Buscar conversas…" @bind="_search" @bind:after="OnSearchChangedAsync" />
        </div>
        <div class="provider-chat-list flex-grow-1 overflow-auto px-2">
            @if (_conversations.Count == 0)
            {
                <div class="text-body-secondary small px-2 py-3">Nenhuma conversa ainda.</div>
            }
            @foreach (var conversation in _conversations)
            {
                <div class="provider-chat-item @(conversation.Id == _conversationId ? "active" : "")" @key="conversation.Id">
                    <button type="button" class="provider-chat-item-btn" @onclick="() => OpenConversationAsync(conversation.Id)" title="@conversation.Title">
                        <span class="d-block text-truncate">@conversation.Title</span>
                        <span class="d-block text-truncate text-body-secondary small">@conversation.Model</span>
                    </button>
                    <button type="button" class="btn-close btn-close-white btn-sm provider-chat-delete" title="Excluir" @onclick="() => DeleteConversationAsync(conversation.Id)"></button>
                </div>
            }
        </div>
    </div>

    <div class="provider-chat-main flex-grow-1 d-flex flex-column">
        <div class="provider-chat-header d-flex align-items-center gap-2 px-3 py-2 border-bottom">
            @if (!_sidebarOpen)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleSidebar" title="Histórico">☰</button>
            }
            <span class="text-body-secondary small header-label">Provider</span>
            <select class="form-select form-select-sm w-auto" @bind="_providerId" @bind:after="OnProviderChangedAsync">
                <option value="">—</option>
                @foreach (var provider in _providers)
                {
                    <option value="@provider.Id" selected="@(provider.Id == _providerId)">@provider.Name</option>
                }
            </select>
            <span class="text-body-secondary small header-label">Model</span>
            <select class="form-select form-select-sm w-auto" @bind="_model" @bind:after="OnModelChangedAsync" disabled="@(_models.Count == 0)">
                @if (_models.Count == 0)
                {
                    <option value="">no models</option>
                }
                @foreach (var model in _models)
                {
                    <option value="@model" selected="@(model == _model)">@model</option>
                }
            </select>
            @if (_conversationTitle is { Length: > 0 })
            {
                <span class="ms-auto small text-body-secondary text-truncate d-none d-md-block">@_conversationTitle</span>
            }
        </div>

        <div class="provider-chat-messages flex-grow-1 overflow-auto px-3 py-3" id="provider-chat-scroll">
            <div class="provider-chat-thread">
            @if (_messages.Count == 0 && !_running && string.IsNullOrEmpty(_streaming))
            {
                <div class="provider-chat-empty">
                    <p class="provider-chat-empty-title">How can I help you today?</p>
                    <p class="small text-body-secondary mb-0">Escolha um provider e um modelo, depois envie uma mensagem. Tools de host (shell, arquivos, CLIs), busca web, código e imagem ficam disponíveis ao modelo — confinadas pelo security gateway.</p>
                </div>
            }
            @foreach (var message in _messages)
            {
                <div class="provider-chat-bubble @BubbleClass(message.Role)">
                    @if (message.Role == "tool")
                    {
                        <details class="provider-tool-card" open="@message.Refused">
                            <summary>
                                <span class="provider-tool-icon"><Icon Name="IconName.Terminal" /></span>
                                <code>@message.ToolName</code>
                                @if (message.Refused)
                                {
                                    <span class="badge text-bg-warning ms-1">refused</span>
                                }
                                <span class="provider-tool-hint ms-auto">result</span>
                            </summary>
                            <pre class="chat-mini-terminal small mb-0"><code>@ToolResultFormatter.FormatForTerminal(message.Content)</code></pre>
                            @if (message.ImageUrl is not null)
                            {
                                <img src="@message.ImageUrl" alt="tool output" class="provider-chat-image img-fluid rounded mt-2" />
                            }
                        </details>
                    }
                    else
                    {
                        @if (SkillChipName(message.Content) is { } chip)
                        {
                            <span class="badge text-bg-secondary mb-1">skill: @chip</span>
                            <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(StripSkillMarker(message.Content)))</div>
                        }
                        else
                        {
                            <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(message.Content))</div>
                        }
                        @if (message.ImageUrl is not null)
                        {
                            <img src="@message.ImageUrl" alt="generated" class="provider-chat-image img-fluid rounded mt-2" />
                        }
                        @if (message.Role == "assistant")
                        {
                            @* open-webui message actions — copy the markdown source. *@
                            <div class="provider-chat-actions">
                                <button type="button" class="provider-chat-action" title="Copiar resposta"
                                        @onclick="() => CopyMessageAsync(message.Id, message.Content)">
                                    <Icon Name="@(_copiedId == message.Id ? IconName.CheckLg : IconName.Clipboard)" />
                                </button>
                            </div>
                        }
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_streaming))
            {
                <div class="provider-chat-bubble assistant">
                    <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(_streaming))</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_reasoning))
            {
                @* Reasoning models (DeepSeek R1, o-series) stream thinking in
                   delta.reasoning_content — visible live while the answer is
                   pending, collapsible afterwards. *@
                <div class="provider-chat-bubble assistant provider-reasoning">
                    <details open="@_running">
                        <summary class="provider-reasoning-summary">
                            @if (_running && string.IsNullOrEmpty(_streaming))
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Thinking
                        </summary>
                        <pre class="provider-reasoning-text mb-0">@_reasoning</pre>
                    </details>
                </div>
            }
            @if (_running && string.IsNullOrEmpty(_streaming))
            {
                <div class="provider-chat-bubble assistant">
                    @if (_statusPhase is not null)
                    {
                        <span class="chat-status-chip">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            @StatusText()
                        </span>
                    }
                    else
                    {
                        <span class="typing-dot"></span>
                    }
                </div>
            }
            </div>
        </div>

        <div class="provider-chat-composer border-top px-3 py-2">
            @if (_error is not null)
            {
                <div class="alert alert-danger py-1 px-2 small mb-2">@_error</div>
            }
            @if (_notice is not null)
            {
                <div class="alert alert-info py-1 px-2 small mb-2">
                    @((MarkupString)_notice)
                    <button type="button" class="btn-close btn-sm float-end" aria-label="Fechar"
                            @onclick="() => _notice = null"></button>
                </div>
            }
            @* SPEC-20261001-chat-skills-slash-commands FR-003: "/" no início do
               composer abre a paleta de skills/comandos. *@
            <SlashCommandPalette Items="SlashItems" Filter="@SlashFilter"
                                 Open="SlashOpen" ActiveIndex="_slashIndex"
                                 OnSelect="OnSlashSelect" />
            <div class="provider-chat-composer-thread">
                <div class="provider-chat-composer-box">
                    <textarea class="provider-chat-input" rows="2" enterkeyhint="send" autocomplete="off" autocapitalize="sentences" data-shortcut-command placeholder="Send a message… (/ comandos e skills, Enter envia)"
                              @bind="_composer" @bind:event="oninput" @onkeydown="OnComposerKey"
                              @onkeydown:preventDefault="_slashPreventDefault"></textarea>
                    <div class="provider-chat-composer-actions">
                        @if (_running)
                        {
                            <button type="button" class="provider-chat-send stop" @onclick="StopAsync" title="Stop" aria-label="Stop">
                                <Icon Name="IconName.StopCircle" />
                            </button>
                        }
                        else
                        {
                            <button type="button" class="provider-chat-send" @onclick="SendAsync" title="Enviar" aria-label="Send"
                                    disabled="@(string.IsNullOrWhiteSpace(_composer) || _providerId == Guid.Empty || string.IsNullOrEmpty(_model))">
                                <Icon Name="IconName.Send" />
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // SPEC-20261001-chat-ux-compact FR-001: histórico oculto por default — ☰ abre o drawer.
    private bool _sidebarOpen;

    private IReadOnlyList<ChatProviderDto> _providers = [];
    private Guid _providerId;
    private IReadOnlyList<string> _models = [];
    private string _model = string.Empty;
    private string? _defaultChatModel;

    private IReadOnlyList<ChatConversationDto> _conversations = [];
    private string? _conversationId;
    private string? _conversationTitle;
    private readonly List<ChatMessageDto> _messages = [];

    /// <summary>Host switch request (/agent builtin) — AiChat flips to agent mode.</summary>
    [Parameter] public EventCallback OnSwitchToAgent { get; set; }

    private string _composer = string.Empty;
    private string _search = string.Empty;

    // SPEC-20261001-chat-skills-slash-commands: slash palette state.
    private IReadOnlyList<SlashCommandPalette.SlashItem> _slashItems = [];
    private int _slashIndex;
    private bool _slashPreventDefault;
    private string? _notice;

    // SPEC-20261001-chat-ux-compact FR-003: live status chip ("Running tool/MCP/agent…").
    private string? _statusPhase;
    private string? _statusLabel;
    private string? _streaming;
    private string? _reasoning;
    private string? _error;
    private bool _running;
    private bool _busy;
    private CancellationTokenSource? _streamCts;
    private string? _copiedId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await Client.GetChatProvidersAsync();
            var conversation = await Client.GetChatConversationsAsync();
            _conversations = conversation;
            try
            {
                // B-16: nova conversa prefere Taskboard:Chat:DefaultChatModel
                // quando o modelo está na lista do provider.
                _defaultChatModel = (await Client.GetConfigurationEntriesAsync())
                    .FirstOrDefault(e => e.Key == "Taskboard:Chat:DefaultChatModel")
                    ?.EffectiveValue;
            }
            catch
            {
                _defaultChatModel = null;
            }
            try
            {
                var capabilities = await Client.GetChatCapabilitiesAsync();
                _slashItems = capabilities
                    .Where(c => c.Kind == Taskboard.Application.Contracts.Chat.ChatCapabilityKind.Skill && c.Enabled)
                    .Select(c => new SlashCommandPalette.SlashItem(c.Name, c.Description, "skill"))
                    .Concat(BuiltinCommands)
                    .ToList();
            }
            catch
            {
                _slashItems = BuiltinCommands;
            }
            if (_providers.Count > 0)
            {
                _providerId = _providers[0].Id;
                await OnProviderChangedAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar providers: {ex.Message}";
        }
    }

    private static string BubbleClass(string role) => role switch
    {
        "user" => "user",
        "tool" => "tool",
        _ => "assistant",
    };

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private async Task OnProviderChangedAsync()
    {
        _models = [];
        _model = string.Empty;
        if (_providerId == Guid.Empty)
        {
            return;
        }

        try
        {
            _models = await Client.GetChatProviderModelsAsync(_providerId);
            if (_defaultChatModel is { Length: > 0 } d && _models.Contains(d))
            {
                _model = d;
            }
            else
            {
                _model = _models.Count > 0 ? _models[0] : string.Empty;
            }
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar modelos: {ex.Message}";
        }
    }

    /// <summary>
    /// B-15: o seletor persistia só o estado local — a conversa continuava no
    /// modelo anterior. PATCH sincroniza; em erro, reverte para o modelo salvo.
    /// </summary>
    private async Task OnModelChangedAsync()
    {
        if (_conversationId is null || string.IsNullOrEmpty(_model))
        {
            return;
        }

        try
        {
            await Client.UpdateChatConversationModelAsync(_conversationId, _model);
        }
        catch (Exception ex)
        {
            _error = $"Falha ao atualizar o modelo da conversa: {ex.Message}";
            var detail = await SafeGetConversationAsync(_conversationId);
            if (detail?.Conversation.Model is { } saved)
            {
                _model = saved;
            }
        }
    }

    private async Task<ChatConversationDetailDto?> SafeGetConversationAsync(string id)
    {
        try
        {
            return await Client.GetChatConversationAsync(id);
        }
        catch
        {
            return null;
        }
    }

    private async Task OnSearchChangedAsync()
    {
        try
        {
            _conversations = await Client.GetChatConversationsAsync(_search);
        }
        catch (Exception)
        {
            // Search is best-effort.
        }
    }

    private async Task StartNewChatAsync()
    {
        if (_providerId == Guid.Empty || string.IsNullOrEmpty(_model))
        {
            _error = "Selecione um provider e um modelo antes de iniciar uma conversa.";
            return;
        }

        _error = null;
        _busy = true;
        try
        {
            var conversation = await Client.CreateChatConversationAsync(new CreateChatConversationRequest(_providerId, _model));
            _conversationId = conversation.Id;
            _conversationTitle = conversation.Title;
            _messages.Clear();
            _streaming = null;
            _reasoning = null;
            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao criar conversa: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenConversationAsync(string id)
    {
        _busy = true;
        _error = null;
        try
        {
            var detail = await Client.GetChatConversationAsync(id);
            if (detail is null)
            {
                return;
            }

            await ApplyConversationAsync(detail);
            await ScrollToEndAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao abrir conversa: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyConversationAsync(ChatConversationDetailDto detail)
    {
        _conversationId = detail.Conversation.Id;
        _conversationTitle = detail.Conversation.Title;
        _messages.Clear();
        _messages.AddRange(detail.Messages);
        _streaming = null;
        _reasoning = null;
        if (_providerId != detail.Conversation.ProviderId)
        {
            _providerId = detail.Conversation.ProviderId;
            await OnProviderChangedAsync();
        }

        if (_models.Contains(detail.Conversation.Model))
        {
            _model = detail.Conversation.Model;
        }
    }

    private async Task DeleteConversationAsync(string id)
    {
        try
        {
            await Client.DeleteChatConversationAsync(id);
            if (_conversationId == id)
            {
                _conversationId = null;
                _conversationTitle = null;
                _messages.Clear();
            }

            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao excluir: {ex.Message}";
        }
    }

    // ---- Slash commands (SPEC-20261001-chat-skills-slash-commands FR-003/004) ----

    private static readonly IReadOnlyList<SlashCommandPalette.SlashItem> BuiltinCommands =
    [
        new("new", "Nova conversa", "builtin"),
        new("agent", "Delegar/ir para Agent mode", "builtin"),
        new("tools", "Abrir tools/capabilities em Settings", "builtin"),
        new("clear", "Limpar o composer", "builtin"),
        new("help", "Listar comandos", "builtin"),
    ];

    private IReadOnlyList<SlashCommandPalette.SlashItem> SlashItems => _slashItems;

    /// <summary>Palette opens while the composer is a single "/token".</summary>
    private bool SlashOpen =>
        _composer.Length > 0 && _composer[0] == '/' && !_composer.Contains(' ', StringComparison.Ordinal) && !_running;

    private string SlashFilter => SlashOpen ? _composer[1..] : string.Empty;

    private IReadOnlyList<SlashCommandPalette.SlashItem> SlashFiltered =>
        SlashCommandPalette.ApplyFilter(_slashItems, SlashFilter);

    private void OnSlashSelect(SlashCommandPalette.SlashItem item)
    {
        if (item.Kind == "skill")
        {
            _composer = $"/{item.Command} ";
        }
        else
        {
            _composer = $"/{item.Command}";
        }
    }

    private async Task OnComposerKey(KeyboardEventArgs e)
    {
        _slashPreventDefault = false;
        if (SlashOpen && HandleSlashKey(e))
        {
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey && !_running)
        {
            _slashPreventDefault = true;
            await SendAsync();
        }
    }

    /// <summary>Slash-palette keys — true when the key was consumed by the palette.</summary>
    private bool HandleSlashKey(KeyboardEventArgs e)
    {
        var filtered = SlashFiltered;
        if (e.Key is "ArrowDown" or "ArrowUp")
        {
            _slashPreventDefault = true;
            _slashIndex = e.Key == "ArrowDown"
                ? (_slashIndex + 1) % filtered.Count
                : (_slashIndex - 1 + filtered.Count) % filtered.Count;
            return true;
        }

        if (e.Key is "Tab")
        {
            _slashPreventDefault = true;
            if (filtered.Count > 0)
            {
                OnSlashSelect(filtered[Math.Min(_slashIndex, filtered.Count - 1)]);
            }
            return true;
        }

        if (e.Key is "Escape")
        {
            _slashPreventDefault = true;
            _composer = string.Empty;
            return true;
        }

        if (e.Key is "Enter" && filtered.Count > 0 && !_composer.Equals($"/{filtered[Math.Min(_slashIndex, filtered.Count - 1)].Command}", StringComparison.Ordinal))
        {
            _slashPreventDefault = true;
            OnSlashSelect(filtered[Math.Min(_slashIndex, filtered.Count - 1)]);
            return true;
        }

        return false;
    }

    /// <summary>Builtin slash commands — true when the turn was consumed locally.</summary>
    private async Task<bool> TryRunBuiltinAsync(string command)
    {
        switch (command.ToLowerInvariant())
        {
            case "new":
                _composer = string.Empty;
                await StartNewChatAsync();
                return true;
            case "clear":
                _composer = string.Empty;
                return true;
            case "agent":
                _composer = string.Empty;
                await OnSwitchToAgent.InvokeAsync();
                return true;
            case "tools":
                _composer = string.Empty;
                Navigation.NavigateTo("/settings");
                return true;
            case "help":
                _notice = "Comandos: /new, /agent, /tools, /clear, /help — /&lt;skill&gt; injeta uma skill global.";
                _composer = string.Empty;
                return true;
            default:
                return false;
        }
    }

    /// <summary>
    /// FR-003: "/name args" becomes a user turn carrying the skill chip marker
    /// plus the SKILL.md instructions — one round-trip saved vs use_skill.
    /// </summary>
    private async Task<string?> ComposeSkillMessageAsync(SlashCommandPalette.SlashItem skill, string rest)
    {
        try
        {
            var capability = (await Client.GetChatCapabilitiesAsync())
                .FirstOrDefault(c => c.Kind == Taskboard.Application.Contracts.Chat.ChatCapabilityKind.Skill
                    && string.Equals(c.Name, skill.Command, StringComparison.OrdinalIgnoreCase));
            // Origin may aggregate several install dirs ("claude, devin") —
            // the detail endpoint resolves by a single source, so use the first.
            var source = capability?.Origin?.Split(',', StringSplitOptions.TrimEntries
                | StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
            var detail = capability is null
                ? null
                : await Client.GetSkillDetailAsync(source, capability.Name);
            if (detail is null)
            {
                _error = $"Skill '{skill.Command}' indisponível.";
                return null;
            }

            var args = string.IsNullOrWhiteSpace(rest) ? string.Empty : "\n\nUser request: " + rest;
            var composed = $"[skill:{detail.Name}] {rest}\n\n"
                + $"<skill name=\"{detail.Name}\" source=\"{detail.Source}\">\n"
                + detail.Content + "\n</skill>" + args;
            return composed;
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar skill '{skill.Command}': {ex.Message}";
            return null;
        }
    }

    /// <summary>FR-003: "Running tool/MCP/agent" chip label per status phase.</summary>
    private string StatusText() => _statusPhase switch
    {
        "running_tool" => $"Running tool: {_statusLabel}",
        "running_mcp" => $"Running MCP: {_statusLabel}",
        "running_agent" => $"Running agent: {_statusLabel}",
        "running_subagent" => $"Running sub-agent: {_statusLabel}",
        "thinking" => "Thinking…",
        _ => _statusLabel ?? "Running…",
    };

    /// <summary>Marker "[skill:name]" prefix → badge chip on user bubbles.</summary>
    private static string? SkillChipName(string content)
    {
        if (!content.StartsWith("[skill:", StringComparison.Ordinal))
        {
            return null;
        }

        var end = content.IndexOf(']', StringComparison.Ordinal);
        return end < 0 ? null : content[7..end];
    }

    private static string StripSkillMarker(string content)
    {
        var end = content.IndexOf(']', StringComparison.Ordinal);
        return end < 0 ? content : content[(end + 1)..].TrimStart();
    }

    private async Task SendAsync()
    {
        var content = _composer.Trim();
        if (await EnsureConversationAsync(content) is not { } conversationId)
        {
            return;
        }

        // FR-004: builtin commands execute locally; /skill injects SKILL.md.
        if (content.StartsWith('/'))
        {
            var (consumed, resolved) = await ResolveSlashContentAsync(content);
            if (consumed)
            {
                return;
            }
            content = resolved;
        }

        _error = null;
        _composer = string.Empty;
        _messages.Add(new ChatMessageDto(
            Id: Guid.NewGuid().ToString("N"), Role: "user", Content: content,
            ToolCallsJson: null, ToolCallId: null, ToolName: null, Refused: false,
            ImagePath: null, ImageUrl: null, TokensIn: null, TokensOut: null, Model: null,
            CreatedAt: DateTime.UtcNow));
        _running = true;
        _streaming = string.Empty;
        _reasoning = string.Empty;
        var streamCts = new CancellationTokenSource();
        _streamCts = streamCts;
        await ScrollToEndAsync();

        await StreamAssistantReplyAsync(conversationId, content, streamCts);
    }

    /// <summary>Creates the conversation when missing; null → nothing to send.</summary>
    private async Task<string?> EnsureConversationAsync(string content)
    {
        if (content.Length != 0 && _conversationId is not null)
        {
            return _conversationId;
        }

        if (_conversationId is null)
        {
            await StartNewChatAsync();
            return _conversationId;
        }

        return null;
    }

    /// <summary>Runs builtin/skill slash handling; consumed → caller returns.</summary>
    private async Task<(bool Consumed, string Content)> ResolveSlashContentAsync(string content)
    {
        var space = content.IndexOf(' ', StringComparison.Ordinal);
        var command = (space < 0 ? content : content[..space]).TrimStart('/');
        var rest = space < 0 ? string.Empty : content[(space + 1)..];

        if (await TryRunBuiltinAsync(command))
        {
            return (true, content);
        }

        var skill = _slashItems.FirstOrDefault(i =>
            i.Kind == "skill" && string.Equals(i.Command, command, StringComparison.OrdinalIgnoreCase));
        if (skill is null)
        {
            return (false, content);
        }

        var composed = await ComposeSkillMessageAsync(skill, rest);
        return composed is null ? (true, content) : (false, composed);
    }

    private async Task StreamAssistantReplyAsync(string conversationId, string content, CancellationTokenSource streamCts)
    {
        try
        {
            using var response = await Client.SendChatMessageAsync(conversationId, content, streamCts.Token);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Falha no envio ({(int)response.StatusCode}).";
                _running = false;
                _streaming = null;
                return;
            }

            await using var stream = await response.Content.ReadAsStreamAsync(streamCts.Token);
            using var reader = new StreamReader(stream);
            string? eventName = null;
            while (await reader.ReadLineAsync(streamCts.Token) is { } line)
            {
                if (line.StartsWith("event:", StringComparison.Ordinal))
                {
                    eventName = line["event:".Length..].Trim();
                    continue;
                }

                if (!line.StartsWith("data:", StringComparison.Ordinal) || eventName is null)
                {
                    continue;
                }

                var data = line["data:".Length..].Trim();
                await HandleSseEventAsync(eventName, data);
                eventName = null;
            }
        }
        catch (OperationCanceledException)
        {
            // Stop pressed — partial content stays on screen.
        }
        catch (Exception ex)
        {
            _error = $"Falha no stream: {ex.Message}";
        }
        finally
        {
            _running = false;
            _streaming = null;
            _statusPhase = null;
            _statusLabel = null;
            streamCts.Dispose();
            _streamCts = null;
            await ReloadConversationAsync();
        }
    }

    private async Task HandleSseEventAsync(string eventName, string data)
    {
        switch (eventName)
        {
            case "chat.delta":
                var delta = JsonSerializer.Deserialize<JsonElement>(data);
                _streaming += delta.TryGetProperty("content", out var c) ? c.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.reasoning":
                var reasoning = JsonSerializer.Deserialize<JsonElement>(data);
                _reasoning += reasoning.TryGetProperty("content", out var r) ? r.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.tool_call":
                // The persisted tool message arrives via reload; live card comes from tool_result.
                break;
            case "chat.status":
                var status = JsonSerializer.Deserialize<JsonElement>(data);
                _statusPhase = status.TryGetProperty("phase", out var ph) ? ph.GetString() : null;
                _statusLabel = status.TryGetProperty("label", out var lb) ? lb.GetString() : null;
                if (_statusPhase is "idle")
                {
                    _statusPhase = null;
                    _statusLabel = null;
                }
                await ScrollToEndAsync();
                break;
            case "chat.tool_result":
                await ReloadConversationAsync();
                await ScrollToEndAsync();
                break;
            case "chat.done":
                _statusPhase = null;
                _statusLabel = null;
                break;
        }
    }

    private async Task ReloadConversationAsync()
    {
        if (_conversationId is null)
        {
            return;
        }

        try
        {
            var detail = await Client.GetChatConversationAsync(_conversationId);
            if (detail is null)
            {
                return;
            }

            _messages.Clear();
            _messages.AddRange(detail.Messages);
            _conversationTitle = detail.Conversation.Title;
            await OnSearchChangedAsync();
        }
        catch (Exception)
        {
            // Reload is best-effort — the streamed content stays visible.
        }
    }

    private async Task StopAsync()
    {
        if (_conversationId is null)
        {
            return;
        }

        try
        {
            await Client.StopChatAsync(_conversationId);
        }
        catch (Exception)
        {
            // The stream ends on its own when the server cancels.
        }
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Delay(1);
        StateHasChanged();
        // SPEC-20261001-chat-ux-compact FR-004: syntax colors (throttled JS-side).
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.highlight", "provider-chat-scroll");
        }
        catch (JSException)
        {
            // Pre-render/disposed — highlight is cosmetic.
        }
    }

    // SPEC-20261001-ai-chat-openwebui: copy the raw markdown of an assistant
    // answer (open-webui message action); shows a ✓ briefly.
    private async Task CopyMessageAsync(string id, string content)
    {
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.copy", content);
            _copiedId = id;
            StateHasChanged();
            _ = Task.Delay(1600).ContinueWith(_ =>
            {
                _copiedId = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (JSException)
        {
            await ToastService.NotifyAsync(new ToastMessage(ToastType.Danger, "Não foi possível copiar."));
        }
    }

    public void Dispose()
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
    }
}
