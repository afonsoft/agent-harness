    /// <summary>RF-005/RF-007: steer.queued/steer.resolved hub fan-out.</summary>
    private void OnSteerChanged(string conversationId, string steerId, string? detail, bool queued)
    {
        if (conversationId != _conversationId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (queued && detail is not null)
            {
                _pendingSteers.RemoveAll(s => s.Id == steerId);
                _pendingSteers.Add(new PendingSteer(steerId, detail));
            }
            else if (!queued)
            {
                _pendingSteers.RemoveAll(s => s.Id == steerId);
            }

            StateHasChanged();
        });
    }

    /// <summary>
    /// RF-003: subscribes to a run — chat.sync replays state, the tail follows.
    /// Detached task: closing a tab/conv cancels only this local stream; the
    /// run itself keeps going on the server and the next open re-attaches.
    /// </summary>
    private void AttachRun(string conversationId, string runId)
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
        var streamCts = new CancellationTokenSource();
        _streamCts = streamCts;
        _runStatus = "queued";
        _runId = runId;
        _streaming = string.Empty;
        _reasoning = string.Empty;
        _ = Task.Run(() => ReadRunStreamAsync(conversationId, runId, streamCts), CancellationToken.None);
        _ = ScrollToEndAsync();
    }

    private async Task ReadRunStreamAsync(string conversationId, string runId, CancellationTokenSource streamCts)
    {
        try
        {
            using var response = await Client.OpenChatRunStreamAsync(conversationId, runId, streamCts.Token);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Falha ao anexar ao run ({(int)response.StatusCode}).";
                return;
            }

            await using var stream = await response.Content.ReadAsStreamAsync(streamCts.Token);
            using var reader = new StreamReader(stream);
            string? eventName = null;
            while (await reader.ReadLineAsync(streamCts.Token) is { } line)
            {
                if (line.StartsWith("event:", StringComparison.Ordinal))
                {
                    eventName = line["event:".Length..].Trim();
                    continue;
                }

                if (!line.StartsWith("data:", StringComparison.Ordinal) || eventName is null)
                {
                    continue;
                }

                var data = line["data:".Length..].Trim();
                await InvokeAsync(() => HandleSseEventAsync(eventName, data));
                eventName = null;
            }
        }
        catch (OperationCanceledException)
        {
            // Stop pressed / conversation switch — the run continues server-side.
        }
        catch (Exception ex)
        {
            _error = $"Falha no stream: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(async () =>
            {
                // SPEC-20261012: chat.done already set the terminal status —
                // keep it as the last-run chip; only a stale live status
                // (stream dropped mid-run) clears before the re-attach.
                if (_runStatus is "queued" or "running" or "paused")
                {
                    _runStatus = null;
                }

                _runId = null;
                _streaming = null;
                _statusPhase = null;
                _statusLabel = null;
                if (ReferenceEquals(_streamCts, streamCts))
                {
                    _streamCts = null;
                }

                // Reload picks up the persisted tail; a still-live run (queued
                // follow-up that just started) re-attaches seamlessly.
                var detail = await ReloadConversationAsync();
                if (detail?.ActiveRun is { } next && _conversationId == conversationId)
                {
                    AttachRun(conversationId, next.Id);
                }
            });
            streamCts.Dispose();
        }
    }

    /// <summary>Creates the conversation when missing; null → nothing to send.</summary>
    private async Task<string?> EnsureConversationAsync(string content, bool hasAttachments = false)
    {
        if ((content.Length != 0 || hasAttachments) && _conversationId is not null)
        {
            return _conversationId;
        }

        if (_conversationId is null)
        {
            await StartNewChatAsync();
            return _conversationId;
        }

        return null;
    }

    /// <summary>Runs builtin/skill slash handling; consumed → caller returns.</summary>
    private async Task<(bool Consumed, string Content)> ResolveSlashContentAsync(string content)
    {
        var space = content.IndexOf(' ', StringComparison.Ordinal);
        var command = (space < 0 ? content : content[..space]).TrimStart('/');
        var rest = space < 0 ? string.Empty : content[(space + 1)..];

        if (await TryRunBuiltinAsync(command, rest))
        {
            return (true, content);
        }

        // SPEC-20261004-cli-slash-commands RF-003: cli commands resolve
        // before global skills — the selected CLI wins on name collision.
        var cliItem = _slashItems.FirstOrDefault(i =>
            i.Kind == "cli" && string.Equals(i.Command, command, StringComparison.OrdinalIgnoreCase));
        if (cliItem is not null)
        {
            return await ResolveCliCommandAsync(cliItem, rest, content);
        }

        var skill = _slashItems.FirstOrDefault(i =>
            i.Kind == "skill" && string.Equals(i.Command, command, StringComparison.OrdinalIgnoreCase));
        if (skill is null)
        {
            return (false, content);
        }

        var composed = await ComposeSkillMessageAsync(skill, rest);
        return composed is null ? (true, content) : (false, composed);
    }

    /// <summary>
    /// File-backed commands inject their body (chip + &lt;command&gt; block,
    /// $ARGUMENTS → rest); body-less ones forward verbatim — the CLI resolves
    /// its own native/ACP-advertised command.
    /// </summary>
    private async Task<(bool Consumed, string Content)> ResolveCliCommandAsync(
        SlashCommandPalette.SlashItem item, string rest, string content)
    {
        var cliName = AgentContext?.AgentCli;
        if (string.IsNullOrWhiteSpace(cliName))
        {
            return (false, content);
        }

        try
        {
            var detail = await Client.GetCliCommandDetailAsync(cliName, item.Command);
            // Unknown to the discovery service (removed between list and
            // send) → forward verbatim; the CLI resolves its own command.
            if (detail is null || string.IsNullOrWhiteSpace(detail.Body))
            {
                return (false, content);
            }

            var composed = SlashCommandComposer.ComposeCliCommand(
                detail.Name, detail.Source, detail.Body, rest, detail.Kind);
            return (false, composed);
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar comando '{item.Command}': {ex.Message}";
            return (true, content);
        }
    }

    private async Task HandleSseEventAsync(string eventName, string data)
    {
        // SPEC-20261012 RF-007: every live event proves activity — the chip's
        // stalled derivation reads this stamp.
        _lastActivityUtc = DateTime.UtcNow;
        switch (eventName)
        {
            // RF-003: full durable state — persisted messages + the in-flight
            // checkpoint; seq already deduped server-side.
            case "chat.sync":
                var sync = JsonSerializer.Deserialize<ChatRunSyncDto>(data, SseJson);
                if (sync is not null)
                {
                    _messages.Clear();
                    _messages.AddRange(sync.Messages);
                    _streaming = sync.Partial;
                    _reasoning = sync.PartialReasoning;
                    _runStatus = sync.Run.Status;
                    // SPEC-20261012: attach derives stalled immediately — the
                    // stamp/threshold come from the server, not the client.
                    _lastActivityUtc = sync.LastActivityUtc ?? DateTime.UtcNow;
                    _stallThresholdSeconds = sync.StallThresholdSeconds > 0
                        ? sync.StallThresholdSeconds : 120;
                    StartStallTimer();
                    // RF-007: chips are ephemeral UI state — a fresh attach
                    // rebuilds them from steer.queued replays, if any.
                    _pendingSteers.Clear();
                }

                await ScrollToEndAsync();
                break;
            case "chat.delta":
                var delta = JsonSerializer.Deserialize<JsonElement>(data);
                _streaming += delta.TryGetProperty("content", out var c) ? c.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.reasoning":
                var reasoning = JsonSerializer.Deserialize<JsonElement>(data);
                _reasoning += reasoning.TryGetProperty("content", out var r) ? r.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.tool_call":
                // The persisted tool message arrives via reload; live card comes from tool_result.
                break;
            case "chat.status":
                var status = JsonSerializer.Deserialize<JsonElement>(data);
                _statusPhase = status.TryGetProperty("phase", out var ph) ? ph.GetString() : null;
                _statusLabel = status.TryGetProperty("label", out var lb) ? lb.GetString() : null;
                if (_statusPhase is "idle")
                {
                    _statusPhase = null;
                    _statusLabel = null;
                }
                await ScrollToEndAsync();
                break;
            case "approval.asked":
            {
                // SPEC-20261005-chat-tool-approval RF-002: pending card.
                var asked = JsonSerializer.Deserialize<JsonElement>(data);
                var dto = new ChatApprovalDto(
                    asked.TryGetProperty("approvalId", out var aid) ? aid.GetString() ?? string.Empty : string.Empty,
                    _runId ?? string.Empty,
                    _conversationId ?? string.Empty,
                    asked.TryGetProperty("toolCallId", out var tcid) ? tcid.GetString() ?? string.Empty : string.Empty,
                    asked.TryGetProperty("toolName", out var tname) ? tname.GetString() ?? string.Empty : string.Empty,
                    asked.TryGetProperty("argsPreview", out var aprv) ? aprv.GetString() ?? "{}" : "{}",
                    "pending", DateTime.UtcNow, null, null, null,
                    asked.TryGetProperty("kind", out var knd) ? knd.GetString() ?? "tool-call" : "tool-call");
                _pendingApprovals.RemoveAll(a => a.Id == dto.Id);
                _pendingApprovals.Add(dto);
                _statusPhase = "waiting-approval";
                _statusLabel = $"Approval: {dto.ToolName}";
                await ScrollToEndAsync();
                break;
            }
            case "approval.decided":
            {
                var decided = JsonSerializer.Deserialize<JsonElement>(data);
                var decidedId = decided.TryGetProperty("approvalId", out var did) ? did.GetString() : null;
                if (decidedId is not null)
                {
                    _pendingApprovals.RemoveAll(a => a.Id == decidedId);
                }

                // RF-003: an approved plan review flips the chip off; a
                // cancelled one (mode turned off) keeps it consistent too.
                if (decided.TryGetProperty("kind", out var dk) && dk.GetString() == "plan-review"
                    && decided.TryGetProperty("status", out var dst))
                {
                    _planMode = dst.GetString() is "allowed-once" or "cancelled" ? "off" : "on";
                }

                if (_denyReasonFor == decidedId)
                {
                    _denyReasonFor = null;
                }

                if (_pendingApprovals.Count == 0 && _statusPhase is "waiting-approval")
                {
                    _statusPhase = null;
                    _statusLabel = null;
                }

                await ScrollToEndAsync();
                break;
            }
            case "chat.pressure":
                var pressure = JsonSerializer.Deserialize<JsonElement>(data);
                _pressure = (
                    pressure.TryGetProperty("estimatedTokens", out var pet) ? pet.GetInt32() : 0,
                    pressure.TryGetProperty("limit", out var plt) ? plt.GetInt32() : 0,
                    pressure.TryGetProperty("compacted", out var pcp) && pcp.GetBoolean());
                if (_conversationId is not null)
                {
                    _pressureByConversation[_conversationId] = _pressure.Value;
                }
                break;
            case "steer.claimed":
            {
                // SPEC-20261005-chat-fork-steering RF-006: the steer entered
                // the wire — drop the pending chip, reload the transcript row.
                var claimed = JsonSerializer.Deserialize<JsonElement>(data);
                var claimedId = claimed.TryGetProperty("steerId", out var cid) ? cid.GetString() : null;
                if (claimedId is not null)
                {
                    _pendingSteers.RemoveAll(s => s.Id == claimedId);
                }

                await ReloadConversationAsync();
                await ScrollToEndAsync();
                break;
            }
            case "chat.tool_result":
                await ReloadConversationAsync();
                await ScrollToEndAsync();
                break;
            case "chat.paused":
                // SPEC-20261012 RF-002: parked at a boundary — the composer
                // flips Pause→Resume; partial content stays visible.
                _runStatus = "paused";
                _statusPhase = "paused";
                _statusLabel = "Pausado";
                break;
            case "chat.resumed":
                // SPEC-20261012 RF-003: back from the park — the next status
                // event repaints the live phase.
                _runStatus = "running";
                _statusPhase = null;
                _statusLabel = null;
                break;
            case "chat.deliverables":
            {
                // RF-007: the run's deliverables card — emitted just before
                // chat.done; persisted rows replay via LastRunDeliverables.
                var deliv = JsonSerializer.Deserialize<JsonElement>(data);
                if (deliv.TryGetProperty("deliverables", out var list))
                {
                    _lastRunDeliverables = JsonSerializer.Deserialize<List<ChatDeliverableDto>>(
                        list.GetRawText(), SseJson);
                }

                await ScrollToEndAsync();
                break;
            }
            case "chat.done":
                var done = JsonSerializer.Deserialize<JsonElement>(data);
                if (done.TryGetProperty("run", out var runEl)
                    && runEl.TryGetProperty("status", out var st))
                {
                    // SPEC-20261012: terminal state rides the header chip
                    // until the next run/conversation replaces it.
                    _runStatus = st.GetString();
                    switch (st.GetString())
                    {
                        case "failed":
                            _error = runEl.TryGetProperty("error", out var err)
                                ? err.GetString() : "Run falhou.";
                            break;
                        case "interrupted":
                            _notice = "Run interrompido (servidor reiniciou) — envie uma nova mensagem para continuar.";
                            break;
                    }
                }

                _statusPhase = null;
                _statusLabel = null;
                _pendingApprovals.Clear();
                _pendingSteers.Clear();
                StopStallTimer();
                // RF-004/RF-005: run settled — refresh todo/diff/plan surfaces.
                _wsRefreshSignal++;
                break;
        }
    }

    private static readonly JsonSerializerOptions SseJson = new(JsonSerializerDefaults.Web);

    private async Task<ChatConversationDetailDto?> ReloadConversationAsync()
    {
        if (_conversationId is null)
        {
            return null;
        }

        try
        {
            var detail = await Client.GetChatConversationAsync(_conversationId);
            if (detail is null)
            {
                return null;
            }

            _messages.Clear();
            _messages.AddRange(detail.Messages);
            _conversationTitle = detail.Conversation.Title;
            _archived = detail.Conversation.ArchivedAt is not null;
            // RF-007: keep pending cards in sync on every transcript reload.
            _pendingApprovals.Clear();
            if (detail.PendingApprovals is { Count: > 0 } pending)
            {
                _pendingApprovals.AddRange(pending);
            }

            _permissionPreset = detail.Conversation.PermissionPreset ?? _permissionPreset;
            _planMode = detail.Conversation.PlanMode ?? _planMode;
            await OnSearchChangedAsync();
            return detail;
        }
        catch (Exception)
        {
            // Reload is best-effort — the streamed content stays visible.
            return null;
        }
    }

    private async Task StopAsync()
    {
        if (_conversationId is null)
        {
            return;
        }

        try
        {
            await Client.StopChatAsync(_conversationId);
        }
        catch (Exception)
        {
            // The stream ends on its own when the server cancels.
        }
    }

    /// <summary>
    /// SPEC-20261012-chat-run-controls RF-008: Pause⇄Resume toggle — the
    /// button and Ctrl+. share this path; server-side flips at the next
    /// tool-call boundary (SSE chat.paused/chat.resumed repaint the chip).
    /// </summary>
    private async Task TogglePauseAsync()
    {
        if (_conversationId is null || _runId is null || _runActionBusy)
        {
            return;
        }

        _runActionBusy = true;
        try
        {
            var ok = _runStatus == "paused"
                ? await Client.ResumeChatRunAsync(_conversationId, _runId)
                : await Client.PauseChatRunAsync(_conversationId, _runId);
            if (!ok)
            {
                _notice = _runStatus == "paused"
                    ? "Não foi possível retomar — a run já terminou."
                    : "Não foi possível pausar — a run já terminou.";
                await ReloadConversationAsync();
            }
            else if (_runStatus == "paused")
            {
                // Optimistic — a parked executor replays chat.resumed, a
                // re-queued one restarts and the attach repaints anyway.
                _runStatus = "running";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = $"Falha no pause/resume: {ex.Message}";
        }
        finally
        {
            _runActionBusy = false;
        }
    }

    /// <summary>
    /// SPEC-20261012 RF-006: derived agent state — pending approvals win over
    /// running/paused; stalled derives from the last-event stamp; terminal
    /// statuses ride through for the last-run badge.
    /// </summary>
    private string? AgentState() => _runStatus switch
    {
        "queued" => "queued",
        "paused" => _pendingApprovals.Count > 0 ? "waiting-approval" : "paused",
        "running" => _pendingApprovals.Count > 0 ? "waiting-approval"
            : IsStalled() ? "stalled" : "running",
        "completed" => "completed",
        "failed" => "failed",
        "stopped" => "stopped",
        "interrupted" => "interrupted",
        _ => null,
    };

    private string? ChipFocusTarget() => AgentState() switch
    {
        "waiting-approval" => "chat-approval-cards",
        "queued" or "running" or "paused" or "stalled" => "chat-live-bubble",
        _ => null,
    };

    /// <summary>RF-007: running + no event for the threshold → stalled.</summary>
    private bool IsStalled() =>
        _runStatus == "running"
        && _lastActivityUtc is { } stamp
        && DateTime.UtcNow - stamp > TimeSpan.FromSeconds(_stallThresholdSeconds);

    /// <summary>
    /// Tick driving the stalled derivation — cheap 5s re-render while a run
    /// is live; started on attach, stopped on done/dispose.
    /// </summary>
    private void StartStallTimer()
    {
        _stallTimer ??= new Timer(
            _ => InvokeAsync(StateHasChanged), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void StopStallTimer()
    {
        _stallTimer?.Dispose();
        _stallTimer = null;
    }

    /// <summary>
    /// SPEC-20261005-chat-attachments-feedback RF-003: clipboard files land
    /// on the hidden InputFile — hook the paste bridge once the textarea
    /// exists.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("taskboardChat.hookPaste",
                    "provider-chat-input", "provider-chat-attach-input");
            }
            catch (JSException)
            {
                // JS helpers are progressive — paste attach just stays off.
            }
        }

        if (_focusRename)
        {
            _focusRename = false;
            try
            {
                await JS.InvokeVoidAsync("taskboard.focusElement", _renameInputRef);
            }
            catch (JSException)
            {
                // Focus is best-effort — the rename input still works without it.
            }
        }
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Delay(1);
        StateHasChanged();
        // SPEC-20261001-chat-ux-compact FR-004: syntax colors (throttled JS-side).
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.highlight", "provider-chat-scroll");
        }
        catch (JSException)
        {
            // Pre-render/disposed — highlight is cosmetic.
        }
    }

    // SPEC-20261001-ai-chat-openwebui: copy the raw markdown of an assistant
    // answer (open-webui message action); shows a ✓ briefly.
    private async Task CopyMessageAsync(string id, string content)
    {
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.copy", content);
            _copiedId = id;
            StateHasChanged();
            _ = Task.Delay(1600).ContinueWith(_ =>
