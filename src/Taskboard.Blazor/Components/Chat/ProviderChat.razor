    /// <summary>
    /// B-15: o seletor persistia só o estado local — a conversa continuava no
    /// modelo anterior. PATCH sincroniza; em erro, reverte para o modelo salvo.
    /// </summary>
    private async Task OnModelChangedAsync()
    {
        if (_conversationId is null || string.IsNullOrEmpty(_model))
        {
            return;
        }

        try
        {
            await Client.UpdateChatConversationModelAsync(_conversationId, _model);
        }
        catch (Exception ex)
        {
            _error = $"Falha ao atualizar o modelo da conversa: {ex.Message}";
            var detail = await SafeGetConversationAsync(_conversationId);
            if (detail?.Conversation.Model is { } saved)
            {
                _model = saved;
            }
        }
    }

