@using System.Text.Json
@using Taskboard.Application.Contracts.Chat
@using Taskboard.Rendering
@inject TaskboardClient Client
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ChatNotificationsService Notifications
@implements IDisposable

@* SPEC-20260929-ai-code-provider-chat RF-010: provider chat mode inside AI
   Code — open-webui-like layout: collapsible history sidebar, provider/model
   pickers, streamed messages with tool cards and inline images. *@

<div class="provider-chat d-flex">
    @* A sidebar é a superfície única de histórico — collapsed = oculta
       (display:none); só abre pelo botão clock-history do header da página
       (ToggleHistoryDrawer). *@
    <div class="provider-chat-sidebar @(_sidebarOpen ? "" : "collapsed")">
        @if (_sidebarOpen)
        {
            <div class="d-flex justify-content-between align-items-center px-3 pt-3">
                <span class="fw-semibold small text-body-secondary">Histórico</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleSidebar" title="Recolher/expandir">☰</button>
            </div>
            <div class="px-3 py-2">
                <button type="button" class="btn btn-primary btn-sm w-100" @onclick="StartNewChatAsync" disabled="@_busy">+ New chat</button>
            </div>
            <div class="px-3 pb-2 d-flex gap-2">
                <input type="search" class="form-control form-control-sm" enterkeyhint="search" data-shortcut-search placeholder="@(_searchContent ? "Buscar no conteúdo…" : "Buscar conversas…")" @bind="_search" @bind:after="OnSearchChangedAsync" />
                @* SPEC-20261005-chat-jobs-schedule-search RF-009: Títulos =
                   filtro do histórico; Conteúdo = busca full-text (FTS5)
                   no corpo das mensagens, resultados agrupados por conversa. *@
                <div class="btn-group btn-group-sm flex-shrink-0" role="group" aria-label="Escopo da busca">
                    <button type="button" class="btn @(!_searchContent ? "btn-primary" : "btn-outline-secondary")"
                            title="Filtrar por título" aria-pressed="@(!_searchContent ? "true" : "false")"
                            @onclick="() => SetSearchContentAsync(false)">Títulos</button>
                    <button type="button" class="btn @(_searchContent ? "btn-primary" : "btn-outline-secondary")"
                            title="Buscar no conteúdo das mensagens" aria-pressed="@(_searchContent ? "true" : "false")"
                            @onclick="() => SetSearchContentAsync(true)">Conteúdo</button>
                </div>
            </div>
            <div class="px-3 pb-2">
                <div class="btn-group btn-group-sm w-100" role="group" aria-label="Filtro de conversas">
                    <button type="button" class="btn @(_showArchived ? "btn-outline-secondary" : "btn-primary")"
                            @onclick="() => SetArchivedFilterAsync(false)">Ativas</button>
                    <button type="button" class="btn @(_showArchived ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetArchivedFilterAsync(true)">Arquivadas</button>
                    @* SPEC-20261005-chat-attachments-feedback RF-006: 👎 só
                       conversas com feedback negativo (encontra pra revisão). *@
                    <button type="button" class="btn @(_negativeOnly ? "btn-danger" : "btn-outline-secondary")"
                            title="Só com feedback negativo" aria-label="Negative feedback only"
                            @onclick="ToggleNegativeOnlyAsync">👎</button>
                </div>
            </div>
            <div class="provider-chat-list flex-grow-1 overflow-auto px-2">
                @if (_searchContent && !string.IsNullOrWhiteSpace(_search))
                {
                    @* RF-009: grouped FTS hits — click opens the conversation
                       and scrolls to #m-{messageId} in the transcript. *@
                    @if (_searchHits.Count == 0)
                    {
                        <div class="text-body-secondary small px-2 py-3">Nenhum resultado.</div>
                    }
                    @foreach (var group in _searchHits.GroupBy(h => h.ConversationId))
                    {
                        <div class="provider-chat-hit-group" @key="group.Key">
                            <button type="button" class="provider-chat-hit-title"
                                    @onclick="() => OpenConversationAsync(group.Key)">
                                @group.First().ConversationTitle
                            </button>
                            @foreach (var hit in group)
                            {
                                <button type="button" class="provider-chat-hit" @key="hit.MessageId"
                                        title="@hit.CreatedAt.ToLocalTime():g"
                                        @onclick="() => OpenHitAsync(hit)">
                                    @((MarkupString)SearchSnippetMarkup(hit.Snippet))
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                @if (_conversations.Count == 0)
                {
                    <div class="text-body-secondary small px-2 py-3">@(_showArchived ? "Nenhuma conversa arquivada." : "Nenhuma conversa ainda.")</div>
                }
                @foreach (var conversation in _conversations)
                {
                    <div class="provider-chat-item @(conversation.Id == _conversationId ? "active" : "")" @key="conversation.Id">
                        <button type="button" class="provider-chat-item-btn" @onclick="() => OpenConversationAsync(conversation.Id)" title="@conversation.Title">
                            <span class="d-block text-truncate">@conversation.Title</span>
                            <span class="d-block text-truncate text-body-secondary small">
                                @conversation.Model
                                @if (conversation.ForkCount > 0)
                                {
                                    @* SPEC-20261005-chat-fork-steering RF-004:
                                       fork-count badge on the source row. *@
                                    <span class="badge text-bg-secondary ms-1" title="@conversation.ForkCount fork(s)">↯@conversation.ForkCount</span>
                                }
                                @if (conversation.ActiveRunStatus is "waiting-approval")
                                {
                                    <span class="badge text-bg-info ms-1" title="Aguardando aprovação de tool">approval?</span>
                                }
                                else if (conversation.ActiveRunStatus is "running" or "queued")
                                {
                                    <span class="provider-chat-run-dot" title="Run em andamento"></span>
                                }
                                @* SPEC-20261005-chat-context-management RF-007:
                                   run.pressure hub badge — % of the wire budget. *@
                                @if (_pressureByConversation.TryGetValue(conversation.Id, out var p) && p.Limit > 0)
                                {
                                    <span class="provider-chat-pressure-badge @(PressureClass(p.Estimated, p.Limit))"
                                          title="Contexto: @p.Estimated/@p.Limit tokens@(p.Compacted ? " — compacted" : string.Empty)">
                                        ctx @(Math.Min(999, (int)Math.Round(100.0 * p.Estimated / p.Limit)))%
                                    </span>
                                }
                            </span>
                        </button>
                        @if (conversation.ForkedFromConversationId is { } forkSource)
                        {
                            @* SPEC-20261005-chat-fork-steering RF-004: lineage
                               subtitle — links back to the source conversation. *@
                            <button type="button" class="provider-chat-fork-line"
                                    title="Abrir conversa de origem"
                                    @onclick="() => OpenConversationAsync(forkSource)">
                                ↯ fork of @(ForkTitle(forkSource))
                            </button>
                        }
                        @if (_showArchived)
                        {
                            <button type="button" class="provider-chat-item-action" title="Restaurar"
                                    @onclick="() => UnarchiveConversationAsync(conversation.Id)">
                                <Icon Name="IconName.ArrowCounterclockwise" />
                            </button>
                            <button type="button" class="provider-chat-item-action text-danger" title="Excluir"
                                    @onclick="() => DeleteConversationAsync(conversation.Id)">
                                <Icon Name="IconName.Trash" />
                            </button>
                        }
                        else
                        {
                            <button type="button" class="provider-chat-item-action" title="Arquivar"
                                    @onclick="() => ArchiveConversationAsync(conversation.Id)">
                                <Icon Name="IconName.Archive" />
                            </button>
                        }
                    </div>
                }
                }
            </div>
            @HistoryExtra
        }
    </div>

    <div class="provider-chat-main flex-grow-1 d-flex flex-column">
        <div class="provider-chat-header d-flex align-items-center gap-2 px-3 py-2 border-bottom">
            @if (AgentContext?.AgentCli is not null)
            {
                <span class="badge text-bg-primary" title="Agent mode — delegated CLI runs bound to this conversation">agent</span>
            }
            @* SPEC-20261012-chat-run-controls RF-006: the full agent state
               replaces the boolean running badge — click focuses the
               pending card / live status bubble. *@
            <AgentStateChip State="@AgentState()" FocusTargetId="@ChipFocusTarget()" />
            @if (_archived)
            {
                <span class="badge text-bg-secondary">arquivada</span>
            }
            @* SPEC-20261005-chat-tool-approval RF-006: per-conversation
               permission preset — chat (read-only) / ask / full. Editable
               mid-run; takes effect on the next tool call. *@
            @if (_conversationId is not null && !_archived)
            {
                <div class="provider-preset-chip" title="Permission preset — política de aprovação de tools">
                    <Icon Name="IconName.ShieldLock" />
                    <select class="form-select form-select-sm provider-preset-select"
                            aria-label="Permission preset"
                            value="@_permissionPreset"
                            @onchange="ChangePresetAsync">
                        <option value="chat">Chat</option>
                        <option value="ask">Ask</option>
                        <option value="full">Full</option>
                    </select>
                </div>
                @* SPEC-20261005-chat-plan-mode RF-005: header chip mirroring
                   PlanMode — a pending review flashes the dot. *@
                <button type="button"
                        class="provider-plan-chip @(_planMode == "on" ? "on" : string.Empty)"
                        title="Plan mode — o modelo planeja (read-only) e apresenta um plano antes de executar"
                        aria-pressed="@(_planMode == "on" ? "true" : "false")"
                        @onclick="() => TogglePlanModeAsync()">
                    <Icon Name="IconName.ListTask" />
                    <span>plan: @_planMode</span>
                    @if (_pendingApprovals.Any(a => a.Kind == "plan-review"))
                    {
                        <span class="provider-plan-dot" aria-label="Plano aguardando revisão"></span>
                    }
                </button>
                @* RF-007: live wire-token meter for the open conversation —
                   chat.pressure SSE updates it each provider call. *@
                @if (_pressure is { Limit: > 0 } meter)
                {
                    <span class="provider-pressure-meter @(PressureClass(meter.Estimated, meter.Limit))"
                          title="Contexto: @meter.Estimated/@meter.Limit tokens@(meter.Compacted ? " — compacted" : string.Empty)"
                          aria-label="Context token usage">
                        <span class="provider-pressure-fill" style="width: @Math.Min(100, 100.0 * meter.Estimated / meter.Limit)%"></span>
                        <span class="provider-pressure-text">@FormatTokens(meter.Estimated)/@FormatTokens(meter.Limit)</span>
                    </span>
                }
            }
            @* SPEC-20261005-chat-fork-steering RF-004: header-level fork —
               branches at the last message; the per-row ⎇ forks mid-way. *@
            @if (_conversationId is not null && _messages.Count > 0 && !_archived)
            {
                <button type="button" class="provider-chat-action" title="Fork — nova conversa a partir daqui"
                        aria-label="Fork conversation from the last message"
                        disabled="@_busy"
                        @onclick="() => ForkFromMessageAsync(_messages[^1].Id)">
                    <Icon Name="IconName.Diagram2" />
                </button>
            }
            @* SPEC-20261005-chat-jobs-schedule-search RF-004/RF-005:
               schedules popover — list, cancel/re-arm, delete, quick create. *@
            @if (_conversationId is not null && !_archived)
            {
                <div class="provider-sched-anchor">
                    <button type="button" class="provider-chat-action" title="Agendamentos"
                            aria-label="Agendamentos da conversa"
                            aria-pressed="@(_schedulePanelOpen ? "true" : "false")"
                            @onclick="ToggleSchedulePanelAsync">
                        <Icon Name="IconName.ClockHistory" />
                        @if (_schedules.Any(s => s.Active))
                        {
                            <span class="provider-sched-badge">@_schedules.Count(s => s.Active)</span>
                        }
                    </button>
                    @if (_schedulePanelOpen)
                    {
                        <div class="provider-sched-panel">
                            <div class="provider-sched-head">Agendamentos</div>
                            @if (_schedules.Count == 0)
                            {
                                <div class="small text-body-secondary px-2 py-2">Nenhum agendamento.</div>
                            }
                            @foreach (var schedule in _schedules)
                            {
                                <div class="provider-sched-row" @key="schedule.Id">
                                    <div class="provider-sched-meta">
                                        <span class="provider-sched-title">@schedule.Title</span>
                                        <span class="small text-body-secondary">
                                            @DescribeSchedule(schedule)
                                        </span>
                                    </div>
                                    <button type="button" class="provider-sched-act" title="@(schedule.Active ? "Pausar" : "Reativar")"
                                            @onclick='() => ToggleScheduleAsync(schedule)'>
                                        @(schedule.Active ? "⏸" : "▶")
                                    </button>
                                    <button type="button" class="provider-sched-act text-danger" title="Excluir"
                                            @onclick='() => DeleteScheduleAsync(schedule.Id)'>
                                        ×
                                    </button>
                                </div>
                            }
                            <div class="provider-sched-new">
                                <input class="form-control form-control-sm" placeholder="Título…" maxlength="120"
                                       @bind="_schedTitle" />
                                <input class="form-control form-control-sm" placeholder="Prompt enviado ao disparar…"
                                       @bind="_schedPrompt" />
                                <div class="d-flex gap-1 align-items-center">
                                    <select class="form-select form-select-sm" @bind="_schedKind" aria-label="Tipo">
                                        <option value="after_seconds">em N segundos</option>
                                        <option value="at">data/hora (ISO)</option>
                                        <option value="cron">cron</option>
                                    </select>
                                    @if (_schedKind == "after_seconds")
                                    {
                                        <input class="form-control form-control-sm" type="number" min="1" style="width: 6rem"
                                               @bind="_schedSeconds" aria-label="Segundos" />
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" style="width: 9rem"
                                               placeholder="@(_schedKind == "cron" ? "*/5 * * * *" : "2026-10-06T09:00")"
                                               @bind="_schedExpr" aria-label="Expressão" />
                                    }
                                </div>
                                <button type="button" class="btn btn-primary btn-sm"
                                        disabled="@(string.IsNullOrWhiteSpace(_schedPrompt) || _schedBusy)"
                                        @onclick="CreateScheduleAsync">Agendar</button>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (_renaming)
            {
                <input class="provider-rename-input ms-auto" @ref="_renameInputRef"
                       @bind="_renameDraft" @bind:event="oninput"
                       @onkeydown="OnRenameKeyDownAsync" @onblur="ConfirmRenameAsync"
                       maxlength="120" aria-label="Rename conversation" />
            }
            else if (_conversationTitle is { Length: > 0 })
            {
                <span class="ms-auto small text-body-secondary text-truncate d-none d-md-block provider-chat-title"
                      role="button" title="Double-click to rename" tabindex="0"
                      @ondblclick="BeginRename">@_conversationTitle</span>
            }
        </div>

        @* SPEC-20261005-chat-jobs-schedule-search RF-003: live background-job
           strip above the transcript — polled (active jobs only); ⏹ kills. *@
        @if (_activeJobs.Count > 0)
        {
            <div class="provider-jobs-strip" aria-label="Background jobs">
                @foreach (var job in _activeJobs)
                {
                    <span class="provider-job-chip" @key="job.Id" title="@job.Command">
                        <span class="provider-job-spinner" aria-hidden="true"></span>
                        <span class="provider-job-name">@ShortCommand(job.Command)</span>
                        <span class="provider-job-elapsed">@JobElapsed(job)</span>
                        <button type="button" class="provider-job-kill" title="Kill" aria-label="Kill job"
                                @onclick='() => KillJobAsync(job.Id)'>×</button>
                    </span>
                }
            </div>
        }

        <div class="provider-chat-messages flex-grow-1 overflow-auto px-3 py-3" id="provider-chat-scroll">
            <div class="provider-chat-thread">
            @if (_messages.Count == 0 && !_running && string.IsNullOrEmpty(_streaming))
            {
                <div class="provider-chat-empty">
                    <p class="provider-chat-empty-title">How can I help you today?</p>
                    <p class="small text-body-secondary mb-0">Escolha um provider e um modelo, depois envie uma mensagem. Tools de host (shell, arquivos, CLIs), busca web, código e imagem ficam disponíveis ao modelo — confinadas pelo security gateway.</p>
                </div>
            }
            @foreach (var message in _messages)
            {
                @* RF-009: #m-{id} anchors let a content-search hit scroll to
                   this bubble (taskboardChat.scrollIntoView). *@
                <div class="provider-chat-bubble @BubbleClass(message.Role)" id="m-@message.Id">
                    @if (message.Role == "tool")
                    {
                        <details class="provider-tool-card" open="@message.Refused">
                            <summary>
                                <span class="provider-tool-icon"><Icon Name="IconName.Terminal" /></span>
                                <code>@message.ToolName</code>
                                @if (message.Refused)
                                {
                                    <span class="badge text-bg-warning ms-1">refused</span>
                                }
                                <span class="provider-tool-hint ms-auto">result</span>
                            </summary>
                            <pre class="chat-mini-terminal small mb-0"><code>@ToolResultFormatter.FormatForTerminal(message.Content)</code></pre>
                            @if (message.ImageUrl is not null)
                            {
                                <img src="@message.ImageUrl" alt="tool output" class="provider-chat-image img-fluid rounded mt-2" />
                            }
                        </details>
                    }
                    else
                    {
                        @if (message.Kind == "summary")
                        {
                            @* RF-004: persisted compaction summary — distinct
                               note, never styled as user text. *@
                            <span class="badge text-bg-info mb-1">context summary</span>
                            <div class="ai-chat-md provider-summary-note">@((MarkupString)MarkdownRenderer.ToSafeHtml(message.Content))</div>
                        }
                        else if (SkillChipName(message.Content) is { } chip)
                        {
                            <span class="badge text-bg-secondary mb-1">skill: @chip</span>
                            <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(StripSkillMarker(message.Content)))</div>
                        }
                        else
                        {
                            @* SPEC-20261005-chat-fork-steering RF-008: mid-turn
                               steer marker — the user message entered at a
                               tool-result boundary, not as a queued turn. *@
                            @if (message.Kind == "steer")
                            {
                                <span class="badge text-bg-warning mb-1" title="Steer — injetado durante a run">steer</span>
                            }
                            else if (message.Kind == "schedule")
                            {
                                @* SPEC-20261005-chat-jobs-schedule-search RF-005: mensagem
                                   entregue pelo dispatcher de agendamento. *@
                                <span class="badge text-bg-info mb-1" title="Agendamento — entregue pelo scheduler">schedule</span>
                            }
                            <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(message.Content))</div>
                        }
                        @if (message.ImageUrl is not null)
                        {
                            <img src="@message.ImageUrl" alt="generated" class="provider-chat-image img-fluid rounded mt-2" />
                        }
                        @* SPEC-20261005-chat-attachments-feedback RF-004:
                           bound attachments — images inline, the rest as
                           download chips. *@
                        @if (message.Attachments is { Count: > 0 } attachments)
                        {
                            <div class="provider-attach-list mt-2">
                                @foreach (var attachment in attachments)
                                {
                                    if (attachment.ContentType.StartsWith("image/", StringComparison.Ordinal))
                                    {
                                        <a href="@attachment.DownloadUrl" target="_blank" rel="noopener" @key="attachment.Id">
                                            <img src="@attachment.DownloadUrl" alt="@attachment.FileName"
                                                 class="provider-chat-image img-fluid rounded" />
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="provider-attach-file" href="@attachment.DownloadUrl"
                                           download="@attachment.FileName" @key="attachment.Id">
                                            <Icon Name="IconName.FileEarmark" />
                                            <span class="provider-attach-file-name">@attachment.FileName</span>
                                            <span class="provider-attach-file-size">@FormatBytes(attachment.ByteSize)</span>
                                        </a>
                                    }
                                }
                            </div>
                        }
                        @* RF-005: persisted thumbs — assistant messages only;
                           👎 opens the note popover (log-only, never on wire). *@
                        @if (message.Role == "assistant")
                        {
                            @if (_feedbackFor == message.Id)
                            {
                                <div class="provider-feedback-pop" @key="@($"fb-{message.Id}")">
                                    <div class="d-flex gap-1 align-items-center mb-1">
                                        <select class="form-select form-select-sm w-auto" @bind="_feedbackCategory" aria-label="Categoria">
                                            <option value="">categoria…</option>
                                            <option value="wrong">errado</option>
                                            <option value="unhelpful">não ajudou</option>
                                            <option value="slow">lento</option>
                                            <option value="style">estilo</option>
                                            <option value="other">outro</option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                @onclick="() => SaveFeedbackAsync(message.Id)">Salvar</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => _feedbackFor = null">✕</button>
                                    </div>
                                    <input type="text" class="form-control form-control-sm" maxlength="2000"
                                           placeholder="Nota (opcional)…" @bind="_feedbackNote" />
                                </div>
                            }
                        }
                        <div class="provider-chat-actions">
                            @if (message.Role == "assistant")
                            {
                                @* open-webui message actions — copy the markdown source. *@
                                <button type="button" class="provider-chat-action" title="Copiar resposta"
                                        @onclick="() => CopyMessageAsync(message.Id, message.Content)">
                                    <Icon Name="@(_copiedId == message.Id ? IconName.CheckLg : IconName.Clipboard)" />
                                </button>
                                <button type="button" class="provider-chat-action @(message.Feedback?.Rating == "positive" ? "active" : "")"
                                        title="Resposta boa" aria-label="Rate up"
                                        @onclick='() => RateMessageAsync(message, "positive")'>
                                    <Icon Name="IconName.HandThumbsUp" />
                                </button>
                                <button type="button" class="provider-chat-action @(message.Feedback?.Rating == "negative" ? "active" : "")"
                                        title="Resposta ruim — adiciona nota" aria-label="Rate down"
                                        @onclick='() => RateMessageAsync(message, "negative")'>
                                    <Icon Name="IconName.HandThumbsDown" />
                                </button>
                            }
                            @* SPEC-20261005-chat-fork-steering RF-004: ⎇ fork
                               from here — branches the conversation at this
                               message into "{title} (fork)". *@
                            <button type="button" class="provider-chat-action" title="Fork daqui — nova conversa a partir desta mensagem"
                                    aria-label="Fork conversation from this message"
                                    disabled="@(_busy || _archived)"
                                    @onclick="() => ForkFromMessageAsync(message.Id)">
                                <Icon Name="IconName.Diagram2" />
                            </button>
                        </div>
                    }
                </div>
            }
            @* SPEC-20261005-chat-attachments-feedback RF-007: deliverables of
               the last finished run — replayed on open (LastRunDeliverables)
               and live-updated by the chat.deliverables SSE event. *@
            @if (_lastRunDeliverables is { Count: > 0 } deliverables)
            {
                <div class="provider-chat-bubble assistant provider-deliverables-card">
                    <div class="provider-approval-head">
                        <Icon Name="IconName.Files" />
                        <span class="fw-semibold">Deliverables (@deliverables.Count)</span>
                    </div>
                    <ul class="provider-deliverables-list">
                        @foreach (var file in deliverables)
                        {
                            <li @key="file.Path">
                                <code class="provider-deliverable-path">@file.Path</code>
                                @if (file.AddedLines is not null || file.RemovedLines is not null)
                                {
                                    <span class="provider-deliverable-diff">
                                        @(file.AddedLines is not null ? $"+{file.AddedLines}" : "")
                                        @(file.RemovedLines is not null ? $"−{file.RemovedLines}" : "")
                                    </span>
                                }
                                <span class="badge text-bg-secondary">@file.Source</span>
                                @if (file.Summary is not null)
                                {
                                    <span class="provider-deliverable-summary">@file.Summary</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (!string.IsNullOrEmpty(_streaming))
            {
                <div class="provider-chat-bubble assistant">
                    <div class="ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(_streaming))</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_reasoning))
            {
                @* Reasoning models (DeepSeek R1, o-series) stream thinking in
                   delta.reasoning_content — visible live while the answer is
                   pending, collapsible afterwards. *@
                <div class="provider-chat-bubble assistant provider-reasoning">
                    <details open="@_running">
                        <summary class="provider-reasoning-summary">
                            @if (_running && string.IsNullOrEmpty(_streaming))
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Thinking
                        </summary>
                        <pre class="provider-reasoning-text mb-0">@_reasoning</pre>
                    </details>
                </div>
            }
            @* SPEC-20261005-chat-tool-approval RF-002/RF-007: pending approval
               cards — replayed from ChatApproval rows on open/attach and kept
               live via approval.asked / approval.decided SSE. *@
            <div id="chat-approval-cards">
            @foreach (var approval in _pendingApprovals)
            {
                @if (approval.Kind == "plan-review")
                {
                    @* SPEC-20261005-chat-plan-mode RF-004: plan review card —
                       rendered markdown + approve/revise-with-feedback; the
                       pending row replays on re-attach like approvals. *@
                    <div class="provider-chat-bubble assistant provider-approval-card provider-plan-card" @key="approval.Id">
                        <div class="provider-approval-head">
                            <Icon Name="IconName.ListTask" />
                            <span class="fw-semibold">Plan review — aprovar para executar?</span>
                        </div>
                        <div class="provider-plan-body ai-chat-md">
                            @((MarkupString)MarkdownRenderer.ToSafeHtml(approval.ArgumentsPreview))
                        </div>
                        <div class="provider-approval-actions d-flex gap-2 mt-2 align-items-center">
                            <button type="button" class="btn btn-sm btn-success"
                                    @onclick="() => ApprovePlanAsync(approval)">
                                Approve plan
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    @onclick="() => ToggleDenyReason(approval.Id)">
                                Revise
                            </button>
                            <div class="ms-auto d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        title="Copiar plano em markdown"
                                        @onclick="() => CopyPlanAsync(approval)">
                                    @(_copiedId == approval.Id ? "✓" : "copy")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        title="Baixar plano como .md"
                                        @onclick="() => DownloadPlanAsync(approval)">
                                    <Icon Name="IconName.Download" />
                                </button>
                            </div>
                        </div>
                        @if (_denyReasonFor == approval.Id)
                        {
                            <div class="d-flex gap-2 mt-2">
                                <input type="text" class="form-control form-control-sm" placeholder="Feedback para revisão (opcional)"
                                       aria-label="Feedback do plano" @bind="_denyReason" />
                                <button type="button" class="btn btn-sm btn-warning"
                                        @onclick="() => RevisePlanAsync(approval)">
                                    Send feedback
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                <div class="provider-chat-bubble assistant provider-approval-card" @key="approval.Id">
                    <div class="provider-approval-head">
                        <Icon Name="IconName.ShieldLock" />
                        <span class="fw-semibold">Approve <code>@approval.ToolName</code>?</span>
                    </div>
                    <details class="provider-approval-args">
                        <summary class="small text-body-secondary">arguments</summary>
                        <pre class="chat-mini-terminal small mb-0"><code>@PrettyArgs(approval.ArgumentsPreview)</code></pre>
                    </details>
                    <div class="provider-approval-actions d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-success"
                                @onclick="() => AllowApprovalAsync(approval, rememberTool: false)">
                            Allow once
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success"
                                @onclick="() => AllowApprovalAsync(approval, rememberTool: true)">
                            Always allow
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                @onclick="() => ToggleDenyReason(approval.Id)">
                            Deny
                        </button>
                    </div>
                    @if (_denyReasonFor == approval.Id)
                    {
                        <div class="d-flex gap-2 mt-2">
                            <input type="text" class="form-control form-control-sm" placeholder="Motivo (opcional)"
                                   aria-label="Motivo da recusa" @bind="_denyReason" />
                            <button type="button" class="btn btn-sm btn-danger"
                                    @onclick="() => DenyApprovalAsync(approval)">
                                Confirm deny
                            </button>
                        </div>
                    }
                </div>
                }
            }
            </div>
            @if (_running && string.IsNullOrEmpty(_streaming))
            {
                <div id="chat-live-bubble" class="provider-chat-bubble assistant">
                    @if (_statusPhase is not null)
                    {
                        <span class="chat-status-chip">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            @StatusText()
                        </span>
                    }
                    else
                    {
                        <span class="typing-dot"></span>
                    }
                </div>
            }
            </div>
        </div>

        <div class="provider-chat-composer border-top px-3 py-2">
            @if (_archived)
            {
                @* RF-006: archived conversations open read-only — the run in
                   background keeps going but the composer stays shut. *@
                <div class="alert alert-secondary py-1 px-2 small mb-2 d-flex align-items-center gap-2">
                    <span>Conversa arquivada — leitura apenas.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto"
                            @onclick="() => UnarchiveConversationAsync(_conversationId!)">Restaurar</button>
                </div>
            }
            @if (_error is not null)
            {
                <div class="alert alert-danger py-1 px-2 small mb-2">@_error</div>
            }
            @if (_notice is not null)
            {
                <div class="alert alert-info py-1 px-2 small mb-2">
                    @((MarkupString)_notice)
                    <button type="button" class="btn-close btn-sm float-end" aria-label="Fechar"
                            @onclick="() => _notice = null"></button>
                </div>
            }
            @* SPEC-20261005-chat-attachments-feedback RF-001/RF-003: staged
               uploads — ✕ removes while unbound; the send binds them to the
               new message in the same request. *@
            @if (_stagedAttachments.Count > 0)
            {
                <div class="provider-steer-list" aria-label="Anexos prontos para envio">
                    @foreach (var attachment in _stagedAttachments)
                    {
                        <span class="provider-steer-chip" @key="attachment.Id"
                              title="@attachment.FileName — @FormatBytes(attachment.ByteSize)">
                            <Icon Name="IconName.Paperclip" />
                            <span class="provider-steer-chip-text">@attachment.FileName</span>
                            <button type="button" class="provider-steer-cancel" title="Remover anexo"
                                    aria-label="Remove attachment"
                                    @onclick="() => RemoveStagedAsync(attachment)">✕</button>
                        </span>
                    }
                </div>
            }
            @* SPEC-20261005-chat-fork-steering RF-005/RF-007: pending steer
               chips — each enters at the next tool-result boundary; ✕
               withdraws while unclaimed. *@
            @if (_pendingSteers.Count > 0)
            {
                <div class="provider-steer-list" aria-label="Steers pendentes">
                    @foreach (var steer in _pendingSteers)
                    {
                        <span class="provider-steer-chip" @key="steer.Id"
                              title="Steer pendente — entra no próximo boundary de tool">
                            <span class="provider-steer-chip-text">@steer.Content</span>
                            <button type="button" class="provider-steer-cancel" title="Cancelar steer"
                                    aria-label="Cancel steer"
                                    @onclick="() => CancelSteerAsync(steer)">✕</button>
                        </span>
                    }
                </div>
            }
            @* SPEC-20261001-chat-skills-slash-commands FR-003: "/" no início do
               composer abre a paleta de skills/comandos. *@
            <SlashCommandPalette Items="SlashItems" Filter="@SlashFilter"
                                 Open="SlashOpen" ActiveIndex="_slashIndex"
                                 OnSelect="OnSlashSelect" />
            <div class="provider-chat-composer-thread">
                <div class="provider-chat-composer-box">
                    <textarea id="provider-chat-input" class="provider-chat-input" rows="2" enterkeyhint="send" autocomplete="off" autocapitalize="sentences" data-shortcut-command placeholder="Send a message… (/ comandos e skills, Enter envia)"
                              @bind="_composer" @bind:event="oninput" @onkeydown="OnComposerKey"
                              @onkeydown:preventDefault="_slashPreventDefault"></textarea>
                    <div class="provider-chat-composer-footer">
                        <div class="provider-chat-composer-picks">
                            @* SPEC-20261005-chat-attachments-feedback RF-001:
                               paperclip opens the file picker; clipboard files
                               land here too via taskboardChat.hookPaste. *@
                            <div class="provider-pick-root">
                                <button type="button" class="provider-pick provider-pick-btn"
                                        title="Anexar arquivo (colar também funciona)" aria-label="Attach file"
                                        disabled="@(_archived || _uploadingAttachment)"
                                        @onclick="TriggerAttachPickAsync">
                                    <Icon Name="IconName.Paperclip" />
                                </button>
                                <InputFile id="provider-chat-attach-input" class="provider-attach-input"
                                           OnChange="OnAttachPickedAsync" multiple hidden />
                            </div>
                            @AgentTools
                            <div class="provider-pick-root">
                                <button type="button" class="provider-pick provider-pick-btn"
                                        title="Provider/model" aria-label="Provider and model"
                                        @onclick="TogglePickMenu">
                                    <Icon Name="IconName.Cpu" />
                                    <span class="provider-pick-label">@(string.IsNullOrEmpty(_model) ? "model" : _model)</span>
                                </button>
                                @if (_pickMenuOpen)
                                {
                                    <div class="provider-pick-backdrop" @onclick="ClosePickMenu"></div>
                                    <div class="provider-pick-panel" role="menu">
                                        @if (_pickProviders)
                                        {
                                            <div class="provider-pick-panel-title">provider</div>
                                            @foreach (var provider in _providers)
                                            {
                                                <button type="button" role="menuitem"
                                                        class="provider-pick-item @(provider.Id == _providerId ? "active" : string.Empty) @(provider.Enabled ? string.Empty : "off")"
                                                        @onclick="() => PickProviderAsync(provider.Id)">
                                                    @provider.Name
                                                    @if (!provider.Enabled)
                                                    {
                                                        <span class="provider-pick-hint">disabled</span>
                                                    }
                                                    else if (!provider.HasApiKey)
                                                    {
                                                        <span class="provider-pick-hint">no key</span>
                                                    }
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="provider-pick-panel-title">@CurrentProviderName — model</div>
                                            @if (_models.Count == 0)
                                            {
                                                <div class="provider-pick-empty">no models</div>
                                            }
                                            @foreach (var model in _models)
                                            {
                                                <button type="button" role="menuitem"
                                                        class="provider-pick-item @(model == _model ? "active" : string.Empty)"
                                                        @onclick="() => PickModelAsync(model)">@model</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="provider-chat-composer-actions">
                            @* RF-002: composer stays usable during a run — a
                               send queues the next turn (FIFO per conversation). *@
                            @if (_running)
                            {
                                @* SPEC-20261005-chat-fork-steering RF-005: Steer
                                   (Ctrl+Enter) — injects into the live run at
                                   the next tool boundary instead of queueing. *@
                                <button type="button" class="provider-chat-send steer" @onclick="() => SendAsync(steer: true)"
                                        title="Steer — injeta na run atual (Ctrl+Enter)" aria-label="Steer"
                                        disabled="@(string.IsNullOrWhiteSpace(_composer) || _providerId == Guid.Empty || string.IsNullOrEmpty(_model) || _archived)">
                                    <Icon Name="IconName.ArrowUpRightCircle" />
                                </button>
                                @* SPEC-20261012-chat-run-controls RF-008:
                                   Pause⇄Resume toggle next to Stop — the
                                   chip/SSE keep the actual state; Ctrl+.
                                   fires the same toggle. *@
                                @if (_runStatus is "paused")
                                {
                                    <button type="button" class="provider-chat-send resume" @onclick="TogglePauseAsync"
                                            title="Resume (Ctrl+.)" aria-label="Resume run" disabled="@_runActionBusy">
                                        <Icon Name="IconName.PlayCircle" />
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="provider-chat-send pause" @onclick="TogglePauseAsync"
                                            title="Pause (Ctrl+.)" aria-label="Pause run"
                                            disabled="@_runActionBusy">
                                        <Icon Name="IconName.PauseCircle" />
                                    </button>
                                }
                                <button type="button" class="provider-chat-send stop" @onclick="StopAsync" title="Stop" aria-label="Stop">
                                    <Icon Name="IconName.StopCircle" />
                                </button>
                            }
                            <button type="button" class="provider-chat-send" @onclick="() => SendAsync()" title="Enviar" aria-label="Send"
                                    disabled="@((string.IsNullOrWhiteSpace(_composer) && _stagedAttachments.Count == 0) || _providerId == Guid.Empty || string.IsNullOrEmpty(_model) || _archived)">
                                <Icon Name="IconName.Send" />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* SPEC-20261011-chat-workspace-panel: Devin-style workspace pane docked
       to the right of the chat — Tasks/Changes/Terminal/Editor/Plan for the
       active conversation (split pane lg+, bottom sheet <lg). *@
    <ConversationWorkspacePanel @ref="_wsPanel"
                                ConversationId="@_conversationId"
                                RefreshSignal="@_wsRefreshSignal" />
</div>

@code {
    // SPEC-20261001-chat-ux-compact FR-001: histórico oculto por default — ☰ abre o drawer.
    private bool _sidebarOpen;

    // SPEC-20261011-chat-workspace-panel: workspace pane ref + data reload signal.
    private ConversationWorkspacePanel? _wsPanel;
    private int _wsRefreshSignal;

    private IReadOnlyList<ChatProviderDto> _providers = [];
    private Guid _providerId;
    private IReadOnlyList<string> _models = [];
    private string _model = string.Empty;
    private string? _defaultChatModel;

    private IReadOnlyList<ChatConversationDto> _conversations = [];
    private string? _conversationId;
    private string? _conversationTitle;
    private bool _renaming;
    private bool _focusRename;
    private string _renameDraft = string.Empty;
    private ElementReference _renameInputRef;
    private readonly List<ChatMessageDto> _messages = [];

    // RF-005: single pill — dropdown providers (skipped when only one)
    // then the model list; the pill shows just the model name.
    private bool _pickMenuOpen;
    private bool _pickProviders;

    private string? CurrentProviderName =>
        _providers.FirstOrDefault(p => p.Id == _providerId)?.Name;

    private void TogglePickMenu()
    {
        _pickMenuOpen = !_pickMenuOpen;
        if (_pickMenuOpen)
        {
            _pickProviders = _providers.Count > 1;
        }
    }

    private void ClosePickMenu() => _pickMenuOpen = false;

    private async Task PickProviderAsync(Guid id)
    {
        _providerId = id;
        await OnProviderChangedAsync();
        _pickProviders = false;
    }

    private async Task PickModelAsync(string model)
    {
        _model = model;
        _pickMenuOpen = false;
        await OnModelChangedAsync();
    }

    /// <summary>Host switch request (/agent builtin) — AiChat flips to agent mode, carrying the current conversation id.</summary>
    [Parameter] public EventCallback<string?> OnSwitchToAgent { get; set; }

    /// <summary>
    /// SPEC-20261004-provider-pick-hybridcache RF-005: agent-bar controls
    /// (view/CLI/docker/workspace/repo/model) rendered INSIDE the composer
    /// footer — AiChat owns the state and handlers, this slot owns the spot.
    /// </summary>
    [Parameter] public RenderFragment? AgentTools { get; set; }

    /// <summary>
    /// SPEC-20261003-ai-code-agent-chat: Agent-mode binding — when set, the
    /// conversation persists the picked CLI/repo/model and the delegated
    /// tools (run_agent, run_cli) default to them.
    /// </summary>
    [Parameter] public ChatAgentContext? AgentContext { get; set; }

    /// <summary>Conversation to open on mount (mode switch carries context).</summary>
    [Parameter] public string? SeedConversationId { get; set; }

    /// <summary>
    /// SPEC-20261004 RF-003: fired when a conversation opens so the parent
    /// can hydrate its agent-bar config (workspace/CLI/repo/model) from the
    /// stored binding — keeps a subsequent parameters-set PATCH from wiping
    /// values the picker state does not know yet.
    /// </summary>
    [Parameter] public EventCallback<ChatAgentContext?> OnConversationAgentLoaded { get; set; }

    /// <summary>
    /// SPEC-20261005-chat-background-resume RF-007: extra history surface
    /// rendered at the bottom of the sidebar — AiChat mounts the collapsed
    /// "Legacy threads" section here.
    /// </summary>
    [Parameter] public RenderFragment? HistoryExtra { get; set; }

    private ChatAgentContext? _appliedAgentContext;

    private string _composer = string.Empty;
    private string _search = string.Empty;

    // SPEC-20261005-chat-jobs-schedule-search RF-009: Títulos|Conteúdo
    // sidebar search scope — content mode queries the FTS5 endpoint.
    private bool _searchContent;
    private IReadOnlyList<ChatSearchHitDto> _searchHits = [];

    // RF-003: active ChatJob strip — polled while a conversation is open.
    private IReadOnlyList<ChatJobDto> _activeJobs = [];
    private CancellationTokenSource? _jobsPollCts;

    // RF-004/RF-005: schedules popover + quick-create form.
    private List<ChatScheduleDto> _schedules = [];
    private bool _schedulePanelOpen;
    private bool _schedBusy;
    private string _schedTitle = string.Empty;
    private string _schedPrompt = string.Empty;
    private string _schedKind = "after_seconds";
    private string _schedExpr = string.Empty;
    private int _schedSeconds = 300;

    // SPEC-20261001-chat-skills-slash-commands: slash palette state.
    private IReadOnlyList<SlashCommandPalette.SlashItem> _slashItems = [];
    private IReadOnlyList<SlashCommandPalette.SlashItem> _skillItems = [];
    // SPEC-20261004-cli-slash-commands: commands/skills of the agent-bar CLI.
    private IReadOnlyList<SlashCommandPalette.SlashItem> _cliItems = [];
    private int _slashIndex;
    private bool _slashPreventDefault;
    private string? _notice;

    // SPEC-20261001-chat-ux-compact FR-003: live status chip ("Running tool/MCP/agent…").
    private string? _statusPhase;
    private string? _statusLabel;
    private string? _streaming;
    private string? _reasoning;
    private string? _error;
    // SPEC-20261012-chat-run-controls: the run's live status drives the chip;
    // _running stays the boolean "a live run exists" the layout already uses.
    private string? _runStatus;
    private bool _running => _runStatus is "queued" or "running" or "paused";
    private DateTime? _lastActivityUtc;
    private int _stallThresholdSeconds = 120;
    private Timer? _stallTimer;
    private bool _runActionBusy;
    private bool _busy;
    private CancellationTokenSource? _streamCts;
    private string? _copiedId;
    // SPEC-20261005-chat-background-resume: the attached run + archive view.
    private string? _runId;
    private bool _archived;
    private bool _showArchived;

    // SPEC-20261005-chat-tool-approval: pending approval cards + preset chip.
    private readonly List<ChatApprovalDto> _pendingApprovals = [];
    private string _permissionPreset = "ask";
    private string _planMode = "off";
    private string? _denyReasonFor;
    private string? _denyReason;

    // SPEC-20261005-chat-context-management RF-007: wire-pressure state —
    // header meter (open conversation) + sidebar badges (run.pressure hub).
    private (int Estimated, int Limit, bool Compacted)? _pressure;
    private readonly Dictionary<string, (int Estimated, int Limit, bool Compacted)> _pressureByConversation = new();

    // SPEC-20261005-chat-fork-steering RF-005/RF-007: pending steer chips.
    private sealed record PendingSteer(string Id, string Content);

    private readonly List<PendingSteer> _pendingSteers = [];

    // SPEC-20261005-chat-attachments-feedback: staged uploads bound on send,
    // feedback popover state, the finished run's deliverables card, and the
    // sidebar's negative-feedback filter.
    private readonly List<ChatAttachmentDto> _stagedAttachments = [];
    private bool _uploadingAttachment;
    private string? _feedbackFor;
    private string _feedbackNote = string.Empty;
    private string? _feedbackCategory;
    private IReadOnlyList<ChatDeliverableDto>? _lastRunDeliverables;
    private bool _negativeOnly;

    /// <summary>SF-web: page-header history button proxies the sidebar.</summary>
    public void ToggleHistoryDrawer() => _sidebarOpen = !_sidebarOpen;

    /// <summary>SPEC-20261011: page-header workspace button proxies the pane.</summary>
    public async Task ToggleWorkspacePanelAsync()
    {
        if (_wsPanel is not null)
        {
            await _wsPanel.ToggleAsync();
        }
    }

    /// <summary>SF-web: page-header new-chat button proxies the sidebar's own action.</summary>
    public Task StartNewChatPublicAsync() => StartNewChatAsync();

    /// <summary>SPEC-20261011: opens a conversation from outside the component —
    /// nav-submenu deep-links (?c=) and search hits land here.</summary>
    public Task OpenConversationPublicAsync(string id) => OpenConversationAsync(id);

    /// <summary>Header pencil (or double-click on the title) starts the inline
    /// rename — Enter/blur commits, Escape cancels.</summary>
    public void BeginRename()
    {
        if (_conversationId is null)
        {
            return;
        }

        _renameDraft = _conversationTitle ?? string.Empty;
        _renaming = true;
        _focusRename = true;
        StateHasChanged();
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            _renaming = false;
        }
    }

    private async Task ConfirmRenameAsync()
    {
        // Escape already cleared _renaming — a trailing blur must not commit.
        if (!_renaming)
        {
            return;
        }

        var title = _renameDraft.Trim();
        _renaming = false;
        if (_conversationId is null || title.Length == 0 || title == _conversationTitle)
        {
            return;
        }

        try
        {
            await Client.RenameChatConversationAsync(_conversationId, title);
            _conversationTitle = title;
            _conversations = _conversations
                .Select(c => c.Id == _conversationId ? c with { Title = title } : c)
                .ToList();
            // Same-URI nav fires LocationChanged so the nav history reloads.
            Navigation.NavigateTo(Navigation.Uri);
        }
        catch (Exception ex)
        {
            await ToastService.NotifyAsync(new ToastMessage(ToastType.Danger, $"Não foi possível renomear: {ex.Message}"));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Notifications.RunPressure += OnRunPressure;
        Notifications.SteerChanged += OnSteerChanged;
        try
        {
            _providers = await Client.GetChatProvidersAsync();
            var conversation = await Client.GetChatConversationsAsync();
            _conversations = conversation;
            try
            {
                // B-16: nova conversa prefere Taskboard:Chat:DefaultChatModel
                // quando o modelo está na lista do provider.
                _defaultChatModel = (await Client.GetConfigurationEntriesAsync())
                    .FirstOrDefault(e => e.Key == "Taskboard:Chat:DefaultChatModel")
                    ?.EffectiveValue;
            }
            catch
            {
                _defaultChatModel = null;
            }
            try
            {
                var capabilities = await Client.GetChatCapabilitiesAsync();
                _skillItems = capabilities
                    .Where(c => c.Kind == Taskboard.Application.Contracts.Chat.ChatCapabilityKind.Skill && c.Enabled)
                    .Select(c => new SlashCommandPalette.SlashItem(c.Name, c.Description, "skill"))
                    .ToList();
            }
            catch
            {
                _skillItems = [];
            }

            await RefreshCliSlashItemsAsync();
            // SPEC-20261004 RF-001: default to a usable provider — the catalog
            // is alphabetical, so [0] can be disabled or keyless.
            if (Taskboard.Application.Contracts.Chat.ChatProviderPick.PreferAvailable(_providers) is { } pick)
            {
                _providerId = pick.Id;
                await OnProviderChangedAsync();
            }

            if (SeedConversationId is not null)
            {
                await OpenConversationAsync(SeedConversationId);
            }
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar providers: {ex.Message}";
        }
    }

    /// <summary>
    /// Agent-bar changes push straight into the open conversation so the next
    /// delegated run sees them (SPEC-20261003-ai-code-agent-chat).
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Equals(_appliedAgentContext, AgentContext))
        {
            return;
        }

        // Palette tracks the agent-bar CLI even before a conversation opens.
        var cliChanged = !string.Equals(
            _appliedAgentContext?.AgentCli, AgentContext?.AgentCli,
            StringComparison.OrdinalIgnoreCase);
        _appliedAgentContext = AgentContext;
        if (cliChanged)
        {
            await RefreshCliSlashItemsAsync();
        }

        if (_conversationId is null)
        {
            return;
        }

        try
        {
            await Client.UpdateChatConversationAgentAsync(
                _conversationId, AgentContext ?? new ChatAgentContext());
        }
        catch
        {
            // Best-effort — the binding refreshes on the next change or send.
        }
    }

