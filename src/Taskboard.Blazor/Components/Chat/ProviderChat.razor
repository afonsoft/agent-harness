    private async Task StartNewChatAsync()
    {
        if (_providerId == Guid.Empty || string.IsNullOrEmpty(_model))
        {
            _error = "Selecione um provider e um modelo antes de iniciar uma conversa.";
            return;
        }

        _error = null;
        _busy = true;
        try
        {
            var conversation = await Client.CreateChatConversationAsync(
                new CreateChatConversationRequest(_providerId, _model, Agent: AgentContext));
            _conversationId = conversation.Id;
            _conversationTitle = conversation.Title;
            _archived = false;
            _runId = null;
            _streamCts?.Cancel();
            _messages.Clear();
            _streaming = null;
            _reasoning = null;
            _pendingApprovals.Clear();
            _permissionPreset = conversation.PermissionPreset ?? "ask";
            _denyReasonFor = null;
            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao criar conversa: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenConversationAsync(string id)
    {
        _busy = true;
        _error = null;
        try
        {
            var detail = await Client.GetChatConversationAsync(id);
            if (detail is null)
            {
                return;
            }

            await ApplyConversationAsync(detail);
            await ScrollToEndAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao abrir conversa: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyConversationAsync(ChatConversationDetailDto detail)
    {
        _conversationId = detail.Conversation.Id;
        _conversationTitle = detail.Conversation.Title;
        _archived = detail.Conversation.ArchivedAt is not null;
        // SPEC-20261004 RF-003: the open conversation's stored binding becomes
        // "applied" — the parameters-set PATCH must not treat it as a change.
        _appliedAgentContext = detail.Conversation.Agent;
        await OnConversationAgentLoaded.InvokeAsync(detail.Conversation.Agent);
        _messages.Clear();
        _messages.AddRange(detail.Messages);
        _streaming = null;
        _reasoning = null;
        // RF-007: replay unresolved approvals on (re-)attach; they resolve
        // live via approval.decided or when the run ends (auto-cancel).
        _pendingApprovals.Clear();
        if (detail.PendingApprovals is { Count: > 0 } pending)
        {
            _pendingApprovals.AddRange(pending);
        }

        _permissionPreset = detail.Conversation.PermissionPreset ?? "ask";
        _denyReasonFor = null;
        if (_providerId != detail.Conversation.ProviderId)
        {
            _providerId = detail.Conversation.ProviderId;
            await OnProviderChangedAsync();
        }

        if (_models.Contains(detail.Conversation.Model))
        {
            _model = detail.Conversation.Model;
        }

        // RF-003: opening a conversation with a live run re-attaches to it —
        // "continue from where it stopped" even after a tab close/reopen.
        if (detail.ActiveRun is { } active && !active.Id.Equals(_runId, StringComparison.Ordinal))
        {
            AttachRun(detail.Conversation.Id, active.Id);
        }
        else if (detail.ActiveRun is null)
        {
            _running = false;
            _runId = null;
        }
    }

    private async Task DeleteConversationAsync(string id)
    {
        try
        {
            await Client.DeleteChatConversationAsync(id);
            if (_conversationId == id)
            {
                _conversationId = null;
                _conversationTitle = null;
                _messages.Clear();
            }

            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao excluir: {ex.Message}";
        }
    }

    // ---- Slash commands (SPEC-20261001-chat-skills-slash-commands FR-003/004) ----

    private static readonly IReadOnlyList<SlashCommandPalette.SlashItem> BuiltinCommands =
    [
        new("new", "Nova conversa", "builtin"),
        new("agent", "Delegar/ir para Agent mode", "builtin"),
        new("tools", "Abrir tools/capabilities em Settings", "builtin"),
        new("clear", "Limpar o composer", "builtin"),
        new("help", "Listar comandos", "builtin"),
    ];

    private IReadOnlyList<SlashCommandPalette.SlashItem> SlashItems => _slashItems;

    /// <summary>Merges builtins → cli → skill keeping the first Command
    /// occurrence (builtin shadows cli shadows skill).</summary>
    private void RebuildSlashItems() =>
        _slashItems = BuiltinCommands
            .Concat(_cliItems)
            .Concat(_skillItems)
            .GroupBy(i => i.Command, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

    /// <summary>Reloads the cli slice of the palette for AgentContext.AgentCli
    /// (best-effort — missing/custom CLIs get no extra items).</summary>
    private async Task RefreshCliSlashItemsAsync()
    {
        var cliName = AgentContext?.AgentCli;
        if (string.IsNullOrWhiteSpace(cliName))
        {
            _cliItems = [];
            RebuildSlashItems();
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _cliItems = (await Client.GetCliCommandsAsync(cliName))
                .Select(c => new SlashCommandPalette.SlashItem(c.Name, c.Description, "cli", cliName))
                .ToList();
        }
        catch
        {
            _cliItems = [];
        }

        RebuildSlashItems();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Palette opens while the composer is a single "/token".</summary>
    private bool SlashOpen =>
        _composer.Length > 0 && _composer[0] == '/' && !_composer.Contains(' ', StringComparison.Ordinal) && !_archived;

    private string SlashFilter => SlashOpen ? _composer[1..] : string.Empty;

    private IReadOnlyList<SlashCommandPalette.SlashItem> SlashFiltered =>
        SlashCommandPalette.ApplyFilter(_slashItems, SlashFilter);

    private void OnSlashSelect(SlashCommandPalette.SlashItem item)
    {
        _composer = item.Kind is "skill" or "cli" ? $"/{item.Command} " : $"/{item.Command}";
    }

    private async Task OnComposerKey(KeyboardEventArgs e)
    {
        _slashPreventDefault = false;
        if (SlashOpen && HandleSlashKey(e))
        {
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _slashPreventDefault = true;
            await SendAsync();
        }
    }

    /// <summary>Slash-palette keys — true when the key was consumed by the palette.</summary>
    private bool HandleSlashKey(KeyboardEventArgs e)
    {
        var filtered = SlashFiltered;
        if (e.Key is "ArrowDown" or "ArrowUp")
        {
            _slashPreventDefault = true;
            _slashIndex = e.Key == "ArrowDown"
                ? (_slashIndex + 1) % filtered.Count
                : (_slashIndex - 1 + filtered.Count) % filtered.Count;
            return true;
        }

        if (e.Key is "Tab")
        {
            _slashPreventDefault = true;
            if (filtered.Count > 0)
            {
                OnSlashSelect(filtered[Math.Min(_slashIndex, filtered.Count - 1)]);
            }
            return true;
        }

        if (e.Key is "Escape")
        {
            _slashPreventDefault = true;
            _composer = string.Empty;
            return true;
        }

        if (e.Key is "Enter" && filtered.Count > 0 && !_composer.Equals($"/{filtered[Math.Min(_slashIndex, filtered.Count - 1)].Command}", StringComparison.Ordinal))
        {
            _slashPreventDefault = true;
            OnSlashSelect(filtered[Math.Min(_slashIndex, filtered.Count - 1)]);
            return true;
        }

        return false;
    }

    /// <summary>Builtin slash commands — true when the turn was consumed locally.</summary>
    private async Task<bool> TryRunBuiltinAsync(string command)
    {
        switch (command.ToLowerInvariant())
        {
            case "new":
                _composer = string.Empty;
                await StartNewChatAsync();
                return true;
            case "clear":
                _composer = string.Empty;
                return true;
            case "agent":
                _composer = string.Empty;
                await OnSwitchToAgent.InvokeAsync(_conversationId);
                return true;
            case "tools":
                _composer = string.Empty;
                Navigation.NavigateTo("/settings");
                return true;
            case "help":
                _notice = "Comandos: /new, /agent, /tools, /clear, /help — /&lt;command&gt; injeta um comando da CLI selecionada, /&lt;skill&gt; injeta uma skill global.";
                _composer = string.Empty;
                return true;
            default:
                return false;
        }
    }

    /// <summary>
    /// FR-003: "/name args" becomes a user turn carrying the skill chip marker
    /// plus the SKILL.md instructions — one round-trip saved vs use_skill.
    /// </summary>
    private async Task<string?> ComposeSkillMessageAsync(SlashCommandPalette.SlashItem skill, string rest)
    {
        try
        {
            var capability = (await Client.GetChatCapabilitiesAsync())
                .FirstOrDefault(c => c.Kind == Taskboard.Application.Contracts.Chat.ChatCapabilityKind.Skill
                    && string.Equals(c.Name, skill.Command, StringComparison.OrdinalIgnoreCase));
            // Origin may aggregate several install dirs ("claude, devin") —
            // the detail endpoint resolves by a single source, so use the first.
            var source = capability?.Origin?.Split(',', StringSplitOptions.TrimEntries
                | StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
            var detail = capability is null
                ? null
                : await Client.GetSkillDetailAsync(source, capability.Name);
            if (detail is null)
            {
                _error = $"Skill '{skill.Command}' indisponível.";
                return null;
            }

            var args = string.IsNullOrWhiteSpace(rest) ? string.Empty : "\n\nUser request: " + rest;
            var composed = $"[skill:{detail.Name}] {rest}\n\n"
                + $"<skill name=\"{detail.Name}\" source=\"{detail.Source}\">\n"
                + detail.Content + "\n</skill>" + args;
            return composed;
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar skill '{skill.Command}': {ex.Message}";
            return null;
        }
    }

    /// <summary>FR-003: "Running tool/MCP/agent" chip label per status phase.</summary>
    private string StatusText() => _statusPhase switch
    {
        "running_tool" => $"Running tool: {_statusLabel}",
        "running_mcp" => $"Running MCP: {_statusLabel}",
        "running_agent" => $"Running agent: {_statusLabel}",
        "running_subagent" => $"Running sub-agent: {_statusLabel}",
        "thinking" => "Thinking…",
        _ => _statusLabel ?? "Running…",
    };

    /// <summary>Marker "[skill:name]"/"[command:name]" prefix → badge chip
    /// on user bubbles.</summary>
    private static string? SkillChipName(string content)
    {
        var offset = -1;
        if (content.StartsWith("[skill:", StringComparison.Ordinal))
        {
            offset = 7;
        }
        else if (content.StartsWith("[command:", StringComparison.Ordinal))
        {
            offset = 9;
        }

        if (offset < 0)
        {
            return null;
        }

        var end = content.IndexOf(']', StringComparison.Ordinal);
        return end < 0 ? null : content[offset..end];
    }

    private static string StripSkillMarker(string content)
    {
        var end = content.IndexOf(']', StringComparison.Ordinal);
        return end < 0 ? content : content[(end + 1)..].TrimStart();
    }

    private async Task SendAsync()
    {
        var content = _composer.Trim();
        if (await EnsureConversationAsync(content) is not { } conversationId)
        {
            return;
        }

        // FR-004: builtin commands execute locally; /skill injects SKILL.md.
        if (content.StartsWith('/'))
        {
            var (consumed, resolved) = await ResolveSlashContentAsync(content);
            if (consumed)
            {
                return;
            }
            content = resolved;
        }

        _error = null;
        _composer = string.Empty;
        try
        {
            var run = await Client.EnqueueChatMessageAsync(conversationId, content);
            // RF-002/RF-003: the optimistic bubble is unnecessary — chat.sync
            // arrives within a frame carrying the persisted user message.
            AttachRun(conversationId, run.Id);
            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha no envio: {ex.Message}";
        }
    }

    /// <summary>
    /// RF-003: subscribes to a run — chat.sync replays state, the tail follows.
    /// Detached task: closing a tab/conv cancels only this local stream; the
    /// run itself keeps going on the server and the next open re-attaches.
    /// </summary>
    private void AttachRun(string conversationId, string runId)
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
        var streamCts = new CancellationTokenSource();
        _streamCts = streamCts;
        _running = true;
        _runId = runId;
        _streaming = string.Empty;
        _reasoning = string.Empty;
        _ = Task.Run(() => ReadRunStreamAsync(conversationId, runId, streamCts), CancellationToken.None);
        _ = ScrollToEndAsync();
    }

    private async Task ReadRunStreamAsync(string conversationId, string runId, CancellationTokenSource streamCts)
    {
        try
        {
            using var response = await Client.OpenChatRunStreamAsync(conversationId, runId, streamCts.Token);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Falha ao anexar ao run ({(int)response.StatusCode}).";
                return;
            }

            await using var stream = await response.Content.ReadAsStreamAsync(streamCts.Token);
            using var reader = new StreamReader(stream);
            string? eventName = null;
            while (await reader.ReadLineAsync(streamCts.Token) is { } line)
            {
                if (line.StartsWith("event:", StringComparison.Ordinal))
                {
                    eventName = line["event:".Length..].Trim();
                    continue;
                }

                if (!line.StartsWith("data:", StringComparison.Ordinal) || eventName is null)
                {
                    continue;
                }

                var data = line["data:".Length..].Trim();
                await InvokeAsync(() => HandleSseEventAsync(eventName, data));
                eventName = null;
            }
        }
        catch (OperationCanceledException)
        {
            // Stop pressed / conversation switch — the run continues server-side.
        }
        catch (Exception ex)
        {
            _error = $"Falha no stream: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(async () =>
            {
                _running = false;
                _runId = null;
                _streaming = null;
                _statusPhase = null;
                _statusLabel = null;
                if (ReferenceEquals(_streamCts, streamCts))
                {
                    _streamCts = null;
                }

                // Reload picks up the persisted tail; a still-live run (queued
                // follow-up that just started) re-attaches seamlessly.
                var detail = await ReloadConversationAsync();
                if (detail?.ActiveRun is { } next && _conversationId == conversationId)
                {
                    AttachRun(conversationId, next.Id);
                }
            });
            streamCts.Dispose();
        }
    }

    /// <summary>Creates the conversation when missing; null → nothing to send.</summary>
    private async Task<string?> EnsureConversationAsync(string content)
    {
        if (content.Length != 0 && _conversationId is not null)
        {
            return _conversationId;
        }

        if (_conversationId is null)
        {
            await StartNewChatAsync();
            return _conversationId;
        }

        return null;
    }

    /// <summary>Runs builtin/skill slash handling; consumed → caller returns.</summary>
    private async Task<(bool Consumed, string Content)> ResolveSlashContentAsync(string content)
    {
        var space = content.IndexOf(' ', StringComparison.Ordinal);
        var command = (space < 0 ? content : content[..space]).TrimStart('/');
        var rest = space < 0 ? string.Empty : content[(space + 1)..];

        if (await TryRunBuiltinAsync(command))
        {
            return (true, content);
        }

        // SPEC-20261004-cli-slash-commands RF-003: cli commands resolve
        // before global skills — the selected CLI wins on name collision.
        var cliItem = _slashItems.FirstOrDefault(i =>
            i.Kind == "cli" && string.Equals(i.Command, command, StringComparison.OrdinalIgnoreCase));
        if (cliItem is not null)
        {
            return await ResolveCliCommandAsync(cliItem, rest, content);
        }

        var skill = _slashItems.FirstOrDefault(i =>
            i.Kind == "skill" && string.Equals(i.Command, command, StringComparison.OrdinalIgnoreCase));
        if (skill is null)
        {
            return (false, content);
        }

        var composed = await ComposeSkillMessageAsync(skill, rest);
        return composed is null ? (true, content) : (false, composed);
    }

    /// <summary>
    /// File-backed commands inject their body (chip + &lt;command&gt; block,
    /// $ARGUMENTS → rest); body-less ones forward verbatim — the CLI resolves
    /// its own native/ACP-advertised command.
    /// </summary>
    private async Task<(bool Consumed, string Content)> ResolveCliCommandAsync(
        SlashCommandPalette.SlashItem item, string rest, string content)
    {
        var cliName = AgentContext?.AgentCli;
        if (string.IsNullOrWhiteSpace(cliName))
        {
            return (false, content);
        }

        try
        {
            var detail = await Client.GetCliCommandDetailAsync(cliName, item.Command);
            // Unknown to the discovery service (removed between list and
            // send) → forward verbatim; the CLI resolves its own command.
            if (detail is null || string.IsNullOrWhiteSpace(detail.Body))
            {
                return (false, content);
            }

            var composed = SlashCommandComposer.ComposeCliCommand(
                detail.Name, detail.Source, detail.Body, rest, detail.Kind);
            return (false, composed);
        }
        catch (Exception ex)
        {
            _error = $"Falha ao carregar comando '{item.Command}': {ex.Message}";
            return (true, content);
        }
    }

    private async Task HandleSseEventAsync(string eventName, string data)
    {
        switch (eventName)
        {
            // RF-003: full durable state — persisted messages + the in-flight
            // checkpoint; seq already deduped server-side.
            case "chat.sync":
                var sync = JsonSerializer.Deserialize<ChatRunSyncDto>(data, SseJson);
                if (sync is not null)
                {
                    _messages.Clear();
                    _messages.AddRange(sync.Messages);
                    _streaming = sync.Partial;
                    _reasoning = sync.PartialReasoning;
                    _running = sync.Run.Status is "queued" or "running";
                }

                await ScrollToEndAsync();
                break;
            case "chat.delta":
                var delta = JsonSerializer.Deserialize<JsonElement>(data);
                _streaming += delta.TryGetProperty("content", out var c) ? c.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.reasoning":
                var reasoning = JsonSerializer.Deserialize<JsonElement>(data);
                _reasoning += reasoning.TryGetProperty("content", out var r) ? r.GetString() ?? string.Empty : string.Empty;
                await ScrollToEndAsync();
                break;
            case "chat.tool_call":
                // The persisted tool message arrives via reload; live card comes from tool_result.
                break;
            case "chat.status":
                var status = JsonSerializer.Deserialize<JsonElement>(data);
                _statusPhase = status.TryGetProperty("phase", out var ph) ? ph.GetString() : null;
                _statusLabel = status.TryGetProperty("label", out var lb) ? lb.GetString() : null;
                if (_statusPhase is "idle")
                {
                    _statusPhase = null;
                    _statusLabel = null;
                }
                await ScrollToEndAsync();
                break;
            case "approval.asked":
            {
                // SPEC-20261005-chat-tool-approval RF-002: pending card.
                var asked = JsonSerializer.Deserialize<JsonElement>(data);
                var dto = new ChatApprovalDto(
                    asked.TryGetProperty("approvalId", out var aid) ? aid.GetString() ?? string.Empty : string.Empty,
                    _runId ?? string.Empty,
                    _conversationId ?? string.Empty,
                    asked.TryGetProperty("toolCallId", out var tcid) ? tcid.GetString() ?? string.Empty : string.Empty,
                    asked.TryGetProperty("toolName", out var tname) ? tname.GetString() ?? string.Empty : string.Empty,
                    asked.TryGetProperty("argsPreview", out var aprv) ? aprv.GetString() ?? "{}" : "{}",
                    "pending", DateTime.UtcNow, null, null, null);
                _pendingApprovals.RemoveAll(a => a.Id == dto.Id);
                _pendingApprovals.Add(dto);
                _statusPhase = "waiting-approval";
                _statusLabel = $"Approval: {dto.ToolName}";
                await ScrollToEndAsync();
                break;
            }
            case "approval.decided":
            {
                var decided = JsonSerializer.Deserialize<JsonElement>(data);
                var decidedId = decided.TryGetProperty("approvalId", out var did) ? did.GetString() : null;
                if (decidedId is not null)
                {
                    _pendingApprovals.RemoveAll(a => a.Id == decidedId);
                }

                if (_denyReasonFor == decidedId)
                {
                    _denyReasonFor = null;
                }

                if (_pendingApprovals.Count == 0 && _statusPhase is "waiting-approval")
                {
                    _statusPhase = null;
                    _statusLabel = null;
                }

                await ScrollToEndAsync();
                break;
            }
            case "chat.tool_result":
                await ReloadConversationAsync();
                await ScrollToEndAsync();
                break;
            case "chat.done":
                var done = JsonSerializer.Deserialize<JsonElement>(data);
                if (done.TryGetProperty("run", out var runEl)
                    && runEl.TryGetProperty("status", out var st))
                {
                    switch (st.GetString())
                    {
                        case "failed":
                            _error = runEl.TryGetProperty("error", out var err)
                                ? err.GetString() : "Run falhou.";
                            break;
                        case "interrupted":
                            _notice = "Run interrompido (servidor reiniciou) — envie uma nova mensagem para continuar.";
                            break;
                    }
                }

                _statusPhase = null;
                _statusLabel = null;
                _pendingApprovals.Clear();
                break;
        }
    }

    private static readonly JsonSerializerOptions SseJson = new(JsonSerializerDefaults.Web);

    private async Task<ChatConversationDetailDto?> ReloadConversationAsync()
    {
        if (_conversationId is null)
        {
            return null;
        }

        try
        {
            var detail = await Client.GetChatConversationAsync(_conversationId);
            if (detail is null)
            {
                return null;
            }

            _messages.Clear();
            _messages.AddRange(detail.Messages);
            _conversationTitle = detail.Conversation.Title;
            _archived = detail.Conversation.ArchivedAt is not null;
            // RF-007: keep pending cards in sync on every transcript reload.
            _pendingApprovals.Clear();
            if (detail.PendingApprovals is { Count: > 0 } pending)
            {
                _pendingApprovals.AddRange(pending);
            }

            _permissionPreset = detail.Conversation.PermissionPreset ?? _permissionPreset;
            await OnSearchChangedAsync();
            return detail;
        }
        catch (Exception)
        {
            // Reload is best-effort — the streamed content stays visible.
            return null;
        }
    }

    private async Task StopAsync()
    {
        if (_conversationId is null)
        {
            return;
        }

        try
        {
            await Client.StopChatAsync(_conversationId);
        }
        catch (Exception)
        {
            // The stream ends on its own when the server cancels.
        }
    }

    private async Task ScrollToEndAsync()
    {
        await Task.Delay(1);
        StateHasChanged();
        // SPEC-20261001-chat-ux-compact FR-004: syntax colors (throttled JS-side).
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.highlight", "provider-chat-scroll");
        }
        catch (JSException)
        {
            // Pre-render/disposed — highlight is cosmetic.
        }
    }

    // SPEC-20261001-ai-chat-openwebui: copy the raw markdown of an assistant
    // answer (open-webui message action); shows a ✓ briefly.
    private async Task CopyMessageAsync(string id, string content)
    {
        try
        {
            await JS.InvokeVoidAsync("taskboardChat.copy", content);
            _copiedId = id;
            StateHasChanged();
            _ = Task.Delay(1600).ContinueWith(_ =>
            {
                _copiedId = null;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (JSException)
        {
            await ToastService.NotifyAsync(new ToastMessage(ToastType.Danger, "Não foi possível copiar."));
        }
    }

    // ---- Tool approvals (SPEC-20261005-chat-tool-approval RF-003/RF-006) ----

    private Task AllowApprovalAsync(ChatApprovalDto approval, bool rememberTool) =>
        DecideApprovalAsync(approval, "allow", reason: null, rememberTool);

    private Task DenyApprovalAsync(ChatApprovalDto approval) =>
        DecideApprovalAsync(approval, "deny", reason: _denyReason, rememberTool: false);

    private async Task DecideApprovalAsync(
        ChatApprovalDto approval, string outcome, string? reason = null, bool rememberTool = false)
    {
        try
        {
            // Null = 409/404 — already decided (timeout/cancel/other tab); the
            // card also clears on the broadcast approval.decided.
            _ = await Client.DecideChatApprovalAsync(approval.Id, outcome, reason, rememberTool);
            _pendingApprovals.RemoveAll(a => a.Id == approval.Id);
            _denyReasonFor = null;
            _denyReason = null;
        }
        catch (Exception ex)
        {
            _error = $"Falha ao decidir aprovação: {ex.Message}";
        }
    }

    private void ToggleDenyReason(string approvalId)
    {
        _denyReasonFor = _denyReasonFor == approvalId ? null : approvalId;
        _denyReason = null;
    }

    private async Task ChangePresetAsync(ChangeEventArgs args)
    {
        var preset = args.Value?.ToString() ?? "ask";
        if (_conversationId is null || preset == _permissionPreset)
        {
            return;
        }

        try
        {
            var updated = await Client.UpdateChatConversationPresetAsync(_conversationId, preset);
            _permissionPreset = updated?.PermissionPreset ?? preset;
            await OnSearchChangedAsync();
        }
        catch (Exception ex)
        {
            _error = $"Falha ao trocar preset: {ex.Message}";
        }
    }

    private static string PrettyArgs(string? argsJson)
    {
        if (string.IsNullOrWhiteSpace(argsJson))
        {
            return "{}";
        }

        try
        {
            using var doc = JsonDocument.Parse(argsJson);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return argsJson;
        }
    }

    public void Dispose()
    {
        _streamCts?.Cancel();
        _streamCts?.Dispose();
    }
}
