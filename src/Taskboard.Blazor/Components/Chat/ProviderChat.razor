    private async Task OnProviderChangedAsync()
    {
        _models = [];
        _model = string.Empty;
        if (_providerId == Guid.Empty)
        {
            return;
        }

        try
        {
            _models = await Client.GetChatProviderModelsAsync(_providerId);
            if (_defaultChatModel is { Length: > 0 } d && _models.Contains(d))
