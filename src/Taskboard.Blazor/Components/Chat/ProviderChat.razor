    // ---- Tool approvals (SPEC-20261005-chat-tool-approval RF-003/RF-006) ----

    private Task AllowApprovalAsync(ChatApprovalDto approval, bool rememberTool) =>
        DecideApprovalAsync(approval, "allow", reason: null, rememberTool);

    private Task DenyApprovalAsync(ChatApprovalDto approval) =>
        DecideApprovalAsync(approval, "deny", reason: _denyReason, rememberTool: false);

    // ---- Plan mode (SPEC-20261005-chat-plan-mode RF-001/RF-004/RF-005) ----

    private Task ApprovePlanAsync(ChatApprovalDto approval) =>
        DecideApprovalAsync(approval, "allow", reason: null);

    private Task RevisePlanAsync(ChatApprovalDto approval) =>
        DecideApprovalAsync(approval, "deny", reason: _denyReason);

