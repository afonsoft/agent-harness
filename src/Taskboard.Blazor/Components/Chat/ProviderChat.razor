                    Title: BlankToNull(_schedTitle), Prompt: _schedPrompt),
                "cron" => new CreateChatScheduleRequest("cron", Expr: _schedExpr,
                    Title: BlankToNull(_schedTitle), Prompt: _schedPrompt),
                _ => new CreateChatScheduleRequest("after_seconds", AfterSeconds: _schedSeconds,
                    Title: BlankToNull(_schedTitle), Prompt: _schedPrompt),
            };
            var created = await Client.CreateChatScheduleAsync(_conversationId, request);
            if (created is null)
            {
                _error = "Falha ao agendar — verifique a expressão (cron/ISO) ou o limite por conversa.";
            }
            else
            {
                _schedTitle = string.Empty;
                _schedPrompt = string.Empty;
                _schedExpr = string.Empty;
