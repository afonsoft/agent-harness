        return elapsed.TotalHours >= 1 ? elapsed.ToString("h\\:mm", System.Globalization.CultureInfo.InvariantCulture)
            : elapsed.ToString("m\\:ss", System.Globalization.CultureInfo.InvariantCulture);
    }

