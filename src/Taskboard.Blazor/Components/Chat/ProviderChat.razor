    /// <summary>
    /// RF-001: stages each picked/pasted file — the upload is deferred to a
    /// staged row; the send binds ids. Files above the server cap are
    /// rejected by the endpoint (400) and surfaced per file.
    /// </summary>
    private async Task OnAttachPickedAsync(InputFileChangeEventArgs args)
    {
        if (await EnsureConversationAsync(string.Empty, hasAttachments: true) is not { } conversationId)
        {
            return;
        }

        _uploadingAttachment = true;
        _error = null;
        try
        {
            foreach (var file in args.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 32L * 1024 * 1024);
                try
                {
                    var dto = await Client.UploadChatAttachmentAsync(
                        conversationId, file.Name, file.ContentType, stream);
                    if (dto is not null)
                    {
                        _stagedAttachments.Add(dto);
                    }
                }
                catch (HttpRequestException ex)
                {
                    _error = $"Anexo '{file.Name}' recusado: {ex.Message}";
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"Falha no upload: {ex.Message}";
        }
        finally
        {
            _uploadingAttachment = false;
        }
    }

    /// <summary>RF-001: removes a staged upload (server deletes row + file).</summary>
    private async Task RemoveStagedAsync(ChatAttachmentDto attachment)
    {
        _stagedAttachments.Remove(attachment);
        if (_conversationId is not null)
        {
            try
            {
                await Client.DeleteChatAttachmentAsync(_conversationId, attachment.Id);
            }
            catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
            {
                _error = $"Falha ao remover anexo: {ex.Message}";
            }
        }
    }

