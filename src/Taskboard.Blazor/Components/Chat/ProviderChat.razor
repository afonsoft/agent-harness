    private async Task TogglePlanModeAsync(bool? active = null)
    {
        if (_conversationId is null)
        {
            return;
        }

        var target = active ?? _planMode != "on";
        try
        {
            var updated = await Client.SetChatPlanModeAsync(_conversationId, target);
            _planMode = updated?.PlanMode ?? (target ? "on" : "off");
            _notice = _planMode == "on"
                ? "Plan mode ativo — o modelo planeja e apresenta um plano antes de executar."
                : null;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Falha ao trocar plan mode: {ex.Message}";
        }
        catch (TaskCanceledException ex)
        {
            _error = $"Falha ao trocar plan mode: {ex.Message}";
        }
    }

    private async Task DecideApprovalAsync(
        ChatApprovalDto approval, string outcome, string? reason = null, bool rememberTool = false)
    {
        try
        {
            // Null = 409/404 — already decided (timeout/cancel/other tab); the
            // card also clears on the broadcast approval.decided.
            _ = await Client.DecideChatApprovalAsync(approval.Id, outcome, reason, rememberTool);
            _pendingApprovals.RemoveAll(a => a.Id == approval.Id);
            _denyReasonFor = null;
            _denyReason = null;
        }
        catch (HttpRequestException ex)
        {
            _error = $"Falha ao decidir aprovação: {ex.Message}";
        }
        catch (TaskCanceledException ex)
        {
            _error = $"Falha ao decidir aprovação: {ex.Message}";
        }
    }

    private void ToggleDenyReason(string approvalId)
    {
        _denyReasonFor = _denyReasonFor == approvalId ? null : approvalId;
        _denyReason = null;
    }

    private async Task ChangePresetAsync(ChangeEventArgs args)
    {
        var preset = args.Value?.ToString() ?? "ask";
        if (_conversationId is null || preset == _permissionPreset)
        {
            return;
        }

        try
        {
            var updated = await Client.UpdateChatConversationPresetAsync(_conversationId, preset);
            _permissionPreset = updated?.PermissionPreset ?? preset;
            await OnSearchChangedAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = $"Falha ao trocar preset: {ex.Message}";
        }
        catch (TaskCanceledException ex)
        {
            _error = $"Falha ao trocar preset: {ex.Message}";
        }
    }

    private static string PrettyArgs(string? argsJson)
    {
        if (string.IsNullOrWhiteSpace(argsJson))
        {
            return "{}";
        }

        try
        {
            using var doc = JsonDocument.Parse(argsJson);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return argsJson;
        }
    }

    /// <summary>RF-007: sidebar badge updates arrive on the hub thread.</summary>
    private void OnRunPressure(string conversationId, int estimated, int limit, bool compacted)
    {
        _pressureByConversation[conversationId] = (estimated, limit, compacted);
        if (conversationId == _conversationId)
        {
            _pressure = (estimated, limit, compacted);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>RF-007: manual compaction via /compact.</summary>
    private async Task CompactConversationAsync()
    {
        if (_conversationId is null)
        {
            _notice = "Abra uma conversa para compactar.";
            return;
        }

        try
        {
            await Client.CompactChatConversationAsync(_conversationId);
            _notice = "Contexto compactado — o histórico ganhou um resumo persistente.";
            await ReloadConversationAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _notice = $"Compactação falhou: {ex.Message}";
        }
    }

    private static string PressureClass(int estimated, int limit) =>
        limit <= 0 ? string.Empty
        : estimated >= limit ? "danger"
        : estimated >= limit * 0.8 ? "warn"
        : "ok";

    private static string FormatTokens(int tokens) =>
        tokens >= 1000 ? $"{tokens / 1000.0:0.#}k" : tokens.ToString(System.Globalization.CultureInfo.InvariantCulture);

