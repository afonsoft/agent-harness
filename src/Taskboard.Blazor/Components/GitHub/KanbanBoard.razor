@inject IGitHubService GitHubService
@inject IAgentOrchestrationService OrchestrationService
@inject ToastService ToastService

<Modal @ref="_agentModal" Size="ModalSize.Small" IsVerticallyCentered="true" OnHidden="OnAgentModalHidden" />
<Modal @ref="_detailModal" Size="ModalSize.Large" IsScrollable="true" />
<Modal @ref="_newTaskModal" Size="ModalSize.Small" IsVerticallyCentered="true" OnHidden="OnNewTaskModalHidden" />

@if (_isLoading)
{
    <Loading Message="Carregando issues..." />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mb-4">@_errorMessage</div>
}
else if (_columns is not null)
{
    <div class="mb-4">
        <Button Color="ButtonColor.Primary" @onclick="OpenNewTaskDialogAsync">
            <Icon Name="IconName.Plus" class="me-2" />Nova Tarefa
        </Button>
    </div>

    <div class="kanban-board">
        @foreach (var column in _columns)
        {
            <div class="kanban-column"
                 @ondrop="() => OnDropAsync(column.Column)"
                 @ondrop:preventDefault="true"
                 @ondragover="OnDragOver"
                 @ondragover:preventDefault="true">
                <div class="kanban-column-header">
                    <h4>@column.Column (@column.Issues.Count)</h4>
                    <span class="kanban-label">@column.Label</span>
                </div>
                <div class="kanban-column-body" style="height: 600px; overflow-y: auto;">
                    <Virtualize Items="column.Issues.ToList()" ItemSize="120" OverscanCount="3">
                        <div class="kanban-card"
                             @key="context.Id"
                             draggable="true"
                             aria-label="@context.Title, drag to move"
                             @ondragstart="() => OnDragStart(context, column.Column)"
                             @onclick="() => OpenTaskDetailAsync(context)">
                            <div class="kanban-card-title">@context.Title</div>
                            <div class="kanban-card-meta">
                                <span>#@context.Number</span>
                                @if (!string.IsNullOrWhiteSpace(context.AssigneeLogin))
                                {
                                    <span title="@context.AssigneeLogin">@@@context.AssigneeLogin</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(context.Body))
                            {
                                <div class="kanban-card-body">@context.Body</div>
                            }
                        </div>
                    </Virtualize>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    private Modal _agentModal = default!;
    private Modal _detailModal = default!;
    private Modal _newTaskModal = default!;

    private TaskCompletionSource<AgentExecutionRequest?>? _agentSelectionTcs;
    private TaskCompletionSource<bool>? _newTaskTcs;

    private bool _isLoading;
    private string? _errorMessage;
    private string? _currentRepository;
    private IReadOnlyList<BoardColumnDto>? _columns;
    private IssueDto? _draggedIssue;
    private GitHubBoardColumn? _draggedFromColumn;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(RepositoryFullName) && RepositoryFullName != _currentRepository)
        {
            _currentRepository = RepositoryFullName;
            await LoadIssuesAsync();
        }
    }

    private async Task LoadIssuesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var issues = await GitHubService.GetIssuesAsync(RepositoryFullName, GitHubBoardColumnExtensions.GetAllLabels());
            _columns = GroupIssuesByColumn(issues);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar issues: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static IReadOnlyList<BoardColumnDto> GroupIssuesByColumn(IReadOnlyList<IssueDto> issues)
    {
        return Enum.GetValues<GitHubBoardColumn>()
            .Select(column => new BoardColumnDto(
                column,
                column.ToLabel(),
                issues.Where(i => i.Column == column).OrderByDescending(i => i.UpdatedAt).ToList().AsReadOnly()))
            .ToList()
            .AsReadOnly();
    }

    private void OnDragStart(IssueDto issue, GitHubBoardColumn fromColumn)
    {
        _draggedIssue = issue;
        _draggedFromColumn = fromColumn;
    }

    private static void OnDragOver(DragEventArgs args)
    {
        // Necessário para permitir o drop.
    }

    private async Task OnDropAsync(GitHubBoardColumn toColumn)
    {
        if (_draggedIssue is null || _draggedFromColumn == toColumn)
        {
            return;
        }

        var issue = _draggedIssue;
        var fromColumn = _draggedFromColumn;

        _draggedIssue = null;
        _draggedFromColumn = null;

        try
        {
            if (toColumn is GitHubBoardColumn.InProgress or GitHubBoardColumn.Backlog)
            {
                var request = await OpenAgentSelectionModalAsync(issue);
                if (request is null)
                {
                    return;
                }

                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                await GitHubService.AddLabelsToIssueAsync(RepositoryFullName, issue.Number, [request.AgentType.ToLabel()]);
                await OrchestrationService.EnqueueAsync(request);
                ToastService.Notify(new(ToastType.Success, $"Issue #{issue.Number} movida para {toColumn.ToLabel()} e agente {request.AgentType} iniciado."));
            }
            else
            {
                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                ToastService.Notify(new(ToastType.Success, $"Issue #{issue.Number} movida para {toColumn.ToLabel()}."));
            }

            await LoadIssuesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao mover issue: {ex.Message}";
            ToastService.Notify(new(ToastType.Danger, _errorMessage));
        }
    }

    private async Task<AgentExecutionRequest?> OpenAgentSelectionModalAsync(IssueDto issue)
    {
        _agentSelectionTcs = new TaskCompletionSource<AgentExecutionRequest?>(TaskCreationOptions.RunContinuationsAsynchronously);

        var parameters = new Dictionary<string, object>
        {
            { nameof(AgentSelectionModal.Issue), issue },
            { nameof(AgentSelectionModal.RepositoryFullName), RepositoryFullName },
            { nameof(AgentSelectionModal.OnSubmit), EventCallback.Factory.Create<AgentExecutionRequest>(this, OnAgentSelectedAsync) },
            { nameof(AgentSelectionModal.OnCancel), EventCallback.Factory.Create(this, OnAgentSelectionCanceledAsync) }
        };

        await _agentModal.ShowAsync<AgentSelectionModal>(title: "Selecionar Agente CLI", parameters: parameters);
        return await _agentSelectionTcs.Task;
    }

    private async Task OnAgentSelectedAsync(AgentExecutionRequest request)
    {
        _agentSelectionTcs?.TrySetResult(request);
        await _agentModal.HideAsync();
    }

    private async Task OnAgentSelectionCanceledAsync()
    {
        _agentSelectionTcs?.TrySetResult(null);
        await _agentModal.HideAsync();
    }

    private void OnAgentModalHidden()
    {
        _agentSelectionTcs?.TrySetResult(null);
        _agentSelectionTcs = null;
    }

    private async Task OpenTaskDetailAsync(IssueDto issue)
    {
        var parameters = new Dictionary<string, object>
        {
            { nameof(TaskDetailDialog.Issue), issue },
            { nameof(TaskDetailDialog.RepositoryFullName), RepositoryFullName }
        };

        await _detailModal.ShowAsync<TaskDetailDialog>(title: $"Issue #{issue.Number}", parameters: parameters);
    }

    private async Task OpenNewTaskDialogAsync()
    {
        _newTaskTcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);

        var parameters = new Dictionary<string, object>
        {
            { nameof(NewTaskDialog.RepositoryFullName), RepositoryFullName },
            { nameof(NewTaskDialog.OnSaved), EventCallback.Factory.Create(this, OnNewTaskSavedAsync) },
            { nameof(NewTaskDialog.OnCancel), EventCallback.Factory.Create(this, OnNewTaskCanceledAsync) }
        };

        await _newTaskModal.ShowAsync<NewTaskDialog>(title: "Nova Tarefa", parameters: parameters);

        if (await _newTaskTcs.Task)
        {
            await LoadIssuesAsync();
        }
    }

    private async Task OnNewTaskSavedAsync()
    {
        _newTaskTcs?.TrySetResult(true);
        await _newTaskModal.HideAsync();
    }

    private async Task OnNewTaskCanceledAsync()
    {
        _newTaskTcs?.TrySetResult(false);
        await _newTaskModal.HideAsync();
    }

    private void OnNewTaskModalHidden()
    {
        _newTaskTcs?.TrySetResult(false);
        _newTaskTcs = null;
    }
}
