@using System.Globalization
@inject IGitHubService GitHubService
@inject IAgentOrchestrationService OrchestrationService
@inject ToastService ToastService

<Modal @ref="_agentModal" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true" OnHidden="OnAgentModalHidden" />
<Modal @ref="_detailModal" Size="ModalSize.Large" Fullscreen="ModalFullscreen.SmallDown" IsScrollable="true" />
<Modal @ref="_newTaskModal" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true" OnHidden="OnNewTaskModalHidden" />

@if (_isLoading)
{
    <Loading Message="Carregando issues..." />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mb-4">@_errorMessage</div>
}
else if (_columns is not null)
{
    <div class="d-flex gap-2 mb-3">
        <Button Color="ButtonColor.Primary" @onclick="OpenNewTaskDialogAsync">
            <Icon Name="IconName.Plus" class="me-2" />Nova Tarefa
        </Button>
        <input type="search" class="form-control form-control-sm w-auto" placeholder="Filtrar por título, descrição ou label..."
               aria-label="Filtrar issues" @bind="_filterText" @bind:event="oninput" />
        <select class="form-select form-select-sm w-auto" aria-label="Filtrar por prioridade" @bind="_filterPriority">
            <option value="">Todas as prioridades</option>
            @foreach (var priority in _priorities)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </div>

    <div class="kanban-board">
        @foreach (var column in _columns)
        {
            var issues = GetIssues(column).ToList();
            <div class="kanban-column"
                 @ondrop="() => OnDropAsync(column.Column)"
                 @ondrop:preventDefault="column.Column.HasLabel()"
                 @ondragover="OnDragOver"
                 @ondragover:preventDefault="column.Column.HasLabel()">
                <div class="kanban-column-header @GetStatusClass(column.Column)">
                    <h2>@column.Label</h2>
                    <span class="kanban-label">@issues.Count</span>
                </div>
                <div class="kanban-column-body" style="max-height: 70vh;">
                    @if (issues.Count > 0)
                    {
                        <Virtualize Items="issues" ItemSize="80" OverscanCount="5">
                            <div class="task-card @GetPriorityClass(context)"
                                 @key="context.Id"
                                 draggable="true"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@context.Title, drag to move"
                                 @ondragstart="() => OnDragStart(context, column.Column)"
                                 @onclick="() => OpenTaskDetailAsync(context)">
                                <div class="task-card-header">
                                    <div class="task-title">@context.Title</div>
                                    <div class="dropdown task-card-actions">
                                        <button type="button" class="task-card-menu" data-bs-toggle="dropdown"
                                                aria-expanded="false" aria-haspopup="menu"
                                                aria-label="Mover issue #@context.Number"
                                                @onclick:stopPropagation @ondragstart:stopPropagation>
                                            <Icon Name="IconName.ThreeDotsVertical" />
                                        </button>
                                        <ul class="dropdown-menu" role="menu">
                                            @foreach (var target in _columns)
                                            {
                                                if (target.Column == column.Column || !target.Column.HasLabel())
                                                {
                                                    continue;
                                                }
                                                <li>
                                                    <button type="button" class="dropdown-item" role="menuitem"
                                                            @onclick="() => MoveIssueAsync(context, column.Column, target.Column)"
                                                            @onclick:stopPropagation>
                                                        Mover para @target.Label
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(context.Body))
                                {
                                    <div class="task-description">@context.Body</div>
                                }
                                <div class="task-meta">
                                    <span class="task-priority-swatch" style="@GetPrioritySwatchStyle(context)"></span>
                                    <span>@context.Priority</span>
                                    <span class="text-body-secondary">|</span>
                                    <span>#@context.Number</span>
                                    <span class="text-body-secondary">|</span>
                                    <span>@(context.AssigneeLogin is null ? "—" : $"@{context.AssigneeLogin}")</span>
                                    @if (TryGetRun(context, out var run))
                                    {
                                        <span class="text-body-secondary">|</span>
                                        <span class="agent-badge @GetAgentBadgeClass(run!)"
                                              title="Agente: @GetAgentDisplayName(run!.AgentType) — @run!.State">
                                            <Icon Name="IconName.Robot" />@GetAgentShortName(run!.AgentType)
                                        </span>
                                    }
                                </div>
                            </div>
                        </Virtualize>
                    }
                    else
                    {
                        <EmptyState Message="No issues" />
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    private Modal _agentModal = default!;
    private Modal _detailModal = default!;
    private Modal _newTaskModal = default!;

    private TaskCompletionSource<AgentExecutionRequest?>? _agentSelectionTcs;
    private TaskCompletionSource<bool>? _newTaskTcs;

    private bool _isLoading;
    private string? _errorMessage;
    private string? _currentRepository;
    private IReadOnlyList<BoardColumnDto>? _columns;
    private Dictionary<string, AgentRunDto>? _agentRuns;
    private IssueDto? _draggedIssue;
    private GitHubBoardColumn? _draggedFromColumn;
    private string _filterText = string.Empty;
    private string _filterPriority = string.Empty;
    private readonly string[] _priorities = ["Urgent", "High", "Medium", "Low", "None"];

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(RepositoryFullName) && RepositoryFullName != _currentRepository)
        {
            _currentRepository = RepositoryFullName;
            await LoadIssuesAsync();
        }
    }

    private async Task LoadIssuesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var issues = await GitHubService.GetIssuesAsync(RepositoryFullName);
            _columns = GitHubBoardGrouper.GroupByColumn(issues, DateTimeOffset.UtcNow);
            await LoadAgentRunsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar issues: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAgentRunsAsync()
    {
        try
        {
            var runs = await OrchestrationService.GetLatestRunsAsync();
            _agentRuns = runs.ToDictionary(r => r.IssueId);
        }
        catch
        {
            // Badge hydration is best-effort — the board still works without it.
            _agentRuns = null;
        }
    }

    private bool TryGetRun(IssueDto issue, out AgentRunDto? run)
    {
        run = null;
        return _agentRuns is not null
            && _agentRuns.TryGetValue(issue.Id.ToString(CultureInfo.InvariantCulture), out run);
    }

    private static string GetAgentBadgeClass(AgentRunDto run)
    {
        var kind = AgentCliMap.CliKindFor(run.AgentType);
        var name = (kind?.ToString() ?? run.AgentType.ToString()).ToLowerInvariant();
        var state = run.State is AgentRunState.Queued or AgentRunState.Running
            ? "agent-badge-active"
            : "agent-badge-muted";
        return $"agent-{name} {state}";
    }

    private static string GetAgentShortName(AgentType type) => type switch
    {
        AgentType.Claude => "Claude",
        AgentType.Codex => "Codex",
        AgentType.OpenCode => "OpenCode",
        AgentType.Devin => "Devin",
        AgentType.Antigravity => "AGY",
        _ => type.ToString()
    };

    private static string GetAgentDisplayName(AgentType type)
    {
        var kind = AgentCliMap.CliKindFor(type);
        return kind is not null
            ? AgentCliMap.GetSpec(kind.Value)?.DisplayName ?? type.ToString()
            : type.ToString();
    }

    private IEnumerable<IssueDto> GetIssues(BoardColumnDto column) =>
        column.Issues.Where(i => GitHubBoardGrouper.MatchesFilters(i, _filterText, _filterPriority));

    private void OnDragStart(IssueDto issue, GitHubBoardColumn fromColumn)
    {
        _draggedIssue = issue;
        _draggedFromColumn = fromColumn;
    }

    private static void OnDragOver(DragEventArgs args)
    {
        // Necessário para permitir o drop.
    }

    private async Task OnDropAsync(GitHubBoardColumn toColumn)
    {
        if (_draggedIssue is null || _draggedFromColumn is not { } fromColumn || fromColumn == toColumn || !toColumn.HasLabel())
        {
            return;
        }

        var issue = _draggedIssue;

        _draggedIssue = null;
        _draggedFromColumn = null;

        await MoveIssueAsync(issue, fromColumn, toColumn);
    }

    private async Task MoveIssueAsync(IssueDto issue, GitHubBoardColumn fromColumn, GitHubBoardColumn toColumn)
    {
        if (fromColumn == toColumn || !toColumn.HasLabel())
        {
            return;
        }

        try
        {
            if (toColumn is GitHubBoardColumn.InProgress or GitHubBoardColumn.Backlog)
            {
                var request = await OpenAgentSelectionModalAsync(issue);
                if (request is null)
                {
                    return;
                }

                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                await GitHubService.AddLabelsToIssueAsync(RepositoryFullName, issue.Number, [request.AgentType.ToLabel()]);
                var queued = await OrchestrationService.EnqueueAsync(request);
                ToastService.Notify(queued
                    ? new(ToastType.Success, $"Issue #{issue.Number} movida para {toColumn.ToLabel()} e agente {request.AgentType} iniciado.")
                    : new(ToastType.Warning, $"Issue #{issue.Number} movida, mas o agente {request.AgentType} não está elegível (desabilitado ou não autenticado)."));
            }
            else
            {
                await GitHubService.UpdateIssueColumnAsync(RepositoryFullName, issue.Number, fromColumn, toColumn);
                ToastService.Notify(new(ToastType.Success, $"Issue #{issue.Number} movida para {toColumn.ToLabel()}."));
            }

            await LoadIssuesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao mover issue: {ex.Message}";
            ToastService.Notify(new(ToastType.Danger, _errorMessage));
        }
    }

    private async Task<AgentExecutionRequest?> OpenAgentSelectionModalAsync(IssueDto issue)
    {
        _agentSelectionTcs = new TaskCompletionSource<AgentExecutionRequest?>(TaskCreationOptions.RunContinuationsAsynchronously);

        var parameters = new Dictionary<string, object>
        {
            { nameof(AgentSelectionModal.Issue), issue },
            { nameof(AgentSelectionModal.RepositoryFullName), RepositoryFullName },
            { nameof(AgentSelectionModal.OnSubmit), EventCallback.Factory.Create<AgentExecutionRequest>(this, OnAgentSelectedAsync) },
            { nameof(AgentSelectionModal.OnCancel), EventCallback.Factory.Create(this, OnAgentSelectionCanceledAsync) }
        };

        await _agentModal.ShowAsync<AgentSelectionModal>(title: "Selecionar Agente CLI", parameters: parameters);
        return await _agentSelectionTcs.Task;
    }

    private async Task OnAgentSelectedAsync(AgentExecutionRequest request)
    {
        _agentSelectionTcs?.TrySetResult(request);
        await _agentModal.HideAsync();
    }

    private async Task OnAgentSelectionCanceledAsync()
    {
        _agentSelectionTcs?.TrySetResult(null);
        await _agentModal.HideAsync();
    }

    private void OnAgentModalHidden()
    {
        _agentSelectionTcs?.TrySetResult(null);
        _agentSelectionTcs = null;
    }

    private async Task OpenTaskDetailAsync(IssueDto issue)
    {
        var parameters = new Dictionary<string, object>
        {
            { nameof(TaskDetailDialog.Issue), issue },
            { nameof(TaskDetailDialog.RepositoryFullName), RepositoryFullName }
        };

        await _detailModal.ShowAsync<TaskDetailDialog>(title: $"Issue #{issue.Number}", parameters: parameters);
    }

    private async Task OpenNewTaskDialogAsync()
    {
        _newTaskTcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);

        var parameters = new Dictionary<string, object>
        {
            { nameof(NewTaskDialog.RepositoryFullName), RepositoryFullName },
            { nameof(NewTaskDialog.OnSaved), EventCallback.Factory.Create(this, OnNewTaskSavedAsync) },
            { nameof(NewTaskDialog.OnCancel), EventCallback.Factory.Create(this, OnNewTaskCanceledAsync) }
        };

        await _newTaskModal.ShowAsync<NewTaskDialog>(title: "Nova Tarefa", parameters: parameters);

        if (await _newTaskTcs.Task)
        {
            await LoadIssuesAsync();
        }
    }

    private async Task OnNewTaskSavedAsync()
    {
        _newTaskTcs?.TrySetResult(true);
        await _newTaskModal.HideAsync();
    }

    private async Task OnNewTaskCanceledAsync()
    {
        _newTaskTcs?.TrySetResult(false);
        await _newTaskModal.HideAsync();
    }

    private void OnNewTaskModalHidden()
    {
        _newTaskTcs?.TrySetResult(false);
        _newTaskTcs = null;
    }

    private static string GetStatusClass(GitHubBoardColumn column) => column switch
    {
        GitHubBoardColumn.Backlog or GitHubBoardColumn.Todo => "status-not-started",
        GitHubBoardColumn.InProgress or GitHubBoardColumn.InReview or GitHubBoardColumn.InPullRequest => "status-in-progress",
        GitHubBoardColumn.Blocked => "status-on-hold",
        GitHubBoardColumn.Done => "status-completed",
        GitHubBoardColumn.Canceled or GitHubBoardColumn.Archived => "status-archived",
        _ => "status-on-hold"
    };

    private static string GetPriorityClass(IssueDto issue) =>
        $"priority-{issue.Priority.ToLowerInvariant()}";

    private static string GetPrioritySwatchStyle(IssueDto issue) =>
        $"background-color: var(--priority-{issue.Priority.ToLowerInvariant()}-border);";
}
