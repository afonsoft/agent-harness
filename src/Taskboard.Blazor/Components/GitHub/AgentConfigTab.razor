@using System.Globalization
@using System.Text
@inject IAgentOrchestrationService OrchestrationService
@inject IAgentPromptTemplateService PromptTemplateService
@inject IGitHubService GitHub
@inject ToastService ToastService
@inject IJSRuntime JS

@*
    SPEC-20260918-kanban-card-ux RF-006: agente elegível + prompt por issue.
    O último prompt usado fica em localStorage["agent-prompt:{issueId}"].
*@

@if (_isLoading)
{
    <div class="d-flex align-items-center pt-3">
        <Spinner Size="SpinnerSize.Small" Class="me-2" />
        <span>Detectando agentes...</span>
    </div>
}
else if (_agents is { Count: 0 })
{
    <div class="alert alert-warning mt-3" role="status">
        Nenhum agente CLI habilitado e autenticado. Ative um agente em
        <a href="/settings" class="alert-link">Settings → Agents</a> ou faça login pelo
        <a href="/terminal" class="alert-link">Terminal</a>.
    </div>
}
else if (_agents is not null)
{
    <div class="pt-3">
        @if (!string.IsNullOrWhiteSpace(RepositoryFullName))
        {
            <div class="mb-3">
                <label class="form-label">Repositório</label>
                <div>
                    <a href="https://github.com/@RepositoryFullName" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                        <i class="bi bi-github me-1"></i>@RepositoryFullName
                    </a>
                </div>
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label for="cfg-agent-select" class="form-label">Agente</label>
                <select id="cfg-agent-select" class="form-select" @bind="_selectedAgentType">
                    @foreach (var agent in _agents)
                    {
                        <option value="@agent.Type" disabled="@(agent.Status != AgentStatus.Available)">
                            @agent.Name (@agent.Status)
                        </option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <label for="cfg-model-select" class="form-label">Modelo</label>
                @if (AgentCliModels.SupportsModelSelection(_selectedAgentType))
                {
                    <select id="cfg-model-select" class="form-select" @bind="_modelTier">
                        <option value="@AgentModelTier.Lite">Lite</option>
                        <option value="@AgentModelTier.Normal">Normal</option>
                        <option value="@AgentModelTier.Ultra">Ultra</option>
                    </select>
                    <div class="form-text">@AgentCliModels.ModelFor(_selectedAgentType, _modelTier)</div>
                }
                else
                {
                    <select id="cfg-model-select" class="form-select" disabled>
                        <option>Gerenciado pela CLI</option>
                    </select>
                    <div class="form-text">A CLI escolhe o modelo</div>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Comando</label>
            <pre class="agent-command-preview border rounded p-2 mb-0 small"><code>@AgentCliInvocation.PreviewCommandLine(_selectedAgentType, _modelTier)</code></pre>
        </div>

        <div class="mb-3">
            <label for="cfg-agent-prompt" class="form-label">Prompt <span class="text-danger">*</span></label>
            <textarea id="cfg-agent-prompt" class="form-control" rows="6" @bind="_prompt"
                      placeholder="Instruções para o agente executar nesta issue..."></textarea>
            @if (string.IsNullOrWhiteSpace(_prompt))
            {
                <div class="form-text text-danger">O prompt é obrigatório.</div>
            }
        </div>

        <div class="d-flex justify-content-end">
            <Button Color="ButtonColor.Primary" @onclick="ExecuteAsync" Disabled="!CanExecute()">
                @if (_executing)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-2" />
                }
                Executar
            </Button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IssueDto? Issue { get; set; }

    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnExecuted { get; set; }

    private bool _isLoading;
    private bool _executing;
    private IReadOnlyList<AgentInfo>? _agents;
    private AgentType _selectedAgentType;
    private AgentModelTier _modelTier = AgentModelTier.Normal;
    private string _prompt = string.Empty;

    private string StorageKey =>
        $"agent-prompt:{Issue?.Id.ToString(CultureInfo.InvariantCulture)}";

    private AgentInfo? SelectedAgent =>
        _agents?.FirstOrDefault(a => a.Type == _selectedAgentType);

    private string RepoCloneUrl =>
        string.IsNullOrWhiteSpace(RepositoryFullName)
            ? string.Empty
            : $"https://github.com/{RepositoryFullName}.git";

    private async Task<string?> LoadTemplateAsync()
    {
        try
        {
            var info = await PromptTemplateService.GetTemplateAsync();
            return info.Template;
        }
        catch
        {
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Issue is null || _agents is not null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _agents = await OrchestrationService.GetAvailableAgentsAsync();
            var first = _agents.FirstOrDefault(a => a.Status == AgentStatus.Available);
            if (first is not null)
            {
                _selectedAgentType = first.Type;
            }

            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                _prompt = saved;
            }
            else
            {
                var template = await LoadTemplateAsync();
                var commentsSection = await BuildCommentsSectionAsync();
                if (!string.IsNullOrWhiteSpace(template))
                {
                    _prompt = AgentPromptTemplate.Render(
                        template, RepoCloneUrl, Issue.Title, Issue.Body, commentsSection.TrimStart());
                    // Older overrides may lack {issueComments} — append so the
                    // handoff channel still reaches the agent (SPEC-20260918-github-comments-history RF-005).
                    if (!AgentPromptTemplate.HasCommentsPlaceholder(template))
                    {
                        _prompt += commentsSection;
                    }
                }
                else
                {
                    _prompt = string.IsNullOrWhiteSpace(Issue.Body)
                        ? $"Resolve a issue #{Issue.Number}: {Issue.Title}"
                        : Issue.Body;
                    _prompt += commentsSection;
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao detectar agentes: {ex.Message}"));
        }
        finally
        {
            _isLoading = false;
        }
    }

    // SPEC-20260918-github-comments-history RF-005: comments are the handoff
    // channel — the rendered prompt carries them as a bounded "Comments:"
    // section. A fetch failure must never block the run.
    private async Task<string> BuildCommentsSectionAsync()
    {
        const int maxChars = 3000;
        try
        {
            if (Issue is null || string.IsNullOrWhiteSpace(RepositoryFullName))
            {
                return string.Empty;
            }

            var comments = await GitHub.GetIssueCommentsAsync(RepositoryFullName, Issue.Number, take: 20);
            if (comments.Count == 0)
            {
                return string.Empty;
            }

            var sb = new StringBuilder("\n\nComments:\n");
            foreach (var c in comments)
            {
                var line = $"- {c.AuthorLogin ?? "unknown"} ({c.CreatedAt:yyyy-MM-dd}): {c.Body}\n";
                if (sb.Length + line.Length > maxChars)
                {
                    sb.Append("- …\n");
                    break;
                }

                sb.Append(line);
            }

            return sb.ToString();
        }
        catch
        {
            return string.Empty;
        }
    }

    private bool CanExecute() =>
        !_executing
        && SelectedAgent is { Status: AgentStatus.Available }
        && !string.IsNullOrWhiteSpace(_prompt);

    private async Task ExecuteAsync()
    {
        if (Issue is null || !CanExecute())
        {
            return;
        }

        _executing = true;
        try
        {
            var request = new AgentExecutionRequest(
                Issue.Id.ToString(CultureInfo.InvariantCulture),
                Issue.Number,
                RepositoryFullName,
                string.Empty,
                Branch: null,
                Scope: null,
                _prompt,
                _selectedAgentType,
                _modelTier);

            var queued = await OrchestrationService.EnqueueAsync(request);
            if (queued)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, _prompt);
                ToastService.Notify(new(ToastType.Success,
                    $"Agente {_selectedAgentType} enfileirado para a issue #{Issue.Number}."));
                await OnExecuted.InvokeAsync();
            }
            else
            {
                ToastService.Notify(new(ToastType.Danger,
                    $"Agente {_selectedAgentType} inelegível (desabilitado ou não autenticado)."));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao executar agente: {ex.Message}"));
        }
        finally
        {
            _executing = false;
        }
    }
}
