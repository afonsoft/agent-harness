@using System.Globalization
@using Taskboard.GitHub
@using Taskboard.Rendering
@inject IGitHubService GitHub
@inject ToastService ToastService
@inject ILocaleService L

@*
    SPEC-20260918-github-comments-history RF-004: GitHub issue comments are the
    handoff channel between humans and agents — list them, post new ones.
*@

<div class="pt-3">
    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 text-body-secondary small">
            <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" /> @L.T("comments.loading")
        </div>
    }
    else if (_error is not null)
    {
        <div class="small text-danger">@_error</div>
    }
    else
    {
        @if (_comments.Count == 0)
        {
            <div class="small text-body-secondary mb-2">@L.T("comments.none")</div>
        }
        else
        {
            <div class="d-flex justify-content-end mb-1">
                <div class="btn-group btn-group-sm" role="group" aria-label="@L.T("comments.viewAria")">
                    <button type="button" class="btn @(_showSource ? "btn-outline-secondary" : "btn-secondary")"
                            @onclick="() => _showSource = false">@L.T("comments.viewRendered")</button>
                    <button type="button" class="btn @(_showSource ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="() => _showSource = true">@L.T("comments.viewSource")</button>
                </div>
            </div>
            <ul class="list-unstyled mb-3">
                @foreach (var c in _comments)
                {
                    <li class="py-2 border-bottom">
                        <div class="d-flex justify-content-between small text-body-secondary">
                            <span><Icon Name="IconName.PersonCircle" class="me-1" />@(c.AuthorLogin ?? "unknown")</span>
                            <span>@UiFormat.DateTime(c.CreatedAt)</span>
                        </div>
                        @if (_showSource)
                        {
                            <div class="small mt-1" style="white-space: pre-wrap;">@c.Body</div>
                        }
                        else
                        {
                            <div class="small mt-1 markdown-body">
                                @((MarkupString)MarkdownRenderer.ToSafeHtml(c.Body ?? string.Empty))
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        <div class="mb-2">
            <label for="issue-comment-body" class="form-label small">@L.T("comments.new") <span class="text-body-secondary">@L.T("comments.publishedSuffix")</span></label>
            <textarea id="issue-comment-body" class="form-control" rows="3" @bind="_draft"
                      placeholder="@L.T("comments.placeholder")"></textarea>
        </div>
        <div class="d-flex justify-content-end">
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="PostAsync"
                    Disabled="@(_posting || string.IsNullOrWhiteSpace(_draft))">
                @if (_posting)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                @L.T("comments.post")
            </Button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public int IssueNumber { get; set; }

    private IReadOnlyList<IssueCommentDto> _comments = [];
    private bool _loading = true;
    private bool _showSource;
    private bool _posting;
    private string? _error;
    private string _draft = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _comments = await GitHub.GetIssueCommentsAsync(RepositoryFullName, IssueNumber);
        }
        catch (Exception ex)
        {
            _error = L.T("comments.loadError", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PostAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        _posting = true;
        try
        {
            await GitHub.AddIssueCommentAsync(RepositoryFullName, IssueNumber, _draft.Trim());
            _draft = string.Empty;
            await ToastService.NotifyAsync(new(ToastType.Success, L.T("comments.publishedToast")));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, L.T("comments.postError", ex.Message)));
        }
        finally
        {
            _posting = false;
        }
    }
}
