@inject IAgentOrchestrationService OrchestrationService
@inject ToastService ToastService

<h6 class="mb-3">Selecionar Agente CLI</h6>

@if (_isLoading)
{
    <div class="d-flex align-items-center">
        <Spinner Size="SpinnerSize.Small" Class="me-2" />
        <span>Detectando agentes...</span>
    </div>
}
else if (_agents is not null)
{
    @if (_agents.Count == 0)
    {
        <div class="alert alert-warning" role="status">
            Nenhum agente CLI habilitado e autenticado. Ative um agente em
            <a href="/settings" class="alert-link">Settings → Agents</a> ou faça login pelo
            <a href="/terminal" class="alert-link">Terminal</a>.
        </div>
    }
    else
    {
    <div class="mb-3">
        <label for="agent-select" class="form-label">Agente</label>
        <select id="agent-select" class="form-select" @bind="_selectedAgentType">
            @foreach (var agent in _agents)
            {
                <option value="@agent.Type" disabled="@(agent.Status != AgentStatus.Available)">@agent.Name (@agent.Status)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="agent-branch" class="form-label">Branch de trabalho</label>
        <input id="agent-branch" type="text" class="form-control" @bind="_branch" />
    </div>

    <div class="mb-3">
        <label for="agent-scope" class="form-label">Escopo</label>
        <input id="agent-scope" type="text" class="form-control" @bind="_scope" />
    </div>

    <div class="mb-3">
        <label for="agent-instructions" class="form-label">Instruções <span class="text-danger">*</span></label>
        <textarea id="agent-instructions" class="form-control" rows="5" @bind="_instructions"></textarea>
        @if (string.IsNullOrWhiteSpace(_instructions))
        {
            <div class="form-text text-danger">As instruções são obrigatórias.</div>
        }
    </div>
    }
}

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <Button Color="ButtonColor.Secondary" @onclick="CancelAsync">Cancelar</Button>
    <Button Color="ButtonColor.Primary" @onclick="ConfirmAsync" Disabled="!CanConfirm()">
        Iniciar Agente
    </Button>
</div>

@code {
    [Parameter, EditorRequired]
    public IssueDto Issue { get; set; } = default!;

    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter]
    public string? DefaultRepoPath { get; set; }

    [Parameter]
    public EventCallback<AgentExecutionRequest> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool _isLoading;
    private IReadOnlyList<AgentInfo>? _agents;
    private AgentType _selectedAgentType;
    private string _branch = string.Empty;
    private string _scope = string.Empty;
    private string _instructions = string.Empty;

    private AgentInfo? SelectedAgent => _agents?.FirstOrDefault(a => a.Type == _selectedAgentType);

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            _agents = await OrchestrationService.GetAvailableAgentsAsync();
            var first = _agents.FirstOrDefault(a => a.Status == AgentStatus.Available);
            if (first is not null)
            {
                _selectedAgentType = first.Type;
            }
            _instructions = string.IsNullOrWhiteSpace(Issue.Body)
                ? $"Resolve a issue #{Issue.Number}: {Issue.Title}"
                : Issue.Body;
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao detectar agentes: {ex.Message}"));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }

    private bool CanConfirm() => SelectedAgent is not null && SelectedAgent.Status == AgentStatus.Available && !string.IsNullOrWhiteSpace(_instructions);

    private async Task ConfirmAsync()
    {
        var agent = SelectedAgent;
        if (agent is null)
        {
            return;
        }

        var request = new AgentExecutionRequest(
            Issue.Id.ToString(),
            Issue.Number,
            RepositoryFullName,
            DefaultRepoPath ?? string.Empty,
            _branch,
            _scope,
            _instructions,
            agent.Type);

        await OnSubmit.InvokeAsync(request);
    }
}
