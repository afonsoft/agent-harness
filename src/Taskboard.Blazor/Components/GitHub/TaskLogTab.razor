@inject IAgentOrchestrationService OrchestrationService
@inject TaskboardClient Client
@inject ToastService ToastService
@using Taskboard.Agents

<div class="agent-log-tab">
    <div class="agent-log-header">
        <strong>Execução do Agente</strong>
        <div class="d-flex gap-2">
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ClearAsync">
                Limpar
            </Button>
            <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="CancelAsync">
                Cancelar
            </Button>
        </div>
    </div>

    @* SPEC-20260921-board-cockpit-agent-observability RF-002: timeline
       normalizada (tool calls, planos, permissões, métricas) — não mais
       texto flat em memória. *@
    <AgentRunTimeline ScopeKind="issue" ScopeId="@IssueId" OnPermissionReply="ReplyPermissionAsync" />
</div>

@code {
    [Parameter, EditorRequired]
    public string IssueId { get; set; } = string.Empty;

    private async Task ClearAsync()
    {
        try
        {
            await OrchestrationService.ClearLogsAsync(IssueId);
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao limpar logs: {ex.Message}"));
        }
    }

    private async Task CancelAsync()
    {
        try
        {
            var accepted = await Client.PostAgentControlAsync(
                new AgentControlRequest("issue", IssueId, "cancel"));
            if (!accepted)
            {
                await OrchestrationService.CancelAsync(IssueId);
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao cancelar: {ex.Message}"));
        }
    }

    private async Task ReplyPermissionAsync(AgentExecutionEvent evt, string optionId)
    {
        try
        {
            var requestId = ExtractRequestId(evt.PayloadJson);
            if (requestId is null)
            {
                return;
            }

            var outcome = optionId.Contains("reject", StringComparison.OrdinalIgnoreCase) ? "deny" : "allow";
            var ok = await Client.PostAgentPermissionReplyAsync(
                new AgentPermissionReplyRequest("issue", IssueId, requestId, outcome));
            if (!ok)
            {
                ToastService.Notify(new(ToastType.Warning, "Permissão expirada ou já respondida."));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao responder permissão: {ex.Message}"));
        }
    }

    private static string? ExtractRequestId(string? payloadJson)
    {
        if (string.IsNullOrWhiteSpace(payloadJson))
        {
            return null;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(payloadJson);
            return doc.RootElement.TryGetProperty("requestId", out var r) ? r.GetString() : null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }
}
