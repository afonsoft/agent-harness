@using System.Globalization
@inject IGitHubService GitHubService
@inject IAgentOrchestrationService OrchestrationService
@inject ToastService ToastService

<Tabs EnableFadeEffect="true">
    <Tab Title="Detalhes" IsActive="true">
        <Content>
            <div class="pt-3">
                @if (_editing)
                {
                    <div class="mb-3">
                        <label for="edit-issue-title" class="form-label">Título <span class="text-danger">*</span></label>
                        <input id="edit-issue-title" type="text" class="form-control" maxlength="250" @bind="_editTitle" />
                    </div>
                    <Tabs EnableFadeEffect="false">
                        <Tab Title="Escrever" IsActive="true">
                            <Content>
                                <div class="pt-2">
                                    <label for="edit-issue-body" class="form-label">Descrição (markdown)</label>
                                    <textarea id="edit-issue-body" class="form-control" rows="8" @bind="_editBody"></textarea>
                                </div>
                            </Content>
                        </Tab>
                        <Tab Title="Visualizar">
                            <Content>
                                <div class="pt-2 markdown-body">
                                    @((MarkupString)MarkdownRenderer.ToSafeHtml(_editBody))
                                </div>
                            </Content>
                        </Tab>
                    </Tabs>
                    <div class="d-flex justify-content-end gap-2 pt-3">
                        <Button Color="ButtonColor.Secondary" Disabled="_saving" @onclick="CancelEdit">Cancelar</Button>
                        <Button Color="ButtonColor.Primary" Disabled="_saving || string.IsNullOrWhiteSpace(_editTitle)" @onclick="SaveEditAsync">
                            @if (_saving)
                            {
                                <Spinner Size="SpinnerSize.Small" Class="me-2" />
                            }
                            Salvar
                        </Button>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <h6 class="mb-0">@Issue?.Title</h6>
                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" @onclick="StartEdit" aria-label="Editar issue">
                            <Icon Name="IconName.PencilSquare" /> Editar
                        </Button>
                    </div>
                    <p class="small text-body-secondary mb-2">
                        <strong>Repositório:</strong> @RepositoryFullName
                    </p>
                    <p class="small text-body-secondary mb-2">
                        <strong>Coluna:</strong> @Issue?.Column.ToDisplayName()
                    </p>
                    <p class="small text-body-secondary mb-2">
                        <strong>Agente:</strong>
                        @if (_latestRun is null)
                        {
                            <span>Nenhum agente executou nesta issue</span>
                        }
                        else
                        {
                            <span class="agent-badge @GetAgentBadgeClass(_latestRun)">
                                <Icon Name="IconName.Robot" />@GetAgentDisplayName(_latestRun.AgentType)
                            </span>
                            <span> — @_latestRun.State</span>
                            @if (_latestRun.FinishedAt is not null)
                            {
                                <span class="d-block text-body-secondary">
                                    iniciado @_latestRun.StartedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                    · finalizado @_latestRun.FinishedAt.Value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                </span>
                            }
                            else
                            {
                                <span class="d-block text-body-secondary">
                                    iniciado @_latestRun.StartedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                </span>
                            }
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Issue?.Body))
                    {
                        <div class="markdown-body mt-3">
                            @((MarkupString)MarkdownRenderer.ToSafeHtml(Issue!.Body))
                        </div>
                    }
                    <a href="@Issue?.HtmlUrl" target="_blank" class="d-block mt-3">
                        <Icon Name="IconName.BoxArrowUpRight" class="me-1" />Abrir no GitHub
                    </a>
                    <a href="/api/vscode/open?repo=@Uri.EscapeDataString(RepositoryFullName)" target="_blank" class="d-block mt-2">
                        <Icon Name="IconName.CodeSlash" class="me-1" />Open in VS Code
                    </a>
                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <Button Color="ButtonColor.Primary" @onclick="() => _showMoveSheet = true">
                            <Icon Name="IconName.ArrowLeftRight" class="me-1" />Mover para…
                        </Button>
                    </div>
                }
            </div>
        </Content>
    </Tab>
    <Tab Title="Agent Config">
        <Content>
            @if (Issue is not null)
            {
                <AgentConfigTab Issue="Issue" RepositoryFullName="@RepositoryFullName" OnExecuted="OnAgentExecutedAsync" />
            }
        </Content>
    </Tab>
    <Tab Title="Logs do Agente">
        <Content>
            <div class="pt-3">
                @if (Issue is not null)
                {
                    <TaskLogTab IssueId="@Issue.Id.ToString(CultureInfo.InvariantCulture)" />
                }
            </div>
        </Content>
    </Tab>
    <Tab Title="Histórico">
        <Content>
            @if (Issue is not null)
            {
                <IssueHistoryTab IssueId="@Issue.Id.ToString(CultureInfo.InvariantCulture)" />
            }
        </Content>
    </Tab>
    <Tab Title="Comentários">
        <Content>
            @if (Issue is not null)
            {
                <IssueCommentsTab RepositoryFullName="@RepositoryFullName" IssueNumber="Issue.Number" />
            }
        </Content>
    </Tab>
</Tabs>

@if (_showMoveSheet && Issue is not null)
{
    <MoveIssueModal Issue="Issue"
                    FromColumn="Issue.Column"
                    OnColumnSelected="OnMoveColumnAsync"
                    OnCloseRequested="OnCloseResolutionAsync"
                    OnDismissed="() => _showMoveSheet = false" />
}

@code {
    [Parameter, EditorRequired]
    public IssueDto? Issue { get; set; }

    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    /// <summary>Disparado quando a issue mudou (move/close/edit/run) — o board recarrega.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Disparado quando um pipeline run é iniciado a partir da aba Agent Config — carrega runId + número da issue.</summary>
    [Parameter]
    public EventCallback<(string RunId, int IssueNumber)> OnAgentRunStarted { get; set; }

    private AgentRunDto? _latestRun;
    private bool _editing;
    private bool _saving;
    private bool _showMoveSheet;
    private string _editTitle = string.Empty;
    private string? _editBody;

    protected override async Task OnParametersSetAsync()
    {
        _latestRun = null;
        _editing = false;
        _showMoveSheet = false;
        if (Issue is null)
        {
            return;
        }

        try
        {
            var runs = await OrchestrationService.GetRunsAsync(
                Issue.Id.ToString(CultureInfo.InvariantCulture), take: 1);
            _latestRun = runs.FirstOrDefault();
        }
        catch
        {
            // Agent info is best-effort — the dialog still works without it.
            _latestRun = null;
        }
    }

    private void StartEdit()
    {
        _editTitle = Issue?.Title ?? string.Empty;
        _editBody = Issue?.Body;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
    }

    private async Task SaveEditAsync()
    {
        if (Issue is null || string.IsNullOrWhiteSpace(_editTitle))
        {
            return;
        }

        _saving = true;
        try
        {
            Issue = await GitHubService.UpdateIssueAsync(
                RepositoryFullName, Issue.Number, _editTitle, _editBody);
            _editing = false;
            ToastService.Notify(new(ToastType.Success, $"Issue #{Issue.Number} atualizada."));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao salvar issue: {ex.Message}"));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnMoveColumnAsync(GitHubBoardColumn column)
    {
        _showMoveSheet = false;
        if (Issue is null || column == Issue.Column || !column.HasLabel())
        {
            return;
        }

        try
        {
            Issue = await GitHubService.UpdateIssueColumnAsync(
                RepositoryFullName, Issue.Number, Issue.Column, column);
            ToastService.Notify(new(ToastType.Success, $"Issue #{Issue.Number} movida para {column.ToLabel()}."));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao mover issue: {ex.Message}"));
        }
    }

    private async Task OnCloseResolutionAsync(string resolution)
    {
        _showMoveSheet = false;
        if (Issue is null)
        {
            return;
        }

        try
        {
            Issue = await GitHubService.CloseIssueAsync(RepositoryFullName, Issue.Number, resolution);
            ToastService.Notify(new(ToastType.Success, $"Issue #{Issue.Number} fechada ({resolution})."));
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao fechar issue: {ex.Message}"));
        }
    }

    private async Task OnAgentExecutedAsync(PipelineExecutionDto? run)
    {
        await OnChanged.InvokeAsync();
        if (run is not null && Issue is not null)
        {
            await OnAgentRunStarted.InvokeAsync((run.PipelineExecutionId, Issue.Number));
        }

        if (Issue is not null)
        {
            try
            {
                var runs = await OrchestrationService.GetRunsAsync(
                    Issue.Id.ToString(CultureInfo.InvariantCulture), take: 1);
                _latestRun = runs.FirstOrDefault();
            }
            catch
            {
                // best-effort
            }
        }
    }

    private static string GetAgentBadgeClass(AgentRunDto run)
    {
        var kind = AgentCliMap.CliKindFor(run.AgentType);
        var name = (kind?.ToString() ?? run.AgentType.ToString()).ToLowerInvariant();
        var state = run.State is AgentRunState.Queued or AgentRunState.Running
            ? "agent-badge-active"
            : "agent-badge-muted";
        return $"agent-{name} {state}";
    }

    private static string GetAgentDisplayName(AgentType type)
    {
        var kind = AgentCliMap.CliKindFor(type);
        return kind is not null
            ? AgentCliMap.GetSpec(kind.Value)?.DisplayName ?? type.ToString()
            : type.ToString();
    }
}
