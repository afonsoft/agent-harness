@inject IGitHubService GitHubService
@inject ToastService ToastService

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">GitHub</h5>

        <div class="mb-3">
            <label for="github-token" class="form-label">Personal Access Token</label>
            <div class="input-group">
                <input id="github-token" type="password" class="form-control" @bind="_token" />
                <button type="button" class="btn btn-outline-secondary" @onclick="ApplyTokenAsync" aria-label="Save token">
                    <Icon Name="IconName.Save" />
                </button>
            </div>
            <div class="form-text">Use a variável de ambiente GITHUB_TOKEN ou informe o token aqui.</div>
        </div>

        <Button Color="ButtonColor.Primary" @onclick="ApplyTokenAsync" Disabled="_isApplyingToken">
            @if (_isApplyingToken)
            {
                <Spinner Size="SpinnerSize.Small" Class="me-2" />
            }
            Aplicar Token
        </Button>

        @if (_repositories is not null)
        {
            <div class="mt-3">
                <label for="repository-select" class="form-label">Repositório</label>
                <select id="repository-select" class="form-select" disabled="@_isLoading"
                        @bind="_selectedRepositoryFullName" @bind:after="OnRepositoryChanged">
                    <option value="">Selecione um repositório</option>
                    @foreach (var repository in _repositories)
                    {
                        <option value="@repository.FullName">@repository.FullName</option>
                    }
                </select>
            </div>
        }

        @if (_isLoading)
        {
            <div class="d-flex align-items-center mt-3">
                <Spinner Size="SpinnerSize.Small" Class="me-2" />
                <span>Carregando repositórios...</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">@_errorMessage</div>
        }
    </div>
</div>

@code {
    private string _token = string.Empty;
    private bool _isApplyingToken;
    private bool _isLoading;
    private string? _errorMessage;
    private IReadOnlyList<RepositoryDto>? _repositories;
    private string _selectedRepositoryFullName = string.Empty;

    [Parameter]
    public EventCallback<string> OnRepositorySelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositoriesAsync();
    }

    private async Task ApplyTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(_token))
        {
            ToastService.Notify(new(ToastType.Warning, "Informe um token válido."));
            return;
        }

        _isApplyingToken = true;
        _errorMessage = null;

        try
        {
            GitHubService.SetToken(_token);
            await LoadRepositoriesAsync();
            ToastService.Notify(new(ToastType.Success, "Token aplicado com sucesso."));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao aplicar token: {ex.Message}";
            ToastService.Notify(new(ToastType.Danger, _errorMessage));
        }
        finally
        {
            _isApplyingToken = false;
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _repositories = null;

        try
        {
            _repositories = await GitHubService.GetRepositoriesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar repositórios: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRepositoryChanged()
    {
        if (!string.IsNullOrWhiteSpace(_selectedRepositoryFullName))
        {
            await OnRepositorySelected.InvokeAsync(_selectedRepositoryFullName);
        }
    }
}
