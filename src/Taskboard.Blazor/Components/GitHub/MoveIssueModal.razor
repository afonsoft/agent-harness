@*
    SPEC-20260918-kanban-card-ux RF-007: inline overlay sheet (não usa o Modal do
    Bootstrap — empilha dentro do TaskDetailDialog sem problemas de z-index e
    funciona como bottom-sheet no mobile). Apresentacional: o chamador executa
    as chamadas de serviço.
*@
@inject ILocaleService L


<div class="move-issue-overlay" role="presentation" @onclick="DismissAsync">
    <div class="move-issue-sheet" role="dialog" aria-modal="true"
         aria-label="@L.T("move.aria", Issue?.Number)"
         @onclick:stopPropagation>
        <div class="move-issue-title">@L.T("move.title", Issue?.Number)</div>
        <div class="move-issue-columns">
            @foreach (var column in GitHubBoardColumnExtensions.LabelBackedColumns)
            {
                var isCurrent = column == FromColumn;
                <button type="button" class="move-issue-option" disabled="@isCurrent"
                        @onclick="() => SelectColumnAsync(column)">
                    <span>@column.ToDisplayName()</span>
                    @if (isCurrent)
                    {
                        <span class="move-issue-current">@L.T("common.current")</span>
                    }
                </button>
            }
        </div>
        <div class="move-issue-divider">@L.T("move.closeIssue")</div>
        <div class="d-flex gap-2">
            <Button Color="ButtonColor.Secondary" Class="flex-fill" Disabled="_busy"
                    @onclick='() => CloseAsync("canceled")'>
                <Icon Name="IconName.XCircle" class="me-1" />@L.T("common.cancel")
            </Button>
            <Button Color="ButtonColor.Secondary" Class="flex-fill" Disabled="_busy"
                    @onclick='() => CloseAsync("archived")'>
                <Icon Name="IconName.Archive" class="me-1" />@L.T("move.archive")
            </Button>
        </div>
        <Button Color="ButtonColor.Link" Class="w-100 mt-2" Disabled="_busy" @onclick="DismissAsync">
            @L.T("common.back")
        </Button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IssueDto? Issue { get; set; }

    [Parameter, EditorRequired]
    public GitHubBoardColumn FromColumn { get; set; }

    [Parameter]
    public EventCallback<GitHubBoardColumn> OnColumnSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback OnDismissed { get; set; }

    private bool _busy;

    private async Task SelectColumnAsync(GitHubBoardColumn column)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        await OnColumnSelected.InvokeAsync(column);
    }

    private async Task CloseAsync(string resolution)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        await OnCloseRequested.InvokeAsync(resolution);
    }

    private Task DismissAsync() => _busy ? Task.CompletedTask : OnDismissed.InvokeAsync();
}
