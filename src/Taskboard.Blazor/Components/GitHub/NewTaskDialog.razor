@inject IGitHubService GitHubService
@inject ToastService ToastService

<div class="mb-3">
    <label for="new-task-title" class="form-label">Título <span class="text-danger">*</span></label>
    <input id="new-task-title" type="text" class="form-control" maxlength="250" @bind="_title" @bind:event="oninput" />
    <div class="form-text">@(_title.Length)/250</div>
</div>

<div class="mb-3">
    <label class="form-label">Descrição (markdown)</label>
    <Tabs EnableFadeEffect="false">
        <Tab Title="Escrever" IsActive="true">
            <Content>
                <div class="pt-2">
                    <textarea id="new-task-body" class="form-control" rows="6" @bind="_body"
                              aria-label="Descrição da tarefa em markdown"
                              placeholder="## Contexto&#10;&#10;- item&#10;&#10;```bash&#10;comando&#10;```"></textarea>
                </div>
            </Content>
        </Tab>
        <Tab Title="Visualizar">
            <Content>
                <div class="pt-2 markdown-body new-task-preview">
                    @if (string.IsNullOrWhiteSpace(_body))
                    {
                        <span class="text-body-secondary">Nada para visualizar.</span>
                    }
                    else
                    {
                        @((MarkupString)MarkdownRenderer.ToSafeHtml(_body))
                    }
                </div>
            </Content>
        </Tab>
    </Tabs>
</div>

<div class="mb-3">
    <label for="new-task-column" class="form-label">Coluna Inicial</label>
    <select id="new-task-column" class="form-select" @bind="_initialColumn">
        @foreach (var column in GitHubBoardColumnExtensions.LabelBackedColumns)
        {
            <option value="@column">@column.ToDisplayName()</option>
        }
    </select>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <Button Color="ButtonColor.Secondary" @onclick="CancelAsync">Cancelar</Button>
    <Button Color="ButtonColor.Primary" @onclick="SubmitAsync" Disabled="_isSubmitting || string.IsNullOrWhiteSpace(_title)">
        @if (_isSubmitting)
        {
            <Spinner Size="SpinnerSize.Small" Class="me-2" />
        }
        Salvar
    </Button>
</div>

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string _title = string.Empty;
    private string? _body;
    private GitHubBoardColumn _initialColumn = GitHubBoardColumn.Backlog;
    private bool _isSubmitting;

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            await GitHubService.CreateIssueAsync(RepositoryFullName, _title, _body, _initialColumn);
            ToastService.Notify(new(ToastType.Success, "Issue criada com sucesso."));
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao criar issue: {ex.Message}"));
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
