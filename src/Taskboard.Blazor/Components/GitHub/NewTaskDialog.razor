@inject IGitHubService GitHubService
@inject ToastService ToastService
@inject ILocaleService L

<div class="mb-3">
    <label for="new-task-title" class="form-label">@L.T("newtask.title") <span class="text-danger">*</span></label>
    <input id="new-task-title" type="text" class="form-control" maxlength="250" @bind="_title" @bind:event="oninput" />
    <div class="form-text">@(_title.Length)/250</div>
</div>

<div class="mb-3">
    <label class="form-label">@L.T("newtask.description")</label>
    <Tabs EnableFadeEffect="false">
        <Tab Title="@L.T("common.write")" IsActive="true">
            <Content>
                <div class="pt-2">
                    <textarea id="new-task-body" class="form-control" rows="6" @bind="_body"
                              aria-label="@L.T("newtask.descAria")"
                              placeholder="@L.T("newtask.descPlaceholder")"></textarea>
                </div>
            </Content>
        </Tab>
        <Tab Title="@L.T("common.preview")">
            <Content>
                <div class="pt-2 markdown-body new-task-preview">
                    @if (string.IsNullOrWhiteSpace(_body))
                    {
                        <span class="text-body-secondary">@L.T("newtask.nothingToPreview")</span>
                    }
                    else
                    {
                        @((MarkupString)MarkdownRenderer.ToSafeHtml(_body))
                    }
                </div>
            </Content>
        </Tab>
    </Tabs>
</div>

<div class="mb-3">
    <label for="new-task-column" class="form-label">@L.T("newtask.column")</label>
    <select id="new-task-column" class="form-select" @bind="_initialColumn">
        @foreach (var column in GitHubBoardColumnExtensions.LabelBackedColumns)
        {
            <option value="@column">@column.ToDisplayName()</option>
        }
    </select>
</div>

<div class="d-flex justify-content-end gap-2 pt-3 border-top">
    <Button Color="ButtonColor.Secondary" @onclick="CancelAsync">@L.T("common.cancel")</Button>
    <Button Color="ButtonColor.Primary" @onclick="SubmitAsync" Disabled="_isSubmitting || string.IsNullOrWhiteSpace(_title)">
        @if (_isSubmitting)
        {
            <Spinner Size="SpinnerSize.Small" Class="me-2" />
        }
        @L.T("common.save")
    </Button>
</div>

@code {
    [Parameter, EditorRequired]
    public string RepositoryFullName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string _title = string.Empty;
    private string? _body;
    private GitHubBoardColumn _initialColumn = GitHubBoardColumn.Backlog;
    private bool _isSubmitting;

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            await GitHubService.CreateIssueAsync(RepositoryFullName, _title, _body, _initialColumn);
            await ToastService.NotifyAsync(new(ToastType.Success, L.T("newtask.created")));
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, L.T("newtask.createError", ex.Message)));
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
