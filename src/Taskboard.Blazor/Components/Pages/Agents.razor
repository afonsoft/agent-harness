@page "/agents"
@attribute [Authorize]
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAgentPromptTemplateService PromptTemplateService
@inject ILocaleService L
@inject ToastService ToastService

<PageTitle>CLI Agents - Harness</PageTitle>

<Modal @ref="_installModal" Size="ModalSize.Large" Fullscreen="ModalFullscreen.SmallDown" IsScrollable="true" />
<Modal @ref="_modelsModal" Fullscreen="ModalFullscreen.SmallDown" />

<h1 class="h4 fw-bold mb-1">CLI Agents</h1>
<p class="small text-body-secondary mb-4">Agent CLIs detected on this machine. Open a terminal to authenticate or manage each CLI.</p>

@* SPEC-20261010-agents-page-tabs RF-001: abas Dashboard/Sessions/CLI Agents/Prompt
   — mesmo modelo ARIA/keyboard/deep-link (?tab=) do Settings. *@
<nav class="settings-tabs nav nav-tabs mb-4 pb-0 border-bottom flex-nowrap overflow-auto" role="tablist" aria-label="Agent sections" @onkeydown="OnTabsKeyDown">
    @foreach (var tab in AgentsTabs)
    {
        var id = tab.Id;
        <button type="button" role="tab" class="nav-link text-nowrap @(id == _activeTab ? "active" : "")"
                aria-selected="@(id == _activeTab ? "true" : "false")" tabindex="@(id == _activeTab ? 0 : -1)"
                data-tab="@id" @onclick="() => SelectTab(id)">
            @tab.Label
        </button>
    }
</nav>

<div class="tab-pane" role="tabpanel" aria-label="Dashboard" hidden="@(_activeTab != "dashboard")">
@* SPEC-20261006 RF-001: agent dashboard — attention columns built from
   delegation tasks, live runs and the mailbox. *@
<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 fw-semibold mb-0">Agent Dashboard</h2>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="LoadDashboardAsync" Disabled="_boardLoading">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
        </div>
        @* SPEC-20261020-agent-board-v2 RF-004/RF-005: toolbar filters + show-idle. *@
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <input class="form-control form-control-sm" style="max-width:220px"
                   placeholder="Search title, preview, repo…" aria-label="Filter board"
                   @bind="_boardQuery" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
            <select class="form-select form-select-sm" style="max-width:140px" aria-label="Filter by CLI"
                    @bind="_boardCli" @bind:after="OnFilterChangedAsync">
                <option value="">All CLIs</option>
                @foreach (var c in _knownClis.OrderBy(x => x))
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select class="form-select form-select-sm" style="max-width:150px" aria-label="Filter by state"
                    @bind="_boardState" @bind:after="OnFilterChangedAsync">
                <option value="">All states</option>
                @foreach (var s in Enum.GetNames<AgentAttentionState>())
                {
                    <option value="@s">@s</option>
                }
            </select>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="board-haspr"
                       @bind="_boardHasPr" @bind:after="OnFilterChangedAsync" />
                <label class="form-check-label small" for="board-haspr">Has PR</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="board-idle"
                       @bind="_showIdle" @bind:after="OnShowIdleChangedAsync" />
                <label class="form-check-label small" for="board-idle">
                    Show idle@(_board is null || _showIdle ? "" : $" ({_board.Idle.Count})")
                </label>
            </div>
            @if (FiltersActive())
            {
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0"
                        @onclick="ClearFiltersAsync">Clear</Button>
            }
            <span class="ms-auto small text-body-secondary">
                @((_board?.UnreadTotal ?? 0) == 0 ? "" : $"{_board!.UnreadTotal} unread")
            </span>
        </div>
        @if (_board is null)
        {
            <p class="small text-body-secondary mb-0">
                @(_boardLoading ? "Loading…" : "No delegation activity yet — delegate work from the AI Code chat (delegate_task/delegate_fanout).")
            </p>
        }
        else
        {
            @* SPEC-20261009 RF-004: merged activity feed above the columns. *@
            @if (_events.Count > 0)
            {
                <ul class="list-unstyled small mb-3 pb-2 border-bottom" style="max-height: 180px; overflow-y: auto;">
                    @foreach (var ev in _events)
                    {
                        <li class="d-flex align-items-baseline gap-2 mb-1">
                            <Badge Color="@EventBadge(ev.Kind)" Class="flex-shrink-0">@ev.Kind</Badge>
                            <span class="text-truncate" title="@ev.Text">@ev.Text</span>
                            <span class="text-body-secondary flex-shrink-0 ms-auto">@ev.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        </li>
                    }
                </ul>
            }
            <div class="row g-3">
                @foreach (var (title, color, items) in BoardColumns())
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded p-2 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-semibold small">@title</span>
                                <Badge Color="@color">@items.Count</Badge>
                            </div>
                            @if (items.Count == 0)
                            {
                                <p class="small text-body-secondary mb-0">—</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var card in items)
                                    {
                                        <li class="mb-2 rounded p-2 @CardTint(card)" role="button" tabindex="0"
                                            @key="card.Id" @onclick="() => OpenCardAsync(card)"
                                            @onkeydown="e => OnCardKeyDown(e, card)">
                                            <div class="d-flex align-items-center gap-2">
                                                <Badge Color="@AttentionBadge(card.State)">@card.State</Badge>
                                                <span class="fw-semibold text-truncate">@card.SessionTitle</span>
                                                @if (card.Unread)
                                                {
                                                    <span class="badge rounded-pill bg-primary ms-auto" title="unread">●</span>
                                                }
                                                <span class="text-body-secondary ms-auto small">@card.CliName</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(card.PreviewText))
                                            {
                                                <div class="text-body-secondary text-truncate mt-1" title="@card.PreviewText">@card.PreviewText</div>
                                            }
                                            <div class="d-flex gap-2 mt-1 align-items-center">
                                                @if (!string.IsNullOrEmpty(card.RepoName))
                                                {
                                                    <Badge Color="BadgeColor.Secondary">@card.RepoName</Badge>
                                                }
                                                @if (!string.IsNullOrEmpty(card.FanoutGroupId))
                                                {
                                                    <span @onclick:stopPropagation="true">
                                                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0"
                                                                @onclick="() => OpenCompareAsync(card.FanoutGroupId)">
                                                            <Icon Name="IconName.ColumnsGap" class="me-1" />Compare legs
                                                        </Button>
                                                    </span>
                                                }
                                                @if (card.PrUrl is not null)
                                                {
                                                    <a href="@card.PrUrl" target="_blank" rel="noopener"
                                                       class="small" @onclick:stopPropagation="true">PR ↗</a>
                                                }
                                            </div>
                                            @if (card.Kind == "scope")
                                            {
                                                @foreach (var item in ScopeMailboxItems())
                                                {
                                                    <div class="border rounded p-2 mt-1 bg-body" @onclick:stopPropagation="true">
                                                        <div class="text-truncate" title="@item.Detail">@item.Title</div>
                                                        @if (_openReplyId == item.Id)
                                                        {
                                                            <textarea class="form-control form-control-sm mt-1" rows="2"
                                                                      placeholder="Reply to the agent…"
                                                                      @bind="_replyText"></textarea>
                                                            <div class="d-flex gap-2 mt-1">
                                                                <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                                                                        Disabled="@(_mailboxBusy || string.IsNullOrWhiteSpace(_replyText))"
                                                                        @onclick="() => SendReplyAsync(item.Id)">
                                                                    @(_mailboxBusy ? "Sending…" : "Reply")
                                                                </Button>
                                                                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                                                                        @onclick="() => _openReplyId = null">Cancel</Button>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(_mailboxError))
                                                            {
                                                                <div class="text-danger small mt-1">@_mailboxError</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex gap-2 mt-1">
                                                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small"
                                                                        @onclick="() => { _openReplyId = item.Id; _replyText = string.Empty; _mailboxError = null; }">
                                                                    Reply
                                                                </Button>
                                                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small"
                                                                        Disabled="_mailboxBusy"
                                                                        @onclick="() => DismissMailboxAsync(item.Id)">
                                                                    Dismiss
                                                                </Button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* SPEC-20261007 RF-004: fan-out compare — per-leg diffstat + bounded patch. *@
<Modal @ref="_compareModal" Title="Fan-out compare" Size="ModalSize.Large"
       Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_compareLoading)
        {
            <p class="small text-body-secondary mb-0">Loading diffs…</p>
        }
        else if (_compareLegs.Count == 0)
        {
            <p class="small text-body-secondary mb-0">No legs found for this fan-out group.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>CLI</th>
                            <th>Status</th>
                            <th class="text-end">Files</th>
                            <th class="text-end">+/−</th>
                            <th>Worktree</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leg in _compareLegs)
                        {
                            <tr>
                                <td>@leg.CliName</td>
                                <td>@leg.Status</td>
                                <td class="text-end">@(leg.Files?.FilesChanged.ToString() ?? "—")</td>
                                <td class="text-end">
                                    @if (leg.Files is not null)
                                    {
                                        <span class="text-success">+@leg.Files.Insertions</span>@(" ")
                                        <span class="text-danger">−@leg.Files.Deletions</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">—</span>
                                    }
                                </td>
                                <td class="small text-body-secondary">
                                    @(leg.Note ?? (leg.WorktreeRunId is null ? "—" : $"run {leg.WorktreeRunId[..Math.Min(8, leg.WorktreeRunId.Length)]}"))
                                </td>
                                <td>
                                    @* SPEC-20261009 RF-002: pick winner — commit + push the leg's branch. *@
                                    @if (leg.WorktreeRunId is not null)
                                    {
                                        if (_promoted.TryGetValue(leg.TaskId, out var promoted))
                                        {
                                            <Badge Color="BadgeColor.Success" title="@promoted.CommitSha"
                                                   style="max-width:12rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;vertical-align:middle">
                                                @promoted.Branch</Badge>
                                            @if (!string.IsNullOrWhiteSpace(promoted.PullRequestUrl))
                                            {
                                                <a href="@promoted.PullRequestUrl" target="_blank" rel="noopener noreferrer"
                                                   class="small d-block">@L.T("agents.compare.openPr")</a>
                                            }
                                        }
                                        else
                                        {
                                            <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small"
                                                    Disabled="@(_promotingId is not null)"
                                                    @onclick="() => PromoteLegAsync(leg)">
                                                @(_promotingId == leg.TaskId ? "…" : L.T("agents.compare.useLeg"))
                                            </Button>
                                            @* SPEC-20261004-promote-leg-pr: repo-backed legs can open the PR in one shot. *@
                                            @if (leg.RepositoryPath is not null)
                                            {
                                                <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small"
                                                        Class="ms-1"
                                                        Disabled="@(_promotingId is not null)"
                                                        @onclick="() => PromoteLegAsync(leg, createPr: true)">
                                                    @(_promotingId == leg.TaskId ? "…" : L.T("agents.compare.useLegPr"))
                                                </Button>
                                            }
                                        }
                                        @if (_promoteError.TryGetValue(leg.TaskId, out var perr))
                                        {
                                            <div class="text-danger small">@perr</div>
                                        }
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(leg.Patch))
                            {
                                <tr>
                                    <td colspan="6" class="p-0">
                                        <details>
                                            <summary class="small text-body-secondary px-2 py-1">Patch (@leg.Patch.Length chars)</summary>
                                            <pre class="small bg-body-tertiary p-2 mb-0 overflow-auto" style="max-height: 320px;">@leg.Patch</pre>
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                @onclick="() => _compareModal.HideAsync()">Close</Button>
    </FooterTemplate>
</Modal>

@* SPEC-20261006 RF-002/RF-003: resumable on-disk CLI sessions. *@
</div>

<div class="tab-pane" role="tabpanel" aria-label="Sessions" hidden="@(_activeTab != "sessions")">
<div class="card">
    <div class="card-body">
        @* RF-003: picker primeiro — só depois de escolher o CLI a tabela aparece
           (últimas 30 via ?take=30). Custom defs não têm store scaneado → chips
           desabilitados com tooltip. *@
        <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Session source CLI">
            @foreach (var src in SessionSources)
            {
                var id = src;
                <button type="button" class="btn btn-sm @(id == _selectedCli ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(id == _selectedCli ? "true" : "false")" data-cli="@id"
                        @onclick="() => SelectSessionCliAsync(id)">@id</button>
            }
            @foreach (var def in _customDefs)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                        title="Session store not scanned for this CLI">@def.DisplayName</button>
            }
        </div>

        <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 fw-semibold mb-0">CLI Sessions</h2>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="LoadSessionsAsync" Disabled="_sessionsLoading || _selectedCli is null">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
        </div>
        @if (_selectedCli is null)
        {
            <p class="small text-body-secondary mb-0">Select a CLI above to list its on-disk sessions (last 30).</p>
        }
        else if (_sessions.Count == 0)
        {
            <p class="small text-body-secondary mb-0">
                @(_sessionsLoading ? "Scanning transcripts…" : $"No on-disk sessions found for '{_selectedCli}' under $HOME.")
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>CLI</th>
                            <th>Session</th>
                            <th>Directory</th>
                            <th>Modified</th>
                            <th class="text-end">Resume</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in _sessions)
                        {
                            <tr @key="session.SourcePath">
                                <td class="fw-semibold">@session.Cli</td>
                                <td class="small"><code>@session.SessionId</code></td>
                                <td class="small text-body-secondary text-truncate" style="max-width: 24rem;" title="@session.SourcePath">
                                    @(session.WorkingDirectory ?? session.SourcePath)
                                </td>
                                <td class="small">@session.ModifiedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    @if (session.ResumeCommand is not null)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@TerminalUrl(session.ResumeCommand)"
                                           title="@session.ResumeCommand">
                                            <Icon Name="IconName.Play" class="me-1" /> Resume
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
</div>

<div class="tab-pane" role="tabpanel" aria-label="CLI Agents" hidden="@(_activeTab != "cli-agents")">
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
            @if (_refreshingProbes)
            {
                <span class="small text-body-secondary d-inline-flex align-items-center me-auto">
                    <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" class="me-1" /> Updating CLI info…
                </span>
            }
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="SyncMetricsAsync" Disabled="_syncing">
                @if (_syncing)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                else
                {
                    <Icon Name="IconName.CloudArrowDown" class="me-1" />
                }
                Sync now
            </Button>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="RefreshAllAsync" Disabled="_loading">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
        </div>

        @if (_loading && _agents is null)
        {
            <Loading Message="Detecting agent CLIs…" />
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <Alert Color="AlertColor.Danger" Dismissable="false">
                <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />@_error
            </Alert>
        }
        else if (_agents is { Count: > 0 })
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>CLI</th>
                            <th>Binary</th>
                            <th>Installed</th>
                            <th>Version</th>
                            <th>Auth</th>
                            <th>Config dir</th>
                            <th title="Sessions ingested from the local CLI database (last 7 days)">Sessions 7d</th>
                            <th>Tokens</th>
                            <th>Last activity</th>
                            <th>Metrics DB</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in _agents)
                        {
                            <tr>
                                <td class="fw-semibold">@agent.DisplayName</td>
                                <td><code>@agent.Binary</code></td>
                                <td>
                                    @if (agent.Installed)
                                    {
                                        <Badge Color="BadgeColor.Success">Installed</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Secondary">Not found</Badge>
                                    }
                                </td>
                                <td class="small">@(agent.Version ?? "—")</td>
                                <td>
                                    @switch (agent.AuthStatus)
                                    {
                                        case AgentCliAuthStatus.Authenticated:
                                            <Badge Color="BadgeColor.Success">Authenticated</Badge>
                                            break;
                                        case AgentCliAuthStatus.NotAuthenticated:
                                            <Badge Color="BadgeColor.Warning">Not authenticated</Badge>
                                            break;
                                        default:
                                            <Badge Color="BadgeColor.Secondary">Unknown</Badge>
                                            break;
                                    }
                                </td>
                                <td class="small"><code>@agent.ConfigDir</code></td>
                                <td class="small">@SessionsFor(agent)</td>
                                <td class="small">@TokensFor(agent)</td>
                                <td class="small">@LastActivityFor(agent)</td>
                                <td>
                                    @{
                                        var (badgeColor, badgeLabel) = SourceBadgeFor(agent);
                                    }
                                    <Badge Color="badgeColor">@badgeLabel</Badge>
                                </td>
                                <td class="text-end">
                                    @if (agent.Installed)
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="@TerminalUrl(agent.LoginCommand)">
                                                <Icon Name="IconName.Terminal" class="me-1" /> Login
                                            </a>
                                            @if (SupportsModelSelection(agent))
                                            {
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        title="Configurar modelos Lite/Normal/Ultra"
                                                        @onclick="() => StartModelConfigAsync(agent)">
                                                    <Icon Name="IconName.Gear" class="me-1" /> Models
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(!agent.PrerequisiteMet)"
                                                title="@InstallButtonTitle(agent)"
                                                @onclick="() => StartInstallAsync(agent)">
                                            <Icon Name="IconName.Download" class="me-1" /> Install
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-body-secondary mt-3 mb-0">
                <Icon Name="IconName.InfoCircle" class="me-1" />
                Auth status is detected by the presence of credential files — contents are never read. Commands are typed into the terminal, not executed automatically.
            </p>
        }
    </div>
</div>

@* SPEC-20260928-ai-code-generic-cli RF-002: user-declared CLIs persisted via
   /api/agents/custom — usable as AI Code threads (chat when acp, terminal
   otherwise). *@
<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <h2 class="h6 fw-semibold mb-0">Custom CLIs</h2>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => EditCustomCli(null)">
                <Icon Name="IconName.PlusSquare" class="me-1" /> Add CLI
            </Button>
        </div>
        <p class="small text-body-secondary">
            Declare any agent CLI installed on this host — it appears in the AI Code picker.
            <code>{model}</code> in the args template is replaced by the thread model.
        </p>
        @if (_customDefs.Count == 0)
        {
            <p class="small text-body-secondary mb-0">No custom CLIs yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Executable</th>
                            <th>Args</th>
                            <th>Transport</th>
                            <th>On PATH</th>
                            <th>Enabled</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var def in _customDefs)
                        {
                            <tr>
                                <td class="fw-semibold">@def.DisplayName</td>
                                <td><code>@def.Executable</code></td>
                                <td class="small"><code>@def.ArgsTemplate</code></td>
                                <td><Badge Color="BadgeColor.Secondary">@def.Transport</Badge></td>
                                <td>
                                    @if (def.Resolved)
                                    {
                                        <Badge Color="BadgeColor.Success">found</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Warning">not found</Badge>
                                    }
                                </td>
                                <td>
                                    @if (def.Enabled)
                                    {
                                        <Badge Color="BadgeColor.Success">on</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Secondary">off</Badge>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="Edit"
                                                @onclick="() => EditCustomCli(def)">
                                            <Icon Name="IconName.PencilSquare" />
                                        </button>
                                        @if (_deleteDefId == def.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteCustomCliAsync(def)">Delete</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _deleteDefId = null">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-link text-danger" title="Delete"
                                                    @onclick="() => _deleteDefId = def.Id">
                                                <Icon Name="IconName.Trash" />
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<Modal @ref="_customCliModal" Title="@(_editingDef is null ? "Add custom CLI" : $"Edit {_editingDef.DisplayName}")" Fullscreen="ModalFullscreen.SmallDown">
    <BodyTemplate>
        <div class="mb-2">
            <label class="form-label small mb-1">Display name</label>
            <input class="form-control form-control-sm" @bind="_defFormName" placeholder="My agent CLI" />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Executable (binary name or absolute path)</label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormExecutable" placeholder="mycli" />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Args template <span class="text-body-secondary">(tokens: {model}, {prompt})</span></label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormArgs" placeholder="--acp {model}" />
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small mb-1">Transport</label>
                <select class="form-select form-select-sm" @bind="_defFormTransport">
                    <option value="pty">pty (raw terminal)</option>
                    <option value="acp">acp (structured — CLI must implement ACP)</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small mb-1">Model flag <span class="text-body-secondary">(optional)</span></label>
                <input class="form-control form-control-sm font-monospace" @bind="_defFormModelFlag" placeholder="--model" />
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small mb-1">Prompt delivery <span class="text-body-secondary">(delegated runs)</span></label>
                <select class="form-select form-select-sm" @bind="_defFormPromptDelivery">
                    <option value="argv">argv — {prompt} in args, or appended</option>
                    <option value="stdin">stdin — piped when template has no {prompt}</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small mb-1">Model list args <span class="text-body-secondary">(optional)</span></label>
                <input class="form-control form-control-sm font-monospace" @bind="_defFormModelListArgs" placeholder="models list" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Version args</label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormVersionArgs" placeholder="--version" />
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="def-enabled" @bind="_defFormEnabled" />
            <label class="form-check-label small" for="def-enabled">Enabled — visible in the AI Code picker</label>
        </div>
        @if (!string.IsNullOrEmpty(_defFormError))
        {
            <Alert Color="AlertColor.Danger" Dismissable="false" class="py-1 mt-2 small">@_defFormError</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => _customCliModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SaveCustomCliAsync" Disabled="_defSaving">
            @if (_defSaving)
            {
                <Spinner Size="SpinnerSize.Small" Class="me-1" />
            }
            Save
        </Button>
    </FooterTemplate>
</Modal>
</div>

<div class="tab-pane" role="tabpanel" aria-label="Prompt" hidden="@(_activeTab != "prompt")">
<div class="card">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-1">Default agent prompt</h2>
        <p class="small text-body-secondary">
            Preenche o prompt da aba <em>Agent Config</em> de cada issue. Placeholders:
            <code>{repoUrl}</code> (URL de clone), <code>{issueTitle}</code>, <code>{issueBody}</code>,
            <code>{issueComments}</code> (comentários do GitHub — handoff entre agentes).
        </p>
        <textarea class="form-control font-monospace" rows="14" @bind="_template"
                  placeholder="@_builtinTemplate" disabled="@_templateLoading"></textarea>
        <div class="d-flex align-items-center gap-2 mt-2">
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SaveTemplateAsync" Disabled="_templateLoading">
                @if (_templateSaving)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                Salvar prompt
            </Button>
            @if (_templateCustomized)
            {
                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ResetTemplateAsync" Disabled="_templateLoading">
                    Restaurar padrão
                </Button>
            }
            @if (_templateCustomized)
            {
                <Badge Color="BadgeColor.Info">customizado</Badge>
            }
        </div>
    </div>
</div>
</div>

@code {
    private Modal _installModal = default!;
    private Modal _modelsModal = default!;
    private IReadOnlyList<AgentCliStatus>? _agents;
    private CliMetricsSummaryDto? _metrics;
    private IReadOnlyList<CliMetricSourceDto> _sources = [];
    private bool _loading = true;
    private bool _syncing;
    private bool _refreshingProbes;
    private string? _error;

    // SPEC-20260928-ai-code-generic-cli RF-002: custom CLI CRUD state.
    private IReadOnlyList<AgentCliDefinitionDto> _customDefs = [];
    private Modal _customCliModal = default!;
    private AgentCliDefinitionDto? _editingDef;
    private string? _deleteDefId;
    private string _defFormName = string.Empty;
    private string _defFormExecutable = string.Empty;
    private string _defFormArgs = string.Empty;
    private string _defFormTransport = "pty";
    private string _defFormModelFlag = string.Empty;
    private string _defFormPromptDelivery = "argv";
    private string _defFormModelListArgs = string.Empty;
    private string _defFormVersionArgs = "--version";
    private bool _defFormEnabled = true;
    private string? _defFormError;
    private bool _defSaving;

    private string _template = string.Empty;
    private string _builtinTemplate = string.Empty;
    private bool _templateLoading;
    private bool _templateSaving;
    private bool _templateCustomized;

    // SPEC-20261006: agent dashboard + resumable CLI sessions.
    private AgentDashboardDto? _dashboard;
    // SPEC-20261020-agent-board-v2: kanban cards from the attention model.
    private AgentBoardSnapshot? _board;
    private bool _boardLoading = true;
    private const string ShowIdleStorageKey = "agent-board:show-idle";
    private string? _boardQuery;
    private string? _boardCli;
    private string? _boardState;
    private bool _boardHasPr;
    // RF-005: default hides the Idle column — toggle persists per browser.
    private bool _showIdle;
    private readonly HashSet<string> _knownClis = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _filterDebounce;
    private IReadOnlyList<AgentSessionInfoDto> _sessions = [];
    private bool _sessionsLoading;

    // SPEC-20261010-agents-page-tabs RF-001/RF-003: tabs + picker-first sessions.
    private static readonly (string Id, string Label)[] AgentsTabs =
    [
        ("dashboard", "Dashboard"),
        ("sessions", "Sessions"),
        ("cli-agents", "CLI Agents"),
        ("prompt", "Prompt"),
    ];
    private string _activeTab = "dashboard";

    // Sources scanned by AgentSessionScanner.Include (same slugs `?cli=` uses).
    private static readonly string[] SessionSources =
        ["claude", "codex", "opencode", "gemini", "agy", "devin"];
    private const int SessionsTake = 30;
    private string? _selectedCli;

    // SPEC-20261007 RF-001/RF-004: mailbox replies + fan-out compare modal.
    private string? _openReplyId;
    private string _replyText = string.Empty;
    private bool _mailboxBusy;
    private string? _mailboxError;
    private Modal _compareModal = default!;
    private IReadOnlyList<FanoutCompareLegDto> _compareLegs = [];
    private bool _compareLoading;

    // SPEC-20261009 RF-002/RF-004: promote winner + activity feed.
    private string? _promotingId;
    private readonly Dictionary<string, TaskboardClient.PromoteResultDto> _promoted = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _promoteError = new(StringComparer.Ordinal);
    private IReadOnlyList<DelegationEventDto> _events = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            RefreshAsync(), LoadTemplateAsync(), LoadCustomDefsAsync(),
            LoadDashboardAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ?tab= / ?cli= deep link — refresh/URL preserva aba e CLI escolhido.
        if (!firstRender)
        {
            return;
        }

        var tab = ResolveQueryValue("tab");
        if (tab is not null && AgentsTabs.Any(t => t.Id == tab))
        {
            _activeTab = tab;
        }

        var cli = ResolveQueryValue("cli");
        if (cli is not null && SessionSources.Contains(cli, StringComparer.OrdinalIgnoreCase))
        {
            _selectedCli = SessionSources.First(s =>
                string.Equals(s, cli, StringComparison.OrdinalIgnoreCase));
            await LoadSessionsAsync();
        }

        // RF-004/RF-005: deep-linkable filters + persisted show-idle toggle.
        _boardQuery = ResolveQueryValue("q");
        _boardCli = ResolveQueryValue("cli") is { Length: > 0 } q && _activeTab == "dashboard"
            ? q : _boardCli;
        _boardState = ResolveQueryValue("state");
        _boardHasPr = string.Equals(ResolveQueryValue("hasPr"), "true", StringComparison.OrdinalIgnoreCase);
        try
        {
            _showIdle = "1" == await JS.InvokeAsync<string?>(
                "localStorage.getItem", ShowIdleStorageKey);
        }
        catch (JSException) { }
        if (FiltersActive())
        {
            await LoadDashboardAsync();
        }

        StateHasChanged();
    }

    private string? ResolveQueryValue(string name)
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Length <= 1)
        {
            return null;
        }

        return query[1..].Split('&')
            .Select(pair => pair.Split('=', 2))
            .Where(pair => pair.Length == 2 && pair[0] == name)
            .Select(pair => Uri.UnescapeDataString(pair[1]))
            .FirstOrDefault();
    }

    private void SelectTab(string id)
    {
        _activeTab = id;
        var query = id == "sessions" && _selectedCli is not null
            ? $"?tab={id}&cli={_selectedCli}"
            : $"?tab={id}";
        Navigation.NavigateTo($"/agents{query}", replace: true);
    }

    /// <summary>WAI-ARIA tabs keyboard model: ←/→ cycle, Home/End jump.</summary>
    private void OnTabsKeyDown(KeyboardEventArgs e)
    {
        var index = Array.FindIndex(AgentsTabs, t => t.Id == _activeTab);
        if (index < 0)
        {
            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % AgentsTabs.Length,
            "ArrowLeft" => (index - 1 + AgentsTabs.Length) % AgentsTabs.Length,
            "Home" => 0,
            "End" => AgentsTabs.Length - 1,
            _ => index,
        };

        if (next != index)
        {
            SelectTab(AgentsTabs[next].Id);
        }
    }

    private async Task SelectSessionCliAsync(string cli)
    {
        _selectedCli = cli;
        Navigation.NavigateTo($"/agents?tab=sessions&cli={cli}", replace: true);
        await LoadSessionsAsync();
    }

    // RF-005: debounced so typing does not fire a request per keystroke.
    private async Task OnFilterChangedAsync()
    {
        _filterDebounce?.Cancel();
        _filterDebounce?.Dispose();
        _filterDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _filterDebounce.Token);
            await LoadDashboardAsync();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnShowIdleChangedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                ShowIdleStorageKey, _showIdle ? "1" : "0");
        }
        catch (JSException) { }
    }

    private bool FiltersActive() =>
        !string.IsNullOrWhiteSpace(_boardQuery) || !string.IsNullOrWhiteSpace(_boardCli)
        || !string.IsNullOrWhiteSpace(_boardState) || _boardHasPr;

    private async Task ClearFiltersAsync()
    {
        _boardQuery = _boardCli = _boardState = null;
        _boardHasPr = false;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _boardLoading = true;
        try
        {
            _board = await Client.GetAgentBoardAsync(
                q: _boardQuery, cli: _boardCli, state: _boardState, hasPr: _boardHasPr);
            foreach (var card in _board is null
                ? Enumerable.Empty<AgentBoardCard>()
                : _board.NeedsYou.Concat(_board.Working).Concat(_board.Done).Concat(_board.Idle))
            {
                _knownClis.Add(card.CliName);
            }
            _dashboard = await Client.GetDelegationDashboardAsync();
            _events = await Client.GetDelegationEventsAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _board = null;
            _dashboard = null;
            _events = [];
        }
        finally
        {
            _boardLoading = false;
        }
    }

    private Task OnCardKeyDown(KeyboardEventArgs e, AgentBoardCard card) =>
        e.Key is "Enter" or " " ? OpenCardAsync(card) : Task.CompletedTask;

    /// <summary>SPEC-20261020 RF-006: card click → mark read + deep-link.</summary>
    private async Task OpenCardAsync(AgentBoardCard card)
    {
        _ = Client.MarkAgentBoardCardReadAsync(card.Id);
        if (!string.IsNullOrWhiteSpace(card.DeepLink) && card.Kind != "scope")
        {
            Navigation.NavigateTo(card.DeepLink);
        }
    }

    /// <summary>Mailbox items behind the scope card's Needs You entry.</summary>
    private IEnumerable<DashboardItemDto> ScopeMailboxItems() =>
        _dashboard?.NeedsYou.Where(i => i.Kind == "mailbox") ?? [];

    private IEnumerable<(string Title, BadgeColor Color, IReadOnlyList<AgentBoardCard> Items)> BoardColumns()
    {
        if (_board is null)
        {
            yield break;
        }

        yield return ("Needs You", BadgeColor.Danger, _board.NeedsYou);
        yield return ("Working", BadgeColor.Primary, _board.Working);
        yield return ("Done", BadgeColor.Success, _board.Done);
        // RF-005: Idle is collapsed by the toolbar toggle (persisted per-browser).
        if (_showIdle)
            yield return ("Idle", BadgeColor.Secondary, _board.Idle);
    }

    private static BadgeColor AttentionBadge(AgentAttentionState state) => state switch
    {
        AgentAttentionState.WaitingYou => BadgeColor.Warning,
        AgentAttentionState.Blocked => BadgeColor.Danger,
        AgentAttentionState.Done => BadgeColor.Success,
        AgentAttentionState.Working => BadgeColor.Primary,
        AgentAttentionState.Idle => BadgeColor.Secondary,
        AgentAttentionState.Exited => BadgeColor.Dark,
        AgentAttentionState.Unverifiable => BadgeColor.Light,
        _ => BadgeColor.Secondary,
    };

    /// <summary>RF-008 tint: Needs You amber, fresh Done green.</summary>
    private static string CardTint(AgentBoardCard card) => card.State switch
    {
        AgentAttentionState.WaitingYou or AgentAttentionState.Blocked =>
            "border border-warning bg-warning-subtle",
        AgentAttentionState.Done when card.PreviewAtUtc is { } at
            && DateTime.UtcNow - at < TimeSpan.FromMinutes(15) =>
            "border border-success bg-success-subtle",
        _ => "border bg-body-tertiary",
    };

    private async Task PromoteLegAsync(FanoutCompareLegDto leg, bool createPr = false)
    {
        _promotingId = leg.TaskId;
        _promoteError.Remove(leg.TaskId);
        try
        {
            var (result, error) = await Client.PromoteDelegationTaskAsync(
                leg.TaskId, createPr: createPr);
            if (result is not null)
            {
                _promoted[leg.TaskId] = result;
            }
            else
            {
                _promoteError[leg.TaskId] = error ?? "promote failed";
            }
        }
        finally
        {
            _promotingId = null;
        }
    }

    private static BadgeColor EventBadge(string kind) => kind switch
    {
        "escalation" or "decision" => BadgeColor.Danger,
        "worker_done" or "task_done" => BadgeColor.Success,
        "task_failed" or "task_stale" or "task_cancelled" => BadgeColor.Warning,
        "heartbeat" => BadgeColor.Secondary,
        _ => BadgeColor.Primary,
    };

    private async Task LoadSessionsAsync()
    {
        if (_selectedCli is null)
        {
            _sessions = [];
            return;
        }

        _sessionsLoading = true;
        try
        {
            _sessions = await Client.GetAgentSessionsAsync(_selectedCli, take: SessionsTake);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _sessions = [];
        }
        finally
        {
            _sessionsLoading = false;
        }
    }

    private async Task SendReplyAsync(string messageId)
    {
        _mailboxBusy = true;
        _mailboxError = null;
        try
        {
            _mailboxError = await Client.ReplyMailboxAsync(messageId, _replyText);
            if (_mailboxError is null)
            {
                _openReplyId = null;
                await LoadDashboardAsync();
            }
        }
        finally
        {
            _mailboxBusy = false;
        }
    }

    private async Task DismissMailboxAsync(string messageId)
    {
        _mailboxBusy = true;
        try
        {
            _mailboxError = await Client.DismissMailboxAsync(messageId);
            if (_mailboxError is null)
            {
                await LoadDashboardAsync();
            }
        }
        finally
        {
            _mailboxBusy = false;
        }
    }

    private async Task OpenCompareAsync(string groupId)
    {
        _compareLoading = true;
        _compareLegs = [];
        await _compareModal.ShowAsync();
        try
        {
            _compareLegs = await Client.GetFanoutCompareAsync(groupId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _compareLegs = [];
        }
        finally
        {
            _compareLoading = false;
        }
    }

    private async Task LoadCustomDefsAsync()
    {
        try
        {
            _customDefs = await Client.GetCustomAgentClisAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _customDefs = [];
        }
    }

    private async Task EditCustomCli(AgentCliDefinitionDto? def)
    {
        _editingDef = def;
        _defFormName = def?.DisplayName ?? string.Empty;
        _defFormExecutable = def?.Executable ?? string.Empty;
        _defFormArgs = def?.ArgsTemplate ?? string.Empty;
        _defFormTransport = def?.Transport ?? "pty";
        _defFormModelFlag = def?.ModelFlag ?? string.Empty;
        _defFormPromptDelivery = def?.PromptDelivery ?? "argv";
        _defFormModelListArgs = def?.ModelListArgs ?? string.Empty;
        _defFormVersionArgs = def?.VersionArgs ?? "--version";
        _defFormEnabled = def?.Enabled ?? true;
        _defFormError = null;
        await _customCliModal.ShowAsync();
    }

    private async Task SaveCustomCliAsync()
    {
        _defFormError = null;
        _defSaving = true;
        try
        {
            var request = new UpsertAgentCliDefinitionRequest(
                _defFormName.Trim(),
                _defFormExecutable.Trim(),
                string.IsNullOrWhiteSpace(_defFormArgs) ? null : _defFormArgs.Trim(),
                _defFormTransport,
                string.IsNullOrWhiteSpace(_defFormModelFlag) ? null : _defFormModelFlag.Trim(),
                string.IsNullOrWhiteSpace(_defFormVersionArgs) ? null : _defFormVersionArgs.Trim(),
                _defFormEnabled,
                _defFormPromptDelivery,
                string.IsNullOrWhiteSpace(_defFormModelListArgs) ? null : _defFormModelListArgs.Trim());

            var (saved, error) = _editingDef is null
                ? await Client.CreateCustomAgentCliAsync(request)
                : await Client.UpdateCustomAgentCliAsync(_editingDef.Id, request);

            if (saved is null)
            {
                _defFormError = error ?? "Save failed.";
                return;
            }

            await _customCliModal.HideAsync();
            await LoadCustomDefsAsync();
            await ToastService.NotifyAsync(new(ToastType.Success,
                _editingDef is null ? $"CLI '{saved.DisplayName}' added." : $"CLI '{saved.DisplayName}' updated."));
        }
        finally
        {
            _defSaving = false;
        }
    }

    private async Task DeleteCustomCliAsync(AgentCliDefinitionDto def)
    {
        _deleteDefId = null;
        if (await Client.DeleteCustomAgentCliAsync(def.Id))
        {
            await ToastService.NotifyAsync(new(ToastType.Success, $"CLI '{def.DisplayName}' removed."));
        }
        else
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, "Custom CLI not found — it may already be gone."));
        }

        await LoadCustomDefsAsync();
    }

    private async Task LoadTemplateAsync()
    {
        _templateLoading = true;
        try
        {
            var info = await PromptTemplateService.GetTemplateAsync();
            _template = info.Template;
            _builtinTemplate = info.Builtin;
            _templateCustomized = info.Customized;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Erro ao carregar prompt padrão: {ex.Message}"));
        }
        finally
        {
            _templateLoading = false;
        }
    }

    private async Task SaveTemplateAsync()
    {
        _templateSaving = true;
        try
        {
            await PromptTemplateService.SetTemplateAsync(_template);
            await ToastService.NotifyAsync(new(ToastType.Success, "Prompt padrão salvo."));
            await LoadTemplateAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Erro ao salvar prompt: {ex.Message}"));
        }
        finally
        {
            _templateSaving = false;
        }
    }

    private async Task ResetTemplateAsync()
    {
        _templateSaving = true;
        try
        {
            await PromptTemplateService.SetTemplateAsync(null);
            await ToastService.NotifyAsync(new(ToastType.Success, "Prompt padrão restaurado."));
            await LoadTemplateAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Erro ao restaurar prompt: {ex.Message}"));
        }
        finally
        {
            _templateSaving = false;
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _agents = await Client.GetAgentClisAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Could not load agent CLI status: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        // SPEC-20260928: the status payload is a fast snapshot — when the
        // server is re-probing versions/models in background, show the
        // indicator and re-fetch once it completes.
        _ = TrackProbeRefreshAsync();

        // Compact metrics are best-effort — never block or break the page.
        try
        {
            var summaryTask = Client.GetCliMetricsSummaryAsync("7d");
            var sourcesTask = Client.GetCliMetricSourcesAsync();
            await Task.WhenAll(summaryTask, sourcesTask);
            _metrics = await summaryTask;
            _sources = await sourcesTask;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _metrics = null;
            _sources = [];
        }
    }

    /// <summary>Refresh button: kicks the background probes then reloads the page data.</summary>
    private async Task RefreshAllAsync()
    {
        // SPEC-20260929-cli-probe-hardening RF-004: a failed kick (network/API)
        // must not escape the handler — notify and still reload the last-known
        // status so the page stays usable.
        try
        {
            await Client.RefreshAgentClisAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await ToastService.NotifyAsync(new(ToastType.Warning,
                $"Could not schedule a CLI probe refresh: {ex.Message}"));
        }

        await RefreshAsync();
    }

    /// <summary>
    /// SPEC-20260928-agent-cli-probe-background: while the server-side probe
    /// refresh is running, poll its status (~1.5s) and refetch the statuses
    /// once when it completes — the page never blocks on subprocess probes.
    /// </summary>
    private async Task TrackProbeRefreshAsync()
    {
        if (_refreshingProbes)
        {
            return;
        }

        try
        {
            var status = await Client.GetAgentCliRefreshStatusAsync();
            if (status is not { Running: true })
            {
                return;
            }

            _refreshingProbes = true;
            await InvokeAsync(StateHasChanged);

            var deadline = DateTime.UtcNow.AddSeconds(20);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(1500);
                status = await Client.GetAgentCliRefreshStatusAsync();
                if (status is not { Running: true })
                {
                    break;
                }
            }

            _agents = await Client.GetAgentClisAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Probe tracking is best-effort — the snapshot is already on screen.
        }
        finally
        {
            _refreshingProbes = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncMetricsAsync()
    {
        _syncing = true;
        try
        {
            var result = await Client.SyncCliMetricsAsync();
            if (result is null)
            {
                await ToastService.NotifyAsync(new(ToastType.Warning, "Métricas de CLI desabilitadas."));
            }
            else if (result.InFlight)
            {
                await ToastService.NotifyAsync(new(ToastType.Info, "Sync já em andamento."));
            }
            else
            {
                await ToastService.NotifyAsync(new(ToastType.Success,
                    $"Sync concluído — {result.SessionsIngested} sessões ingeridas."));
            }
            await RefreshAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Erro ao sincronizar métricas: {ex.Message}"));
        }
        finally
        {
            _syncing = false;
        }
    }

    private string SessionsFor(AgentCliStatus agent) =>
        MetricsFor(agent)?.Sessions.ToString() ?? "—";

    private string TokensFor(AgentCliStatus agent) =>
        MetricsFor(agent) is { Tokens: > 0 } t ? FormatTokens(t.Tokens) : "—";

    private string LastActivityFor(AgentCliStatus agent) =>
        MetricsFor(agent)?.LastActivityUtc is { } at
            ? UiFormat.DateTime(at)
            : "—";

    private CliMetricsTotalsDto? MetricsFor(AgentCliStatus agent) =>
        _metrics?.ByKind.TryGetValue(agent.Agent.ToString(), out var totals) == true ? totals : null;

    private (BadgeColor Color, string Label) SourceBadgeFor(AgentCliStatus agent)
    {
        var sources = _sources.Where(s => s.Kind == agent.Agent.ToString()).ToList();
        return sources switch
        {
            [] => (BadgeColor.Secondary, "no source"),
            _ when sources.Any(s => s.Status is "Error") => (BadgeColor.Danger, "error"),
            _ when sources.Any(s => s.SchemaDrifted) => (BadgeColor.Warning, "drifted"),
            _ when sources.Any(s => s.Status is "Available" or "CopiedToTemp") => (BadgeColor.Success, "synced"),
            _ => (BadgeColor.Secondary, "missing"),
        };
    }

    private static string FormatTokens(long tokens) => tokens switch
    {
        >= 1_000_000 => $"{tokens / 1_000_000d:0.#}M",
        >= 1_000 => $"{tokens / 1_000d:0.#}K",
        _ => tokens.ToString(),
    };

    private async Task StartInstallAsync(AgentCliStatus agent)
    {
        var parameters = new Dictionary<string, object>
        {
            ["Kind"] = agent.Agent,
            ["DisplayName"] = agent.DisplayName,
            ["OnFinished"] = EventCallback.Factory.Create(this, OnInstallFinishedAsync)
        };
        await _installModal.ShowAsync<AgentInstallDialog>(
            title: $"Install {agent.DisplayName}", parameters: parameters);
    }

    private async Task OnInstallFinishedAsync()
    {
        await _installModal.HideAsync();
        await RefreshAsync();
    }

    private static bool SupportsModelSelection(AgentCliStatus agent) =>
        AgentCliMap.AgentTypeFor(agent.Agent) is { } type
        && AgentCliModels.SupportsModelSelection(type);

    private async Task StartModelConfigAsync(AgentCliStatus agent)
    {
        if (AgentCliMap.AgentTypeFor(agent.Agent) is not { } agentType)
        {
            return;
        }

        var parameters = new Dictionary<string, object>
        {
            ["AgentType"] = agentType,
            ["DisplayName"] = agent.DisplayName,
            ["OnFinished"] = EventCallback.Factory.Create(this, OnModelConfigFinishedAsync)
        };
        await _modelsModal.ShowAsync<AgentModelConfigDialog>(
            title: $"Modelos — {agent.DisplayName}", parameters: parameters);
    }

    private async Task OnModelConfigFinishedAsync() => await _modelsModal.HideAsync();

    private static string InstallButtonTitle(AgentCliStatus agent) =>
        agent.PrerequisiteMet
            ? agent.InstallHint
            : $"Requires '{agent.RequiredTool}' on PATH — {agent.InstallHint}";

    private static string TerminalUrl(string command) =>
        $"/terminal?cmd={Uri.EscapeDataString(command)}";
}
