@page "/agents"
@attribute [Authorize]
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAgentPromptTemplateService PromptTemplateService
@inject IAgentModelCatalogService ModelCatalog
@inject ILocaleService L
@inject ToastService ToastService

<PageTitle>CLI Agents - Harness</PageTitle>

<Modal @ref="_installModal" Size="ModalSize.Large" Fullscreen="ModalFullscreen.SmallDown" IsScrollable="true" />
<Modal @ref="_modelsModal" Fullscreen="ModalFullscreen.SmallDown" />

@* RF-007 retry: model swap on the new attempt (schema-budget/quota rejects).
   Root-level — inside a hidden tab-pane the backdrop shows but the dialog stays hidden. *@
<Modal @ref="_retryModal" Title="Retry task" Fullscreen="ModalFullscreen.SmallDown">
    <BodyTemplate>
        <p class="small text-body-secondary mb-1 text-truncate" title="@_retryCard?.SessionTitle">@_retryCard?.SessionTitle</p>
        <div class="mb-1">
            <label class="form-label small mb-1">Model <span class="text-body-secondary">(empty keeps the previous one)</span></label>
            <input class="form-control form-control-sm font-monospace" list="agents-retry-models"
                   @bind="_retryModel" placeholder="e.g. opencode/claude-sonnet-5" />
            <datalist id="agents-retry-models">
                @foreach (var m in _retryModels)
                {
                    <option value="@m"></option>
                }
            </datalist>
        </div>
        @if (!string.IsNullOrEmpty(_retryError))
        {
            <Alert Color="AlertColor.Danger" Dismissable="false" class="py-1 mt-2 small">@_retryError</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => _retryModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SubmitRetryAsync" Disabled="_retryBusy">
            @if (_retryBusy)
            {
                <Spinner Size="SpinnerSize.Small" Class="me-1" />
            }
            Retry
        </Button>
    </FooterTemplate>
</Modal>

<h1 class="h4 fw-bold mb-1">CLI Agents</h1>
<p class="small text-body-secondary mb-4">Agent CLIs detected on this machine. Open a terminal to authenticate or manage each CLI.</p>
@* SPEC-20261020-provider-quota-usage RF-006: quota roster strip. *@
<ProviderUsageStrip />

@* SPEC-20261010-agents-page-tabs RF-001: abas Dashboard/Sessions/CLI Agents/Prompt
   — mesmo modelo ARIA/keyboard/deep-link (?tab=) do Settings. *@
<nav class="settings-tabs nav nav-tabs mb-4 pb-0 border-bottom flex-nowrap overflow-auto" role="tablist" aria-label="Agent sections" @onkeydown="OnTabsKeyDown">
    @foreach (var tab in AgentsTabs)
    {
        var id = tab.Id;
        <button type="button" role="tab" class="nav-link text-nowrap @(id == _activeTab ? "active" : "")"
                aria-selected="@(id == _activeTab ? "true" : "false")" tabindex="@(id == _activeTab ? 0 : -1)"
                data-tab="@id" @onclick="() => SelectTab(id)">
            @tab.Label
        </button>
    }
</nav>

<div class="tab-pane" role="tabpanel" aria-label="Dashboard" hidden="@(_activeTab != "dashboard")">
@* SPEC-20261006 RF-001: agent dashboard — attention columns built from
   delegation tasks, live runs and the mailbox. *@
<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 fw-semibold mb-0">Agent Dashboard</h2>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="LoadDashboardAsync" Disabled="_boardLoading">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
        </div>
        @* SPEC-20261020-agent-board-v2 RF-004/RF-005: toolbar filters + show-idle. *@
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <input class="form-control form-control-sm" style="max-width:220px"
                   placeholder="Search title, preview, repo…" aria-label="Filter board"
                   @bind="_boardQuery" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
            <select class="form-select form-select-sm" style="max-width:140px" aria-label="Filter by CLI"
                    @bind="_boardCli" @bind:after="OnFilterChangedAsync">
                <option value="">All CLIs</option>
                @foreach (var c in _knownClis.OrderBy(x => x))
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select class="form-select form-select-sm" style="max-width:150px" aria-label="Filter by state"
                    @bind="_boardState" @bind:after="OnFilterChangedAsync">
                <option value="">All states</option>
                @foreach (var s in Enum.GetNames<AgentAttentionState>())
                {
                    <option value="@s">@s</option>
                }
            </select>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="board-haspr"
                       @bind="_boardHasPr" @bind:after="OnFilterChangedAsync" />
                <label class="form-check-label small" for="board-haspr">Has PR</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="board-idle"
                       @bind="_showIdle" @bind:after="OnShowIdleChangedAsync" />
                <label class="form-check-label small" for="board-idle">
                    Show idle@(_board is null || _showIdle ? "" : $" ({_board.Idle.Count})")
                </label>
            </div>
            @if (FiltersActive())
            {
                <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0"
                        @onclick="ClearFiltersAsync">Clear</Button>
            }
            <span class="ms-auto small text-body-secondary">
                @((_board?.UnreadTotal ?? 0) == 0 ? "" : $"{_board!.UnreadTotal} unread")
            </span>
        </div>
        @if (_board is null)
        {
            <p class="small text-body-secondary mb-0">
                @(_boardLoading ? "Loading…" : "No delegation activity yet — delegate work from the AI Code chat (delegate_task/delegate_fanout).")
            </p>
        }
        else
        {
            @* SPEC-20261020-agents-feed-notifications: persistent global feed
               replaces the merged in-memory activity list (RF-003). *@
            <FeedPanel />
            <div class="row g-3">
                @foreach (var (title, color, items) in BoardColumns())
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded p-2 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fw-semibold small">@title</span>
                                <Badge Color="@color">@items.Count</Badge>
                            </div>
                            @if (items.Count == 0)
                            {
                                <p class="small text-body-secondary mb-0">—</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var card in items)
                                    {
                                        <li id="@CardDomId(card.Id)" class="mb-2 rounded p-2 @CardTint(card) @FocusRing(card)" role="button" tabindex="0"
                                            @key="card.Id" @onclick="() => OpenCardAsync(card)"
                                            @onkeydown="e => OnCardKeyDown(e, card)">
                                            <div class="d-flex align-items-center gap-2">
                                                <Badge Color="@AttentionBadge(card.State)">@card.State</Badge>
                                                <span class="fw-semibold text-truncate">@card.SessionTitle</span>
                                                @if (card.Unread)
                                                {
                                                    <span class="badge rounded-pill bg-primary ms-auto" title="unread">●</span>
                                                }
                                                <span class="text-body-secondary ms-auto small">@card.CliName</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(card.PreviewText))
                                            {
                                                <div class="text-body-secondary text-truncate mt-1" title="@card.PreviewText">@card.PreviewText</div>
                                            }
                                            <div class="d-flex gap-2 mt-1 align-items-center">
                                                @if (!string.IsNullOrEmpty(card.RepoName))
                                                {
                                                    <Badge Color="BadgeColor.Secondary">@card.RepoName</Badge>
                                                }
                                                @if (!string.IsNullOrEmpty(card.FanoutGroupId))
                                                {
                                                    <span @onclick:stopPropagation="true">
                                                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0"
                                                                @onclick="() => OpenCompareAsync(card.FanoutGroupId)">
                                                            <Icon Name="IconName.ColumnsGap" class="me-1" />Compare legs
                                                        </Button>
                                                    </span>
                                                }
                                                @if (card.Kind == "task" && IsRetryable(card))
                                                {
                                                    @* RF-007: retry com troca de modelo — schema-budget/quota do
                                                       modelo anterior não deve obrigar o usuário a recriar a task. *@
                                                    <span @onclick:stopPropagation="true">
                                                        <Button Color="ButtonColor.Link" Size="ButtonSize.Small" Class="p-0"
                                                                @onclick="() => OpenRetryModalAsync(card)">
                                                            <Icon Name="IconName.ArrowClockwise" class="me-1" />Retry
                                                        </Button>
                                                    </span>
                                                }
                                                @if (card.PrUrl is not null)
                                                {
                                                    <a href="@card.PrUrl" target="_blank" rel="noopener"
                                                       class="small" @onclick:stopPropagation="true">PR ↗</a>
                                                }
                                            </div>
                                            @if (card.Kind == "scope")
                                            {
                                                @foreach (var item in ScopeMailboxItems())
                                                {
                                                    <div class="border rounded p-2 mt-1 bg-body" @onclick:stopPropagation="true">
                                                        <div class="text-truncate" title="@item.Detail">@item.Title</div>
                                                        @if (_openReplyId == item.Id)
                                                        {
                                                            <textarea class="form-control form-control-sm mt-1" rows="2"
                                                                      placeholder="Reply to the agent…"
                                                                      @bind="_replyText"></textarea>
                                                            <div class="d-flex gap-2 mt-1">
                                                                <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                                                                        Disabled="@(_mailboxBusy || string.IsNullOrWhiteSpace(_replyText))"
                                                                        @onclick="() => SendReplyAsync(item.Id)">
                                                                    @(_mailboxBusy ? "Sending…" : "Reply")
                                                                </Button>
                                                                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                                                                        @onclick="() => _openReplyId = null">Cancel</Button>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(_mailboxError))
                                                            {
                                                                <div class="text-danger small mt-1">@_mailboxError</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex gap-2 mt-1">
                                                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small"
                                                                        @onclick="() => { _openReplyId = item.Id; _replyText = string.Empty; _mailboxError = null; }">
                                                                    Reply
                                                                </Button>
                                                                <Button Color="ButtonColor.Link" Size="ButtonSize.Small"
                                                                        Disabled="_mailboxBusy"
                                                                        @onclick="() => DismissMailboxAsync(item.Id)">
                                                                    Dismiss
                                                                </Button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* SPEC-20261007 RF-004: fan-out compare — per-leg diffstat + bounded patch. *@
<Modal @ref="_compareModal" Title="Fan-out compare" Size="ModalSize.Large"
       Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_compareLoading)
        {
            <p class="small text-body-secondary mb-0">Loading diffs…</p>
        }
        else if (_compareLegs.Count == 0)
        {
            <p class="small text-body-secondary mb-0">No legs found for this fan-out group.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>CLI</th>
                            <th>Status</th>
                            <th class="text-end">Files</th>
                            <th class="text-end">+/−</th>
                            <th>Worktree</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leg in _compareLegs)
                        {
                            <tr>
                                <td>@leg.CliName</td>
                                <td>@leg.Status</td>
                                <td class="text-end">@(leg.Files?.FilesChanged.ToString() ?? "—")</td>
                                <td class="text-end">
                                    @if (leg.Files is not null)
                                    {
                                        <span class="text-success">+@leg.Files.Insertions</span>@(" ")
                                        <span class="text-danger">−@leg.Files.Deletions</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">—</span>
                                    }
                                </td>
                                <td class="small text-body-secondary">
                                    @(leg.Note ?? (leg.WorktreeRunId is null ? "—" : $"run {leg.WorktreeRunId[..Math.Min(8, leg.WorktreeRunId.Length)]}"))
                                </td>
                                <td>
                                    @* SPEC-20261009 RF-002: pick winner — commit + push the leg's branch. *@
                                    @if (leg.WorktreeRunId is not null)
                                    {
                                        if (_promoted.TryGetValue(leg.TaskId, out var promoted))
                                        {
                                            <Badge Color="BadgeColor.Success" title="@promoted.CommitSha"
                                                   style="max-width:12rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block;vertical-align:middle">
                                                @promoted.Branch</Badge>
                                            @if (!string.IsNullOrWhiteSpace(promoted.PullRequestUrl))
                                            {
                                                <a href="@promoted.PullRequestUrl" target="_blank" rel="noopener noreferrer"
                                                   class="small d-block">@L.T("agents.compare.openPr")</a>
                                            }
                                        }
                                        else
                                        {
                                            <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small"
                                                    Disabled="@(_promotingId is not null)"
                                                    @onclick="() => PromoteLegAsync(leg)">
                                                @(_promotingId == leg.TaskId ? "…" : L.T("agents.compare.useLeg"))
                                            </Button>
                                            @* SPEC-20261004-promote-leg-pr: repo-backed legs can open the PR in one shot. *@
                                            @if (leg.RepositoryPath is not null)
                                            {
                                                <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small"
                                                        Class="ms-1"
                                                        Disabled="@(_promotingId is not null)"
                                                        @onclick="() => PromoteLegAsync(leg, createPr: true)">
                                                    @(_promotingId == leg.TaskId ? "…" : L.T("agents.compare.useLegPr"))
                                                </Button>
                                            }
                                        }
                                        @if (_promoteError.TryGetValue(leg.TaskId, out var perr))
                                        {
                                            <div class="text-danger small">@perr</div>
                                        }
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(leg.Patch))
                            {
                                <tr>
                                    <td colspan="6" class="p-0">
                                        <details>
                                            <summary class="small text-body-secondary px-2 py-1">Patch (@leg.Patch.Length chars)</summary>
                                            <pre class="small bg-body-tertiary p-2 mb-0 overflow-auto" style="max-height: 320px;">@leg.Patch</pre>
                                        </details>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                @onclick="() => _compareModal.HideAsync()">Close</Button>
    </FooterTemplate>
</Modal>

@* SPEC-20261006 RF-002/RF-003: resumable on-disk CLI sessions. *@
</div>

<div class="tab-pane" role="tabpanel" aria-label="Sessions" hidden="@(_activeTab != "sessions")">
<div class="card">
    <div class="card-body">
        @* SPEC-20261020-session-history-parity RF-005: one chip per discovered
           CLI (with count) — click filters, the eye persists visibility;
           custom defs have no scanned store → disabled chips. *@
        <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Session source CLI">
            <button type="button" class="btn btn-sm @(_selectedCli is null ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@(_selectedCli is null ? "true" : "false")"
                    @onclick="() => SelectSessionCliAsync(null)">All</button>
            @foreach (var chip in SessionChips)
            {
                var id = chip.Cli;
                <span class="btn-group btn-group-sm" role="group" aria-label="@id sessions">
                    <button type="button"
                            class="btn @CliChipClass(id, chip.Hidden)"
                            aria-pressed="@(id == _selectedCli ? "true" : "false")" data-cli="@id"
                            @onclick="() => SelectSessionCliAsync(id == _selectedCli ? null : id)">
                        @id <span class="badge text-bg-secondary ms-1">@chip.Count</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            title="@(chip.Hidden ? $"Show {id} sessions" : $"Hide {id} sessions")"
                            aria-label="@(chip.Hidden ? $"Show {id}" : $"Hide {id}")"
                            @onclick="() => ToggleCliHiddenAsync(id, !chip.Hidden)">
                        <Icon Name="@(chip.Hidden ? IconName.EyeSlash : IconName.Eye)" />
                    </button>
                </span>
            }
            @foreach (var def in _customDefs)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                        title="Session store not scanned for this CLI">@def.DisplayName</button>
            }
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h6 fw-semibold mb-0 me-auto">CLI Sessions</h2>
            <input type="search" class="form-control form-control-sm" style="max-width: 16rem;"
                   placeholder="Filter title, dir or branch…" aria-label="Filter sessions"
                   value="@_sessionQuery" @oninput="OnSessionQueryInput" />
            <div class="form-check mb-0" title="Search inside transcript files (rg, ≤5s)">
                <input class="form-check-input" type="checkbox" id="searchTranscripts"
                       checked="@_transcriptSearch" @onchange="OnTranscriptSearchChanged" />
                <label class="form-check-label small" for="searchTranscripts">Transcripts</label>
            </div>
            <select class="form-select form-select-sm w-auto" aria-label="Group sessions by"
                    value="@_sessionGroup" @onchange="OnSessionGroupChanged">
                <option value="cli">Group: CLI</option>
                <option value="project">Group: Project</option>
                <option value="day">Group: Day</option>
            </select>
            <select class="form-select form-select-sm w-auto" aria-label="Sort sessions by"
                    value="@_sessionSort" @onchange="OnSessionSortChanged">
                <option value="modified">Sort: Modified</option>
                <option value="created">Sort: Created</option>
                <option value="title">Sort: Title</option>
                <option value="duration">Sort: Duration</option>
            </select>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="hideEmptySessionGroups"
                       checked="@_hideEmptyGroups" @onchange="OnHideEmptyChanged" />
                <label class="form-check-label small" for="hideEmptySessionGroups">Hide empty</label>
            </div>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                    @onclick="() => LoadSessionsAsync(rebuild: true)" Disabled="_sessionsLoading">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
            @if (_hibStats is { HibernatedCount: > 0 } or { AutoResumedTotal: > 0 })
            {
                <span class="small text-body-secondary ms-auto"
                      title="Hibernation stats — estimated RSS saved is a per-CLI heuristic">
                    @_hibStats.HibernatedCount hibernated
                    @if (_hibStats.AutoResumedTotal > 0)
                    {
                        <text> · @_hibStats.AutoResumedTotal auto-resumed</text>
                    }
                    @if (_hibStats.EstimatedRssSavedMb > 0)
                    {
                        <text> · ~@_hibStats.EstimatedRssSavedMb MB saved</text>
                    }
                </span>
            }
        </div>

        @if (_sessionsLoading && _sessionIndex is null)
        {
            <p class="small text-body-secondary mb-0">Scanning transcripts…</p>
        }
        else if (_sessionIndex is null || _sessionIndex.Total == 0)
        {
            <p class="small text-body-secondary mb-0">No on-disk sessions found under $HOME.</p>
        }
        else
        {
            @foreach (var group in _sessionIndex.Groups)
            {
                <section class="mb-3" aria-label="@group.Label">
                    <h3 class="h6 text-body-secondary mb-1">@group.Label
                        <span class="badge text-bg-secondary ms-1">@group.Count</span></h3>
                    @if (group.Count == 0)
                    {
                        <p class="small text-body-secondary fst-italic mb-0">No sessions.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    @foreach (var session in group.Sessions)
                                    {
                                        <tr @key="SessionRowKey(session)">
                                            <td>
                                                <div class="fw-semibold text-truncate" style="max-width: 24rem;"
                                                     title="@session.Title">
                                                    @if (session.Live)
                                                    {
                                                        <Icon Name="IconName.CircleFill" class="me-1 text-success"
                                                              title="Live session" />
                                                        <span class="badge text-bg-success me-1">live</span>
                                                    }
                                                    @if (session.Hibernated)
                                                    {
                                                        <span class="badge text-bg-secondary me-1"
                                                              title="Hibernated — process paused, resumes via native CLI">
                                                            zzz
                                                        </span>
                                                    }
                                                    @if (session.Pinned)
                                                    {
                                                        <Icon Name="IconName.PinAngleFill" class="me-1 text-info"
                                                              title="Pinned — keep alive, never hibernates" />
                                                    }
                                                    @if (session is { Hibernated: true, HibernationKey: not null })
                                                    {
                                                        @* RF-006: focusing the row asks the server to
                                                           auto-resume (or stays resumable when the
                                                           pref is off — the Resume button remains). *@
                                                        <button type="button"
                                                                class="btn btn-link p-0 border-0 align-baseline text-start fw-semibold"
                                                                @onclick="() => FocusHibernatedAsync(session.HibernationKey)"
                                                                disabled="@(_focusingKey is not null)"
                                                                title="Focus — auto-resumes when enabled in settings">
                                                            @session.Title
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        @session.Title
                                                    }
                                                </div>
                                                <div class="small text-body-secondary">
                                                    <code>@session.SessionId</code>
                                                    @if (session.RepoName is not null)
                                                    {
                                                        <span class="ms-2">@session.RepoName</span>
                                                    }
                                                    @if (session.Branch is not null)
                                                    {
                                                        <span class="ms-1"><Icon Name="IconName.Git" class="me-1" />@session.Branch</span>
                                                    }
                                                </div>
                                                @if (session.MatchSnippet is not null)
                                                {
                                                    <div class="small text-body-secondary text-truncate fst-italic"
                                                         style="max-width: 30rem;" title="@session.MatchSnippet">
                                                        &ldquo;@session.MatchSnippet&rdquo;
                                                    </div>
                                                }
                                            </td>
                                            <td class="small text-body-secondary text-truncate" style="max-width: 18rem;"
                                                title="@(session.Cwd ?? session.TranscriptPath)">
                                                @(session.Cwd ?? session.TranscriptPath)
                                            </td>
                                            <td class="small text-nowrap">
                                                @if (session.HibernatedAtUtc is { } hibernatedAt)
                                                {
                                                    <span class="text-body-secondary">
                                                        hibernated @FormatAge(hibernatedAt) ago
                                                    </span>
                                                }
                                                else
                                                {
                                                    @session.ModifiedAtUtc.ToString("yyyy-MM-dd HH:mm")
                                                }
                                                @if (session.MessageCount is not null)
                                                {
                                                    <span class="badge text-bg-light ms-1">@session.MessageCount msgs</span>
                                                }
                                                <span class="badge text-bg-light ms-1">@FormatSize(session.SizeBytes)</span>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                @if (session is { Hibernated: true, HibernationKey: not null })
                                                {
                                                    <button class="btn btn-sm btn-outline-success"
                                                            @onclick="() => ResumeHibernatedAsync(session.HibernationKey)"
                                                            disabled="@(_resumingKey is not null)"
                                                            title="Respawn with native resume">
                                                        <Icon Name="IconName.Play" class="me-1" /> Resume
                                                    </button>
                                                }
                                                else if (session.ResumeCommand is not null)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" href="@TerminalUrl(session.ResumeCommand)"
                                                       title="@session.ResumeCommand">
                                                        <Icon Name="IconName.Play" class="me-1" /> Resume
                                                    </a>
                                                }
                                                <SessionActionsMenu Entry="session"
                                                    OnDeleted="() => LoadSessionsAsync(rebuild: true)"
                                                    OnPinnedChanged="() => LoadSessionsAsync(rebuild: false)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    </div>
</div>
</div>

<div class="tab-pane" role="tabpanel" aria-label="CLI Agents" hidden="@(_activeTab != "cli-agents")">
<div class="card">
