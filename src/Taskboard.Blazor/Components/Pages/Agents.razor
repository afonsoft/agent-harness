    // RF-007 retry-with-model: task cards failed/stale (Blocked) ou cancelled (Exited).
    private Modal _retryModal = default!;
    private AgentBoardCard? _retryCard;
    private string? _retryModel;
    private List<string> _retryModels = [];
    private string? _retryError;
    private bool _retryBusy;

    private static bool IsRetryable(AgentBoardCard card) =>
        card.State is AgentAttentionState.Blocked or AgentAttentionState.Exited;

    private async Task OpenRetryModalAsync(AgentBoardCard card)
    {
        _retryCard = card;
        _retryModel = null;
        _retryError = null;
        _retryModels = [];

        // CLIs builtin expõem catálogo vivo; custom defs ficam com input livre.
        if (Enum.TryParse<AgentType>(card.CliName, ignoreCase: true, out var agentType)
            && AgentCliModels.SupportsModelSelection(agentType))
        {
            try
            {
                _retryModels = (await ModelCatalog.ListAvailableAsync(agentType)).ToList();
            }
            catch (Exception)
            {
                // probe falhou — o input continua aceitando texto livre
            }
        }

        await _retryModal.ShowAsync();
    }

    private async Task SubmitRetryAsync()
    {
        if (_retryCard is null)
        {
            return;
        }

        _retryBusy = true;
        _retryError = null;
        try
        {
            var taskId = _retryCard.Id.StartsWith("task:", StringComparison.Ordinal)
                ? _retryCard.Id[5..]
                : _retryCard.Id;
            var (result, error) = await Client.RetryDelegationTaskAsync(taskId, _retryModel);
            if (error is not null)
            {
                _retryError = error;
                return;
            }

            await _retryModal.HideAsync();
            await ToastService.NotifyAsync(new(ToastType.Success,
                $"Retry enfileirado — attempt {result?.Dispatch.Attempt} em {_retryCard.CliName}."));
            await LoadDashboardAsync();
        }
        finally
        {
            _retryBusy = false;
        }
    }

