@page "/agents"
@attribute [Authorize]
@inject TaskboardClient Client
@inject IAgentPromptTemplateService PromptTemplateService
@inject ToastService ToastService

<PageTitle>CLI Agents - Harness</PageTitle>

<Modal @ref="_installModal" Size="ModalSize.Large" IsScrollable="true" />
<Modal @ref="_modelsModal" />

<h1 class="h4 fw-bold mb-1">CLI Agents</h1>
<p class="small text-body-secondary mb-4">Agent CLIs detected on this machine. Open a terminal to authenticate or manage each CLI.</p>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
            @if (_refreshingProbes)
            {
                <span class="small text-body-secondary d-inline-flex align-items-center me-auto">
                    <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" class="me-1" /> Updating CLI info…
                </span>
            }
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="SyncMetricsAsync" Disabled="_syncing">
                @if (_syncing)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                else
                {
                    <Icon Name="IconName.CloudArrowDown" class="me-1" />
                }
                Sync now
            </Button>
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="RefreshAllAsync" Disabled="_loading">
                <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
            </Button>
        </div>

        @if (_loading && _agents is null)
        {
            <Loading Message="Detecting agent CLIs..." />
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <Alert Color="AlertColor.Danger" Dismissable="false">
                <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />@_error
            </Alert>
        }
        else if (_agents is { Count: > 0 })
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>CLI</th>
                            <th>Binary</th>
                            <th>Installed</th>
                            <th>Version</th>
                            <th>Auth</th>
                            <th>Config dir</th>
                            <th title="Sessions ingested from the local CLI database (last 7 days)">Sessions 7d</th>
                            <th>Tokens</th>
                            <th>Last activity</th>
                            <th>Metrics DB</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in _agents)
                        {
                            <tr>
                                <td class="fw-semibold">@agent.DisplayName</td>
                                <td><code>@agent.Binary</code></td>
                                <td>
                                    @if (agent.Installed)
                                    {
                                        <Badge Color="BadgeColor.Success">Installed</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Secondary">Not found</Badge>
                                    }
                                </td>
                                <td class="small">@(agent.Version ?? "—")</td>
                                <td>
                                    @switch (agent.AuthStatus)
                                    {
                                        case AgentCliAuthStatus.Authenticated:
                                            <Badge Color="BadgeColor.Success">Authenticated</Badge>
                                            break;
                                        case AgentCliAuthStatus.NotAuthenticated:
                                            <Badge Color="BadgeColor.Warning">Not authenticated</Badge>
                                            break;
                                        default:
                                            <Badge Color="BadgeColor.Secondary">Unknown</Badge>
                                            break;
                                    }
                                </td>
                                <td class="small"><code>@agent.ConfigDir</code></td>
                                <td class="small">@SessionsFor(agent)</td>
                                <td class="small">@TokensFor(agent)</td>
                                <td class="small">@LastActivityFor(agent)</td>
                                <td>
                                    @{
                                        var (badgeColor, badgeLabel) = SourceBadgeFor(agent);
                                    }
                                    <Badge Color="badgeColor">@badgeLabel</Badge>
                                </td>
                                <td class="text-end">
                                    @if (agent.Installed)
                                    {
                                        <div class="d-inline-flex gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="@TerminalUrl(agent.LoginCommand)">
                                                <Icon Name="IconName.Terminal" class="me-1" /> Login
                                            </a>
                                            @if (SupportsModelSelection(agent))
                                            {
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        title="Configurar modelos Lite/Normal/Ultra"
                                                        @onclick="() => StartModelConfigAsync(agent)">
                                                    <Icon Name="IconName.Gear" class="me-1" /> Models
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(!agent.PrerequisiteMet)"
                                                title="@InstallButtonTitle(agent)"
                                                @onclick="() => StartInstallAsync(agent)">
                                            <Icon Name="IconName.Download" class="me-1" /> Install
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-body-secondary mt-3 mb-0">
                <Icon Name="IconName.InfoCircle" class="me-1" />
                Auth status is detected by the presence of credential files — contents are never read. Commands are typed into the terminal, not executed automatically.
            </p>
        }
    </div>
</div>

@* SPEC-20260928-ai-code-generic-cli RF-002: user-declared CLIs persisted via
   /api/agents/custom — usable as AI Code threads (chat when acp, terminal
   otherwise). *@
<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <h2 class="h6 fw-semibold mb-0">Custom CLIs</h2>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => EditCustomCli(null)">
                <Icon Name="IconName.PlusSquare" class="me-1" /> Add CLI
            </Button>
        </div>
        <p class="small text-body-secondary">
            Declare any agent CLI installed on this host — it appears in the AI Code picker.
            <code>{model}</code> in the args template is replaced by the thread model.
        </p>
        @if (_customDefs.Count == 0)
        {
            <p class="small text-body-secondary mb-0">No custom CLIs yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Executable</th>
                            <th>Args</th>
                            <th>Transport</th>
                            <th>On PATH</th>
                            <th>Enabled</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var def in _customDefs)
                        {
                            <tr>
                                <td class="fw-semibold">@def.DisplayName</td>
                                <td><code>@def.Executable</code></td>
                                <td class="small"><code>@def.ArgsTemplate</code></td>
                                <td><Badge Color="BadgeColor.Secondary">@def.Transport</Badge></td>
                                <td>
                                    @if (def.Resolved)
                                    {
                                        <Badge Color="BadgeColor.Success">found</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Warning">not found</Badge>
                                    }
                                </td>
                                <td>
                                    @if (def.Enabled)
                                    {
                                        <Badge Color="BadgeColor.Success">on</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Secondary">off</Badge>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="Edit"
                                                @onclick="() => EditCustomCli(def)">
                                            <Icon Name="IconName.PencilSquare" />
                                        </button>
                                        @if (_deleteDefId == def.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteCustomCliAsync(def)">Delete</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _deleteDefId = null">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-link text-danger" title="Delete"
                                                    @onclick="() => _deleteDefId = def.Id">
                                                <Icon Name="IconName.Trash" />
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<Modal @ref="_customCliModal" Title="@(_editingDef is null ? "Add custom CLI" : $"Edit {_editingDef.DisplayName}")">
    <BodyTemplate>
        <div class="mb-2">
            <label class="form-label small mb-1">Display name</label>
            <input class="form-control form-control-sm" @bind="_defFormName" placeholder="My agent CLI" />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Executable (binary name or absolute path)</label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormExecutable" placeholder="mycli" />
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Args template <span class="text-body-secondary">(tokens: {model}, {prompt})</span></label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormArgs" placeholder="--acp {model}" />
        </div>
        <div class="row g-2 mb-2">
            <div class="col-6">
                <label class="form-label small mb-1">Transport</label>
                <select class="form-select form-select-sm" @bind="_defFormTransport">
                    <option value="pty">pty (raw terminal)</option>
                    <option value="acp">acp (structured — CLI must implement ACP)</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label small mb-1">Model flag <span class="text-body-secondary">(optional)</span></label>
                <input class="form-control form-control-sm font-monospace" @bind="_defFormModelFlag" placeholder="--model" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label small mb-1">Version args</label>
            <input class="form-control form-control-sm font-monospace" @bind="_defFormVersionArgs" placeholder="--version" />
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="def-enabled" @bind="_defFormEnabled" />
            <label class="form-check-label small" for="def-enabled">Enabled — visible in the AI Code picker</label>
        </div>
        @if (!string.IsNullOrEmpty(_defFormError))
        {
            <Alert Color="AlertColor.Danger" Dismissable="false" class="py-1 mt-2 small">@_defFormError</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="() => _customCliModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SaveCustomCliAsync" Disabled="_defSaving">
            @if (_defSaving)
            {
                <Spinner Size="SpinnerSize.Small" Class="me-1" />
            }
            Save
        </Button>
    </FooterTemplate>
</Modal>

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-1">Default agent prompt</h2>
        <p class="small text-body-secondary">
            Preenche o prompt da aba <em>Agent Config</em> de cada issue. Placeholders:
            <code>{repoUrl}</code> (URL de clone), <code>{issueTitle}</code>, <code>{issueBody}</code>,
            <code>{issueComments}</code> (comentários do GitHub — handoff entre agentes).
        </p>
        <textarea class="form-control font-monospace" rows="14" @bind="_template"
                  placeholder="@_builtinTemplate" disabled="@_templateLoading"></textarea>
        <div class="d-flex align-items-center gap-2 mt-2">
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SaveTemplateAsync" Disabled="_templateLoading">
                @if (_templateSaving)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                Salvar prompt
            </Button>
            @if (_templateCustomized)
            {
                <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ResetTemplateAsync" Disabled="_templateLoading">
                    Restaurar padrão
                </Button>
            }
            @if (_templateCustomized)
            {
                <Badge Color="BadgeColor.Info">customizado</Badge>
            }
        </div>
    </div>
</div>

@code {
    private Modal _installModal = default!;
    private Modal _modelsModal = default!;
    private IReadOnlyList<AgentCliStatus>? _agents;
    private CliMetricsSummaryDto? _metrics;
    private IReadOnlyList<CliMetricSourceDto> _sources = [];
    private bool _loading = true;
    private bool _syncing;
    private bool _refreshingProbes;
    private string? _error;

    // SPEC-20260928-ai-code-generic-cli RF-002: custom CLI CRUD state.
    private IReadOnlyList<AgentCliDefinitionDto> _customDefs = [];
    private Modal _customCliModal = default!;
    private AgentCliDefinitionDto? _editingDef;
    private string? _deleteDefId;
    private string _defFormName = string.Empty;
    private string _defFormExecutable = string.Empty;
    private string _defFormArgs = string.Empty;
    private string _defFormTransport = "pty";
    private string _defFormModelFlag = string.Empty;
    private string _defFormVersionArgs = "--version";
    private bool _defFormEnabled = true;
    private string? _defFormError;
    private bool _defSaving;

    private string _template = string.Empty;
    private string _builtinTemplate = string.Empty;
    private bool _templateLoading;
    private bool _templateSaving;
    private bool _templateCustomized;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RefreshAsync(), LoadTemplateAsync(), LoadCustomDefsAsync());
    }

    private async Task LoadCustomDefsAsync()
    {
        try
        {
            _customDefs = await Client.GetCustomAgentClisAsync();
        }
        catch
        {
            _customDefs = [];
        }
    }

    private async Task EditCustomCli(AgentCliDefinitionDto? def)
    {
        _editingDef = def;
        _defFormName = def?.DisplayName ?? string.Empty;
        _defFormExecutable = def?.Executable ?? string.Empty;
        _defFormArgs = def?.ArgsTemplate ?? string.Empty;
        _defFormTransport = def?.Transport ?? "pty";
        _defFormModelFlag = def?.ModelFlag ?? string.Empty;
        _defFormVersionArgs = def?.VersionArgs ?? "--version";
        _defFormEnabled = def?.Enabled ?? true;
        _defFormError = null;
        await _customCliModal.ShowAsync();
    }

    private async Task SaveCustomCliAsync()
    {
        _defFormError = null;
        _defSaving = true;
        try
        {
            var request = new UpsertAgentCliDefinitionRequest(
                _defFormName.Trim(),
                _defFormExecutable.Trim(),
                string.IsNullOrWhiteSpace(_defFormArgs) ? null : _defFormArgs.Trim(),
                _defFormTransport,
                string.IsNullOrWhiteSpace(_defFormModelFlag) ? null : _defFormModelFlag.Trim(),
                string.IsNullOrWhiteSpace(_defFormVersionArgs) ? null : _defFormVersionArgs.Trim(),
                _defFormEnabled);

            var (saved, error) = _editingDef is null
                ? await Client.CreateCustomAgentCliAsync(request)
                : await Client.UpdateCustomAgentCliAsync(_editingDef.Id, request);

            if (saved is null)
            {
                _defFormError = error ?? "Save failed.";
                return;
            }

            await _customCliModal.HideAsync();
            await LoadCustomDefsAsync();
            ToastService.Notify(new(ToastType.Success,
                _editingDef is null ? $"CLI '{saved.DisplayName}' added." : $"CLI '{saved.DisplayName}' updated."));
        }
        finally
        {
            _defSaving = false;
        }
    }

    private async Task DeleteCustomCliAsync(AgentCliDefinitionDto def)
    {
        _deleteDefId = null;
        if (await Client.DeleteCustomAgentCliAsync(def.Id))
        {
            ToastService.Notify(new(ToastType.Success, $"CLI '{def.DisplayName}' removed."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, "Custom CLI not found — it may already be gone."));
        }

        await LoadCustomDefsAsync();
    }

    private async Task LoadTemplateAsync()
    {
        _templateLoading = true;
        try
        {
            var info = await PromptTemplateService.GetTemplateAsync();
            _template = info.Template;
            _builtinTemplate = info.Builtin;
            _templateCustomized = info.Customized;
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao carregar prompt padrão: {ex.Message}"));
        }
        finally
        {
            _templateLoading = false;
        }
    }

    private async Task SaveTemplateAsync()
    {
        _templateSaving = true;
        try
        {
            await PromptTemplateService.SetTemplateAsync(_template);
            ToastService.Notify(new(ToastType.Success, "Prompt padrão salvo."));
            await LoadTemplateAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao salvar prompt: {ex.Message}"));
        }
        finally
        {
            _templateSaving = false;
        }
    }

    private async Task ResetTemplateAsync()
    {
        _templateSaving = true;
        try
        {
            await PromptTemplateService.SetTemplateAsync(null);
            ToastService.Notify(new(ToastType.Success, "Prompt padrão restaurado."));
            await LoadTemplateAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao restaurar prompt: {ex.Message}"));
        }
        finally
        {
            _templateSaving = false;
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _agents = await Client.GetAgentClisAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load agent CLI status: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        // SPEC-20260928: the status payload is a fast snapshot — when the
        // server is re-probing versions/models in background, show the
        // indicator and re-fetch once it completes.
        _ = TrackProbeRefreshAsync();

        // Compact metrics are best-effort — never block or break the page.
        try
        {
            var summaryTask = Client.GetCliMetricsSummaryAsync("7d");
            var sourcesTask = Client.GetCliMetricSourcesAsync();
            await Task.WhenAll(summaryTask, sourcesTask);
            _metrics = await summaryTask;
            _sources = await sourcesTask;
        }
        catch
        {
            _metrics = null;
            _sources = [];
        }
    }

    /// <summary>Refresh button: kicks the background probes then reloads the page data.</summary>
    private async Task RefreshAllAsync()
    {
        await Client.RefreshAgentClisAsync();
        await RefreshAsync();
    }

    /// <summary>
    /// SPEC-20260928-agent-cli-probe-background: while the server-side probe
    /// refresh is running, poll its status (~1.5s) and refetch the statuses
    /// once when it completes — the page never blocks on subprocess probes.
    /// </summary>
    private async Task TrackProbeRefreshAsync()
    {
        if (_refreshingProbes)
        {
            return;
        }

        try
        {
            var status = await Client.GetAgentCliRefreshStatusAsync();
            if (status is not { Running: true })
            {
                return;
            }

            _refreshingProbes = true;
            await InvokeAsync(StateHasChanged);

            var deadline = DateTime.UtcNow.AddSeconds(20);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(1500);
                status = await Client.GetAgentCliRefreshStatusAsync();
                if (status is not { Running: true })
                {
                    break;
                }
            }

            _agents = await Client.GetAgentClisAsync();
        }
        catch
        {
            // Probe tracking is best-effort — the snapshot is already on screen.
        }
        finally
        {
            _refreshingProbes = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncMetricsAsync()
    {
        _syncing = true;
        try
        {
            var result = await Client.SyncCliMetricsAsync();
            if (result is null)
            {
                ToastService.Notify(new(ToastType.Warning, "Métricas de CLI desabilitadas."));
            }
            else if (result.InFlight)
            {
                ToastService.Notify(new(ToastType.Info, "Sync já em andamento."));
            }
            else
            {
                ToastService.Notify(new(ToastType.Success,
                    $"Sync concluído — {result.SessionsIngested} sessões ingeridas."));
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro ao sincronizar métricas: {ex.Message}"));
        }
        finally
        {
            _syncing = false;
        }
    }

    private string SessionsFor(AgentCliStatus agent) =>
        MetricsFor(agent)?.Sessions.ToString() ?? "—";

    private string TokensFor(AgentCliStatus agent) =>
        MetricsFor(agent) is { Tokens: > 0 } t ? FormatTokens(t.Tokens) : "—";

    private string LastActivityFor(AgentCliStatus agent) =>
        MetricsFor(agent)?.LastActivityUtc is { } at
            ? at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "—";

    private CliMetricsTotalsDto? MetricsFor(AgentCliStatus agent) =>
        _metrics?.ByKind.TryGetValue(agent.Agent.ToString(), out var totals) == true ? totals : null;

    private (BadgeColor Color, string Label) SourceBadgeFor(AgentCliStatus agent)
    {
        var sources = _sources.Where(s => s.Kind == agent.Agent.ToString()).ToList();
        return sources switch
        {
            [] => (BadgeColor.Secondary, "no source"),
            _ when sources.Any(s => s.Status is "Error") => (BadgeColor.Danger, "error"),
            _ when sources.Any(s => s.SchemaDrifted) => (BadgeColor.Warning, "drifted"),
            _ when sources.Any(s => s.Status is "Available" or "CopiedToTemp") => (BadgeColor.Success, "synced"),
            _ => (BadgeColor.Secondary, "missing"),
        };
    }

    private static string FormatTokens(long tokens) => tokens switch
    {
        >= 1_000_000 => $"{tokens / 1_000_000d:0.#}M",
        >= 1_000 => $"{tokens / 1_000d:0.#}K",
        _ => tokens.ToString(),
    };

    private async Task StartInstallAsync(AgentCliStatus agent)
    {
        var parameters = new Dictionary<string, object>
        {
            ["Kind"] = agent.Agent,
            ["DisplayName"] = agent.DisplayName,
            ["OnFinished"] = EventCallback.Factory.Create(this, OnInstallFinishedAsync)
        };
        await _installModal.ShowAsync<AgentInstallDialog>(
            title: $"Install {agent.DisplayName}", parameters: parameters);
    }

    private async Task OnInstallFinishedAsync()
    {
        await _installModal.HideAsync();
        await RefreshAsync();
    }

    private static bool SupportsModelSelection(AgentCliStatus agent) =>
        AgentCliMap.AgentTypeFor(agent.Agent) is { } type
        && AgentCliModels.SupportsModelSelection(type);

    private async Task StartModelConfigAsync(AgentCliStatus agent)
    {
        if (AgentCliMap.AgentTypeFor(agent.Agent) is not { } agentType)
        {
            return;
        }

        var parameters = new Dictionary<string, object>
        {
            ["AgentType"] = agentType,
            ["DisplayName"] = agent.DisplayName,
            ["OnFinished"] = EventCallback.Factory.Create(this, OnModelConfigFinishedAsync)
        };
        await _modelsModal.ShowAsync<AgentModelConfigDialog>(
            title: $"Modelos — {agent.DisplayName}", parameters: parameters);
    }

    private async Task OnModelConfigFinishedAsync() => await _modelsModal.HideAsync();

    private static string InstallButtonTitle(AgentCliStatus agent) =>
        agent.PrerequisiteMet
            ? agent.InstallHint
            : $"Requires '{agent.RequiredTool}' on PATH — {agent.InstallHint}";

    private static string TerminalUrl(string command) =>
        $"/terminal?cmd={Uri.EscapeDataString(command)}";
}
