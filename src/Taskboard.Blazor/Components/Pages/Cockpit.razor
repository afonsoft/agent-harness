@page "/cockpit"
@using System.Text
@attribute [Authorize]
@inject TaskboardClient Client
@inject IGitHubService GitHub
@inject IAgentOrchestrationService Orchestration
@inject IAgentPromptTemplateService PromptTemplateService
@inject SelectedRepositoryService SelectedRepo
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Cockpit - Harness</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1">Cockpit</h1>
        <p class="small text-body-secondary mb-0">ADE runs — timeline ao vivo, HITL e diffs.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @* RF-003/RF-005: approvals pendentes sempre visíveis no header. *@
        @if (PendingApprovals > 0)
        {
            <span class="badge text-bg-warning align-self-center">
                <Icon Name="IconName.ExclamationTriangleFill" class="me-1" />@PendingApprovals approval@(PendingApprovals > 1 ? "s" : "")
            </span>
        }
        <span class="small text-body-secondary align-self-center" title="Cockpit hub">
            <Icon Name="IconName.Broadcast" /> <span class="@(_hub?.State == HubConnectionState.Connected ? "text-success" : "text-warning")">@(_hub?.State.ToString() ?? "—")</span>
        </span>
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="RefreshAsync" Disabled="_loading">
            <Icon Name="IconName.ArrowClockwise" class="me-1" /> Refresh
        </Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="OpenStartAsync">
            <Icon Name="IconName.Play" class="me-1" /> New Run
        </Button>
    </div>
</div>

@if (_loading && _runs is null)
{
    <Loading Message="Loading runs..." />
}
else if (_runs is { Count: 0 })
{
    <div class="alert alert-secondary" role="status">Nenhum run ainda — inicie um pipeline com <strong>New Run</strong>.</div>
}
else if (_runs is not null)
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Template</th>
                    <th>Repositório</th>
                    <th>Criado</th>
                    <th>Etapas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in _runs)
                {
                    <tr role="button" style="cursor: pointer" @onclick="() => OpenRun(run.PipelineExecutionId)">
                        <td>
                            <StatusBadge Status="@run.Status" />
                            @* RF-005: approval gates surface on the list, not only on the run page. *@
                            @if (run.Status is "WaitingApproval")
                            {
                                <span class="badge text-bg-warning ms-1">Needs approval</span>
                            }
                        </td>
                        <td><code>@run.TemplateId</code></td>
                        <td>@run.RepositoryFullName</td>
                        <td class="small text-body-secondary">@run.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="small">@CompletedStages(run) / @run.Stages.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<Modal @ref="_startModal" Title="New Run" Size="ModalSize.Large" IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="cockpit-template">Pipeline template</label>
                <select id="cockpit-template" class="form-select form-select-sm" @bind="_start.TemplateId">
                    @foreach (var t in _templates ?? [])
                    {
                        <option value="@t.TemplateId">@t.Name (@string.Join(" → ", t.StageKeys))</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Repository</label>
                <RepositoryCombobox Id="cockpit-repo" AriaLabel="Repository" Placeholder="owner/repo"
                                    Repositories="@_repoNames" IsLoading="@_reposLoading"
                                    @bind-Value="_start.RepositoryFullName" />
            </div>
            @if (IsSingleAgent)
            {
                <div class="col-md-6">
                    <label class="form-label" for="cockpit-agent">Agent CLI</label>
                    <select id="cockpit-agent" class="form-select form-select-sm" @bind="_start.AgentType">
                        @foreach (var agent in _agents ?? [])
                        {
                            <option value="@agent.Type">@agent.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="cockpit-tier">Model tier</label>
                    <select id="cockpit-tier" class="form-select form-select-sm" @bind="_start.ModelTier">
                        <option value="@AgentModelTier.Lite">Lite</option>
                        <option value="@AgentModelTier.Normal">Normal</option>
                        <option value="@AgentModelTier.Ultra">Ultra</option>
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input id="cockpit-verify" type="checkbox" class="form-check-input" @bind="_start.RunVerification" />
                        <label class="form-check-label" for="cockpit-verify">Run verification stage (dotnet format/build/test)</label>
                    </div>
                </div>
            }
            else
            {
                <div class="col-12">
                    <div class="form-check">
                        <input id="cockpit-single" type="checkbox" class="form-check-input" @bind="_start.SingleAgent" />
                        <label class="form-check-label" for="cockpit-single">Single agent — um CLI para todas as etapas</label>
                    </div>
                </div>
                @if (_start.SingleAgent)
                {
                    <div class="col-md-6">
                        <label class="form-label" for="cockpit-single-agent">Agent CLI</label>
                        <select id="cockpit-single-agent" class="form-select form-select-sm" @bind="_start.SingleAgentType">
                            <option value="">Auto</option>
                            @foreach (var agent in _agents ?? [])
                            {
                                <option value="@agent.Type">@agent.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="cockpit-single-tier">Model tier</label>
                        <select id="cockpit-single-tier" class="form-select form-select-sm" @bind="_start.SingleAgentTier">
                            <option value="">Auto (template)</option>
                            <option value="@AgentModelTier.Lite">Lite</option>
                            <option value="@AgentModelTier.Normal">Normal</option>
                            <option value="@AgentModelTier.Ultra">Ultra</option>
                        </select>
                    </div>
                }
            }
            @if (SelectedTemplate is { } selectedTemplate)
            {
                <div class="col-12">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="() => _optionsOpen = !_optionsOpen"
                            aria-expanded="@_optionsOpen" aria-controls="cockpit-stage-options">
                        <Icon Name="@(_optionsOpen ? IconName.ChevronDown : IconName.ChevronRight)" class="me-1" />
                        Options — @selectedTemplate.Stages.Count steps
                    </button>
                    @if (_optionsOpen)
                    {
                        <div id="cockpit-stage-options" class="border rounded mt-2">
                            @foreach (var stage in selectedTemplate.Stages)
                            {
                                <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom">
                                    <span class="small text-body-secondary" style="min-width: 8rem">
                                        <code>@stage.Key</code> · @stage.Name
                                    </span>
                                    @if (stage.Kind == "AgentWork")
                                    {
                                        var row = StageOptionFor(stage.Key);
                                        <select class="form-select form-select-sm" style="max-width: 12rem"
                                                disabled="@(!IsSingleAgent && _start.SingleAgent)"
                                                @bind="row.Agent">
                                            <option value="">Auto (@stage.DefaultAgent)</option>
                                            @foreach (var agent in _agents ?? [])
                                            {
                                                <option value="@agent.Type">@agent.Name</option>
                                            }
                                        </select>
                                        <select class="form-select form-select-sm" style="max-width: 9rem"
                                                disabled="@(!IsSingleAgent && _start.SingleAgent)"
                                                @bind="row.Tier">
                                            <option value="">@stage.DefaultTier</option>
                                            <option value="@AgentModelTier.Lite">Lite</option>
                                            <option value="@AgentModelTier.Normal">Normal</option>
                                            <option value="@AgentModelTier.Ultra">Ultra</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light">@stage.Kind</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            @if (_agents is { Count: 0 })
            {
                <div class="col-12">
                    <div class="alert alert-warning small mb-0" role="alert">
                        Nenhum Agent CLI disponível — instale e autentique um em <strong>Settings → Agents</strong>.
                    </div>
                </div>
            }
            <div class="col-md-6">
                <label class="form-label" for="cockpit-branch">Base branch</label>
                <input id="cockpit-branch" class="form-control form-control-sm" @bind="_start.BaseBranch" placeholder="main" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="cockpit-issue">Issue (opcional)</label>
                <input id="cockpit-issue" class="form-control form-control-sm" @bind="_start.IssueId" placeholder="#123" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="cockpit-spec">Spec path (opcional)</label>
                <input id="cockpit-spec" class="form-control form-control-sm" @bind="_start.SpecPath" placeholder=".specs/SPEC-….md" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="cockpit-budget">Budget cap USD (opcional)</label>
                <input id="cockpit-budget" type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_start.MaxBudgetUsd" />
            </div>
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0" for="cockpit-prompt">Prompt</label>
                    <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                            @onclick="UseDefaultPromptAsync" Disabled="_promptTemplateLoading">
                        @if (_promptTemplateLoading) { <Spinner Size="SpinnerSize.Small" Class="me-1" /> }
                        <Icon Name="IconName.FileEarmarkText" class="me-1" /> Usar prompt padrão
                    </Button>
                </div>
                <textarea id="cockpit-prompt" class="form-control form-control-sm font-monospace" rows="8" @bind="_start.Prompt"
                          placeholder="O que o pipeline deve fazer…"></textarea>
                <div class="form-text">O botão acima carrega o prompt padrão de <em>CLI Agents</em> com os placeholders preenchidos — edite livremente antes de iniciar.</div>
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => _startModal.HideAsync()">Cancel</Button>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="StartRunAsync" Disabled="@(!CanStart || _starting)">
            @if (_starting) { <Spinner Size="SpinnerSize.Small" /> } Start
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private IReadOnlyList<PipelineExecutionDto>? _runs;
    private IReadOnlyList<PipelineTemplateDto>? _templates;
    private IReadOnlyList<AgentInfo>? _agents;
    private IReadOnlyList<string> _repoNames = [];
    private bool _loading;
    private bool _reposLoading;
    private bool _starting;
    private bool _promptTemplateLoading;
    private Modal _startModal = default!;
    private readonly RunStartForm _start = new();
    private readonly Dictionary<string, StageOption> _stageOptions = new(StringComparer.Ordinal);
    private bool _optionsOpen;
    private CancellationTokenSource _cts = new();
    private HubConnection? _hub;
    private CancellationTokenSource _rowRefreshCts = new();

    /// <summary>RF-005: runs waiting on an approval gate — header chip + row badge.</summary>
    private int PendingApprovals => _runs?.Count(r => r.Status is "WaitingApproval") ?? 0;

    private bool IsSingleAgent => _start.TemplateId == PipelineTemplateIds.SingleAgent;

    private PipelineTemplateDto? SelectedTemplate =>
        _templates?.FirstOrDefault(t => t.TemplateId == _start.TemplateId);

    private bool CanStart =>
        !string.IsNullOrWhiteSpace(_start.TemplateId)
        && !string.IsNullOrWhiteSpace(_start.RepositoryFullName)
        && !string.IsNullOrWhiteSpace(_start.Prompt)
        && _agents is not { Count: 0 };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = LoadPickersAsync();
        _ = JS.InvokeVoidAsync("taskboardNotify.ensurePermission");
        await ConnectHubAsync();
    }

    /// <summary>
    /// SPEC-20260923-cockpit-run-hardening RF-003: the shared `runs` group
    /// carries every cockpit event — the list refreshes the affected row
    /// live (debounced) instead of needing F5.
    /// </summary>
    private async Task ConnectHubAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/harness-cockpit-hub"))
            .WithAutomaticReconnect([TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30)])
            .Build();

        _hub.On<CockpitEventDto>("ReceiveCockpitEvent", evt =>
        {
            if (evt.Kind is "run_status" or "status" or "stage" or "verification" or "error" or "approval" or "lifecycle")
            {
                ScheduleRowRefresh(evt.RunId);
            }

            return InvokeAsync(StateHasChanged);
        });

        _hub.On<ApprovalRequestDto>("RequireApproval", request =>
        {
            ToastService.Notify(new ToastMessage(
                ToastType.Warning, request.Summary ?? request.Description));
            _ = JS.InvokeVoidAsync("taskboardNotify.notify",
                request.Title,
                request.Summary ?? request.Description,
                Nav.ToAbsoluteUri($"/cockpit/runs/{request.RunId}").ToString());
            ScheduleRowRefresh(request.RunId);
            return InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += async _ =>
        {
            // Replay-safe: one list refresh reconciles anything missed offline.
            await InvokeAsync(RefreshAsync);
            await InvokeAsync(StateHasChanged);
        };

        try
        {
            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinRunsGroup");
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Hub indisponível: {ex.Message}"));
        }
    }

    /// <summary>
    /// Collapses a burst of events for the same run into one GET — the last
    /// event in a 400ms window triggers the fetch.
    /// </summary>
    private void ScheduleRowRefresh(string runId)
    {
        var previous = Interlocked.Exchange(ref _rowRefreshCts, new CancellationTokenSource());
        try
        {
            previous.Cancel();
            previous.Dispose();
        }
        catch (ObjectDisposedException)
        {
        }

        var token = _rowRefreshCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                var details = await Client.GetRunAsync(runId, token);
                if (details is not null && _runs is not null)
                {
                    var rows = _runs.ToList();
                    var index = rows.FindIndex(r => r.PipelineExecutionId == runId);
                    if (index >= 0)
                    {
                        rows[index] = details.Execution;
                    }
                    else
                    {
                        rows.Insert(0, details.Execution);
                    }

                    _runs = rows;
                }
                else if (details is null)
                {
                    await RefreshAsync();
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex) when (ex is not JSDisconnectedException)
            {
                // A failed row refresh is harmless — the next event retries.
                ToastService.Notify(new ToastMessage(ToastType.Warning, $"Refresh: {ex.Message}"));
            }
        });
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            _runs = await Client.ListRunsAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, ex.Message));
            _runs ??= [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPickersAsync()
    {
        try
        {
            _templates = await Client.ListPipelineTemplatesAsync(_cts.Token);
            _start.TemplateId ??= _templates.FirstOrDefault()?.TemplateId;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Templates: {ex.Message}"));
        }

        try
        {
            _agents = (await Orchestration.GetAvailableAgentsAsync(_cts.Token))
                .Where(a => a.Status == AgentStatus.Available)
                .ToList();
            if (_agents.Count > 0 && !_agents.Any(a => a.Type == _start.AgentType))
            {
                _start.AgentType = _agents[0].Type;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Agents: {ex.Message}"));
        }

        _reposLoading = true;
        try
        {
            await SelectedRepo.EnsureLoadedAsync();
            _repoNames = SelectedRepo.Repositories;
            _start.RepositoryFullName ??= SelectedRepo.Selected;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Repositories: {ex.Message}"));
        }
        finally
        {
            _reposLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenStartAsync()
    {
        _start.BaseBranch = string.IsNullOrWhiteSpace(_start.BaseBranch) ? "main" : _start.BaseBranch;
        _start.RepositoryFullName ??= SelectedRepo.Selected;
        await _startModal.ShowAsync();
    }

    private async Task StartRunAsync()
    {
        _starting = true;
        try
        {
            var run = await Client.StartRunAsync(new RunStartRequest(
                _start.TemplateId!, _start.RepositoryFullName!, _start.BaseBranch ?? "main",
                string.IsNullOrWhiteSpace(_start.IssueId) ? null : _start.IssueId,
                string.IsNullOrWhiteSpace(_start.SpecPath) ? null : _start.SpecPath,
                _start.Prompt!, _start.MaxBudgetUsd,
                AgentOverride: IsSingleAgent ? _start.AgentType : null,
                TierOverride: IsSingleAgent ? _start.ModelTier : null,
                SkipVerification: IsSingleAgent && !_start.RunVerification,
                StageOverrides: BuildStageOverrides(),
                SingleAgent: !IsSingleAgent && _start.SingleAgent,
                SingleAgentType: ParseAgent(_start.SingleAgentType),
                SingleAgentTier: ParseTier(_start.SingleAgentTier)), _cts.Token);
            await _startModal.HideAsync();
            if (run is not null)
            {
                Nav.NavigateTo($"/cockpit/runs/{run.PipelineExecutionId}");
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, ex.Message));
        }
        finally
        {
            _starting = false;
        }
    }

    /// <summary>
    /// Loads the shared default prompt template (CLI Agents → Default agent
    /// prompt) and renders its placeholders with the run's repository/issue
    /// context, leaving the textarea editable before the run starts.
    /// </summary>
    private async Task UseDefaultPromptAsync()
    {
        _promptTemplateLoading = true;
        try
        {
            var info = await PromptTemplateService.GetTemplateAsync(_cts.Token);
            var (title, body, comments) = await LoadIssueContextAsync();
            var cloneUrl = string.IsNullOrWhiteSpace(_start.RepositoryFullName)
                ? null
                : $"https://github.com/{_start.RepositoryFullName}.git";
            _start.Prompt = AgentPromptTemplate.Render(info.Template, cloneUrl, title, body, comments);
            // Older overrides may lack {issueComments} — append so the handoff
            // channel still reaches the agent (same rule as AgentConfigTab).
            if (!AgentPromptTemplate.HasCommentsPlaceholder(info.Template) && comments is not null)
            {
                _start.Prompt += $"\n\nComments:\n{comments}";
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, $"Prompt padrão: {ex.Message}"));
        }
        finally
        {
            _promptTemplateLoading = false;
        }
    }

    private async Task<(string? Title, string? Body, string? Comments)> LoadIssueContextAsync()
    {
        if (!int.TryParse(_start.IssueId?.TrimStart('#'), out var number)
            || string.IsNullOrWhiteSpace(_start.RepositoryFullName))
        {
            return (null, null, null);
        }

        try
        {
            // GetIssueAsync hits the issue directly — GetIssuesAsync applies the
            // board visibility window and would miss old closed issues.
            var issue = await GitHub.GetIssueAsync(_start.RepositoryFullName, number, _cts.Token);
            if (issue is null)
            {
                ToastService.Notify(new ToastMessage(ToastType.Warning,
                    $"Issue #{number} não encontrada em {_start.RepositoryFullName} — placeholders de issue ficam vazios."));
            }

            return (issue?.Title, issue?.Body, await BuildCommentsSectionAsync(number));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning,
                $"Não foi possível carregar a issue #{number}: {ex.Message}"));
            return (null, null, null);
        }
    }

    // Same bounded "Comments:" shape used by AgentConfigTab — a fetch failure
    // must never block filling the prompt.
    private async Task<string?> BuildCommentsSectionAsync(int issueNumber)
    {
        const int maxChars = 3000;
        try
        {
            var comments = await GitHub.GetIssueCommentsAsync(
                _start.RepositoryFullName!, issueNumber, take: 20, _cts.Token);
            if (comments.Count == 0)
            {
                return null;
            }

            var sb = new StringBuilder();
            foreach (var c in comments)
            {
                var line = $"- {c.AuthorLogin ?? "unknown"} ({c.CreatedAt:yyyy-MM-dd}): {c.Body}\n";
                if (sb.Length + line.Length > maxChars)
                {
                    sb.Append("- …\n");
                    break;
                }

                sb.Append(line);
            }

            return sb.ToString().TrimEnd();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning,
                $"Não foi possível carregar os comentários da issue #{issueNumber}: {ex.Message}"));
            return null;
        }
    }

    private StageOption StageOptionFor(string stageKey) =>
        _stageOptions.TryGetValue(stageKey, out var option)
            ? option
            : _stageOptions[stageKey] = new StageOption();

    private IReadOnlyDictionary<string, PipelineStageOverrideDto>? BuildStageOverrides()
    {
        // Only keys of the template currently selected — options typed for a
        // previous template must not leak into the request.
        var validKeys = SelectedTemplate?.Stages
            .Where(s => s.Kind == "AgentWork")
            .Select(s => s.Key)
            .ToHashSet(StringComparer.Ordinal) ?? [];
        var map = new Dictionary<string, PipelineStageOverrideDto>(StringComparer.Ordinal);
        foreach (var (key, option) in _stageOptions)
        {
            if (!validKeys.Contains(key))
            {
                continue;
            }

            var agent = ParseAgent(option.Agent);
            var tier = ParseTier(option.Tier);
            if (agent is not null || tier is not null)
            {
                map[key] = new PipelineStageOverrideDto(agent, tier);
            }
        }

        return map.Count > 0 ? map : null;
    }

    private static AgentType? ParseAgent(string? value) =>
        Enum.TryParse<AgentType>(value, out var agent) ? agent : null;

    private static AgentModelTier? ParseTier(string? value) =>
        Enum.TryParse<AgentModelTier>(value, out var tier) ? tier : null;

    private void OpenRun(string runId) => Nav.NavigateTo($"/cockpit/runs/{runId}");

    private static int CompletedStages(PipelineExecutionDto run) =>
        run.Stages.Count(s => s.Status is "Completed" or "Skipped");

    public async ValueTask DisposeAsync()
    {
        try
        {
            _rowRefreshCts.Cancel();
            _rowRefreshCts.Dispose();
            _cts.Cancel();
            _cts.Dispose();
        }
        catch (ObjectDisposedException)
        {
        }

        if (_hub is not null)
        {
            try
            {
                if (_hub.State == HubConnectionState.Connected)
                {
                    await _hub.InvokeAsync("LeaveRunsGroup");
                }
                await _hub.DisposeAsync();
            }
            catch
            {
                // Dispose is best-effort.
            }
        }
    }

    private sealed class RunStartForm
    {
        public string? TemplateId { get; set; }
        public string? RepositoryFullName { get; set; }
        public string? BaseBranch { get; set; } = "main";
        public string? IssueId { get; set; }
        public string? SpecPath { get; set; }
        public string? Prompt { get; set; }
        public decimal? MaxBudgetUsd { get; set; }
        public AgentType AgentType { get; set; } = AgentType.Codex;
        public AgentModelTier ModelTier { get; set; } = AgentModelTier.Normal;
        public bool RunVerification { get; set; } = true;
        /// <summary>Single agent mode for multi-stage templates (SPEC-20260922 RF-005).</summary>
        public bool SingleAgent { get; set; }
        /// <summary>Single-agent CLI — empty means Auto (server picks one eligible CLI).</summary>
        public string? SingleAgentType { get; set; }
        /// <summary>Single-agent tier — empty keeps each stage's template default.</summary>
        public string? SingleAgentTier { get; set; }
    }

    private sealed class StageOption
    {
        /// <summary>Stage agent pick — empty means Auto.</summary>
        public string Agent { get; set; } = "";
        /// <summary>Stage tier pick — empty keeps the template default.</summary>
        public string Tier { get; set; } = "";
    }
}
