@page "/workflow"
@attribute [Authorize]
@implements IDisposable
@inject IGitHubService GitHubService
@inject SelectedRepositoryService RepoService

<PageTitle>Workflow - Harness</PageTitle>

<div class="d-flex align-items-center mb-1">
    <h1 class="h4 fw-bold mb-0">Workflow</h1>
    @if (RepoService.Selected is not null)
    {
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="RefreshAsync" disabled="@_isLoadingWorkflows">
            <Icon Name="IconName.ArrowClockwise" /> Refresh
        </button>
    }
</div>
<p class="small text-body-secondary mb-4">GitHub Actions runs per repository (read-only)</p>

@if (_isLoading)
{
    <Loading Message="Loading repositories..." />
}
else
{
    @if (RepoService.Warning is not null)
    {
        <div class="alert alert-warning">@RepoService.Warning</div>
    }
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_isLoadingWorkflows)
    {
        <Loading Message="Loading workflows..." />
    }
    else if (_workflows is not null)
    {
        @if (_workflows.Count == 0)
        {
            <EmptyState Message="No GitHub Actions workflows in this repository." />
        }
        else
        {
            @foreach (var workflow in _workflows)
            {
                var expanded = _expanded.Contains(workflow.Id);
                <div class="card mb-2" @key="workflow.Id">
                    <div class="card-header d-flex align-items-center gap-2 py-2" role="button" @onclick="() => ToggleWorkflowAsync(workflow)">
                        <Icon Name="@(expanded ? IconName.ChevronDown : IconName.ChevronRight)" class="text-body-secondary" />
                        <div class="me-auto">
                            <span class="fw-semibold">@workflow.Name</span>
                            <span class="small text-body-secondary ms-2">@ShortPath(workflow.Path)</span>
                        </div>
                        @if (workflow.State != "active")
                        {
                            <span class="badge text-bg-secondary">@workflow.State</span>
                        }
                        @if (workflow.LastRun is { } lastRun)
                        {
                            <span class="@WorkflowRunBadge.CssClass(lastRun.Status, lastRun.Conclusion)">
                                @WorkflowRunBadge.Label(lastRun.Status, lastRun.Conclusion)
                            </span>
                            <span class="small text-body-secondary">@RelativeTime(lastRun.UpdatedAt)</span>
                        }
                        else
                        {
                            <span class="small text-body-secondary">No runs yet</span>
                        }
                        <a href="@workflow.HtmlUrl" target="_blank" rel="noopener" class="small" @onclick:stopPropagation="true">↗</a>
                    </div>
                    @if (expanded)
                    {
                        <div class="card-body p-0">
                            @if (_runsLoading.Contains(workflow.Id))
                            {
                                <div class="p-3"><Loading Message="Loading runs..." /></div>
                            }
                            else if (_runs.TryGetValue(workflow.Id, out var runs))
                            {
                                @if (runs.Count == 0)
                                {
                                    <div class="p-3"><EmptyState Message="No runs for this workflow." /></div>
                                }
                                else
                                {
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-3">Run</th>
                                                <th>Status</th>
                                                <th>Branch</th>
                                                <th>SHA</th>
                                                <th>Actor</th>
                                                <th>Duration</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var run in runs)
                                            {
                                                <tr @key="run.Id">
                                                    <td class="ps-3">
                                                        <span class="small">#@run.RunNumber</span>
                                                        @if (!string.IsNullOrWhiteSpace(run.DisplayTitle))
                                                        {
                                                            <span class="small text-body-secondary ms-1">@Truncate(run.DisplayTitle, 60)</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="@WorkflowRunBadge.CssClass(run.Status, run.Conclusion)">
                                                            @WorkflowRunBadge.Label(run.Status, run.Conclusion)
                                                        </span>
                                                    </td>
                                                    <td class="small">@run.HeadBranch</td>
                                                    <td class="workflow-run-sha">@ShortSha(run.HeadSha)</td>
                                                    <td class="small">@run.ActorLogin</td>
                                                    <td class="small">@FormatDuration(run)</td>
                                                    <td><a href="@run.HtmlUrl" target="_blank" rel="noopener" class="small">↗</a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    }
    else if (RepoService.Selected is null)
    {
        <EmptyState Message="Type or select a repository to load its workflows." />
    }
}

@code {
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(60);

    private bool _isLoading = true;
    private bool _isLoadingWorkflows;
    private string? _errorMessage;
    private IReadOnlyList<WorkflowDto>? _workflows;
    private readonly HashSet<long> _expanded = [];
    private readonly HashSet<long> _runsLoading = [];
    private readonly Dictionary<long, IReadOnlyList<WorkflowRunDto>> _runs = new();
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        RepoService.Changed += OnRepoChangedAsync;
        await RepoService.EnsureLoadedAsync();
        await LoadWorkflowsAsync();
        _isLoading = false;
    }

    private Task OnRepoChangedAsync() => InvokeAsync(async () =>
    {
        _expanded.Clear();
        _runs.Clear();
        await LoadWorkflowsAsync();
        StateHasChanged();
    });

    private Task RefreshAsync() => LoadWorkflowsAsync();

    private async Task LoadWorkflowsAsync()
    {
        var repo = RepoService.Selected;
        if (repo is null)
        {
            _workflows = null;
            return;
        }

        _isLoadingWorkflows = true;
        _errorMessage = null;
        try
        {
            var workflows = await GitHubService.GetWorkflowsAsync(repo);
            // Discard stale responses on rapid repo switches.
            if (!string.Equals(repo, RepoService.Selected, StringComparison.Ordinal))
            {
                return;
            }

            _workflows = workflows;
            foreach (var id in _expanded.ToList())
            {
                await LoadRunsAsync(id);
            }

            UpdateRefreshTimer();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load workflows: {ex.Message}";
            _workflows = null;
        }
        finally
        {
            _isLoadingWorkflows = false;
        }
    }

    private async Task ToggleWorkflowAsync(WorkflowDto workflow)
    {
        if (!_expanded.Add(workflow.Id))
        {
            _expanded.Remove(workflow.Id);
            return;
        }

        await LoadRunsAsync(workflow.Id);
    }

    private async Task LoadRunsAsync(long workflowId)
    {
        var repo = RepoService.Selected;
        if (repo is null)
        {
            return;
        }

        _runsLoading.Add(workflowId);
        try
        {
            var runs = await GitHubService.GetWorkflowRunsAsync(repo, workflowId, 10);
            if (!string.Equals(repo, RepoService.Selected, StringComparison.Ordinal))
            {
                return; // stale response from a previous selection
            }

            _runs[workflowId] = runs;
        }
        catch (Exception)
        {
            _runs[workflowId] = [];
        }
        finally
        {
            _runsLoading.Remove(workflowId);
        }
    }

    private void UpdateRefreshTimer()
    {
        var hasLive = _workflows?.Any(w => w.LastRun is { } r && WorkflowRunBadge.IsLive(r.Status)) == true
            || _runs.Values.Any(rs => rs.Any(r => WorkflowRunBadge.IsLive(r.Status)));

        if (hasLive && _refreshTimer is null)
        {
            _refreshTimer = new System.Threading.Timer(
                _ => _ = InvokeAsync(async () =>
                {
                    await LoadWorkflowsAsync();
                    StateHasChanged();
                }),
                null, AutoRefreshInterval, AutoRefreshInterval);
        }
        else if (!hasLive)
        {
            _refreshTimer?.Dispose();
            _refreshTimer = null;
        }
    }

    private static string ShortPath(string path)
    {
        var file = path.Split('/').LastOrDefault() ?? path;
        return file;
    }

    private static string ShortSha(string? sha) =>
        string.IsNullOrWhiteSpace(sha) ? "—" : sha[..Math.Min(7, sha.Length)];

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "…";

    private static string RelativeTime(DateTimeOffset at)
    {
        var elapsed = DateTimeOffset.UtcNow - at;
        if (elapsed.TotalMinutes < 1)
        {
            return "just now";
        }
        if (elapsed.TotalHours < 1)
        {
            return $"{(int)elapsed.TotalMinutes}m ago";
        }
        if (elapsed.TotalDays < 1)
        {
            return $"{(int)elapsed.TotalHours}h ago";
        }
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private static string FormatDuration(WorkflowRunDto run)
    {
        if (WorkflowRunBadge.IsLive(run.Status))
        {
            var started = run.RunStartedAt == default ? run.CreatedAt : run.RunStartedAt;
            var elapsed = DateTimeOffset.UtcNow - started;
            return $"running {FormatSpan(elapsed)}";
        }

        return FormatSpan(run.UpdatedAt - run.CreatedAt);
    }

    private static string FormatSpan(TimeSpan span)
    {
        if (span.TotalMinutes < 1)
        {
            return $"{(int)span.TotalSeconds}s";
        }
        if (span.TotalHours < 1)
        {
            return $"{(int)span.TotalMinutes}m";
        }
        return $"{(int)span.TotalHours}h {span.Minutes}m";
    }

    public void Dispose()
    {
        RepoService.Changed -= OnRepoChangedAsync;
        _refreshTimer?.Dispose();
    }
}
