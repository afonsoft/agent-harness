@page "/settings"
@attribute [Authorize]
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject ToastService ToastService

<PageTitle>Settings - Taskboard</PageTitle>

<div class="settings-page">
    <h1 class="h4 fw-bold mb-1">Settings</h1>
    <p class="small text-body-secondary mb-4">Customize your workspace and agents</p>

    @if (_isLoading)
    {
        <Loading Message="Loading settings..." />
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-4">@_errorMessage</div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">
                <div class="form-section">
                    <h2 class="form-section-title">Integrations</h2>
                    <label class="form-label" for="github-token">GitHub token</label>
                    <p class="small text-body-secondary">Paste a personal access token with repo scope.</p>
                    <div class="setting-row-input">
                        <input id="github-token" type="@_tokenInputType" class="form-control" @bind="_gitHubToken" placeholder="ghp_…" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleTokenVisibility">@_tokenToggleLabel</button>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Security</h2>
                    <label class="form-label" for="current-password">Change password</label>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <input id="current-password" type="password" class="form-control" @bind="_currentPassword" placeholder="Current password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_newPassword" placeholder="New password" aria-label="New password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_confirmPassword" placeholder="Confirm new password" aria-label="Confirm new password" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_passwordError))
                    {
                        <p class="mt-2 small text-danger">@_passwordError</p>
                    }
                    <div class="mt-3">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ChangePasswordAsync">Change password</button>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Agents</h2>
                    @if (!_agents.Any())
                    {
                        <EmptyState Message="No agents discovered." />
                    }
                    else
                    {
                        <div>
                            @foreach (var agent in _agents)
                            {
                                <div class="setting-row" @key="agent.Type">
                                    <div>
                                        <div class="fw-medium">@agent.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                                        {
                                            <div class="small text-body-secondary">@agent.Description</div>
                                        }
                                        <div class="small text-body-secondary">@agent.Type@(string.IsNullOrWhiteSpace(agent.Version) ? "" : $" · v{agent.Version}")</div>
                                    </div>
                                    <div class="form-check form-switch mb-0">
                                        <input type="checkbox" role="switch" class="form-check-input" checked="@_enabledState[agent.Type]" @onchange="e => ToggleAgent(agent.Type, (bool)e.Value!)" aria-label="Enable @agent.Name" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="action-bar">
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetAsync">Reset</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save changes</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _gitHubToken;
    private string? _originalGitHubToken;
    private IReadOnlyList<AgentPreferenceDto> _agents = [];
    private readonly Dictionary<AgentType, bool> _enabledState = new();
    private readonly Dictionary<AgentType, bool> _originalEnabledState = new();

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;

    private string _tokenInputType = "password";
    private string _tokenToggleLabel = "Show";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Client.GetSettingsAsync();
            _gitHubToken = settings.GitHubToken;
            _originalGitHubToken = _gitHubToken;
            _agents = settings.Agents;
            _enabledState.Clear();
            _originalEnabledState.Clear();
            foreach (var agent in _agents)
            {
                _enabledState[agent.Type] = agent.Enabled;
                _originalEnabledState[agent.Type] = agent.Enabled;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleTokenVisibility()
    {
        if (_tokenInputType == "password")
        {
            _tokenInputType = "text";
            _tokenToggleLabel = "Hide";
        }
        else
        {
            _tokenInputType = "password";
            _tokenToggleLabel = "Show";
        }
    }

    private void ToggleAgent(AgentType type, bool enabled)
    {
        _enabledState[type] = enabled;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _passwordError = "All fields are required.";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _passwordError = "New passwords do not match.";
            return;
        }

        try
        {
            await Client.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
            ToastService.Notify(new(ToastType.Success, "Password changed"));
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
        }
        catch (HttpRequestException)
        {
            _passwordError = "Current password is incorrect.";
        }
    }

    private void ResetAsync()
    {
        _gitHubToken = _originalGitHubToken;
        foreach (var (type, value) in _originalEnabledState)
        {
            _enabledState[type] = value;
        }
        _passwordError = null;
        ToastService.Notify(new(ToastType.Info, "Settings reset"));
    }

    private async Task SaveAsync()
    {
        var request = new SaveSettingsRequest(
            "light",
            _gitHubToken,
            _enabledState.Where(kv => kv.Value).Select(kv => kv.Key.ToString()).ToList().AsReadOnly());
        await Client.SaveSettingsAsync(request);
        ToastService.Notify(new(ToastType.Success, "Settings saved"));
        Navigation.NavigateTo("/settings", forceLoad: true);
    }
}
