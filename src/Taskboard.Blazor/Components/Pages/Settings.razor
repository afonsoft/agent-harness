    private static string GetMcpBadgeClass(McpAgentResult agent) => agent.State switch
    {
        McpAgentState.Configured => "text-bg-success",
        McpAgentState.Updated => "text-bg-info",
        McpAgentState.Failed => "text-bg-danger",
        McpAgentState.Repaired => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private static string McpBadgeTitle(McpAgentResult agent) =>
        agent.Error is null ? agent.Path : $"{agent.Path} — {agent.Error}";

    private static string GetMcpBadgeLabel(McpAgentResult agent) => agent.State switch
    {
        McpAgentState.Configured => "configured",
        McpAgentState.Updated => "updated",
        McpAgentState.Repaired => "repaired",
        McpAgentState.Removed => "removed",
        McpAgentState.Failed => "error",
        McpAgentState.Skipped => "skipped",
        _ => "not configured"
    };

    private async Task SaveRagAsync()
    {
        _ragBusy = true;
        _ragError = null;
        try
        {
            // Blank key keeps the stored value; the API treats "" as clear.
            var error = await Client.SaveRagMcpAsync(
                _ragName.Trim(),
                _ragUrl.Trim(),
                string.IsNullOrWhiteSpace(_ragApiKey) ? null : _ragApiKey.Trim());
            if (error is not null)
            {
                _ragError = error;
                return;
            }

