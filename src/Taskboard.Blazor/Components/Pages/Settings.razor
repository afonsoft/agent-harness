    private async Task InstallAgentMcpAsync()
    {
        _mcpAddError = null;
        if (string.IsNullOrWhiteSpace(_mcpAddName))
        {
            _mcpAddError = "Name is required.";
            return;
        }

        var isHttp = _mcpAddTransport == "http";
        if (isHttp ? string.IsNullOrWhiteSpace(_mcpAddUrl) : string.IsNullOrWhiteSpace(_mcpAddCommand))
        {
            _mcpAddError = isHttp ? "URL is required." : "Command is required.";
            return;
        }

        if (_mcpAddAgents.Count == 0)
        {
            _mcpAddError = "Select at least one agent.";
            return;
        }

        _mcpBusy = true;
        try
        {
            var args = isHttp
                ? null
                : _mcpAddArgs.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var (results, error) = await Client.InstallAgentMcpAsync(new AgentMcpInstallRequest(
                _mcpAddName.Trim(),
                Url: isHttp ? _mcpAddUrl.Trim() : null,
                Command: isHttp ? null : _mcpAddCommand.Trim(),
                Args: args,
                Headers: null,
                Env: null,
                Agents: _mcpAddAgents.ToList()));
            if (error is not null)
            {
                _mcpAddError = error;
                return;
            }

            _mcpApplyResults = results;
            _mcpAddName = _mcpAddUrl = _mcpAddCommand = _mcpAddArgs = string.Empty;
            await _mcpAddModal.HideAsync();
            _agentMcpInventory = await Client.GetAgentMcpInventoryAsync();
            await LoadChatMcpServersAsync();
        }
        finally
        {
            _mcpBusy = false;
        }
    }

    private async Task OpenMcpRemoveModalAsync(AgentType agent, string serverName)
    {
        _removeAgent = agent;
        _removeServerName = serverName;
        await _mcpRemoveModal.ShowAsync();
    }

    private async Task CloseMcpRemoveModalAsync() => await _mcpRemoveModal.HideAsync();

    private async Task RemoveAgentMcpAsync()
    {
        if (_removeAgent is null || string.IsNullOrWhiteSpace(_removeServerName))
        {
            return;
        }

        _mcpBusy = true;
        try
        {
            var (results, error) = await Client.RemoveAgentMcpAsync(
                new AgentMcpRemoveRequest(_removeServerName, [_removeAgent.Value]));
            if (error is not null)
            {
                _agentMcpError = error;
            }
            else
            {
                _mcpApplyResults = results;
            }

            await _mcpRemoveModal.HideAsync();
            _agentMcpInventory = await Client.GetAgentMcpInventoryAsync();
        }
        finally
        {
            _mcpBusy = false;
        }
    }

    private static string McpOriginBadgeClass(string? origin) => origin switch
    {
        "agents-global" => "text-bg-primary",
        "rag" => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private async Task InstallSkillsRepoAsync()
    {
        _skillsRepoError = null;
        _skillsBusy = true;
        try
        {
            var (status, error) = await Client.InstallSkillsRepositoryAsync(
                string.IsNullOrWhiteSpace(_skillsRepoInstall) ? null : _skillsRepoInstall.Trim());
            if (error is not null)
            {
                _skillsRepoError = error;
                return;
            }

            await ToastService.NotifyAsync(new(ToastType.Success, "Skills install started"));
        }
        finally
        {
            _skillsBusy = false;
        }
    }

    private async Task SearchSkillsAsync()
    {
        _skillsSearchError = null;
        _skillResults = [];
        if (string.IsNullOrWhiteSpace(_skillsQuery))
        {
            _skillsSearchError = "Type a search query.";
            return;
        }

        _skillsBusy = true;
        try
        {
            _skillResults = await Client.SearchSkillsAsync(_skillsQuery.Trim());
            if (_skillResults.Count == 0)
            {
                _skillsSearchError = "No results — search requires npx available on the server.";
            }
        }
        catch (HttpRequestException ex)
        {
            _skillsSearchError = $"Search failed: {ex.Message}";
        }
        finally
        {
            _skillsBusy = false;
        }
    }

    private static string SkillRowKey(SkillSearchResultDto result) => result.Repository + "@" + result.Name;

    // merged de config + ~/.agents + RAG — o mesmo nome pode vir de origens
    // diferentes; keys por Name sozinho quebram o render (dup key crash).
    private static string ChatMcpServerKey(ChatMcpServerStatus server) => server.Name + "@" + server.Origin;

    private static string AgentMcpServerKey(AgentMcpServerEntryDto server) => server.Name + "@" + server.Transport + "@" + server.Detail;

    // a mesma key pode aparecer duas vezes (registry + redis scan) — o source
    // diferencia para o @key ficar único entre irmãos.
    private static string CacheKeyRowKey(CacheKeyItemDto item) => item.Source + "@" + item.Key;

    private async Task InstallOneSkillAsync(SkillSearchResultDto result)
    {
        _skillsSearchError = null;
        if (string.IsNullOrWhiteSpace(result.Repository))
        {
            _skillsSearchError = "This row has no repository — install it manually.";
            return;
        }

        _skillsBusy = true;
        try
        {
            var (step, error) = await Client.InstallSkillAsync(result.Repository, result.Skill);
            if (error is not null || step?.State == SkillsInstallStepState.Failed)
            {
                _skillsSearchError = error ?? step?.Message ?? "Install failed.";
                return;
            }

            await ToastService.NotifyAsync(new(ToastType.Success, $"{result.Name} installed"));
            _installedSkills = await Client.GetSkillsAsync();
        }
        finally
        {
            _skillsBusy = false;
        }
    }
}
