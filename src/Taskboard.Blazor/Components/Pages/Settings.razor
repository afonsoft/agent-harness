    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // ?tab= deep link — refresh/URL preserves the selected tab.
        var tab = ResolveTabFromQuery();
        if (tab is not null && SettingsTabs.Any(t => t.Id == tab))
        {
            _activeTab = tab;
