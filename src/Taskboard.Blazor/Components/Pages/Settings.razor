        }
    }

    private static ISet<string> ParseDisabledIds(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new HashSet<string>(StringComparer.Ordinal);
        }

        try
        {
            var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(raw);
            return ids is null
                ? new HashSet<string>(StringComparer.Ordinal)
                : new HashSet<string>(ids, StringComparer.Ordinal);
        }
        catch (System.Text.Json.JsonException)
        {
            return new HashSet<string>(StringComparer.Ordinal);
        }
    }

    // SPEC-20260929-ai-code-provider-chat RF-011.
    private async Task LoadChatStateAsync()
    {
        _chatBusy = true;
        try
        {
            _chatProviders = await Client.GetChatProvidersAsync();
            try
            {
                _capabilities = await Client.GetChatCapabilitiesAsync();
            }
            catch
            {
                _capabilities = [];
            }

            foreach (var capability in ChatCapabilities)
            {
                var state = _chatCapability[capability];
                var raw = _configEntries.FirstOrDefault(e => e.Key == state.ConfigKey)?.EffectiveValue;
                (state.ProviderId, state.Model) = ParseCapabilityValue(raw);
                if (!string.IsNullOrEmpty(state.ProviderId))
                {
                    await LoadCapabilityModelsAsync(capability, state);
                }
            }

            var backend = _configEntries.FirstOrDefault(e => e.Key == "Taskboard:Chat:SearchBackend")?.EffectiveValue;
            _chatSearchBackend = string.IsNullOrWhiteSpace(backend) ? "none" : backend;
            _chatSearchUrl = _configEntries.FirstOrDefault(e => e.Key == "Taskboard:Chat:SearchUrl")?.EffectiveValue ?? string.Empty;
        }
        catch (Exception ex)
        {
            _chatError = $"Failed to load chat settings: {ex.Message}";
        }
        finally
        {
            _chatBusy = false;
        }
    }

    private static (string ProviderId, string Model) ParseCapabilityValue(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return (string.Empty, string.Empty);
        }

        var separator = raw.IndexOf(':');
        return separator <= 0
            ? (string.Empty, string.Empty)
            : (raw[..separator], raw[(separator + 1)..]);
    }

    private async Task LoadCapabilityModelsAsync(string capability, ChatCapabilityState state)
    {
        try
        {
            state.Models = await Client.GetChatProviderModelsAsync(Guid.Parse(state.ProviderId));
        }
        catch (Exception)
        {
            state.Models = [];
        }
    }

    private async Task OnCapabilityProviderChangedAsync(string capability)
    {
        var state = _chatCapability[capability];
        state.Model = string.Empty;
        state.Models = [];
        if (Guid.TryParse(state.ProviderId, out var providerId))
        {
            try
            {
                state.Models = await Client.GetChatProviderModelsAsync(providerId);
                state.Model = state.Models.Count > 0 ? state.Models[0] : string.Empty;
            }
            catch (Exception ex)
            {
                _chatError = $"Failed to load models: {ex.Message}";
            }
        }
    }

    private async Task SaveCapabilityAsync(string capability)
    {
        var state = _chatCapability[capability];
        var value = string.IsNullOrEmpty(state.ProviderId) || string.IsNullOrEmpty(state.Model)
            ? string.Empty
            : $"{state.ProviderId}:{state.Model}";
        var error = await Client.SetConfigurationValueAsync(state.ConfigKey, value);
        if (error is not null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to save {capability} default: {error}"));
            return;
        }

        await ToastService.NotifyAsync(new(ToastType.Success, $"{capability} default model saved"));
        await LoadConfigurationAsync();
    }

