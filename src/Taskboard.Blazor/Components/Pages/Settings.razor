@page "/settings"
@attribute [Authorize]
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject IGitHubService GitHubService
@implements IDisposable

<PageTitle>Settings - Taskboard</PageTitle>

<div class="settings-page">
    <h1 class="h4 fw-bold mb-1">Settings</h1>
    <p class="small text-body-secondary mb-4">Customize your workspace and agents</p>

    @if (_isLoading)
    {
        <Loading Message="Loading settings..." />
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-4">@_errorMessage</div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">
                <div class="form-section">
                    <h2 class="form-section-title">Integrations</h2>
                    <label class="form-label" for="github-token">GitHub token</label>
                    <p class="small text-body-secondary">Paste a personal access token with repo scope.</p>
                    <div class="setting-row-input">
                        <input id="github-token" type="@_tokenInputType" class="form-control" @bind="_gitHubToken" placeholder="ghp_…" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleTokenVisibility">@_tokenToggleLabel</button>
                    </div>

                    <label class="form-label mt-3" for="skills-repo">Skills source repository</label>
                    <p class="small text-body-secondary">Git repository cloned to install agent skills on each enabled CLI.</p>
                    <div class="setting-row-input">
                        <RepositoryCombobox Id="skills-repo"
                                            AriaLabel="Skills source repository"
                                            Placeholder="owner/repo"
                                            Repositories="@_repoNames"
                                            @bind-Value="_skillsRepo" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="SaveSkillsRepoAsync">Save</button>
                        @if (_skillsRepoIsOverride)
                        {
                            <button type="button" class="btn btn-outline-danger text-nowrap" @onclick="ResetSkillsRepoAsync">Reset</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_skillsRepoError))
                    {
                        <p class="mt-2 small text-danger">@_skillsRepoError</p>
                    }
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Agent Skills</h2>
                    <p class="small text-body-secondary">
                        Global install of the configured skills repository into every supported agent CLI
                        (<code>npx skills add &lt;repo&gt; -g --all --copy</code> + <code>install.sh --all</code>).
                    </p>

                    @if (_skillsInstall is null)
                    {
                        <p class="small text-body-secondary">Status unavailable.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            @if (_skillsInstall.Installed)
                            {
                                <span class="badge text-bg-success">Installed — @_skillsInstall.SkillCount skills</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Not installed</span>
                            }
                            @foreach (var prereq in _skillsInstall.Prerequisites)
                            {
                                <span class="badge @(prereq.Value ? "text-bg-success" : "text-bg-danger")"
                                      title="@(prereq.Value ? "available" : "missing")">@prereq.Key</span>
                            }
                        </div>
                        <div class="small text-body-secondary mb-2">
                            Repository: <code>@(_skillsInstall.Repository ?? "—")</code>
                            @if (_skillsInstall.LastRunUtc is not null)
                            {
                                <span class="ms-2">Last run: @_skillsInstall.LastRunUtc.Value.LocalDateTime.ToString("g")</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_skillsInstall.Error))
                        {
                            <p class="small text-danger mb-2">@_skillsInstall.Error</p>
                        }
                        @if (_skillsInstall.Steps.Count > 0)
                        {
                            <ul class="small mb-2">
                                @foreach (var step in _skillsInstall.Steps)
                                {
                                    <li>
                                        <code>@step.Name</code> — @step.State
                                        @if (!string.IsNullOrWhiteSpace(step.Message))
                                        {
                                            <span class="text-body-secondary">(@step.Message)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (_skillsInstall.Locations.Count > 0)
                        {
                            <ul class="small mb-2">
                                @foreach (var location in _skillsInstall.Locations)
                                {
                                    <li><code>@location.Path</code> — @location.Count skills</li>
                                }
                            </ul>
                        }
                        @if (_skillsSync is not null && _skillsSync.LastRunUtc is not null)
                        {
                            <p class="small text-body-secondary mb-2">
                                Sync: @_skillsSync.State — @_skillsSync.LastRunUtc.Value.LocalDateTime.ToString("g")
                            </p>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-primary"
                                    disabled="@(_skillsBusy || !_skillsInstall.Prerequisites.GetValueOrDefault("npx") || !_skillsInstall.Prerequisites.GetValueOrDefault("git"))"
                                    title="@SkillsInstallButtonTitle()"
                                    @onclick="InstallSkillsAsync">Install</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_skillsBusy" @onclick="VerifySkillsAsync">Verify</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_skillsBusy" @onclick="SyncSkillsAsync">Sync</button>
                        </div>
                    }
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">RAG / Knowledge MCP</h2>
                    <p class="small text-body-secondary">
                        Provision the RAG MCP server into every enabled agent CLI config
                        (<code>~/.claude.json</code>, <code>~/.codex/config.toml</code>, …).
                    </p>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="rag-name">Server name</label>
                            <input id="rag-name" type="text" class="form-control font-monospace" @bind="_ragName" placeholder="knowledge" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="rag-url">MCP URL</label>
                            <input id="rag-url" type="text" class="form-control font-monospace" @bind="_ragUrl" placeholder="https://rag.afonsoft.dev/mcp" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="rag-key">API key</label>
                        <div class="setting-row-input">
                            <input id="rag-key" type="@_ragKeyInputType" class="form-control font-monospace" @bind="_ragApiKey" placeholder="@(_ragKeySet ? "•••• (unchanged)" : "aft_…")" />
                            <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleRagKeyVisibility">@_ragKeyToggleLabel</button>
                        </div>
                        <p class="small text-body-secondary mt-1 mb-0">Leave blank to keep the stored key.</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_ragError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@_ragError</div>
                    }

                    @if (_mcpStatus is not null && _mcpStatus.Agents.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var agent in _mcpStatus.Agents)
                            {
                                <span class="badge @GetMcpBadgeClass(agent)" title="@McpBadgeTitle(agent)">
                                    @agent.Agent — @GetMcpBadgeLabel(agent)
                                </span>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="button" class="btn btn-outline-primary" disabled="@_ragBusy" @onclick="SaveRagAsync">Save &amp; Sync</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@_ragBusy" @onclick="SyncMcpAsync">Sync</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@_ragBusy" @onclick="VerifyMcpAsync">Verify</button>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Security</h2>
                    <label class="form-label" for="current-password">Change password</label>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <input id="current-password" type="password" class="form-control" @bind="_currentPassword" placeholder="Current password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_newPassword" placeholder="New password" aria-label="New password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_confirmPassword" placeholder="Confirm new password" aria-label="Confirm new password" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_passwordError))
                    {
                        <p class="mt-2 small text-danger">@_passwordError</p>
                    }
                    <div class="mt-3">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ChangePasswordAsync">Change password</button>
                    </div>
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Agents</h2>
                    @if (!_agents.Any())
                    {
                        <EmptyState Message="No agents discovered." />
                    }
                    else
                    {
                        <div>
                            @foreach (var agent in _agents)
                            {
                                <div class="setting-row" @key="agent.Type">
                                    <div>
                                        <div class="fw-medium">@agent.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                                        {
                                            <div class="small text-body-secondary">@agent.Description</div>
                                        }
                                        <div class="small text-body-secondary">@agent.Type@(string.IsNullOrWhiteSpace(agent.Version) ? "" : $" · v{agent.Version}")</div>
                                    </div>
                                    <div class="form-check form-switch mb-0">
                                        <input type="checkbox" role="switch" class="form-check-input" checked="@_enabledState[agent.Type]" @onchange="e => ToggleAgent(agent.Type, (bool)e.Value!)" aria-label="Enable @agent.Name" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Configuration</h2>
                    <p class="small text-body-secondary">Database overrides win over environment variables and appsettings.</p>
                    @if (_configError is not null)
                    {
                        <div class="alert alert-warning mb-0">@_configError</div>
                    }
                    else if (_configEntries.Count == 0)
                    {
                        <EmptyState Message="No configuration keys." />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Key</th>
                                        <th scope="col">Value</th>
                                        <th scope="col">Source</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _configEntries)
                                    {
                                        <tr @key="entry.Key">
                                            <td class="font-monospace small">@entry.Key</td>
                                            <td class="small">
                                                @if (_editingKey == entry.Key)
                                                {
                                                    <input type="text" class="form-control form-control-sm font-monospace" @bind="_editingValue" aria-label="Value for @entry.Key" />
                                                }
                                                else
                                                {
                                                    @(entry.EffectiveValue ?? "—")
                                                    @if (entry.RequiresRestart)
                                                    {
                                                        <span class="badge text-bg-secondary ms-1" title="Applies on next restart">restart</span>
                                                    }
                                                }
                                            </td>
                                            <td><span class="badge @GetSourceBadgeClass(entry.Source)">@entry.Source</span></td>
                                            <td class="text-end text-nowrap">
                                                @if (_editingKey == entry.Key)
                                                {
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => SaveConfigAsync(entry)">Save</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelConfigEdit">Cancel</button>
                                                }
                                                else if (entry.Editable)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartConfigEdit(entry)">Edit</button>
                                                    @if (entry.Source == "db")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ResetConfigAsync(entry)">Reset</button>
                                                    }
                                                }
                                                else if (!string.IsNullOrEmpty(entry.ReadOnlyReason))
                                                {
                                                    <span class="small text-body-secondary" title="@entry.ReadOnlyReason">read-only</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="action-bar">
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetAsync">Reset</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save changes</button>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _gitHubToken;
    private string? _originalGitHubToken;
    private IReadOnlyList<AgentPreferenceDto> _agents = [];
    private readonly Dictionary<AgentType, bool> _enabledState = new();
    private readonly Dictionary<AgentType, bool> _originalEnabledState = new();

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;

    private string _tokenInputType = "password";
    private string _tokenToggleLabel = "Show";

    private IReadOnlyList<ConfigurationEntryDto> _configEntries = [];
    private string? _configError;
    private string? _editingKey;
    private string _editingValue = string.Empty;

    private const string SkillsRepositoryKey = "Taskboard:Skills:Repository";
    private string _skillsRepo = string.Empty;
    private bool _skillsRepoIsOverride;
    private string? _skillsRepoError;
    private IReadOnlyList<string> _repoNames = [];

    private SkillsInstallStatus? _skillsInstall;
    private SkillsSyncStatus? _skillsSync;
    private bool _skillsBusy;
    private CancellationTokenSource? _pollCts;

    private const string RagServerNameKey = "Taskboard:Rag:ServerName";
    private const string RagUrlKey = "Taskboard:Rag:Url";
    private const string RagApiKeyKey = "Taskboard:Rag:ApiKey";
    private McpProvisionStatus? _mcpStatus;
    private string _ragName = "knowledge";
    private string _ragUrl = string.Empty;
    private string _ragApiKey = string.Empty;
    private bool _ragKeySet;
    private bool _ragBusy;
    private string? _ragError;
    private string _ragKeyInputType = "password";
    private string _ragKeyToggleLabel = "Show";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Client.GetSettingsAsync();
            _gitHubToken = settings.GitHubToken;
            _originalGitHubToken = _gitHubToken;
            _agents = settings.Agents;
            _enabledState.Clear();
            _originalEnabledState.Clear();
            foreach (var agent in _agents)
            {
                _enabledState[agent.Type] = agent.Enabled;
                _originalEnabledState[agent.Type] = agent.Enabled;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        try
        {
            var repositories = await GitHubService.GetRepositoriesAsync();
            _repoNames = repositories.Select(r => r.FullName).OrderBy(n => n).ToList();
        }
        catch
        {
            // No GitHub token or API failure — free-text owner/repo stays usable.
            _repoNames = [];
        }

        await LoadConfigurationAsync();
        await LoadSkillsStatusAsync();
        await LoadMcpStatusAsync();
    }

    private async Task LoadSkillsStatusAsync()
    {
        try
        {
            _skillsInstall = await Client.GetSkillsInstallStatusAsync();
            _skillsSync = await Client.GetSkillsSyncStatusAsync();
        }
        catch
        {
            _skillsInstall = null;
        }
    }

    private string SkillsInstallButtonTitle()
    {
        if (_skillsInstall is null)
        {
            return "Install the configured skills repository globally";
        }

        var missing = _skillsInstall.Prerequisites
            .Where(p => !p.Value)
            .Select(p => p.Key)
            .ToList();
        return missing.Count > 0
            ? $"Missing prerequisites: {string.Join(", ", missing)}"
            : "Install the configured skills repository globally";
    }

    private void StartStatusPolling()
    {
        if (_pollCts is not null)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _ = PollStatusLoopAsync(_pollCts.Token);
    }

    private async Task PollStatusLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    if (_skillsInstall?.State == SkillsSyncState.Running)
                    {
                        _skillsInstall = await Client.GetSkillsInstallStatusAsync();
                    }

                    if (_skillsSync?.State == SkillsSyncState.Running)
                    {
                        _skillsSync = await Client.GetSkillsSyncStatusAsync();
                    }

                    if (_mcpStatus?.State == McpProvisionState.Running)
                    {
                        _mcpStatus = await Client.GetMcpStatusAsync();
                    }
                }
                catch
                {
                    // Transient poll failure — next tick retries.
                }

                var running = _skillsInstall?.State == SkillsSyncState.Running
                    || _skillsSync?.State == SkillsSyncState.Running
                    || _mcpStatus?.State == McpProvisionState.Running;
                await InvokeAsync(StateHasChanged);
                if (!running)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _pollCts = null;
        }
    }

    public void Dispose() => _pollCts?.Cancel();

    private async Task InstallSkillsAsync()
    {
        _skillsBusy = true;
        try
        {
            _skillsInstall = await Client.InstallSkillsAsync();
            ToastService.Notify(new(ToastType.Info, "Skills install started"));
            if (_skillsInstall?.State == SkillsSyncState.Running)
            {
                StartStatusPolling();
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to start skills install: {ex.Message}"));
        }
        finally
        {
            _skillsBusy = false;
        }
    }

    private async Task VerifySkillsAsync()
    {
        _skillsBusy = true;
        try
        {
            _skillsInstall = await Client.VerifySkillsInstallAsync();
            ToastService.Notify(new(_skillsInstall?.Installed == true ? ToastType.Success : ToastType.Info,
                _skillsInstall?.Installed == true
                    ? $"Skills installed — {_skillsInstall.SkillCount} found"
                    : "Skills not installed"));
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Verify failed: {ex.Message}"));
        }
        finally
        {
            _skillsBusy = false;
        }
    }

    private async Task SyncSkillsAsync()
    {
        _skillsBusy = true;
        try
        {
            _skillsSync = await Client.SyncSkillsAsync();
            ToastService.Notify(new(ToastType.Info, "Skills sync started"));
            if (_skillsSync?.State == SkillsSyncState.Running)
            {
                StartStatusPolling();
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to start skills sync: {ex.Message}"));
        }
        finally
        {
            _skillsBusy = false;
        }
    }

    private async Task LoadMcpStatusAsync()
    {
        try
        {
            _mcpStatus = await Client.GetMcpStatusAsync();
        }
        catch
        {
            _mcpStatus = null;
        }
    }

    private void ToggleRagKeyVisibility()
    {
        if (_ragKeyInputType == "password")
        {
            _ragKeyInputType = "text";
            _ragKeyToggleLabel = "Hide";
        }
        else
        {
            _ragKeyInputType = "password";
            _ragKeyToggleLabel = "Show";
        }
    }

    private static string GetMcpBadgeClass(McpAgentResult agent) => agent.State switch
    {
        McpAgentState.Configured => "text-bg-success",
        McpAgentState.Failed => "text-bg-danger",
        McpAgentState.Repaired => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private static string McpBadgeTitle(McpAgentResult agent) =>
        agent.Error is null ? agent.Path : $"{agent.Path} — {agent.Error}";

    private static string GetMcpBadgeLabel(McpAgentResult agent) => agent.State switch
    {
        McpAgentState.Configured => "configured",
        McpAgentState.Repaired => "repaired",
        McpAgentState.Removed => "removed",
        McpAgentState.Failed => "error",
        McpAgentState.Skipped => "skipped",
        _ => "not configured"
    };

    private async Task SaveRagAsync()
    {
        _ragBusy = true;
        _ragError = null;
        try
        {
            // Blank key keeps the stored value; the API treats "" as clear.
            var error = await Client.SaveRagMcpAsync(
                _ragName.Trim(),
                _ragUrl.Trim(),
                string.IsNullOrWhiteSpace(_ragApiKey) ? null : _ragApiKey.Trim());
            if (error is not null)
            {
                _ragError = error;
                return;
            }

            _ragApiKey = string.Empty;
            _ragKeySet = true;
            ToastService.Notify(new(ToastType.Success, "RAG MCP configuration saved — provisioning started"));
            await LoadConfigurationAsync();
            await LoadMcpStatusAsync();
            if (_mcpStatus?.State == McpProvisionState.Running)
            {
                StartStatusPolling();
            }
        }
        catch (Exception ex)
        {
            _ragError = $"Failed to save RAG configuration: {ex.Message}";
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private async Task SyncMcpAsync()
    {
        _ragBusy = true;
        try
        {
            _mcpStatus = await Client.SyncMcpAsync();
            ToastService.Notify(new(ToastType.Info, "MCP provisioning started"));
            if (_mcpStatus?.State == McpProvisionState.Running)
            {
                StartStatusPolling();
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to start MCP sync: {ex.Message}"));
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private async Task VerifyMcpAsync()
    {
        _ragBusy = true;
        try
        {
            await LoadMcpStatusAsync();
            var configured = _mcpStatus?.Agents.Count(a => a.Configured) ?? 0;
            ToastService.Notify(new(ToastType.Info, $"MCP status refreshed — {configured} agent(s) configured"));
        }
        finally
        {
            _ragBusy = false;
        }
    }

    private async Task LoadConfigurationAsync()
    {
        try
        {
            _configEntries = await Client.GetConfigurationEntriesAsync();
            _configError = null;
            var skillsEntry = _configEntries.FirstOrDefault(e => e.Key == SkillsRepositoryKey);
            if (skillsEntry is not null)
            {
                _skillsRepo = skillsEntry.EffectiveValue ?? string.Empty;
                _skillsRepoIsOverride = skillsEntry.Source == "db";
            }

            _ragName = _configEntries.FirstOrDefault(e => e.Key == RagServerNameKey)?.EffectiveValue ?? "knowledge";
            _ragUrl = _configEntries.FirstOrDefault(e => e.Key == RagUrlKey)?.EffectiveValue ?? string.Empty;
            _ragKeySet = _configEntries.FirstOrDefault(e => e.Key == RagApiKeyKey)?.EffectiveValue is not null;
        }
        catch (Exception ex)
        {
            _configEntries = [];
            _configError = $"Could not load configuration entries: {ex.Message}";
        }
    }

    private async Task SaveSkillsRepoAsync()
    {
        _skillsRepoError = null;
        var error = await Client.SetConfigurationValueAsync(SkillsRepositoryKey, _skillsRepo.Trim());
        if (error is not null)
        {
            _skillsRepoError = error;
            return;
        }

        ToastService.Notify(new(ToastType.Success, "Skills source repository saved"));
        await LoadConfigurationAsync();
    }

    private async Task ResetSkillsRepoAsync()
    {
        _skillsRepoError = null;
        var error = await Client.DeleteConfigurationValueAsync(SkillsRepositoryKey);
        if (error is not null)
        {
            _skillsRepoError = error;
            return;
        }

        ToastService.Notify(new(ToastType.Info, "Skills source repository reset to default"));
        await LoadConfigurationAsync();
    }

    private void StartConfigEdit(ConfigurationEntryDto entry)
    {
        _editingKey = entry.Key;
        _editingValue = entry.Masked ? string.Empty : entry.EffectiveValue ?? string.Empty;
    }

    private void CancelConfigEdit()
    {
        _editingKey = null;
        _editingValue = string.Empty;
    }

    private async Task SaveConfigAsync(ConfigurationEntryDto entry)
    {
        var error = await Client.SetConfigurationValueAsync(entry.Key, _editingValue);
        if (error is not null)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to save {entry.Key}: {error}"));
            return;
        }

        _editingKey = null;
        _editingValue = string.Empty;
        ToastService.Notify(entry.RequiresRestart
            ? new(ToastType.Warning, $"{entry.Key} saved — applies on next restart")
            : new(ToastType.Success, $"{entry.Key} saved"));
        await LoadConfigurationAsync();
    }

    private async Task ResetConfigAsync(ConfigurationEntryDto entry)
    {
        var error = await Client.DeleteConfigurationValueAsync(entry.Key);
        if (error is not null)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to reset {entry.Key}: {error}"));
            return;
        }

        ToastService.Notify(new(ToastType.Info, $"{entry.Key} override removed"));
        await LoadConfigurationAsync();
    }

    private static string GetSourceBadgeClass(string source) => source switch
    {
        "db" => "text-bg-primary",
        "env" => "text-bg-info",
        "appsettings" => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private void ToggleTokenVisibility()
    {
        if (_tokenInputType == "password")
        {
            _tokenInputType = "text";
            _tokenToggleLabel = "Hide";
        }
        else
        {
            _tokenInputType = "password";
            _tokenToggleLabel = "Show";
        }
    }

    private void ToggleAgent(AgentType type, bool enabled)
    {
        _enabledState[type] = enabled;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;

        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _passwordError = "All fields are required.";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _passwordError = "New passwords do not match.";
            return;
        }

        try
        {
            await Client.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
            ToastService.Notify(new(ToastType.Success, "Password changed"));
            _currentPassword = _newPassword = _confirmPassword = string.Empty;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _passwordError = "Not authorized. Please sign in again.";
        }
        catch (HttpRequestException)
        {
            _passwordError = "Current password is incorrect.";
        }
    }

    private void ResetAsync()
    {
        _gitHubToken = _originalGitHubToken;
        foreach (var (type, value) in _originalEnabledState)
        {
            _enabledState[type] = value;
        }
        _passwordError = null;
        ToastService.Notify(new(ToastType.Info, "Settings reset"));
    }

    private async Task SaveAsync()
    {
        try
        {
            var request = new SaveSettingsRequest(
                "light",
                _gitHubToken,
                _enabledState.Where(kv => kv.Value).Select(kv => kv.Key.ToString()).ToList().AsReadOnly());
            await Client.SaveSettingsAsync(request);
            ToastService.Notify(new(ToastType.Success, "Settings saved"));
            Navigation.NavigateTo("/settings", forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to save settings: {ex.Message}"));
        }
    }
}
