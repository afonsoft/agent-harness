    private ConfigurationEntryDto? FeatureEntry(string key) =>
        _configEntries.FirstOrDefault(e => e.Key == key);

    private static bool IsFeatureEnabled(ConfigurationEntryDto entry) =>
        string.Equals(entry.EffectiveValue, "true", StringComparison.OrdinalIgnoreCase);

    private async Task ToggleFeatureAsync(string key, bool enabled)
    {
        var error = await Client.SetConfigurationValueAsync(key, enabled ? "true" : "false");
        if (error is not null)
