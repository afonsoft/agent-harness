    private string _activeTab = "general";

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // ?tab= deep link — refresh/URL preserves the selected tab.
        var tab = ResolveTabFromQuery();
        if (tab is not null && SettingsTabs.Any(t => t.Id == tab))
        {
            _activeTab = tab;
            StateHasChanged();
        }
    }

    private string? ResolveTabFromQuery()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Length <= 1)
        {
            return null;
        }

        return query[1..].Split('&')
            .Select(pair => pair.Split('=', 2))
            .Where(pair => pair.Length == 2 && pair[0] == "tab")
            .Select(pair => Uri.UnescapeDataString(pair[1]))
            .FirstOrDefault();
    }

    private void SelectTab(string id)
    {
        _activeTab = id;
        Navigation.NavigateTo($"/settings?tab={id}", replace: true);
    }

    /// <summary>WAI-ARIA tabs keyboard model: ←/→ cycle, Home/End jump.</summary>
    private void OnTabsKeyDown(KeyboardEventArgs e)
    {
        var index = Array.FindIndex(SettingsTabs, t => t.Id == _activeTab);
        if (index < 0)
        {
            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" => (index + 1) % SettingsTabs.Length,
            "ArrowLeft" => (index - 1 + SettingsTabs.Length) % SettingsTabs.Length,
            "Home" => 0,
            "End" => SettingsTabs.Length - 1,
            _ => index,
        };

        if (next != index)
        {
            SelectTab(SettingsTabs[next].Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Client.GetSettingsAsync();
            _gitHubToken = settings.GitHubToken;
            _originalGitHubToken = _gitHubToken;
            _agents = settings.Agents;
            _enabledState.Clear();
            _originalEnabledState.Clear();
            foreach (var agent in _agents)
            {
                _enabledState[agent.Type] = agent.Enabled;
                _originalEnabledState[agent.Type] = agent.Enabled;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        try
        {
            var repositories = await GitHubService.GetRepositoriesAsync();
            _repoNames = repositories.Select(r => r.FullName).OrderBy(n => n).ToList();
        }
        catch
        {
            // No GitHub token or API failure — free-text owner/repo stays usable.
            _repoNames = [];
        }

        await LoadConfigurationAsync();
        await LoadChatStateAsync();
        await LoadSkillsStatusAsync();
        await LoadMcpStatusAsync();
    }

