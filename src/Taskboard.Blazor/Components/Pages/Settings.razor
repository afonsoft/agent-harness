    private async Task LoadConfigurationAsync()
    {
        try
        {
            _configEntries = await Client.GetConfigurationEntriesAsync();
            _configError = null;
            var skillsEntry = _configEntries.FirstOrDefault(e => e.Key == SkillsRepositoryKey);
            if (skillsEntry is not null)
            {
                _skillsRepo = skillsEntry.EffectiveValue ?? string.Empty;
                _skillsRepoIsOverride = skillsEntry.Source == "db";
            }

            ApplyRagState();
        }
        catch (Exception ex)
        {
            _configEntries = [];
            _configError = $"Could not load configuration entries: {ex.Message}";
        }
    }

    // Effective RAG form state (SPEC-20260921-settings-rag-mcp-prefill): the
    // config catalog wins; mcp/status is the fallback. Fields are only
    // overwritten while the form has no unsaved edits, so a reload (Verify /
    // post-save / post-sync) never clobbers what the user is typing.
    private void ApplyRagState()
    {
        var state = RagMcpFormResolver.Resolve(_configEntries, _mcpStatus);
        var pristine = !_ragStateApplied
            || (string.Equals(_ragUrl.Trim(), _ragUrlSaved ?? string.Empty, StringComparison.Ordinal)
                && string.Equals(_ragName.Trim(), _ragNameSaved ?? string.Empty, StringComparison.Ordinal));
        if (pristine)
        {
            _ragName = state.ServerName;
            _ragUrl = state.Url ?? string.Empty;
            _ragStateApplied = true;
        }
        _ragNameSaved = state.ServerName;
        _ragNameSource = state.ServerNameSource;
        _ragUrlSaved = state.Url;
        _ragUrlSource = state.UrlSource;
        _ragKeySet = state.ApiKeySet;
    }

    private async Task SaveSkillsRepoAsync()
    {
        _skillsRepoError = null;
        var error = await Client.SetConfigurationValueAsync(SkillsRepositoryKey, _skillsRepo.Trim());
        if (error is not null)
        {
            _skillsRepoError = error;
            return;
        }

        await ToastService.NotifyAsync(new(ToastType.Success, "Skills source repository saved"));
        await LoadConfigurationAsync();
    }

    private async Task ResetSkillsRepoAsync()
    {
        _skillsRepoError = null;
        var error = await Client.DeleteConfigurationValueAsync(SkillsRepositoryKey);
        if (error is not null)
        {
            _skillsRepoError = error;
            return;
        }

        await ToastService.NotifyAsync(new(ToastType.Info, "Skills source repository reset to default"));
        await LoadConfigurationAsync();
    }

    private void StartConfigEdit(ConfigurationEntryDto entry)
    {
        _editingKey = entry.Key;
        _editingValue = entry.Masked ? string.Empty : entry.EffectiveValue ?? string.Empty;
    }

    private void CancelConfigEdit()
    {
        _editingKey = null;
        _editingValue = string.Empty;
    }

    private async Task SaveConfigAsync(ConfigurationEntryDto entry)
    {
        var error = await Client.SetConfigurationValueAsync(entry.Key, _editingValue);
        if (error is not null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to save {entry.Key}: {error}"));
            return;
        }

        _editingKey = null;
        _editingValue = string.Empty;
        await ToastService.NotifyAsync(entry.RequiresRestart
            ? new(ToastType.Warning, $"{entry.Key} saved — applies on next restart")
            : new(ToastType.Success, $"{entry.Key} saved"));
        await LoadConfigurationAsync();
    }

    private async Task ResetConfigAsync(ConfigurationEntryDto entry)
    {
        var error = await Client.DeleteConfigurationValueAsync(entry.Key);
        if (error is not null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to reset {entry.Key}: {error}"));
            return;
        }

        await ToastService.NotifyAsync(new(ToastType.Info, $"{entry.Key} override removed"));
        await LoadConfigurationAsync();
    }

    /// <summary>Toggle granular — reescreve a lista Disabled preservando os demais ids.</summary>
    private async Task ToggleCapabilityAsync(ChatCapability cap)
    {
        var raw = _configEntries
            .FirstOrDefault(e => e.Key == "Taskboard:Chat:Capabilities:Disabled")?.EffectiveValue;
        var ids = ParseDisabledIds(raw);
        if (cap.Enabled)
        {
            ids.Add(cap.Id);
        }
        else
        {
            ids.Remove(cap.Id);
        }

        _chatBusy = true;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(ids.Order(StringComparer.Ordinal).ToList());
            var error = await Client.SetConfigurationValueAsync("Taskboard:Chat:Capabilities:Disabled", json);
            if (error is not null)
            {
                await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to toggle {cap.Id}: {error}"));
                return;
            }

            await ToastService.NotifyAsync(new(ToastType.Success, $"{cap.Id} {(cap.Enabled ? "disabled" : "enabled")}"));
            await LoadConfigurationAsync();
            await LoadChatStateAsync();
        }
        finally
        {
            _chatBusy = false;
        }
    }

    private async Task RefreshCapabilitiesAsync()
    {
        _chatBusy = true;
        try
        {
            _capabilities = await Client.GetChatCapabilitiesAsync();
        }
        catch
        {
            // best-effort — mantém o catálogo atual.
        }
        finally
