            _ragApiKey = string.Empty;
            _ragKeySet = true;
            await ToastService.NotifyAsync(new(ToastType.Success, "RAG MCP configuration saved — provisioning started"));
            await LoadConfigurationAsync();
            await LoadMcpStatusAsync();
            if (_mcpStatus?.State == McpProvisionState.Running)
