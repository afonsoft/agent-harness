@page "/settings"
@attribute [Authorize]
@using Taskboard.Application.Contracts.Chat
@inject TaskboardClient Client
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject IGitHubService GitHubService
@inject IJSRuntime JS
@inject ChatNotificationsService ChatNotifications
@implements IDisposable

<PageTitle>Settings - Harness</PageTitle>

<div class="settings-page">
    <h1 class="h4 fw-bold mb-1">Settings</h1>
    <p class="small text-body-secondary mb-4">Customize your workspace and agents</p>

    @if (_isLoading)
    {
        <Loading Message="Loading settings…" />
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-4">@_errorMessage</div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">
                <nav class="settings-tabs nav nav-tabs mb-4 pb-0 border-bottom flex-nowrap overflow-auto" role="tablist" aria-label="Settings sections" @onkeydown="OnTabsKeyDown">
                    @foreach (var tab in SettingsTabs)
                    {
                        var id = tab.Id;
                        <button type="button" role="tab" class="nav-link text-nowrap @(id == _activeTab ? "active" : "")"
                                aria-selected="@(id == _activeTab ? "true" : "false")" tabindex="@(id == _activeTab ? 0 : -1)"
                                data-tab="@id" @onclick="() => SelectTab(id)">
                            @tab.Label
                        </button>
                    }
                </nav>
                <!-- SPEC-20260930-settings-tabs: panéis permanecem no DOM (d-none) — estado de formulário preservado ao alternar abas. -->
                <div class="tab-pane" role="tabpanel" aria-label="Integrations" hidden="@(_activeTab != "integrations")">
                <div class="form-section">
                    <h2 class="form-section-title">Integrations</h2>
                    <label class="form-label" for="github-token">GitHub token</label>
                    <p class="small text-body-secondary">Paste a personal access token with repo scope.</p>
                    <div class="setting-row-input">
                        <input id="github-token" type="@_tokenInputType" class="form-control" @bind="_gitHubToken" placeholder="ghp_…" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleTokenVisibility">@_tokenToggleLabel</button>
                    </div>

                    <label class="form-label mt-3" for="skills-repo">Skills source repository</label>
                    <p class="small text-body-secondary">Git repository cloned to install agent skills on each enabled CLI.</p>
                    <div class="setting-row-input">
                        <RepositoryCombobox Id="skills-repo"
                                            AriaLabel="Skills source repository"
                                            Placeholder="owner/repo"
                                            Repositories="@_repoNames"
                                            @bind-Value="_skillsRepo" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="SaveSkillsRepoAsync">Save</button>
                        @if (_skillsRepoIsOverride)
                        {
                            <button type="button" class="btn btn-outline-danger text-nowrap" @onclick="ResetSkillsRepoAsync">Reset</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_skillsRepoError))
                    {
                        <p class="mt-2 small text-danger">@_skillsRepoError</p>
                    }
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">Agent Skills</h2>
                    <p class="small text-body-secondary">
                        Global install of the configured skills repository into every supported agent CLI
                        (<code>npx skills add &lt;repo&gt; -g --all --copy</code> + <code>install.sh --all</code>).
                    </p>

                    @if (_skillsInstall is null)
                    {
                        <p class="small text-body-secondary">Status unavailable.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            @if (_skillsInstall.Installed)
                            {
                                <span class="badge text-bg-success">Installed — @_skillsInstall.SkillCount skills</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Not installed</span>
                            }
                            @foreach (var prereq in _skillsInstall.Prerequisites)
                            {
                                <span class="badge @(prereq.Value ? "text-bg-success" : "text-bg-danger")"
                                      title="@(prereq.Value ? "available" : "missing")">@prereq.Key</span>
                            }
                        </div>
                        <div class="small text-body-secondary mb-2">
                            Repository: <code>@(_skillsInstall.Repository ?? "—")</code>
                            @if (_skillsInstall.LastRunUtc is not null)
                            {
                                <span class="ms-2">Last run: @UiFormat.DateTime(_skillsInstall.LastRunUtc.Value.LocalDateTime)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_skillsInstall.Error))
                        {
                            <p class="small text-danger mb-2">@_skillsInstall.Error</p>
                        }
                        @if (_skillsInstall.Steps.Count > 0)
                        {
                            <ul class="small mb-2">
                                @foreach (var step in _skillsInstall.Steps)
                                {
                                    <li>
                                        <code>@step.Name</code> — @step.State
                                        @if (!string.IsNullOrWhiteSpace(step.Message))
                                        {
                                            <span class="text-body-secondary">(@step.Message)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (_skillsInstall.Locations.Count > 0)
                        {
                            <ul class="small mb-2">
                                @foreach (var location in _skillsInstall.Locations)
                                {
                                    <li><code>@location.Path</code> — @location.Count skills</li>
                                }
                            </ul>
                        }
                        @if (_skillsSync is not null && _skillsSync.LastRunUtc is not null)
                        {
                            <p class="small text-body-secondary mb-2">
                                Sync: @_skillsSync.State — @UiFormat.DateTime(_skillsSync.LastRunUtc.Value.LocalDateTime)
                            </p>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-primary"
                                    disabled="@(_skillsBusy || !_skillsInstall.Prerequisites.GetValueOrDefault("npx") || !_skillsInstall.Prerequisites.GetValueOrDefault("git"))"
                                    title="@SkillsInstallButtonTitle()"
                                    @onclick="InstallSkillsAsync">Install</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_skillsBusy" @onclick="VerifySkillsAsync">Verify</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_skillsBusy" @onclick="SyncSkillsAsync">Sync</button>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small fw-semibold">Process log</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadSkillsLogAsync">Refresh</button>
                            </div>
                            @if (_skillsLog.Count == 0)
                            {
                                <p class="small text-body-secondary mb-0">No install/sync log yet.</p>
                            }
                            else
                            {
                                <div class="agent-log-console">
                                    @foreach (var entry in _skillsLog)
                                    {
                                        <div class="agent-log-line @GetOperationLogClass(entry)">
                                            <span class="agent-log-timestamp">@entry.AtUtc.LocalDateTime.ToString("HH:mm:ss")</span>
                                            <span class="agent-log-content">@entry.Message</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="form-section">
                    <h2 class="form-section-title">RAG / Knowledge MCP</h2>
                    <p class="small text-body-secondary">
                        Provision the RAG MCP server into every enabled agent CLI config
                        (<code>~/.claude.json</code>, <code>~/.codex/config.toml</code>, …).
                    </p>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="rag-name">
                                Server name
                                @if (!string.IsNullOrWhiteSpace(_ragNameSource))
                                {
                                    <span class="badge @GetSourceBadgeClass(_ragNameSource) ms-1 fw-normal">@_ragNameSource</span>
                                }
                            </label>
                            <input id="rag-name" type="text" class="form-control font-monospace" @bind="_ragName" placeholder="e.g. knowledge" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="rag-url">
                                MCP URL
                                @if (!string.IsNullOrWhiteSpace(_ragUrlSource))
                                {
                                    <span class="badge @GetSourceBadgeClass(_ragUrlSource) ms-1 fw-normal">@_ragUrlSource</span>
                                }
                            </label>
                            <input id="rag-url" type="text" inputmode="url" class="form-control font-monospace" @bind="_ragUrl" placeholder="e.g. https://mcp.example.com/mcp" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <label class="form-label" for="rag-key">API key</label>
                        <div class="setting-row-input">
                            <input id="rag-key" type="@_ragKeyInputType" class="form-control font-monospace" @bind="_ragApiKey" placeholder="@(_ragKeySet ? "•••• (unchanged)" : "aft_…")" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                            <button type="button" class="btn btn-outline-secondary text-nowrap" @onclick="ToggleRagKeyVisibility">@_ragKeyToggleLabel</button>
                        </div>
                        <p class="small text-body-secondary mt-1 mb-0">Leave blank to keep the stored key.</p>
                    </div>

                    @if (string.IsNullOrWhiteSpace(_ragUrlSaved))
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            No MCP URL saved — Sync stays disabled until you save one (Save &amp; Sync).
                        </div>
                    }
                    else if (!string.Equals(_ragUrl.Trim(), _ragUrlSaved, StringComparison.Ordinal))
                    {
                        <div class="alert alert-info mt-2 mb-0">
                            Unsaved changes — Sync provisions the <strong>saved</strong> URL
                            (<code>@_ragUrlSaved</code>); use Save &amp; Sync to apply the form values.
                        </div>
                    }

                    @if (_configError is not null)
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            @_configError Values shown below were resolved by the MCP provisioning status.
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_mcpStatus?.ConfiguredUrl))
                    {
                        <p class="small text-body-secondary mt-2 mb-0">
                            Provisioned as <code>@_mcpStatus.ServerName</code> → <code>@_mcpStatus.ConfiguredUrl</code>
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_ragError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@_ragError</div>
                    }

                    @if (_ragTestResult is not null)
                    {
                        <div class="alert @(_ragTestResult.Ok ? "alert-success" : "alert-warning") mt-2 mb-0">
                            @if (_ragTestResult.Ok)
                            {
                                <span>Reachable — @_ragTestResult.Tools tool(s), @_ragTestResult.LatencyMs ms.</span>
                            }
                            else
                            {
                                <span>Not reachable: @_ragTestResult.Error</span>
                            }
                        </div>
                    }

                    @if (_mcpStatus is not null && _mcpStatus.Agents.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var agent in _mcpStatus.Agents)
                            {
                                <span class="badge @GetMcpBadgeClass(agent)" title="@McpBadgeTitle(agent)">
                                    @agent.Agent — @GetMcpBadgeLabel(agent)
                                </span>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="button" class="btn btn-outline-primary" disabled="@_ragBusy" @onclick="SaveRagAsync">Save &amp; Sync</button>
                        <button type="button" class="btn btn-outline-secondary"
                                disabled="@(_ragBusy || string.IsNullOrWhiteSpace(_ragUrlSaved))"
                                title="@(string.IsNullOrWhiteSpace(_ragUrlSaved) ? "Save a URL first" : "Provision the saved configuration into all agent CLIs")"
                                @onclick="SyncMcpAsync">Sync</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@_ragBusy" @onclick="VerifyMcpAsync">Verify</button>
                        <button type="button" class="btn btn-outline-secondary"
                                disabled="@(_ragBusy || string.IsNullOrWhiteSpace(_ragUrlSaved))"
                                title="@(string.IsNullOrWhiteSpace(_ragUrlSaved) ? "Save a URL first" : "Run a live MCP handshake against the saved RAG server")"
                                @onclick="TestRagAsync">Test connection</button>
                        @if (!_ragRemoveConfirm)
                        {
                            <button type="button" class="btn btn-outline-danger" disabled="@_ragBusy"
                                    title="Remove the MCP server from every agent CLI config"
                                    @onclick="() => _ragRemoveConfirm = true">Remove</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled="@_ragBusy" @onclick="RemoveMcpAsync">Confirm removal</button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@_ragBusy" @onclick="() => _ragRemoveConfirm = false">Cancel</button>
                        }
                    </div>

                    <div class="mt-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small fw-semibold">Process log</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadMcpLogAsync">Refresh</button>
                        </div>
                        @if (_mcpLog.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">No provisioning log yet.</p>
                        }
                        else
                        {
                            <div class="agent-log-console">
                                @foreach (var entry in _mcpLog)
                                {
                                    <div class="agent-log-line @GetOperationLogClass(entry)">
                                        <span class="agent-log-timestamp">@entry.AtUtc.LocalDateTime.ToString("HH:mm:ss")</span>
                                        <span class="agent-log-content">@entry.Message</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                </div>
                <div class="tab-pane" role="tabpanel" aria-label="Security" hidden="@(_activeTab != "security")">
                <div class="form-section">
                    <h2 class="form-section-title">Security</h2>
                    <label class="form-label" for="current-password">Change password</label>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <input id="current-password" type="password" class="form-control" @bind="_currentPassword" placeholder="Current password" autocomplete="current-password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_newPassword" placeholder="New password" aria-label="New password" autocomplete="new-password" />
                        </div>
                        <div class="col-md-4">
                            <input type="password" class="form-control" @bind="_confirmPassword" placeholder="Confirm new password" aria-label="Confirm new password" autocomplete="new-password" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_changeError))
                    {
                        <p class="mt-2 small text-danger">@_changeError</p>
                    }
                    <div class="mt-3">
                        <button type="button" class="btn btn-outline-secondary" @onclick="ChangePasswordAsync">Change password</button>
                    </div>
                </div>

                </div>
                <div class="tab-pane" role="tabpanel" aria-label="Agents" hidden="@(_activeTab != "agents")">
                <div class="form-section">
                    <h2 class="form-section-title">Agents</h2>
                    <p class="small text-body-secondary">
                        Only installed and authenticated agent CLIs are listed. A disabled agent cannot be
                        selected for task actions. Manage logins on the <a href="/agents">Agents</a> page
                        or the <a href="/terminal">Terminal</a>.
                    </p>
                    @if (!_agents.Any())
                    {
                        <div class="alert alert-secondary mb-0" role="status">
                            No agent CLI is authenticated right now —
                            <a href="/agents" class="alert-link">open Agents</a> to check status or
                            <a href="/terminal" class="alert-link">open the Terminal</a> to log in.
                        </div>
                    }
                    else
                    {
                        <div>
                            @foreach (var agent in _agents)
                            {
                                <div class="setting-row" @key="agent.Type">
                                    <div>
                                        <div class="fw-medium">
                                            @agent.Name
                                            <span class="badge text-bg-success ms-1">Authenticated</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                                        {
                                            <div class="small text-body-secondary">@agent.Description</div>
                                        }
                                        <div class="small text-body-secondary">@agent.Type@(string.IsNullOrWhiteSpace(agent.Version) ? "" : $" · v{agent.Version}")</div>
                                    </div>
                                    <div class="form-check form-switch mb-0">
                                        <input type="checkbox" role="switch" class="form-check-input agent-toggle" checked="@_enabledState[agent.Type]" @onchange="e => ToggleAgent(agent.Type, (bool)e.Value!)" aria-label="Enable @agent.Name" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                </div>
                <div class="tab-pane" role="tabpanel" aria-label="Chat" hidden="@(_activeTab != "chat")">
                <div class="form-section">
                    <h2 class="form-section-title">Chat</h2>
                    <p class="small text-body-secondary">
                        OpenAI-compatible providers for the AI Code provider chat (SPEC-20260929-ai-code-provider-chat).
                        API keys are stored server-side and never returned in clear text.
                    </p>
                    @if (_chatError is not null)
                    {
                        <div class="alert alert-warning mb-2">@_chatError</div>
                    }
                    <div class="table-responsive mb-2">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Base URL</th>
                                    <th scope="col">Key</th>
                                    <th scope="col">Enabled</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var provider in _chatProviders)
                                {
                                    <tr @key="provider.Id">
                                        <td class="fw-medium">@provider.Name</td>
                                        <td class="small font-monospace">@provider.BaseUrl</td>
                                        <td class="small">@(provider.HasApiKey ? provider.KeyHint : "—")</td>
                                        <td>
                                            <span class="badge @(provider.Enabled ? "text-bg-success" : "text-bg-secondary")">@(provider.Enabled ? "on" : "off")</span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => TestChatProviderAsync(provider)" disabled="@_chatBusy">
                                                Test
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteChatProviderAsync(provider)" disabled="@_chatBusy">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (_chatProviders.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-body-secondary small">No provider registered.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label small mb-1" for="chat-provider-name">Name</label>
                            <input id="chat-provider-name" class="form-control form-control-sm" @bind="_chatNewName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1" for="chat-provider-url">Base URL</label>
                            <input id="chat-provider-url" inputmode="url" class="form-control form-control-sm font-monospace" placeholder="https://api.openai.com" @bind="_chatNewUrl" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-1" for="chat-provider-key">API key</label>
                            <input id="chat-provider-key" type="password" class="form-control form-control-sm" @bind="_chatNewKey" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-sm btn-primary w-100" @onclick="AddChatProviderAsync" disabled="@_chatBusy">Add provider</button>
                        </div>
                    </div>

                    <h3 class="h6">Capability defaults</h3>
                    <p class="small text-body-secondary mb-2">Model used per capability when the conversation does not override it.</p>
                    @foreach (var capability in ChatCapabilities)
                    {
                        var state = _chatCapability[capability];
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-md-2">
                                <span class="small fw-medium text-capitalize">@capability</span>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select form-select-sm" @bind="state.ProviderId" @bind:after="() => OnCapabilityProviderChangedAsync(capability)">
                                    <option value="">—</option>
                                    @foreach (var provider in _chatProviders)
                                    {
                                        <option value="@provider.Id" selected="@(provider.Id.ToString() == state.ProviderId)">@provider.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select form-select-sm" @bind="state.Model" disabled="@(state.Models.Count == 0)">
                                    @if (state.Models.Count == 0)
                                    {
                                        <option value="">no models</option>
                                    }
                                    @foreach (var model in state.Models)
                                    {
                                        <option value="@model" selected="@(model == state.Model)">@model</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="() => SaveCapabilityAsync(capability)" disabled="@_chatBusy">
                                    Save
                                </button>
                            </div>
                        </div>
                    }

                    <h3 class="h6 mt-3">Web search</h3>
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-3">
                            <label class="form-label small mb-1" for="chat-search-backend">Backend</label>
                            <select id="chat-search-backend" class="form-select form-select-sm" @bind="_chatSearchBackend">
                                <option value="none">none</option>
                                <option value="searxng">SearxNG</option>
                                <option value="tavily">Tavily</option>
                                <option value="brave">Brave</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small mb-1" for="chat-search-url">SearxNG URL</label>
                            <input id="chat-search-url" inputmode="url" class="form-control form-control-sm font-monospace" placeholder="https://searx.example.com" @bind="_chatSearchUrl" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="SaveChatSearchAsync" disabled="@_chatBusy">Save</button>
                        </div>
                    </div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small mb-1" for="chat-search-key">Tavily / Brave API key</label>
                            <input id="chat-search-key" type="password" class="form-control form-control-sm" @bind="_chatSearchKey" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        </div>
                    </div>

                    @* SPEC-20261005-chat-tool-approval RF-004/RF-008: gate
                       global, preset default e timeout — conversas novas
                       herdam o preset; per-tool overrides na tabela abaixo. *@
                    <h3 class="h6 mt-3">Tool approvals</h3>
                    <p class="small text-body-secondary">
                        Gate de permissão para tools mutantes. <code>chat</code> recusa mutação,
                        <code>ask</code> pede aprovação por call, <code>full</code> nunca pede.
                    </p>
                    @{ var approvalEnabledKey = "Taskboard:Chat:Approval:Enabled"; var approvalEnabledEntry = FeatureEntry(approvalEnabledKey); }
                    <div class="setting-row">
                        <div>
                            <div class="fw-medium">Enable tool approval gate</div>
                            <div class="small text-body-secondary">Off = comportamento atual (nenhuma tool é bloqueada).</div>
                            @if (approvalEnabledEntry is not null)
                            {
                                <div class="mt-1"><span class="badge @GetSourceBadgeClass(approvalEnabledEntry.Source)">@approvalEnabledEntry.Source</span></div>
                            }
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input type="checkbox" role="switch" class="form-check-input"
                                   checked="@(approvalEnabledEntry is not null && IsFeatureEnabled(approvalEnabledEntry))"
                                   @onchange="e => ToggleFeatureAsync(approvalEnabledKey, (bool)e.Value!)"
                                   aria-label="Enable tool approval gate" />
                        </div>
                    </div>

                    @{ var approvalPresetEntry = FeatureEntry("Taskboard:Chat:Approval:Preset"); }
                    <div class="setting-row">
                        <div>
                            <div class="fw-medium">Default permission preset</div>
                            <div class="small text-body-secondary">Preset das conversas novas (chip no header do chat).</div>
                            @if (approvalPresetEntry is not null)
                            {
                                <div class="mt-1"><span class="badge @GetSourceBadgeClass(approvalPresetEntry.Source)">@approvalPresetEntry.Source</span></div>
                            }
                        </div>
                        <select class="form-select form-select-sm" style="width:auto" aria-label="Default permission preset"
                                value="@(approvalPresetEntry?.EffectiveValue ?? "ask")"
                                @onchange="ChangeApprovalPresetAsync">
                            <option value="chat">chat — read-only</option>
                            <option value="ask">ask — prompt por tool</option>
                            <option value="full">full — never ask</option>
                        </select>
                    </div>

                    @{ var approvalTimeoutEntry = FeatureEntry("Taskboard:Chat:Approval:TimeoutSeconds"); }
                    <div class="setting-row">
                        <div>
                            <div class="fw-medium">Approval timeout (s)</div>
                            <div class="small text-body-secondary">Espera da decisão antes de negar fail-closed. 0 = espera para sempre.</div>
                            @if (approvalTimeoutEntry is not null)
                            {
                                <div class="mt-1"><span class="badge @GetSourceBadgeClass(approvalTimeoutEntry.Source)">@approvalTimeoutEntry.Source</span></div>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" class="form-control form-control-sm" style="width:6rem" min="0" max="3600"
                                   @bind="_chatApprovalTimeout" aria-label="Approval timeout" />
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SaveApprovalTimeoutAsync">Save</button>
                        </div>
                    </div>

                    @* SPEC-20261001-chat-capability-registry: catálogo unificado
                       (builtin/MCP/skill/delegation) com toggle granular. *@
                    <h3 class="h6 mt-3">Capabilities</h3>
                    <p class="small text-body-secondary">
                        Tools builtin, MCP, skills e delegação. Clique no estado para habilitar/desabilitar
                        individualmente (lista <code>Taskboard:Chat:Capabilities:Disabled</code>). Policy:
                        override por tool (<code>Taskboard:Chat:Approval:ToolPolicy:{name}</code>).
                    </p>
                    @if (_capabilities.Count == 0)
                    {
                        <p class="small text-body-secondary">Catálogo indisponível.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Kind</th>
                                        <th scope="col">Capability</th>
                                        <th scope="col">Origin</th>
                                        <th scope="col">State</th>
                                        <th scope="col">Policy</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cap in _capabilities)
                                    {
                                        <tr @key="cap.Id">
                                            <td><span class="badge text-bg-secondary">@cap.Kind</span></td>
                                            <td class="small font-monospace text-break">@cap.Name</td>
                                            <td class="small">@(cap.Origin ?? "—")</td>
                                            <td class="text-nowrap">
                                                <button type="button" class="btn btn-sm @(cap.Enabled ? "btn-outline-success" : "btn-outline-danger")"
                                                        @onclick="() => ToggleCapabilityAsync(cap)" disabled="@_chatBusy">
                                                    @(cap.Enabled ? "on" : "off")
                                                </button>
                                                @if (cap.RequiresConfirmation)
                                                {
                                                    <span class="badge text-bg-warning">mutating</span>
                                                }
                                            </td>
                                            <td>
                                                @if (cap.Kind is ChatCapabilityKind.BuiltinTool or ChatCapabilityKind.McpTool)
                                                {
                                                    <select class="form-select form-select-sm" style="width:auto"
                                                            aria-label="Approval policy for @cap.Name"
                                                            value="@(cap.ApprovalPolicy ?? "")"
                                                            @onchange="e => SetToolPolicyAsync(cap, e.Value?.ToString())">
                                                        <option value="">—</option>
                                                        <option value="ask">ask</option>
                                                        <option value="never">never</option>
                                                        <option value="allow">allow</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="small text-body-secondary">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="RefreshCapabilitiesAsync" disabled="@_chatBusy">Refresh</button>
                    }
                </div>
                </div>

                @* SPEC-20261010-mcp-skills-hub RF-006: dedicated tab —
                   AI Code MCP tools (config ∪ ~/.agents ∪ rag), per-CLI MCP
                   installs, skills repo/search/install. *@
                <div class="tab-pane" role="tabpanel" aria-label="MCP/Skills" hidden="@(_activeTab != "mcp-skills")">

                    <div class="form-section">
                        <h2 class="form-section-title">AI Code MCP tools</h2>
                        <p class="small text-body-secondary">
                            Servers the AI Code chat may call — merged from configuration,
                            <code>~/.agents</code> (<code>mcp.json</code>, <code>mcp_config.json</code>,
                            <code>mcps/**/*.json</code>) and the provisioned RAG server.
                        </p>

                        @{ var mcpEnabledKey = "Taskboard:Chat:Mcp:Enabled"; var mcpEnabledEntry = FeatureEntry(mcpEnabledKey); }
                        <div class="setting-row">
                            <div>
                                <div class="fw-medium">Enable MCP tools</div>
                                <div class="small text-body-secondary">Exposes every healthy server below as <code>mcp_*</code> chat tools.</div>
                                @if (mcpEnabledEntry is not null)
                                {
                                    <div class="mt-1"><span class="badge @GetSourceBadgeClass(mcpEnabledEntry.Source)">@mcpEnabledEntry.Source</span></div>
                                }
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input type="checkbox" role="switch" class="form-check-input"
                                       checked="@(mcpEnabledEntry is not null && IsFeatureEnabled(mcpEnabledEntry))"
                                       @onchange="e => ToggleFeatureAsync(mcpEnabledKey, (bool)e.Value!)"
                                       aria-label="Enable MCP tools" />
                            </div>
                        </div>

                        @{ var mcpGlobalKey = "Taskboard:Chat:Mcp:IncludeGlobalAgents"; var mcpGlobalEntry = FeatureEntry(mcpGlobalKey); }
                        <div class="setting-row">
                            <div>
                                <div class="fw-medium">Include ~/.agents servers</div>
                                <div class="small text-body-secondary">Merges the global agents-skills MCP files into AI Code.</div>
                                @if (mcpGlobalEntry is not null)
                                {
                                    <div class="mt-1"><span class="badge @GetSourceBadgeClass(mcpGlobalEntry.Source)">@mcpGlobalEntry.Source</span></div>
                                }
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input type="checkbox" role="switch" class="form-check-input"
                                       checked="@(mcpGlobalEntry is not null && IsFeatureEnabled(mcpGlobalEntry))"
                                       @onchange="e => ToggleFeatureAsync(mcpGlobalKey, (bool)e.Value!)"
                                       aria-label="Include global agents MCPs" />
                            </div>
                        </div>

                        @{ var mcpTimeoutEntry = FeatureEntry("Taskboard:Chat:Mcp:CallTimeoutSeconds"); }
                        <div class="setting-row">
                            <div>
                                <div class="fw-medium">Tool call timeout (s)</div>
                                <div class="small text-body-secondary">Per-call timeout, clamped to 5–300.</div>
                                @if (mcpTimeoutEntry is not null)
                                {
                                    <div class="mt-1"><span class="badge @GetSourceBadgeClass(mcpTimeoutEntry.Source)">@mcpTimeoutEntry.Source</span></div>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="number" class="form-control form-control-sm" style="width:6rem" min="5" max="300"
                                       @bind="_chatMcpTimeout" aria-label="Tool call timeout" />
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SaveChatMcpTimeoutAsync">Save</button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3 mb-2">
                            <h3 class="h6 fw-semibold mb-0">Merged servers</h3>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadChatMcpServersAsync">Refresh</button>
                        </div>
                        @if (_chatMcpServers.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">No MCP servers — add one below or drop a file under <code>~/.agents</code>.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Name</th><th>Transport</th><th>Tools</th><th>Origin</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @foreach (var server in _chatMcpServers)
                                        {
                                            @* merged de config + ~/.agents + RAG —
                                               o mesmo nome pode vir de origens
                                               diferentes. *@
                                            <tr @key="ChatMcpServerKey(server)">
                                                <td class="small font-monospace">@server.Name</td>
                                                <td class="small">@server.Transport</td>
                                                <td class="small">@server.ToolCount</td>
                                                <td><span class="badge @McpOriginBadgeClass(server.Origin)">@server.Origin</span></td>
                                                <td class="small">
                                                    @if (server.Healthy)
                                                    {
                                                        <span class="text-success">healthy</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger" title="@server.Error">@(server.Error is { Length: > 60 } e ? e[..60] + "…" : server.Error ?? "down")</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <details class="mt-2">
                            <summary class="small text-body-secondary" role="button">Advanced — edit servers JSON</summary>
                            <textarea class="form-control font-monospace mt-2" rows="4" @bind="_chatMcpServersJson"
                                      aria-label="MCP servers JSON" spellcheck="false"></textarea>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SaveChatMcpServersJsonAsync">Save JSON</button>
                            </div>
                        </details>
                    </div>

                    <div class="form-section">
                        <div class="d-flex align-items-center justify-content-between">
                            <h2 class="form-section-title mb-0">Agent CLI MCPs</h2>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="OpenMcpAddModalAsync">Add MCP</button>
                        </div>
                        <p class="small text-body-secondary mt-1">
                            MCP entries written into each CLI's user-scope config. CLI-managed formats (Antigravity,
                            Cline, Continue) are read-only here.
                        </p>
                        @if (_agentMcpError is not null)
                        {
                            <div class="alert alert-warning py-2 small">@_agentMcpError</div>
                        }
                        @if (_mcpApplyResults is { Count: > 0 })
                        {
                            <div class="mb-2">
                                @foreach (var result in _mcpApplyResults)
                                {
                                    <span class="badge @GetMcpBadgeClass(result) me-1" title="@result.Error">@result.Agent — @result.State</span>
                                }
                            </div>
                        }
                        @if (_agentMcpInventory.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">No agent CLIs detected.</p>
                        }
                        else
                        {
                            @foreach (var agent in _agentMcpInventory)
                            {
                                <div class="border rounded p-2 mb-2" @key="agent.Agent">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="fw-semibold small">@agent.Agent</span>
                                        <span class="badge @(agent.Writable ? "text-bg-success" : "text-bg-secondary")">
                                            @(agent.Writable ? "writable" : "read-only")
                                        </span>
                                    </div>
                                    <div class="small text-body-secondary font-monospace text-truncate mb-1" title="@agent.ConfigPath">@agent.ConfigPath</div>
                                    @if (agent.Servers.Count == 0)
                                    {
                                        <span class="small text-body-secondary">no MCP servers</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var server in agent.Servers)
                                            {
                                                @* entries merged de múltiplos
                                                   arquivos do agente — nome pode
                                                   repetir. *@
                                                <span class="badge text-bg-light border d-inline-flex align-items-center gap-1" @key="AgentMcpServerKey(server)">
                                                    @server.Name <span class="text-body-secondary">@server.Transport</span>
                                                    @if (agent.Writable)
                                                    {
                                                        <button type="button" class="btn-close" style="font-size:.55rem"
                                                                aria-label="Remove @server.Name from @agent.Agent"
                                                                @onclick="() => OpenMcpRemoveModalAsync(agent.Agent, server.Name)"></button>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="form-section">
                        <h2 class="form-section-title">Skills</h2>
                        <p class="small text-body-secondary">
                            Installs run <code>npx skills add</code> globally — the configured repository is
                            <code>@_skillsRepo</code>.
                        </p>

                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-12 col-md-7">
                                <label class="form-label small mb-1" for="skills-repo-install">Install repository</label>
                                <input id="skills-repo-install" type="text" class="form-control form-control-sm font-monospace"
                                       @bind="_skillsRepoInstall" placeholder="owner/repo or git URL" spellcheck="false" />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@_skillsBusy"
                                        @onclick="InstallSkillsRepoAsync">Install repo</button>
                            </div>
                        </div>
                        @if (_skillsRepoError is not null)
                        {
                            <div class="alert alert-warning py-2 small">@_skillsRepoError</div>
                        }

                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-12 col-md-7">
                                <label class="form-label small mb-1" for="skills-search">Search skills.sh</label>
                                <input id="skills-search" type="search" class="form-control form-control-sm"
                                       @bind="_skillsQuery" placeholder="e.g. review, test, docs" />
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_skillsBusy"
                                        @onclick="SearchSkillsAsync">Search</button>
                            </div>
                        </div>
                        @if (_skillsSearchError is not null)
                        {
                            <div class="alert alert-warning py-2 small">@_skillsSearchError</div>
                        }
                        @if (_skillResults.Count > 0)
                        {
                            <div class="table-responsive mb-2">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Skill</th><th>Repository</th><th>Description</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var result in _skillResults)
                                        {
                                            <tr @key="SkillRowKey(result)">
                                                <td class="small font-monospace">@result.Name</td>
                                                <td class="small font-monospace">@result.Repository</td>
                                                <td class="small text-body-secondary">@result.Description</td>
                                                <td class="text-nowrap">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_skillsBusy"
                                                            @onclick="() => InstallOneSkillAsync(result)">Install</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h3 class="h6 fw-semibold mt-3 mb-2">Installed (@_installedSkills.Count)</h3>
                        @if (_installedSkills.Count == 0)
                        {
                            <p class="small text-body-secondary mb-0">No skills installed yet.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var skill in _installedSkills)
                                {
                                    @* O mesmo skill name aparece em várias homes
                                       (agents/claude/devin/…) e até duplicado
                                       dentro da mesma fonte — a key precisa ser
                                       o Path, que é único por instalação. *@
                                    <span class="badge text-bg-light border" title="@skill.Source — @skill.Description" @key="skill.Path">@skill.Name</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane" role="tabpanel" aria-label="General" hidden="@(_activeTab != "general")">
                <div class="form-section">
                    <h2 class="form-section-title">Features</h2>
                    <p class="small text-body-secondary">
                        Feature switches persist as database overrides and apply immediately — no restart.
                    </p>
                    @if (_configError is not null)
                    {
                        <div class="alert alert-warning mb-0">@_configError</div>
                    }
                    else
                    {
                        @foreach (var (key, label, description) in FeatureToggles)
                        {
                            var entry = FeatureEntry(key);
                            <div class="setting-row" @key="key">
                                <div>
                                    <div class="fw-medium">@label</div>
                                    <div class="small text-body-secondary">@description</div>
                                    @if (entry is not null)
                                    {
                                        <div class="mt-1">
                                            <span class="badge @GetSourceBadgeClass(entry.Source)">@entry.Source</span>
                                        </div>
                                    }
                                </div>
                                <div class="form-check form-switch mb-0">
                                    @if (entry is not null && entry.Editable)
                                    {
                                        <input type="checkbox" role="switch" class="form-check-input" checked="@(IsFeatureEnabled(entry))" @onchange="e => ToggleFeatureAsync(key, (bool)e.Value!)" aria-label="Enable @label" />
                                    }
                                    else
                                    {
                                        <span class="small text-body-secondary">unavailable</span>
                                    }
                                </div>
                            </div>
                        }

                        @* SPEC-20261005 RF-008: per-browser overrides win over
                           the global defaults above without touching shared
                           config — localStorage["harness.chat.notify.*"]. *@
                        <div class="setting-row">
                            <div>
                                <div class="fw-medium">Chat notifications — this browser</div>
                                <div class="small text-body-secondary">Override on this device only (default = use the global toggles above).</div>
                            </div>
                            <div class="d-flex gap-2 align-items-center small">
                                @foreach (var (pref, label) in NotifyBrowserPrefs)
                                {
                                    <label class="d-flex flex-column align-items-center text-body-secondary" @key="pref">
                                        @label
                                        <select class="form-select form-select-sm"
                                                value="@GetNotifyBrowserOverride(pref)"
                                                @onchange="e => SetNotifyBrowserOverrideAsync(pref, e.Value?.ToString())"
                                                aria-label="Browser override for @label">
                                            <option value="">default</option>
                                            <option value="on">on</option>
                                            <option value="off">off</option>
                                        </select>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
                </div>

                @* SPEC-20261010-settings-configuration-tab: dedicated tab — keys
                   grouped by category, managed-elsewhere keys hidden into links,
                   connections info header on top. *@
                <div class="tab-pane" role="tabpanel" aria-label="Configuration" hidden="@(_activeTab != "configuration")">
                @if (_configError is not null)
                {
                    <div class="alert alert-warning mb-3">@_configError</div>
                }
                else if (_configEntries.Count == 0)
                {
                    <EmptyState Message="No configuration keys." />
                }
                else
                {
                    <div class="form-section">
                        <h2 class="form-section-title">Connections</h2>
                        <p class="small text-body-secondary">Active database provider and cache mode (read-only).</p>
                        @if (_connectionInfo is not null)
                        {
                            <div class="setting-row">
                                <div>
                                    <div class="fw-medium">Database</div>
                                    <div class="small text-body-secondary font-monospace">
                                        ConnectionStrings:@(_connectionInfo.DbConnectionName ?? "Taskboard") = @(_connectionInfo.DbConnectionString ?? "—")
                                    </div>
                                </div>
                                <span class="badge text-bg-info align-self-center">@(_connectionInfo.DbProvider == "postgresql" ? "PostgreSQL" : "SQLite")</span>
                            </div>
                            <div class="setting-row">
                                <div>
                                    <div class="fw-medium">Cache</div>
                                    <div class="small text-body-secondary font-monospace">
                                        @if (_connectionInfo.CacheMode == "redis")
                                        {
                                            @($"Taskboard:Cache:Redis:InstanceName = {_connectionInfo.CacheInstanceName}")
                                        }
                                        else
                                        {
                                            @("Taskboard:Cache:Redis:ConnectionString — empty (L1 only)")
                                        }
                                    </div>
                                </div>
                                <span class="badge text-bg-info align-self-center">@(_connectionInfo.CacheMode == "redis" ? "Redis (L1+L2)" : "In-memory (L1)")</span>
                            </div>
                        }
                        @if (_cacheStats is not null)
                        {
                            <div class="setting-row">
                                <div>
                                    <div class="fw-medium">Provider</div>
                                    <div class="small text-body-secondary font-monospace">
                                        @if (_cacheStats.RedisConfigured)
                                        {
                                            @($"instance = {_cacheStats.InstanceName ?? "harness:"}")
                                            @if (_cacheStats.RedisConnected)
                                            {
                                                <text> — connected</text>
                                            }
                                            else
                                            {
                                                <text> — unreachable</text>
                                            }
                                        }
                                        else
                                        {
                                            @("in-process L1 — no Redis configured")
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-1 align-self-center">
                                    <span class="badge @(_cacheStats.Provider == "redis" ? "text-bg-info" : "text-bg-secondary")">@_cacheStats.Provider</span>
                                    @if (_cacheStats.RedisConfigured)
                                    {
                                        <span class="badge @(_cacheStats.RedisConnected ? "text-bg-success" : "text-bg-danger")" title="Redis PING">@(_cacheStats.RedisConnected ? "connected" : "down")</span>
                                    }
                                </div>
                            </div>
                            <div class="setting-row">
                                <div>
                                    <div class="fw-medium">TTLs</div>
                                    <div class="small text-body-secondary font-monospace">
                                        @($"L2 = {_cacheStats.DefaultExpirationSeconds}s · L1 = {_cacheStats.LocalCacheExpirationSeconds}s")
                                    </div>
                                </div>
                            </div>
                            <div class="setting-row">
                                <div>
                                    <div class="fw-medium">Keys</div>
                                    <div class="small text-body-secondary">
                                        written through HybridCache since boot
                                        @if (_cacheStats.ServerKeys is not null)
                                        {
                                            @($" · {_cacheStats.ServerKeys} on server{(_cacheStats.ServerKeysPartial ? "+" : "")}")
                                        }
                                    </div>
                                </div>
                                <span class="badge text-bg-light border align-self-center">@_cacheStats.Keys.Count</span>
                            </div>
                            @if (_cacheStats.StatsError is not null)
                            {
                                <div class="alert alert-warning small mb-2">@_cacheStats.StatsError</div>
                            }
                            @if (_cacheStats.Keys.Count == 0)
                            {
                                <p class="small text-body-secondary mb-0">No cached keys tracked yet — entries appear after the first cache write.</p>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col">Key</th>
                                                <th scope="col">Tags</th>
                                                <th scope="col">Seen</th>
                                                <th scope="col">Source</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var key in _cacheStats.Keys)
                                            {
                                                <tr @key="CacheKeyRowKey(key)">
                                                    <td class="font-monospace small text-break">@key.Key</td>
                                                    <td class="small text-body-secondary">@(key.Tags ?? "—")</td>
                                                    <td class="small text-nowrap">@(key.FirstSeenUtc == DateTimeOffset.MinValue ? "—" : key.FirstSeenUtc.LocalDateTime.ToString("HH:mm:ss"))</td>
                                                    <td><span class="badge @(key.Source == "redis" ? "text-bg-info" : "text-bg-light border")">@key.Source</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>

                    @foreach (var (groupId, title, description) in ConfigurationGroupSections)
                    {
                        var groupEntries = _configEntries.Where(e => e.ManagedIn is null && e.Group == groupId).ToList();
                        if (groupEntries.Count == 0)
                        {
                            continue;
                        }
                        <div class="form-section" @key="groupId">
                            <h2 class="form-section-title">@title</h2>
                            <p class="small text-body-secondary">@description Database overrides win over environment variables and appsettings.</p>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Key</th>
                                            <th scope="col">Value</th>
                                            <th scope="col">Source</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in groupEntries)
                                        {
                                            <tr @key="entry.Key">
                                                <td class="font-monospace small">@entry.Key</td>
                                                <td class="small">
                                                    @if (_editingKey == entry.Key)
                                                    {
                                                        <input type="text" class="form-control form-control-sm font-monospace" @bind="_editingValue" aria-label="Value for @entry.Key" />
                                                    }
                                                    else
                                                    {
                                                        @(entry.EffectiveValue ?? "—")
                                                        @if (entry.RequiresRestart)
                                                        {
                                                            <span class="badge text-bg-secondary ms-1" title="Applies on next restart">restart</span>
                                                        }
                                                    }
                                                </td>
                                                <td><span class="badge @GetSourceBadgeClass(entry.Source)">@entry.Source</span></td>
                                                <td class="text-end text-nowrap">
                                                    @if (_editingKey == entry.Key)
                                                    {
                                                        <div class="d-inline-flex gap-2">
                                                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => SaveConfigAsync(entry)">Save</button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelConfigEdit">Cancel</button>
                                                        </div>
                                                    }
                                                    else if (entry.Editable)
                                                    {
                                                        <div class="d-inline-flex gap-2">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartConfigEdit(entry)">Edit</button>
                                                            @if (entry.Source == "db")
                                                            {
                                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ResetConfigAsync(entry)">Reset</button>
                                                            }
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(entry.ReadOnlyReason))
                                                    {
                                                        <span class="small text-body-secondary" title="@entry.ReadOnlyReason">read-only</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    var managed = _configEntries.Where(e => e.ManagedIn is not null).ToList();
                    @if (managed.Count > 0)
                    {
                        <details class="mb-3">
                            <summary class="small text-body-secondary">Managed in other screens (@managed.Count keys)</summary>
                            <ul class="small mt-2 mb-0">
                                @foreach (var entry in managed)
                                {
                                    <li @key="entry.Key"><a href="@entry.ManagedIn">@entry.Key</a></li>
                                }
                            </ul>
                        </details>
                    }
                }
                </div>
            </div>

            <div class="action-bar">
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetAsync">Reset</button>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save changes</button>
            </div>
        </div>
    }
</div>

@* SPEC-20261010-mcp-skills-hub RF-006: add/remove MCP modals. *@
<Modal @ref="_mcpAddModal" Title="Add MCP server to agent CLIs" Size="ModalSize.Large"
       Fullscreen="ModalFullscreen.SmallDown" IsScrollable="true">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label small" for="mcp-add-name">Name</label>
            <input id="mcp-add-name" type="text" class="form-control form-control-sm font-monospace"
                   @bind="_mcpAddName" placeholder="e.g. filesystem" maxlength="64" spellcheck="false" />
        </div>
        <div class="mb-3">
            <label class="form-label small" for="mcp-add-transport">Transport</label>
            <select id="mcp-add-transport" class="form-select form-select-sm" @bind="_mcpAddTransport">
                <option value="http">HTTP (url)</option>
                <option value="stdio">stdio (command)</option>
            </select>
        </div>
        @if (_mcpAddTransport == "http")
        {
            <div class="mb-3">
                <label class="form-label small" for="mcp-add-url">URL</label>
                <input id="mcp-add-url" type="url" class="form-control form-control-sm font-monospace"
                       @bind="_mcpAddUrl" placeholder="https://mcp.example.com/mcp" spellcheck="false" />
            </div>
        }
        else
        {
            <div class="mb-2">
                <label class="form-label small" for="mcp-add-command">Command</label>
                <input id="mcp-add-command" type="text" class="form-control form-control-sm font-monospace"
                       @bind="_mcpAddCommand" placeholder="npx" spellcheck="false" />
            </div>
            <div class="mb-3">
                <label class="form-label small" for="mcp-add-args">Args (space separated)</label>
                <input id="mcp-add-args" type="text" class="form-control form-control-sm font-monospace"
                       @bind="_mcpAddArgs" placeholder="-y @@modelcontextprotocol/server-filesystem /path" spellcheck="false" />
            </div>
        }
        <fieldset class="mb-2">
            <legend class="form-label small">Apply to agents</legend>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var agent in _agentMcpInventory.Where(a => a.Writable))
                {
                    <div class="form-check" @key="agent.Agent">
                        <input class="form-check-input" type="checkbox" id="mcp-agent-@agent.Agent"
                               checked="@_mcpAddAgents.Contains(agent.Agent)"
                               @onchange="e => ToggleMcpAddAgent(agent.Agent, (bool)e.Value!)" />
                        <label class="form-check-label small" for="mcp-agent-@agent.Agent">@agent.Agent</label>
                    </div>
                }
            </div>
        </fieldset>
        @if (_mcpAddError is not null)
        {
            <div class="alert alert-warning py-2 small mb-0">@_mcpAddError</div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseMcpAddModalAsync">Cancel</button>
        <button type="button" class="btn btn-sm btn-primary" disabled="@_mcpBusy" @onclick="InstallAgentMcpAsync">Install</button>
    </FooterTemplate>
</Modal>

<Modal @ref="_mcpRemoveModal" Title="Remove MCP server" Size="ModalSize.Small"
       Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        <p class="small mb-0">Remove <code>@_removeServerName</code> from <strong>@_removeAgent</strong>'s config?</p>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseMcpRemoveModalAsync">Cancel</button>
        <button type="button" class="btn btn-sm btn-danger" disabled="@_mcpBusy" @onclick="RemoveAgentMcpAsync">Remove</button>
    </FooterTemplate>
</Modal>

