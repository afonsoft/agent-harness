    private async Task SaveChatSearchAsync()
    {
        _chatBusy = true;
        try
        {
            string? error;
            error = await Client.SetConfigurationValueAsync("Taskboard:Chat:SearchBackend", _chatSearchBackend);
            if (error is null && !string.IsNullOrWhiteSpace(_chatSearchUrl))
            {
                error = await Client.SetConfigurationValueAsync("Taskboard:Chat:SearchUrl", _chatSearchUrl.Trim());
            }

            if (error is null && !string.IsNullOrWhiteSpace(_chatSearchKey))
            {
                error = await Client.SetConfigurationValueAsync("Taskboard:Chat:SearchApiKey", _chatSearchKey);
            }

            if (error is not null)
            {
                await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to save search config: {error}"));
                return;
            }

            await ToastService.NotifyAsync(new(ToastType.Success, "Web search configuration saved"));
            await LoadConfigurationAsync();
        }
        finally
        {
            _chatBusy = false;
        }
    }

