        new("push", "push"),
    ];

    private readonly Dictionary<string, string?> _notifyBrowserOverrides = new(StringComparer.Ordinal);

    private async Task LoadNotifyBrowserOverridesAsync()
    {
        try
        {
            foreach (var (pref, _) in NotifyBrowserPrefs)
            {
                _notifyBrowserOverrides[pref] =
                    await JS.InvokeAsync<string?>("taskboardNotify.getChatPref", pref);
            }

            StateHasChanged();
            if (_activeTab == "mcp-skills")
            {
                _ = LoadMcpSkillsTabAsync();
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS indisponível — os selects ficam no "default".
        }
    }

    private string GetNotifyBrowserOverride(string pref) =>
        _notifyBrowserOverrides.TryGetValue(pref, out var v) ? v ?? "" : "";

    private async Task SetNotifyBrowserOverrideAsync(string pref, string? selected)
    {
        var normalized = selected == "on" ? "true" : selected == "off" ? "false" : null;
        _notifyBrowserOverrides[pref] = normalized;
        await JS.InvokeVoidAsync("taskboardNotify.setChatPref", pref, normalized);

        if (pref == "browser" && normalized == "true")
        {
            await ChatNotifications.EnsureBrowserPermissionAsync();
        }

        // SPEC-20261005 RF-009: per-browser push pref — subscribe/unsubscribe
        // this browser to match the resolved preference.
        if (pref == "push")
        {
            _ = ChatNotifications.SyncPushAsync();
        }
    }

    private string? ResolveTabFromQuery()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Length <= 1)
        {
            return null;
        }

        return query[1..].Split('&')
            .Select(pair => pair.Split('=', 2))
            .Where(pair => pair.Length == 2 && pair[0] == "tab")
            .Select(pair => Uri.UnescapeDataString(pair[1]))
            .FirstOrDefault();
    }

    private void SelectTab(string id)
    {
        _activeTab = id;
        Navigation.NavigateTo($"/settings?tab={id}", replace: true);
