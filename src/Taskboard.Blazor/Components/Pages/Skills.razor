@page "/skills"
@attribute [Authorize]
@inject TaskboardClient Client

<PageTitle>Skills - Harness</PageTitle>

<Modal @ref="_skillModal" Size="ModalSize.Large" DialogCssClass="modal-70" IsScrollable="true" />

<h1 class="h4 fw-bold mb-1">Skills</h1>
<p class="small text-body-secondary mb-4">Installed agent skills</p>

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-column gap-3 mb-4">
            <div>
                <label for="skills-search" class="visually-hidden">Search skills</label>
                <input id="skills-search" type="search" class="form-control" placeholder="Search by name, description or source" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilters" />
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="filter-chip @(string.IsNullOrEmpty(_selectedSource) ? "active" : "")" @onclick="() => SelectSource(null)">All</button>
                @foreach (var source in _sources)
                {
                    <button type="button" class="filter-chip @(_selectedSource == source ? "active" : "")" @onclick="() => SelectSource(source)">@source</button>
                }
            </div>
        </div>

        @if (_loading)
        {
            <Loading Message="Loading skills..." />
        }
        else if (_errorMessage is not null)
        {
            <div class="alert alert-danger mb-3">@_errorMessage</div>
        }
        else if (!_filteredSkills.Any())
        {
            @if (string.IsNullOrWhiteSpace(_search) && string.IsNullOrWhiteSpace(_selectedSource))
            {
                <EmptyState Message="No skills installed." />
            }
            else
            {
                <EmptyState Message="No skills match your filters." />
                <div class="mt-3 text-center">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear filters</button>
                </div>
            }
        }
        else
        {
            <div class="skill-grid">
                @foreach (var skill in _filteredSkills)
                {
                    <div class="skill-card" tabindex="0" @key="skill.Path" @onclick="() => OpenDetail(skill)" @onkeydown="e => HandleKeyDown(e, skill)">
                        <div class="skill-card-header">
                            <h3 class="skill-card-title" title="@skill.Name">@skill.Name</h3>
                            <span class="source-badge @GetSourceBadgeClass(skill.Source)">@skill.Source</span>
                        </div>
                        <p class="skill-card-description">@skill.Description</p>
                        <p class="skill-card-path" title="@skill.Path">@skill.Path</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private Modal _skillModal = default!;
    private bool _loading = true;
    private string? _errorMessage;
    private string _search = string.Empty;
    private string? _selectedSource;
    private IReadOnlyList<SkillDto> _skills = [];
    private IReadOnlyList<SkillDto> _filteredSkills = [];
    private List<string> _sources = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _skills = await Client.GetSkillsAsync();
            _sources = _skills.Select(s => s.Source).Distinct().OrderBy(s => s).ToList();
            _filteredSkills = _skills;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading skills: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectSource(string? source)
    {
        _selectedSource = source;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _selectedSource = null;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredSkills = _skills.Where(Filter).ToList();
    }

    private bool Filter(SkillDto skill)
    {
        var matchesSearch = string.IsNullOrWhiteSpace(_search)
            || skill.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || skill.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || skill.Source.Contains(_search, StringComparison.OrdinalIgnoreCase);

        var matchesSource = string.IsNullOrWhiteSpace(_selectedSource)
            || skill.Source.Equals(_selectedSource, StringComparison.OrdinalIgnoreCase);

        return matchesSearch && matchesSource;
    }

    private static string GetSourceBadgeClass(string source) => source.ToLowerInvariant() switch
    {
        "claude" => "source-badge-claude",
        "devin" => "source-badge-devin",
        "cursor" => "source-badge-cursor",
        "opencode" => "source-badge-opencode",
        "taskboard" => "source-badge-taskboard",
        _ => "source-badge-unknown"
    };

    private async Task OpenDetail(SkillDto skill)
    {
        try
        {
            var detail = await Client.GetSkillDetailAsync(skill.Source, skill.Name);
            if (detail is null)
            {
                return;
            }

            var parameters = new Dictionary<string, object>
            {
                { nameof(SkillDetailDialog.Skill), detail }
            };

            await _skillModal.ShowAsync<SkillDetailDialog>(title: skill.Name, parameters: parameters);
        }
        catch
        {
            // ignore dialog errors
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, SkillDto skill)
    {
        if (e.Code is "Enter" or "Space")
        {
            await OpenDetail(skill);
        }
    }
}
