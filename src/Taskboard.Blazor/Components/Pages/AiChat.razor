@page "/ai-chat"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@inject TaskboardClient Client
@inject IAgentOrchestrationService OrchestrationService
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>AI Code - Harness</PageTitle>

<h1 class="h4 fw-bold mb-1">AI Code</h1>
<p class="small text-body-secondary mb-3">Chat threads and agent sub-tasks</p>

@if (_threads is null)
{
    <Loading Message="Loading threads..." />
}
else
{
    <div class="ai-chat-layout">
        <aside class="ai-chat-sidebar card">
            <div class="card-body p-2">
                <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Class="w-100 mb-2" @onclick="ShowNewThreadAsync">
                    + New thread
                </Button>
                @if (_threads.Count == 0)
                {
                    <div class="text-body-secondary small p-2">No threads yet.</div>
                }
                <ul class="ai-chat-thread-list list-unstyled mb-0">
                    @foreach (var thread in OrderedThreads)
                    {
                        var isActive = thread.Id == _activeThreadId;
                        <li class="ai-chat-thread-item @(isActive ? "active" : null)">
                            <button type="button" class="ai-chat-thread-btn" @onclick="() => SelectThreadAsync(thread)">
                                <span class="ai-chat-thread-title text-truncate">@thread.Title</span>
                                <span class="ai-chat-thread-meta">
                                    <span class="badge text-bg-secondary">@thread.Model</span>
                                    @if (thread.Status == "running")
                                    {
                                        <span class="badge text-bg-warning ai-chat-badge-live">running</span>
                                    }
                                    else if (thread.Status == "failed")
                                    {
                                        <span class="badge text-bg-danger">failed</span>
                                    }
                                </span>
                            </button>
                            @if (_deleteConfirmId == thread.Id)
                            {
                                <span class="ai-chat-thread-confirm">
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteThreadAsync(thread)">Delete</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _deleteConfirmId = null">Cancel</button>
                                </span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-link text-danger ai-chat-thread-delete"
                                        title="Delete thread" @onclick="() => _deleteConfirmId = thread.Id">
                                    <Icon Name="IconName.Trash" />
                                </button>
                            }
                        </li>
                    }
                </ul>
            </div>
        </aside>

        <section class="ai-chat-main card">
            @if (_activeThread is null)
            {
                <div class="card-body">
                    <EmptyState Message="Select a thread or create a new one." />
                </div>
            }
            else
            {
                <div class="card-header d-flex align-items-center justify-content-between py-2">
                    <div class="text-truncate">
                        <strong>@_activeThread.Title</strong>
                        <span class="text-body-secondary small ms-2">@_activeThread.Model</span>
                        @if (!string.IsNullOrWhiteSpace(_activeThread.AgentType))
                        {
                            <span class="badge text-bg-primary ms-2">agent: @_activeThread.AgentType</span>
                        }
                    </div>
                    @if (_running)
                    {
                        <span class="badge text-bg-warning ai-chat-badge-live">running</span>
                    }
                    else if (_activeThread.Status == "failed")
                    {
                        <span class="badge text-bg-danger">failed</span>
                    }
                </div>

                @if (_sseError)
                {
                    <div class="alert alert-warning small py-1 px-3 mb-0 rounded-0">
                        Live stream interrupted — retrying automatically.
                    </div>
                }

                <div class="ai-chat-messages card-body" @ref="_messagesRef">
                    @if (_events.Count == 0 && !_running)
                    {
                        <div class="text-body-secondary small">No messages yet — say something below.</div>
                    }
                    @if (_activeThread.Mode == "agent")
                    {
                        @foreach (var item in AgentRenderItems)
                        {
                            if (item.Tool is { } tool)
                            {
                                <ToolCallCard Model="tool" />
                                continue;
                            }

                            if (item.Group is { } group)
                            {
                                <ToolCallChangesCard Items="group" />
                                continue;
                            }

                            var ev = item.Event!;
                            if (ev.Kind is "metric" or "permission")
                            {
                                // Metrics feed the composer meter; pending
                                // permissions render below the stream.
                                continue;
                            }

                            if (ev.Role is "queued")
                            {
                                <div class="ai-chat-msg ai-chat-msg-user">
                                    <div class="ai-chat-bubble ai-chat-queued">
                                        @ev.Content
                                        <span class="badge text-bg-secondary ms-2">queued</span>
                                        <button type="button" class="btn btn-sm btn-link text-danger py-0 ms-1"
                                                title="Cancel queued prompt"
                                                @onclick="() => CancelQueuedAsync(ev.Id)">
                                            <Icon Name="IconName.XCircle" />
                                        </button>
                                    </div>
                                </div>
                                continue;
                            }

                            if (ev.Role is "user")
                            {
                                <div class="ai-chat-msg ai-chat-msg-user">
                                    <div class="ai-chat-bubble">
                                        @ev.Content
                                        <button type="button" class="btn btn-sm btn-link ai-chat-fork-btn"
                                                title="Fork thread from here"
                                                @onclick="() => ForkFromAsync(ev.Id)">
                                            <Icon Name="IconName.Diagram3" />
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (ev.Role is "assistant" && ev.Kind is not "session")
                            {
                                <div class="ai-chat-msg ai-chat-msg-assistant">
                                    <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(ev.Content))</div>
                                </div>
                            }
                            else
                            {
                                <div class="ai-chat-msg ai-chat-msg-system">
                                    <span class="@(ev.Role == "error" ? "text-danger" : "text-body-secondary")">@ev.Content</span>
                                </div>
                            }
                        }
                        @foreach (var permission in _permissions)
                        {
                            <PermissionPromptCard Request="permission" OnReply="OnPermissionReplyAsync" />
                        }
                    }
                    else
                    {
                        @foreach (var group in GroupedEvents)
                        {
                            @if (group.Role is "user")
                            {
                                <div class="ai-chat-msg ai-chat-msg-user">
                                    <div class="ai-chat-bubble">@group.Text</div>
                                </div>
                            }
                            else if (group.Role is "assistant")
                            {
                                <div class="ai-chat-msg ai-chat-msg-assistant">
                                    <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(group.Text))</div>
                                </div>
                            }
                            else
                            {
                                <div class="ai-chat-msg ai-chat-msg-system">
                                    <span class="@(group.Role == "error" ? "text-danger" : "text-body-secondary")">@group.Text</span>
                                </div>
                            }
                        }
                    }
                    @if (_running)
                    {
                        <div class="ai-chat-msg ai-chat-msg-assistant">
                            <div class="ai-chat-bubble ai-chat-typing">
                                <Spinner Size="SpinnerSize.Small" /> thinking…
                            </div>
                        </div>
                    }
                </div>

                <div class="card-footer p-2">
                    @if (_activeThread.Mode == "agent" && (_modelOptions.Count > 0 || _modes.Count > 0 || Usage is not null))
                    {
                        <div class="d-flex gap-3 align-items-center mb-2 flex-wrap small">
                            @if (_modelOptions.Count > 0)
                            {
                                <label class="d-flex align-items-center gap-1 mb-0">
                                    <span class="text-body-secondary">model</span>
                                    <select class="form-select form-select-sm ai-chat-quickselect"
                                            value="@_currentModel"
                                            @onchange="OnModelSwitchAsync">
                                        @foreach (var option in _modelOptions)
                                        {
                                            <option value="@option" selected="@(option == _currentModel)">@option</option>
                                        }
                                    </select>
                                </label>
                            }
                            @if (_modes.Count > 0)
                            {
                                <label class="d-flex align-items-center gap-1 mb-0">
                                    <span class="text-body-secondary">mode</span>
                                    <select class="form-select form-select-sm ai-chat-quickselect"
                                            value="@_currentMode"
                                            @onchange="OnModeSwitchAsync">
                                        @foreach (var mode in _modes)
                                        {
                                            <option value="@mode.Id" selected="@(mode.Id == _currentMode)">@mode.Name</option>
                                        }
                                    </select>
                                </label>
                            }
                            @if (Usage is { } usage)
                            {
                                var percent = usage.Ratio is { } r ? (int)Math.Round(r * 100) : 0;
                                var meterClass = percent >= 95 ? "bg-danger" : percent >= 80 ? "bg-warning" : "bg-success";
                                <div class="d-flex align-items-center gap-2 ms-auto" title="@UsageTooltip(usage)">
                                    <div class="progress ai-chat-meter" role="progressbar">
                                        <div class="progress-bar @meterClass" style="width: @Math.Min(percent, 100)%"></div>
                                    </div>
                                    <span class="text-body-secondary">
                                        @usage.Used.ToString("N0")@(usage.Size is { } s ? $" / {s:N0}" : "") tokens
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    <div class="d-flex gap-2 align-items-end">
                        <textarea class="form-control ai-chat-composer" rows="2"
                                  placeholder="@(_running && _activeThread.Mode != "agent" ? "Waiting for the assistant…" : (_activeThread.Mode == "agent" && _running ? "Steer or queue instruction…" : "Message…"))"
                                  disabled="@((_running && _activeThread.Mode != "agent") || _sending)"
                                  @bind="_composer"
                                  @bind:event="oninput"
                                  @onkeydown="OnComposerKeyDownAsync"></textarea>
                        <div class="d-flex flex-column gap-2">
                            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                                    Disabled="@((_running && _activeThread.Mode != "agent") || _sending || string.IsNullOrWhiteSpace(_composer))"
                                    @onclick="SendMessageAsync">Send</Button>
                            @if (_activeThread.Mode == "agent")
                            {
                                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                        Disabled="@_sending"
                                        title="Resend the last user prompt"
                                        @onclick="RetryAgentAsync">Retry</Button>
                                @if (_running)
                                {
                                    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="StopAgentAsync">Stop</Button>
                                }
                            }
                            else
                            {
                                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                        Disabled="@(_running || _sending)"
                                        @onclick="ShowRunAgentAsync">Run agent</Button>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
}

<Modal @ref="_newThreadModal" />
<Modal @ref="_runAgentModal" />

@code {
    private static readonly JsonSerializerOptions SseJson = new(JsonSerializerDefaults.Web);

    private IReadOnlyCollection<AiChatThreadDto>? _threads;
    private string? _activeThreadId;
    private AiChatThreadDto? _activeThread;
    private readonly List<AiChatEventDto> _events = [];
    private readonly HashSet<string> _seenEventIds = new(StringComparer.Ordinal);
    private readonly List<PermissionRequestInfo> _permissions = [];
    private readonly List<string> _modelOptions = [];
    private readonly List<(string Id, string Name)> _modes = [];
    private string? _modelConfigId;
    private string? _currentModel;
    private string? _currentMode;
    private string _composer = string.Empty;
    private bool _running;
    private bool _sending;
    private bool _sseError;
    private bool _scrollPending;
    private string? _deleteConfirmId;
    private ElementReference _messagesRef;
    private Modal _newThreadModal = default!;
    private Modal _runAgentModal = default!;
    private DotNetObjectReference<AiChat>? _dotNetRef;
    private CancellationTokenSource _disposeCts = new();

    private IEnumerable<AiChatThreadDto> OrderedThreads =>
        _threads?.OrderByDescending(t => t.UpdatedAt) ?? Enumerable.Empty<AiChatThreadDto>();

    // SPEC-20260921-ai-code-chat-ux RF-001: o stream flat vira render items —
    // tool_call+updates fundem por toolCallId e edições consecutivas agregam.
    private IReadOnlyList<ChatRenderItem> AgentRenderItems => ToolCallGrouper.Build(_events);

    // RF-003: último usage_update do stream alimenta o medidor de contexto.
    private ContextUsage? Usage
    {
        get
        {
            for (var i = _events.Count - 1; i >= 0; i--)
            {
                if (_events[i].Kind == "metric")
                {
                    return ContextUsage.TryParse(_events[i].PayloadJson);
                }
            }

            return null;
        }
    }

    private static string UsageTooltip(ContextUsage usage)
    {
        var tip = $"context used: {usage.Used:N0}";
        if (usage.Size is { } size)
        {
            tip += $" of {size:N0} tokens";
        }

        if (usage.Cost is { } cost)
        {
            tip += $" · cost ${cost:F4}";
        }

        return tip;
    }

    // Consecutive user/assistant events render as one bubble — the server stores
    // one event per streamed delta, so grouping merges them into a growing
    // message. System-level roles (activity/error) render one line each.
    private IEnumerable<(string Role, string Text)> GroupedEvents
    {
        get
        {
            string? role = null;
            var buffer = new System.Text.StringBuilder();
            foreach (var ev in _events)
            {
                var normalized = ev.Role is "user" or "assistant" ? ev.Role : null;
                if (normalized is null)
                {
                    if (role is not null)
                    {
                        yield return (role, buffer.ToString());
                        buffer.Clear();
                        role = null;
                    }
                    yield return (ev.Role, ev.Content);
                    continue;
                }

                if (role is not null && normalized != role)
                {
                    yield return (role, buffer.ToString());
                    buffer.Clear();
                }
                role = normalized;
                buffer.Append(normalized == "assistant" ? ev.Content : ev.Content + "\n");
            }
            if (role is not null)
            {
                yield return (role, buffer.ToString());
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            _threads = await Client.GetAiChatThreadsAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to load threads: {ex.Message}"));
            _threads = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("taskboard.scrollToBottom", _messagesRef);
        }
    }

    private async Task SelectThreadAsync(AiChatThreadDto thread)
    {
        _activeThread = thread;
        _activeThreadId = thread.Id;
        _events.Clear();
        _seenEventIds.Clear();
        _permissions.Clear();
        _modelOptions.Clear();
        _modes.Clear();
        _modelConfigId = null;
        _currentModel = null;
        _currentMode = null;
        _running = thread.Status == "running";
        _sseError = false;
        _scrollPending = true;

        await JS.InvokeVoidAsync(
            "taskboardSse.connect",
            "ai-chat",
            $"/api/local/ai/threads/{Uri.EscapeDataString(thread.Id)}/events",
            _dotNetRef,
            new[] { "ai_chat.event", "ai_chat.run", "ai_chat.session", "ai_chat.permission" });

        // RF-005: quick-switch controls appear only when the peer advertised
        // model configOptions / modes in the negotiated session info.
        if (thread.Mode == "agent")
        {
            try
            {
                var state = await Client.GetAgentScopeStateAsync("thread", thread.Id);
                ParseSessionInfo(state?.SessionInfoJson);
                _running = state?.State == "running" || _running;
            }
            catch (Exception)
            {
                // Controls are optional — session info may be absent.
            }
        }
    }

    private void ParseSessionInfo(string? sessionInfoJson)
    {
        if (string.IsNullOrWhiteSpace(sessionInfoJson))
        {
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(sessionInfoJson);
            var root = doc.RootElement;

            if (root.TryGetProperty("configOptions", out var options) && options.ValueKind == JsonValueKind.Array)
            {
                foreach (var option in options.EnumerateArray())
                {
                    var category = option.TryGetProperty("category", out var c) ? c.GetString() : null;
                    if (!string.Equals(category, "model", StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    _modelConfigId = option.TryGetProperty("id", out var oid) ? oid.GetString() : "model";
                    _currentModel = option.TryGetProperty("value", out var v) ? v.GetString() : null;
                    if (option.TryGetProperty("options", out var values) && values.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var entry in values.EnumerateArray())
                        {
                            var val = entry.TryGetProperty("value", out var ev) ? ev.GetString()
                                : entry.ValueKind == JsonValueKind.String ? entry.GetString() : null;
                            if (val is { Length: > 0 } && !_modelOptions.Contains(val))
                            {
                                _modelOptions.Add(val);
                            }
                        }
                    }
                }
            }

            if (root.TryGetProperty("modes", out var modes) && modes.ValueKind == JsonValueKind.Object)
            {
                _currentMode = modes.TryGetProperty("currentModeId", out var cm) ? cm.GetString() : null;
                if (modes.TryGetProperty("availableModes", out var available) && available.ValueKind == JsonValueKind.Array)
                {
                    foreach (var mode in available.EnumerateArray())
                    {
                        var id = mode.TryGetProperty("id", out var mid) ? mid.GetString() : null;
                        if (id is { Length: > 0 })
                        {
                            var name = mode.TryGetProperty("name", out var mn) ? mn.GetString() : null;
                            _modes.Add((id, name ?? id));
                        }
                    }
                }
            }
        }
        catch (JsonException)
        {
        }
    }

    [JSInvokable]
    public async Task OnSseEvent(string eventType, string data)
    {
        try
        {
            if (eventType == "ai_chat.permission")
            {
                var permission = JsonSerializer.Deserialize<PermissionRequestInfo>(data, SseJson);
                if (permission is not null && !_permissions.Any(p => p.RequestId == permission.RequestId))
                {
                    _permissions.Add(permission);
                    _scrollPending = true;
                }
                _sseError = false;
            }
            else if (eventType == "ai_chat.event")
            {
                var ev = JsonSerializer.Deserialize<AiChatEventDto>(data, SseJson);
                if (ev is not null)
                {
                    if (_seenEventIds.Add(ev.Id))
                    {
                        _events.Add(ev);
                        _scrollPending = true;
                    }
                    else
                    {
                        // Re-published event (e.g. queued → dispatched user):
                        // update in place rather than skip.
                        var index = _events.FindIndex(e => e.Id == ev.Id);
                        if (index >= 0)
                        {
                            _events[index] = ev;
                        }
                    }

                    // Turn ends on session/prompt stopReason or session death.
                    if (ev.Kind == "session"
                        && (ev.PayloadJson?.Contains("\"stopReason\"") == true
                            || ev.PayloadJson?.Contains("\"dead\"") == true))
                    {
                        _running = false;
                    }
                }
                _sseError = false;
            }
            else if (eventType == "ai_chat.session")
            {
                _scrollPending = true;
            }
            else if (eventType == "ai_chat.run")
            {
                var run = JsonSerializer.Deserialize<AiChatRunDto>(data, SseJson);
                if (run is not null)
                {
                    _running = run.Status == "running";
                    if (_activeThreadId == run.ThreadId && _activeThread is { } active)
                    {
                        var status = run.Status == "failed" ? "failed" : run.Status == "running" ? "running" : "idle";
                        _activeThread = active with { Status = status };
                        _threads = _threads?.Select(t => t.Id == run.ThreadId ? t with { Status = status } : t).ToList();
                    }
                    _scrollPending = true;
                }
                _sseError = false;
            }
        }
        catch (JsonException)
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSseError()
    {
        _sseError = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnComposerKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_sending && !string.IsNullOrWhiteSpace(_composer))
        {
            if (!_running || _activeThread?.Mode == "agent")
            {
                await SendMessageAsync();
            }
        }
    }

    private async Task SendMessageAsync()
    {
        var threadId = _activeThreadId;
        var content = _composer.Trim();
        if (threadId is null || content.Length == 0)
        {
            return;
        }

        _sending = true;
        try
        {
            if (_activeThread?.Mode == "agent")
            {
                // RF-002: the queue endpoint persists the prompt (queued event)
                // and dispatches FIFO — no separate user-event post needed.
                var queued = await Client.QueueAgentThreadPromptAsync(threadId, content);
                _composer = string.Empty;
                if (queued is null)
                {
                    ToastService.Notify(new(ToastType.Danger, "Failed to queue the prompt."));
                    return;
                }

                if (_seenEventIds.Add(queued.Id))
                {
                    _events.Add(queued);
                    _scrollPending = true;
                }

                _running = true;
                return;
            }

            var postedAssistant = await Client.PostAiChatEventAsync(threadId, new AddAiChatEventRequest("user", content));
            if (postedAssistant is null)
            {
                ToastService.Notify(new(ToastType.Danger, "Failed to post the message."));
                return;
            }

            _composer = string.Empty;
            _running = true;

            var run = await Client.StartAiChatRunAsync(threadId);
            if (run is null)
            {
                _running = false;
                ToastService.Notify(new(ToastType.Danger, "Failed to start the assistant run."));
            }
        }
        catch (Exception ex)
        {
            _running = false;
            ToastService.Notify(new(ToastType.Danger, $"Send failed: {ex.Message}"));
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task StopAgentAsync()
    {
        if (_activeThreadId is null) return;
        var ok = await Client.CancelAgentThreadAsync(_activeThreadId);
        if (ok)
        {
            _running = false;
            ToastService.Notify(new(ToastType.Info, "Agent run cancelled."));
        }
    }

    /// <summary>RF-002: cancel a queued prompt before the backend dispatches it.</summary>
    private async Task CancelQueuedAsync(string eventId)
    {
        if (_activeThreadId is null) return;
        if (await Client.CancelQueuedPromptAsync(_activeThreadId, eventId))
        {
            _events.RemoveAll(e => e.Id == eventId);
            _seenEventIds.Remove(eventId);
        }
    }

    /// <summary>RF-004: fork this thread at the selected event and switch to the new thread.</summary>
    private async Task ForkFromAsync(string eventId)
    {
        if (_activeThreadId is null) return;
        var fork = await Client.ForkAiChatThreadAsync(_activeThreadId, eventId);
        if (fork is null)
        {
            ToastService.Notify(new(ToastType.Danger, "Failed to fork the thread."));
            return;
        }

        _threads = (_threads ?? []).Concat([fork]).ToList();
        ToastService.Notify(new(ToastType.Success, $"Forked into '{fork.Title}'."));
        await SelectThreadAsync(fork);
    }

    /// <summary>RF-004: resend the last user prompt (cancels an active turn first).</summary>
    private async Task RetryAgentAsync()
    {
        if (_activeThreadId is null) return;
        var admitted = await Client.RetryAgentThreadAsync(_activeThreadId);
        if (admitted)
        {
            _running = true;
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, "Nothing to retry — send a prompt first."));
        }
    }

    /// <summary>RF-005: session/set_config_option for the ACP model option.</summary>
    private async Task OnModelSwitchAsync(ChangeEventArgs e)
    {
        if (_activeThreadId is null || _modelConfigId is null || e.Value is not string value)
        {
            return;
        }

        var ok = await Client.PostAgentControlAsync(
            new AgentControlRequest("thread", _activeThreadId, "set_config", Content: value, ConfigId: _modelConfigId));
        if (ok)
        {
            _currentModel = value;
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, "Model switch rejected — no live session."));
        }
    }

    /// <summary>RF-005: session/set_mode on the live session.</summary>
    private async Task OnModeSwitchAsync(ChangeEventArgs e)
    {
        if (_activeThreadId is null || e.Value is not string modeId)
        {
            return;
        }

        var ok = await Client.PostAgentControlAsync(
            new AgentControlRequest("thread", _activeThreadId, "set_mode", Content: modeId));
        if (ok)
        {
            _currentMode = modeId;
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, "Mode switch rejected — no live session."));
        }
    }

    private async Task OnPermissionReplyAsync((string RequestId, string Outcome) args)
    {
        if (_activeThreadId is null) return;
        var ok = await Client.ReplyAgentPermissionAsync(_activeThreadId, args.RequestId, args.Outcome);
        _permissions.RemoveAll(p => p.RequestId == args.RequestId);
        if (ok)
        {
            ToastService.Notify(new(ToastType.Success, $"Permission '{args.Outcome}' sent to agent."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, "Permission request already expired."));
        }
    }

    private async Task ShowNewThreadAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            ["OnSubmit"] = EventCallback.Factory.Create<CreateAiChatThreadRequest>(this, CreateThreadAsync),
            ["OnCancel"] = EventCallback.Factory.Create(this, () => _newThreadModal.HideAsync())
        };
        await _newThreadModal.ShowAsync<NewThreadDialog>(title: "New thread", parameters: parameters);
    }

    private async Task CreateThreadAsync(CreateAiChatThreadRequest request)
    {
        var thread = await Client.CreateAiChatThreadAsync(request);
        await _newThreadModal.HideAsync();
        if (thread is null)
        {
            ToastService.Notify(new(ToastType.Danger, "Failed to create the thread."));
            return;
        }

        _threads = (_threads ?? []).Concat([thread]).ToList();
        await SelectThreadAsync(thread);
    }

    private async Task DeleteThreadAsync(AiChatThreadDto thread)
    {
        _deleteConfirmId = null;
        var deleted = await Client.DeleteAiChatThreadAsync(thread.Id);
        if (!deleted)
        {
            ToastService.Notify(new(ToastType.Danger, "Failed to delete the thread."));
            return;
        }

        _threads = (_threads ?? []).Where(t => t.Id != thread.Id).ToList();
        if (_activeThreadId == thread.Id)
        {
            await JS.InvokeVoidAsync("taskboardSse.disconnect", "ai-chat");
            _activeThread = null;
            _activeThreadId = null;
            _events.Clear();
            _seenEventIds.Clear();
            _running = false;
        }
    }

    private async Task ShowRunAgentAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            ["OnSubmit"] = EventCallback.Factory.Create<RunAgentDialog.RunAgentSelection>(this, QueueAgentAsync),
            ["OnCancel"] = EventCallback.Factory.Create(this, () => _runAgentModal.HideAsync())
        };
        await _runAgentModal.ShowAsync<RunAgentDialog>(title: "Run agent on this thread", parameters: parameters);
    }

    private async Task QueueAgentAsync(RunAgentDialog.RunAgentSelection selection)
    {
        await _runAgentModal.HideAsync();
        var threadId = _activeThreadId;
        var threadTitle = _activeThread?.Title ?? "thread";
        if (threadId is null)
        {
            return;
        }

        var issueId = $"thread-{threadId}";
        var prompt = AgentThreadPromptBuilder.Build(threadTitle, selection.RepositoryFullName, _events);
        var request = new AgentExecutionRequest(
            issueId,
            IssueNumber: 0,
            selection.RepositoryFullName,
            RepoPath: string.Empty,
            Branch: null,
            Scope: null,
            prompt,
            selection.AgentType,
            selection.Tier);

        bool queued;
        try
        {
            queued = await OrchestrationService.EnqueueAsync(request);
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Failed to queue the agent: {ex.Message}"));
            return;
        }

        if (!queued)
        {
            ToastService.Notify(new(ToastType.Danger, $"{selection.AgentName} is not eligible right now (disabled or CLI not authenticated)."));
            return;
        }

        await Client.PostAiChatEventAsync(
            threadId,
            new AddAiChatEventRequest("activity",
                $"{selection.AgentName} queued for {selection.RepositoryFullName} (tier {selection.Tier})."));

        _ = PollAgentRunAsync(issueId, threadId, selection.AgentName, selection.RepositoryFullName, _disposeCts.Token);
    }

    private async Task PollAgentRunAsync(
        string issueId, string threadId, string agentName, string repo, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            var deadline = DateTime.UtcNow.AddMinutes(15);
            while (DateTime.UtcNow < deadline && await timer.WaitForNextTickAsync(ct))
            {
                var runs = await OrchestrationService.GetRunsAsync(issueId, 1, ct);
                var latest = runs.FirstOrDefault();
                if (latest?.State is AgentRunState.Succeeded or AgentRunState.Failed or AgentRunState.Canceled or AgentRunState.BudgetExceeded)
                {
                    var ok = latest.State == AgentRunState.Succeeded;
                    await Client.PostAiChatEventAsync(
                        threadId,
                        new AddAiChatEventRequest(ok ? "activity" : "error",
                            $"{agentName} {latest.State.ToString().ToLowerInvariant()} on {repo}."),
                        ct);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // Status post-back is best-effort — the run itself is unaffected.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _disposeCts.CancelAsync();
        _disposeCts.Dispose();
        try
        {
            await JS.InvokeVoidAsync("taskboardSse.disconnect", "ai-chat");
        }
        catch (JSDisconnectedException)
        {
        }
        _dotNetRef?.Dispose();
    }
}
