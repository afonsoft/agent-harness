            options.Add(new CliOption(
                $"custom:{def.Id}", label, null, def.Id,
                // Custom defs spawn via argv (PTY) only — the server refuses
                // acp transport for them (SPEC-20260929-ai-chat-capabilities).
                SupportsChat: false,
