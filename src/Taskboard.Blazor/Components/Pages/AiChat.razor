    {
        var space = content.IndexOf(' ', StringComparison.Ordinal);
        var command = (space < 0 ? content : content[..space]).TrimStart('/');
        var rest = space < 0 ? string.Empty : content[(space + 1)..];

        if (await TryRunBuiltinAsync(command))
