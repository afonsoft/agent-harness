    private async Task SelectThreadAsync(AiChatThreadDto thread)
    {
        ResetThreadState(thread);
        await SyncBarDefaultsAsync(thread);
        await ConnectThreadSseAsync(thread);
        await LoadAgentScopeAsync(thread);
    }

    private void ResetThreadState(AiChatThreadDto thread)
    {
        _activeThread = thread;
        _activeThreadId = thread.Id;
        _events.Clear();
        _seenEventIds.Clear();
        _permissions.Clear();
        _modelOptions.Clear();
        _modes.Clear();
        _modelConfigId = null;
        _currentModel = null;
        _currentMode = null;
        _running = thread.Status == "running";
        _sseError = false;
        _scrollPending = true;
    }

    private async Task SyncBarDefaultsAsync(AiChatThreadDto thread)
    {
        // Keep the bar defaults in sync so "New" starts from this config.
        _cfgMode = thread.Mode;
        var cliOption = CliOptionFor(thread.AgentCliId, thread.AgentType);
        if (cliOption is not null)
        {
            _cfgCli = cliOption;
            _cfgView = thread.Transport == "pty" ? "terminal" : "chat";
            _cfgContext = thread.ContainerContext ?? string.Empty;
            try
            {
                await JS.InvokeVoidAsync("taskboard.setAiChatLastAgent", _cfgCli);
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
            {
                // Best-effort — failure here is non-fatal.
            }
        }

        _cfgRepo = thread.RepositoryFullName ?? string.Empty;
        _cfgModelTier = thread.ModelTier ?? string.Empty;
        _cfgModelId = string.Empty;
        _cfgSandbox = thread.Sandbox;
    }

    private async Task ConnectThreadSseAsync(AiChatThreadDto thread) =>
        await JS.InvokeVoidAsync(
            "taskboardSse.connect",
            "ai-chat",
            $"/api/local/ai/threads/{Uri.EscapeDataString(thread.Id)}/events",
            _dotNetRef,
            new[] { "ai_chat.event", "ai_chat.run", "ai_chat.session", "ai_chat.permission" });

    private async Task LoadAgentScopeAsync(AiChatThreadDto thread)
    {
        // RF-005: quick-switch controls appear only when the peer advertised
        // model configOptions / modes in the negotiated session info.
        if (thread.Mode != "agent")
        {
            return;
        }

        try
        {
            var state = await Client.GetAgentScopeStateAsync("thread", thread.Id);
            ParseSessionInfo(state?.SessionInfoJson);
            _running = state?.State == "running" || _running;
        }
        catch (Exception)
        {
            // Controls are optional — session info may be absent.
        }
    }

    private void ParseSessionInfo(string? sessionInfoJson)
    {
        if (string.IsNullOrWhiteSpace(sessionInfoJson))
        {
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(sessionInfoJson);
            var root = doc.RootElement;
            ParseModelConfigOptions(root);
            ParseSessionModes(root);
        }
        catch (JsonException)
        {
            // Malformed payload — treated as absent.
        }
    }

    private void ParseModelConfigOptions(JsonElement root)
    {
        if (!root.TryGetProperty("configOptions", out var options) || options.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        foreach (var option in options.EnumerateArray())
        {
            if (!IsModelCategory(option))
            {
                continue;
            }

            _modelConfigId = option.TryGetProperty("id", out var oid) ? oid.GetString() : "model";
            _currentModel = option.TryGetProperty("value", out var v) ? v.GetString() : null;
            AddModelOptions(option);
        }
    }

    private static bool IsModelCategory(JsonElement option) =>
        option.TryGetProperty("category", out var c)
        && string.Equals(c.GetString(), "model", StringComparison.OrdinalIgnoreCase);

    private void AddModelOptions(JsonElement option)
    {
        if (!option.TryGetProperty("options", out var values) || values.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        foreach (var val in values.EnumerateArray()
            .Select(ExtractOptionValue)
            .OfType<string>()
            .Where(v => v.Length > 0 && !_modelOptions.Contains(v)))
        {
            _modelOptions.Add(val);
        }
    }

    private static string? ExtractOptionValue(JsonElement entry)
    {
        if (entry.TryGetProperty("value", out var ev))
        {
            return ev.GetString();
        }
        return entry.ValueKind == JsonValueKind.String ? entry.GetString() : null;
    }

    private string? ConfigRepoOrNull() =>
        string.IsNullOrWhiteSpace(_cfgRepo) ? null : _cfgRepo.Trim();

    private static string? CliOptionFor(string? agentCliId, string? agentType)
    {
        if (!string.IsNullOrWhiteSpace(agentCliId))
        {
            return $"custom:{agentCliId}";
        }
        return string.IsNullOrWhiteSpace(agentType) ? null : $"agent:{agentType}";
    }

    private void ParseSessionModes(JsonElement root)
    {
        if (!root.TryGetProperty("modes", out var modes) || modes.ValueKind != JsonValueKind.Object)
        {
            return;
        }

        _currentMode = modes.TryGetProperty("currentModeId", out var cm) ? cm.GetString() : null;
        if (!modes.TryGetProperty("availableModes", out var available) || available.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        foreach (var mode in available.EnumerateArray())
        {
            var id = mode.TryGetProperty("id", out var mid) ? mid.GetString() : null;
            if (id is { Length: > 0 })
            {
                var name = mode.TryGetProperty("name", out var mn) ? mn.GetString() : null;
                _modes.Add((id, name ?? id));
            }
        }
    }

    [JSInvokable]
    public async Task OnSseEvent(string eventType, string data)
    {
        try
        {
            switch (eventType)
            {
                case "ai_chat.permission":
                    OnPermissionSse(data);
                    break;
                case "ai_chat.event":
                    OnChatEventSse(data);
                    break;
                case "ai_chat.session":
                    _scrollPending = true;
                    break;
                case "ai_chat.run":
                    OnRunSse(data);
                    break;
            }
        }
        catch (JsonException)
        {
            // Malformed payload — treated as absent.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnPermissionSse(string data)
    {
        var permission = JsonSerializer.Deserialize<PermissionRequestInfo>(data, SseJson);
        if (permission is not null && !_permissions.Any(p => p.RequestId == permission.RequestId))
        {
            _permissions.Add(permission);
            _scrollPending = true;
        }

        _sseError = false;
    }

    private void OnChatEventSse(string data)
    {
        var ev = JsonSerializer.Deserialize<AiChatEventDto>(data, SseJson);
        if (ev is not null)
        {
            UpsertEvent(ev);

            // Turn ends on session/prompt stopReason or session death.
            if (ev.Kind == "session"
                && (ev.PayloadJson?.Contains("\"stopReason\"") == true
                    || ev.PayloadJson?.Contains("\"dead\"") == true))
            {
                _running = false;
            }
        }

        _sseError = false;
    }

    private void UpsertEvent(AiChatEventDto ev)
    {
        if (_seenEventIds.Add(ev.Id))
        {
            _events.Add(ev);
            _scrollPending = true;
            return;
        }

        // Re-published event (e.g. queued → dispatched user):
        // update in place rather than skip.
        var index = _events.FindIndex(e => e.Id == ev.Id);
        if (index >= 0)
        {
            _events[index] = ev;
        }
    }

    private void OnRunSse(string data)
    {
        var run = JsonSerializer.Deserialize<AiChatRunDto>(data, SseJson);
        if (run is not null)
        {
            _running = run.Status == "running";
            if (_activeThreadId == run.ThreadId && _activeThread is { } active)
            {
                var status = run.Status switch
                {
                    "failed" => "failed",
                    "running" => "running",
                    _ => "idle",
                };
                _activeThread = active with { Status = status };
                _threads = _threads?.Select(t => t.Id == run.ThreadId ? t with { Status = status } : t).ToList();
            }

            _scrollPending = true;
        }

        _sseError = false;
    }

    [JSInvokable]
    public async Task OnSseError()
    {
        _sseError = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnComposerKeyDownAsync(KeyboardEventArgs e)
    {
        _slashPreventDefault = false;
        if (SlashOpen && HandleSlashKey(e))
        {
            return;
        }

        // SPEC-20261003 RF-005 (OpenCode parity): Esc interrupts a running
        // agent turn — same affordance as the circular stop button.
        if (e.Key == "Escape" && _running && IsAgentMode)
        {
            _slashPreventDefault = true;
            await StopAgentAsync();
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey && !_sending && !string.IsNullOrWhiteSpace(_composer)
            && (!_running || IsAgentMode))
        {
            _slashPreventDefault = true;
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        var content = _composer.Trim();
        // Terminal threads may be created empty — input goes through the xterm.
        if (content.Length == 0 && !(_activeThreadId is null && _cfgView == "terminal"))
        {
            return;
        }

        _sending = true;
        try
        {
            // SPEC-20261003 RF-004: slash commands resolve before the turn —
            // builtins run locally, /<skill> expands to the SKILL.md body.
            if (content.StartsWith("/", StringComparison.Ordinal))
            {
                var (consumed, resolved) = await ResolveSlashContentAsync(content);
                if (consumed)
                {
                    return;
                }

                content = resolved;
            }

            // RF-007: no create form — the first Send materializes the thread
            // with the command-bar config and an auto-derived title.
            if (_activeThreadId is null && !await EnsureThreadAsync(content))
            {
                return;
            }

            if (_activeThreadId is not { } threadId)
            {
                return;
            }

            if (IsAgentMode)
            {
                await QueueAgentPromptAsync(threadId, content);
                return;
            }

            await PostAndStartAssistantRunAsync(threadId, content);
        }
        catch (Exception ex)
        {
            _running = false;
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Send failed: {ex.Message}"));
        }
        finally
        {
            _sending = false;
        }
    }

    /// <summary>Creates the thread from the command-bar config; false → abort send.</summary>
    private async Task<bool> EnsureThreadAsync(string content)
    {
        var cli = SelectedCli;
        var request = new CreateAiChatThreadRequest(
            AiChatThreadTitle.Derive(content),
            _cfgModelId, // empty → tier/CLI default
            "none",
            _cfgMode == "agent" ? _cfgSandbox : "read-only",
            Mode: _cfgMode,
            AgentType: cli?.AgentType?.ToString(),
            WorkspacePath: null, // fixed ~/repos — repo resolves server-side
            RepositoryFullName: string.IsNullOrWhiteSpace(_cfgRepo) ? null : _cfgRepo.Trim(),
            ModelTier: _cfgModelTier.Length == 0 ? null : _cfgModelTier,
            // SPEC-20260928-ai-code-generic-cli: view/context/custom —
            // "chat" sends null so builtin→acp and the def's declared
            // transport apply; "terminal" always sends pty.
            Transport: _cfgView == "terminal" ? "pty" : null,
            ContainerContext: string.IsNullOrWhiteSpace(_cfgContext) ? null : _cfgContext,
            AgentCliId: cli?.AgentCliId);

        var (thread, createError) = await Client.CreateAiChatThreadAsync(request);
        if (thread is null)
        {
            // RF-003: surface the real backend reason (e.g. missing clone).
            await ToastService.NotifyAsync(new(ToastType.Danger, createError ?? "Failed to create the thread."));
            return false;
        }

        _threads = (_threads ?? []).Concat([thread]).ToList();
        await SelectThreadAsync(thread);

        // PTY threads have no structured prompt flow — the xterm pane owns
        // input. The composer text stays so nothing is lost; the user
        // pastes/retypes inside the terminal.
        return thread.Kind != "terminal";
    }

    /// <summary>RF-002: the queue endpoint persists the prompt (queued event)
    /// and dispatches FIFO — no separate user-event post needed.</summary>
    private async Task QueueAgentPromptAsync(string threadId, string content)
    {
        var (queued, queueError) = await Client.QueueAgentThreadPromptAsync(threadId, content);
        if (queued is null)
        {
            // B-11: keep the draft — clearing the composer before the
            // failure check throws the user's text away on any
            // network/validation error.
            await ToastService.NotifyAsync(new(ToastType.Danger, queueError ?? "Failed to queue the prompt."));
            return;
        }

        _composer = string.Empty;

        if (_seenEventIds.Add(queued.Id))
        {
            _events.Add(queued);
            _scrollPending = true;
        }

        _running = true;
    }

    private async Task PostAndStartAssistantRunAsync(string threadId, string content)
    {
        var (postedAssistant, postError) = await Client.PostAiChatEventAsync(threadId, new AddAiChatEventRequest("user", content));
        if (postedAssistant is null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, postError ?? "Failed to post the message."));
            return;
        }

        _composer = string.Empty;
        _running = true;

        var (run, runError) = await Client.StartAiChatRunAsync(threadId);
        if (run is null)
        {
            _running = false;
            await ToastService.NotifyAsync(new(ToastType.Danger, runError ?? "Failed to start the assistant run."));
        }
    }

    /// <summary>RF-007 + SPEC-20260929-ai-code-ux-fixes RF-001/RF-003: New —
    /// creates the thread immediately (it appears in the rail, gets the
    /// command-bar defaults), closes the mobile drawer and honors the global
    /// repo selection before the inherited _cfgRepo.</summary>
    private async Task NewConversationAsync()
    {
        await JS.InvokeVoidAsync("taskboardSse.disconnect", "ai-chat");
        _railDrawerOpen = false;
        _activeThread = null;
        _activeThreadId = null;
        _events.Clear();
        _seenEventIds.Clear();
        _permissions.Clear();
        _modelOptions.Clear();
        _modes.Clear();
        _modelConfigId = null;
        _currentModel = null;
        _currentMode = null;
        _composer = string.Empty;
        _running = false;
        _sseError = false;
        _scrollPending = false;

        if (_cfgMode != "provider" && _cfgView != "terminal")
        {
            // SPEC-20261003-ai-code-agent-chat: "+" in Agent mode starts a
            // fresh agent-chat — a new provider conversation is created on
            // the next send; no legacy thread is materialized.
            _seedConversationId = null;
            _agentChatKey++;
            return;
        }

        var cli = SelectedCli;
        // RF-002: the global repository selector wins over the repo inherited
        // from the previously selected thread.
        var repo = !string.IsNullOrWhiteSpace(SelectedRepo.Selected)
            ? SelectedRepo.Selected
            : ConfigRepoOrNull();
        var request = new CreateAiChatThreadRequest(
            "New conversation",
            _cfgModelId,
            "none",
            _cfgMode == "agent" ? _cfgSandbox : "read-only",
            Mode: _cfgMode,
            AgentType: cli?.AgentType?.ToString(),
            WorkspacePath: null,
            RepositoryFullName: repo,
            ModelTier: _cfgModelTier.Length == 0 ? null : _cfgModelTier,
            Transport: _cfgView == "terminal" ? "pty" : null,
            ContainerContext: string.IsNullOrWhiteSpace(_cfgContext) ? null : _cfgContext,
            AgentCliId: cli?.AgentCliId);

        var (thread, createError) = await Client.CreateAiChatThreadAsync(request);
        if (thread is null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, createError ?? "Failed to create the conversation."));
            return;
        }

        _threads = (_threads ?? []).Concat([thread]).ToList();
        await SelectThreadAsync(thread);

        if (thread.Kind != "terminal")
        {
            await JS.InvokeVoidAsync("taskboard.focusElement", _composerRef);
        }
    }

    private async Task StopAgentAsync()
    {
        if (_activeThreadId is null) return;
        var ok = await Client.CancelAgentThreadAsync(_activeThreadId);
        if (ok)
        {
            _running = false;
            await ToastService.NotifyAsync(new(ToastType.Info, "Agent run cancelled."));
        }
    }

    /// <summary>RF-002: cancel a queued prompt before the backend dispatches it.</summary>
    private async Task CancelQueuedAsync(string eventId)
    {
        if (_activeThreadId is null) return;
        if (await Client.CancelQueuedPromptAsync(_activeThreadId, eventId))
        {
            _events.RemoveAll(e => e.Id == eventId);
            _seenEventIds.Remove(eventId);
        }
    }

    /// <summary>RF-004: fork this thread at the selected event and switch to the new thread.</summary>
    private async Task ForkFromAsync(string eventId)
    {
        if (_activeThreadId is null) return;
        var (fork, error) = await Client.ForkAiChatThreadAsync(_activeThreadId, eventId);
        if (fork is null)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, error ?? "Failed to fork the thread."));
            return;
        }

        _threads = (_threads ?? []).Concat([fork]).ToList();
        await ToastService.NotifyAsync(new(ToastType.Success, $"Forked into '{fork.Title}'."));
        await SelectThreadAsync(fork);
    }

    /// <summary>RF-004: resend the last user prompt (cancels an active turn first).</summary>
    private async Task RetryAgentAsync()
    {
        if (_activeThreadId is null) return;
        var admitted = await Client.RetryAgentThreadAsync(_activeThreadId);
        if (admitted)
        {
            _running = true;
        }
        else
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, "Nothing to retry — send a prompt first."));
        }
    }

    /// <summary>RF-005: session/set_config_option for the ACP model option.</summary>
    private async Task OnModelSwitchAsync(ChangeEventArgs e)
    {
        if (_activeThreadId is null || _modelConfigId is null || e.Value is not string value)
        {
            return;
        }

        var ok = await Client.PostAgentControlAsync(
            new AgentControlRequest("thread", _activeThreadId, "set_config", Content: value, ConfigId: _modelConfigId));
        if (ok)
        {
            _currentModel = value;
        }
        else
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, "Model switch rejected — no live session."));
        }
    }

    /// <summary>RF-005: session/set_mode on the live session.</summary>
    private async Task OnModeSwitchAsync(ChangeEventArgs e)
    {
        if (_activeThreadId is null || e.Value is not string modeId)
        {
            return;
        }

        var ok = await Client.PostAgentControlAsync(
            new AgentControlRequest("thread", _activeThreadId, "set_mode", Content: modeId));
        if (ok)
        {
            _currentMode = modeId;
        }
        else
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, "Mode switch rejected — no live session."));
        }
    }

    private async Task OnPermissionReplyAsync((string RequestId, string Outcome) args)
    {
        if (_activeThreadId is null) return;
        var ok = await Client.ReplyAgentPermissionAsync(_activeThreadId, args.RequestId, args.Outcome);
        _permissions.RemoveAll(p => p.RequestId == args.RequestId);
        if (ok)
        {
            await ToastService.NotifyAsync(new(ToastType.Success, $"Permission '{args.Outcome}' sent to agent."));
        }
        else
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, "Permission request already expired."));
        }
    }

    private async Task DeleteThreadAsync(AiChatThreadDto thread)
    {
        var deleted = await Client.DeleteAiChatThreadAsync(thread.Id);
        if (!deleted)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, "Failed to delete the thread."));
            return;
        }

        _threads = (_threads ?? []).Where(t => t.Id != thread.Id).ToList();
        if (_activeThreadId == thread.Id)
        {
            await JS.InvokeVoidAsync("taskboardSse.disconnect", "ai-chat");
            _activeThread = null;
            _activeThreadId = null;
            _events.Clear();
            _seenEventIds.Clear();
            _running = false;
        }
    }

    private async Task ShowRunAgentAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            ["OnSubmit"] = EventCallback.Factory.Create<RunAgentDialog.RunAgentSelection>(this, QueueAgentAsync),
            ["OnCancel"] = EventCallback.Factory.Create(this, () => HideModalAsync(_runAgentModal))
        };
        await _runAgentModal.ShowAsync<RunAgentDialog>(title: "Run agent on this thread", parameters: parameters);
    }

    private async Task QueueAgentAsync(RunAgentDialog.RunAgentSelection selection)
    {
        await HideModalAsync(_runAgentModal);
        var threadId = _activeThreadId;
        var threadTitle = _activeThread?.Title ?? "thread";
        if (threadId is null)
        {
            return;
        }

        var issueId = $"thread-{threadId}";
        var prompt = AgentThreadPromptBuilder.Build(threadTitle, selection.RepositoryFullName, _events);
        var request = new AgentExecutionRequest(
            issueId,
            IssueNumber: 0,
            selection.RepositoryFullName,
            RepoPath: string.Empty,
            Branch: null,
            Scope: null,
            prompt,
            selection.AgentType,
            selection.Tier);

        bool queued;
        try
        {
            queued = await OrchestrationService.EnqueueAsync(request);
        }
        catch (Exception ex)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to queue the agent: {ex.Message}"));
            return;
        }

        if (!queued)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"{selection.AgentName} is not eligible right now (disabled or CLI not authenticated)."));
            return;
        }

        var (_, error) = await Client.PostAiChatEventAsync(
            threadId,
            new AddAiChatEventRequest("activity",
                $"{selection.AgentName} queued for {selection.RepositoryFullName} (tier {selection.Tier})."));
        if (error is not null)
        {
            await ToastService.NotifyAsync(new(ToastType.Warning, error));
        }

        _ = PollAgentRunAsync(issueId, threadId, selection.AgentName, selection.RepositoryFullName, _disposeCts.Token);
    }

    private async Task PollAgentRunAsync(
        string issueId, string threadId, string agentName, string repo, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            var deadline = DateTime.UtcNow.AddMinutes(15);
            while (DateTime.UtcNow < deadline && await timer.WaitForNextTickAsync(ct))
            {
                var runs = await OrchestrationService.GetRunsAsync(issueId, 1, ct);
                var latest = runs.FirstOrDefault();
                if (latest?.State is AgentRunState.Succeeded or AgentRunState.Failed or AgentRunState.Canceled or AgentRunState.BudgetExceeded)
                {
                    var ok = latest.State == AgentRunState.Succeeded;
                    await Client.PostAiChatEventAsync(
                        threadId,
                        new AddAiChatEventRequest(ok ? "activity" : "error",
                            $"{agentName} {latest.State.ToString().ToLowerInvariant()} on {repo}."),
                        ct);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Cancellation is the expected shutdown path — nothing to clean up.
        }
        catch (Exception)
        {
            // Status post-back is best-effort — the run itself is unaffected.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _disposeCts.CancelAsync();
        _disposeCts.Dispose();
        try
        {
            await JS.InvokeVoidAsync("taskboardSse.disconnect", "ai-chat");
        }
        catch (JSDisconnectedException)
        {
            // Best-effort — failure here is non-fatal.
        }
        _dotNetRef?.Dispose();
    }
}
