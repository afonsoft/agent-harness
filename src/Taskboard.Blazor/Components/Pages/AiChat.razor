@page "/ai-chat"
@attribute [Authorize]
@inject TaskboardClient Client

<h1 class="h4 fw-bold mb-1">AI Chat</h1>
<p class="small text-body-secondary mb-4">Chat threads and models</p>

@if (_threads is null)
{
    <Loading Message="Loading threads..." />
}
else if (!_threads.Any())
{
    <EmptyState Message="No threads yet." />
}
else
{
    <div class="card">
        <ul class="list-group list-group-flush">
            @foreach (var thread in _threads)
            {
                <li class="list-group-item d-flex align-items-center justify-content-between">
                    <span>@thread.Title</span>
                    <span class="badge text-bg-secondary">@thread.Model</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    private IReadOnlyCollection<AiChatThreadDto>? _threads;

    protected override async Task OnInitializedAsync()
    {
        _threads = await Client.GetAiChatThreadsAsync();
    }
}
