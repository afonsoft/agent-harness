        {
            var (type, display) = ResolveContainerBinary(bin);
            if (type is null || !covered.Add(type.Value))
            {
                continue;
            }

            options.Add(new CliOption(
                $"agent:{type.Value}", display ?? bin, type.Value, null,
                SupportsChat: AgentCliMap.SupportsAcp(type.Value), Selectable: true));
        }
    }

    private static (AgentType? Type, string? Display) ResolveContainerBinary(string bin)
    {
        var match = AgentCliMap.AllSpecs()
            .Where(kv => string.Equals(kv.Value.Binary, bin, StringComparison.Ordinal))
            .Select(kv => (Type: AgentCliMap.AgentTypeFor(kv.Key), Display: kv.Value.DisplayName))
            .FirstOrDefault();
        if (match.Type is not null)
        {
            return match;
        }

        return (bin == "openhands" ? AgentType.OpenHands : null, null);
    }

    private void AddHostOptions(List<CliOption> options, HashSet<AgentType> covered)
    {
        foreach (var agent in _agents ?? [])
        {
            if (agent.Status != AgentStatus.Available || !covered.Add(agent.Type))
            {
                continue;
            }

            options.Add(new CliOption(
                $"agent:{agent.Type}", agent.Name, agent.Type, null,
                SupportsChat: AgentCliMap.SupportsAcp(agent.Type), Selectable: true));
        }

        // Installed but not eligible (no auth / disabled) — terminal threads
        // still work: authentication happens inside the PTY.
        foreach (var status in _cliStatuses)
        {
            if (!status.Installed || AgentCliMap.AgentTypeFor(status.Agent) is not { } type
                || covered.Contains(type))
            {
                continue;
            }

            covered.Add(type);
            options.Add(new CliOption(
                $"agent:{type}", status.DisplayName, type, null,
                SupportsChat: false, Selectable: true));
        }
    }

    private void AddCustomDefOptions(List<CliOption> options)
