@page "/ai-chat"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@using Taskboard.Application.Contracts.Chat
@inject TaskboardClient Client
@inject IAgentOrchestrationService OrchestrationService
@inject IGitHubService GitHubService
@inject IJSRuntime JS
@inject ToastService ToastService
@inject Taskboard.Blazor.Services.SelectedRepositoryService SelectedRepo
@inject NavigationManager Navigation

<PageTitle>AI Code - Harness</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 fw-bold mb-0">AI Code</h1>
    @* SPEC-20261003-ai-code-devin-layout RF-001: contexto em texto —
       workspace/repo selecionado (Devin-style "branch · repo"). *@
    <span class="small text-body-secondary ms-1 text-truncate" title="@ContextText">
        <Icon Name="IconName.Folder" class="me-1" />@ContextText
    </span>
    @* SPEC-20261003-ai-code-devin-layout RF-002: seletor segmentado de modo no
       topo (Devin "Agent/Ask") — ícones; o segmento ativo mostra o rótulo. *@
    <div class="ms-auto d-flex align-items-center gap-2">
        <div class="ai-chat-modeswitch" role="group" aria-label="Conversation mode">
            <button type="button"
                    class="ai-chat-modebtn @(ActiveMode == "provider" ? "active" : "")"
                    title="Chat — provider direto com tools (Ask)" aria-label="Chat mode"
                    @onclick='() => SetModeAsync("provider")'>
                <Icon Name="IconName.ChatDots" />
                @if (ActiveMode == "provider")
                {
                    <span class="ms-1 d-none d-md-inline">Chat</span>
                }
            </button>
            @* SPEC-20261003-ai-code-agent-chat: Assistant mode was removed —
               Agent mode IS the provider-chat surface bound to the agent bar
               (CLI delegation via tools, no ACP session). *@
            <button type="button"
                    class="ai-chat-modebtn @(ActiveMode == "agent" ? "active" : "")"
                    title="Agent — chat com tools que delega runs aos CLIs" aria-label="Agent mode"
                    @onclick='() => SetModeAsync("agent")'>
                <Icon Name="IconName.Robot" />
                @if (ActiveMode == "agent")
                {
                    <span class="ms-1 d-none d-md-inline">Agent</span>
                }
            </button>
        </div>
        @* SPEC-20260929-ai-chat-rail-overlay RF-002: histórico + new chat no
           topo-direito sobre o painel de chat — o rail fica oculto por padrão. *@
        <button type="button" class="ai-chat-iconbtn" title="Threads history"
                aria-label="Open thread history"
                @onclick="OpenRailDrawerAsync">
            <Icon Name="IconName.ClockHistory" />
        </button>
        <button type="button" class="ai-chat-iconbtn primary" title="New conversation"
                aria-label="New conversation"
                disabled="@(!HasEligibleAgent)"
                @onclick="NewConversationAsync">
            <Icon Name="IconName.PlusSquare" />
        </button>
    </div>
</div>

@if (_threads is null)
{
    <Loading Message="Loading threads…" />
}
else
{
<div class="ai-chat-layout @(_railDrawerOpen ? "rail-open" : "")" @onkeydown="OnPageKeyDown">
    @if (_railDrawerOpen)
    {
        <div class="ai-chat-rail-scrim" @onclick="() => _railDrawerOpen = false"></div>
    }
    <div class="ai-chat-rail-wrap @(_railDrawerOpen ? "drawer-open" : "")">
        <ThreadRail Threads="OrderedThreads"
                    ActiveThreadId="@_activeThreadId"
                    Collapsed="false"
                    HasEligibleAgent="HasEligibleAgent"
                    OnNew="NewConversationAsync"
                    OnSelect="SelectThreadFromRailAsync"
                    OnDelete="DeleteThreadAsync" />
    </div>

    <section class="ai-chat-main card">
        @if (_cfgMode == "provider")
        {
            @* SPEC-20260929-ai-code-provider-chat RF-010: provider chat mode —
               replaces the agent-CLI UI with the open-webui-like layout. *@
            <div class="card-body p-2">
                <ProviderChat OnSwitchToAgent="SwitchToAgentMode" />
            </div>
        }
        else if (_activeThread is null)
        {
            @* SPEC-20261003-ai-code-agent-chat: Agent mode — the provider chat
               bound to the agent bar below. The assistant answers normally and
               delegates CLI runs via run_agent/run_cli (exec argv, never ACP);
               CLI/repo/model persist on the conversation. The bar stays
               editable while no legacy thread is bound. *@
            <div class="card-body p-2">
                <ProviderChat @key="_agentChatKey"
                              AgentContext="CurrentAgentContext"
                              SeedConversationId="@_seedConversationId"
                              OnSwitchToAgent="SwitchToAgentMode" />
            </div>
            <div class="card-footer p-2">
                <div class="ai-chat-toolbar small">
                    <label class="ai-chat-ctl"
                           title="Structured agent chat or a raw CLI terminal (PTY) thread">
                        <Icon Name="IconName.Terminal" />
                        <select class="ai-chat-select"
                                value="@_cfgView" @onchange="OnCfgViewChanged">
                            <option value="chat">chat</option>
                            <option value="terminal">terminal</option>
                        </select>
                    </label>
                    <label class="ai-chat-ctl" title="Agent CLI — default for delegated runs">
                        <Icon Name="IconName.Robot" />
                        <select class="ai-chat-select"
                                value="@_cfgCli" @onchange="OnCfgCliChanged">
                            @foreach (var opt in _cliOptions)
                            {
                                // Agent-chat delegates via exec argv — every
                                // selectable CLI works (no ACP requirement).
                                <option value="@opt.Value"
                                        disabled="@(!opt.Selectable)">@opt.Label</option>
                            }
                        </select>
                    </label>
                    @if (_dockerContainers?.Count > 0)
                    {
                        <label class="ai-chat-ctl"
                               title="Run the CLI on this host or inside a running container">
                            <Icon Name="IconName.Box" />
                            <select class="ai-chat-select"
                                    value="@_cfgContext" @onchange="OnCfgContextChanged">
                                <option value="">host</option>
                                @foreach (var name in _dockerContainers.Select(container => container.Name))
                                {
                                    <option value="@name">⬢ @name</option>
                                }
                            </select>
                        </label>
                    }
                    <button type="button" class="ai-chat-ctl ai-chat-ctlbtn"
                            title="Repository (optional — resolves to ~/repos/<name>)"
                            @onclick="ShowRepoModalAsync">
                        <Icon Name="IconName.Folder" />
                        <span class="ms-1">@(string.IsNullOrWhiteSpace(_cfgRepo) ? "repo" : _cfgRepo)</span>
                    </button>
                    <button type="button" class="ai-chat-ctl ai-chat-ctlbtn"
                            title="Model for delegated CLI runs"
                            @onclick="ShowModelModalAsync">
                        <Icon Name="IconName.Cpu" />
                        <span class="ms-1">@ConfigModelLabel</span>
                    </button>
                    @if (_chatUnavailableHint)
                    {
                        <span class="text-body-secondary small">
                            Chat indisponível — configure um provider ou CLI com chat em
                            <a href="/settings" class="alert-link">Settings → Chat</a>.
                        </span>
                    }
                    @if (_agents is not null && !_cliOptions.Any(o => o.Selectable))
                    {
                        <span class="text-warning">
                            No enabled CLI —
                            <a href="/settings" class="alert-link">Settings → Agents</a>
                        </span>
                    }
                </div>
            </div>
        }
        else
        {
        @if (_activeThread is not null)
        {
            <div class="card-header d-flex align-items-center justify-content-between py-2">
                <div class="text-truncate">
                    <strong>@_activeThread.Title</strong>
                    <span class="text-body-secondary small ms-2">@_activeThread.Model</span>
                    @if (CliBadge(_activeThread) is { } cliName)
                    {
                        <span class="badge text-bg-primary ms-2">agent: @cliName</span>
                    }
                    @if (_activeThread.Kind == "terminal")
                    {
                        <span class="badge text-bg-dark ms-1">terminal</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.ContainerContext))
                    {
                        <span class="badge text-bg-info ms-1">⬢ @_activeThread.ContainerContext</span>
                    }
                </div>
                @if (_running)
                {
                    <span class="badge text-bg-warning ai-chat-badge-live">running</span>
                }
                else if (_activeThread.Status == "failed")
                {
                    <span class="badge text-bg-danger">failed</span>
                }
            </div>
        }

        @if (_sseError)
        {
            <div class="alert alert-warning small py-1 px-3 mb-0 rounded-0">
                Live stream interrupted — retrying automatically.
            </div>
        }

        @* SPEC-20260928-ai-code-ux-simplify RF-005: terminal-transport threads
           render the PTY pane instead of bubbles/composer (the pane owns its
           own input via xterm once SPEC-20260928-ai-code-generic-cli lands). *@
        @if (_activeThread?.Kind == "terminal")
        {
            @* @key forces a fresh pane per thread — without it Blazor reuses
               the instance and a second ConnectHubAsync stacks hub handlers
               and leaves the previous xterm undisposed
               (SPEC-20260929-pty-session-security RF-003). *@
            <PtyThreadPane Thread="_activeThread" @key="_activeThread.Id" />
        }
        else
        {
        <div class="ai-chat-messages card-body" @ref="_messagesRef">
            @if (_events.Count == 0 && !_running)
            {
                <div class="text-body-secondary small">
                    @(_activeThread is null
                        ? "Configure the bar below and send a message to start a conversation."
                        : "No messages yet — say something below.")
                </div>
            }
            @if (IsAgentMode)
            {
                @foreach (var item in AgentRenderItems)
                {
                    if (item.Tool is not null)
                    {
                        <ToolCallCard Model="item.Tool!" />
                        continue;
                    }

                    if (item.Group is not null)
                    {
                        <ToolCallChangesCard Items="item.Group!" />
                        continue;
                    }

                    var ev = item.Event!;
                    if (ev.Kind is "metric" or "permission")
                    {
                        // Metrics feed the composer meter; pending
                        // permissions render below the stream.
                        continue;
                    }

                    if (ev.Role is "queued")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble ai-chat-queued">
                                @ev.Content
                                <span class="badge text-bg-secondary ms-2">queued</span>
                                <button type="button" class="btn btn-sm btn-link text-danger py-0 ms-1"
                                        title="Cancel queued prompt"
                                        @onclick="() => CancelQueuedAsync(ev.Id)">
                                    <Icon Name="IconName.XCircle" />
                                </button>
                            </div>
                        </div>
                        continue;
                    }

                    if (ev.Role is "user")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble">
                                @ev.Content
                                <button type="button" class="btn btn-sm btn-link ai-chat-fork-btn"
                                        title="Fork thread from here"
                                        @onclick="() => ForkFromAsync(ev.Id)">
                                    <Icon Name="IconName.Diagram3" />
                                </button>
                            </div>
                        </div>
                    }
                    else if (ev.Role is "assistant" && ev.Kind is not "session")
                    {
                        <div class="ai-chat-msg ai-chat-msg-assistant">
                            <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(ev.Content))</div>
                        </div>
                    }
                    else
                    {
                        <div class="ai-chat-msg ai-chat-msg-system">
                            <span class="@(ev.Role == "error" ? "text-danger" : "text-body-secondary")">@ev.Content</span>
                        </div>
                    }
                }
                @foreach (var permission in _permissions)
                {
                    <PermissionPromptCard Request="permission" OnReply="OnPermissionReplyAsync" />
                }
            }
            else
            {
                @foreach (var group in GroupedEvents)
                {
                    @if (group.Role is "user")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble">@group.Text</div>
                        </div>
                    }
                    else if (group.Role is "assistant")
                    {
                        <div class="ai-chat-msg ai-chat-msg-assistant">
                            <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(group.Text))</div>
                        </div>
                    }
                    else
                    {
                        <div class="ai-chat-msg ai-chat-msg-system">
                            <span class="@(group.Role == "error" ? "text-danger" : "text-body-secondary")">@group.Text</span>
                        </div>
                    }
                }
            }
            @if (_running)
            {
                <div class="ai-chat-msg ai-chat-msg-assistant">
                    <div class="ai-chat-bubble ai-chat-typing">
                        <Spinner Size="SpinnerSize.Small" /> thinking…
                    </div>
                </div>
            }
        </div>

        <div class="card-footer p-2">
            @* SPEC-20261003-ai-code-devin-layout RF-003: composer em caixa única
               arredondada (Devin-style) — textarea em cima, toolbar de ícones
               embaixo, ações circulares à direita. *@
            <div class="ai-chat-composer-box">
                <SlashCommandPalette Items="AiChatSlashItems" Filter="@SlashFilter"
                                     Open="SlashOpen" ActiveIndex="_slashIndex"
                                     OnSelect="OnSlashSelect" />
                <textarea class="ai-chat-input" rows="2"
                          enterkeyhint="send" autocomplete="off" data-shortcut-command
                          @ref="_composerRef"
                          placeholder="@ComposerPlaceholder"
                          disabled="@((_running && !IsAgentMode) || _sending)"
                          @bind="_composer"
                          @bind:event="oninput"
                          @onkeydown="OnComposerKeyDownAsync"
                          @onkeydown:preventDefault="_slashPreventDefault"></textarea>
                @* RF-005/RF-006: toolbar — ícones + selects compactos enquanto
                   desbloqueada; chips quando a conversa está vinculada. *@
                <div class="ai-chat-toolbar small">
                @if (_activeThread is null)
                {
                    @* SPEC-20260929-ai-chat-view-first RF-001: View precedes
                       Agent CLI — the chosen surface filters the CLI list. *@
                    <label class="ai-chat-ctl"
                           title="Structured chat (ACP) or raw terminal (PTY)">
                        <Icon Name="IconName.Terminal" />
                        <select class="ai-chat-select"
                                value="@_cfgView" @onchange="OnCfgViewChanged">
                            <option value="chat" disabled="@(!AnyChatCapableCli)">chat</option>
                            <option value="terminal">terminal</option>
                        </select>
                    </label>
                    <label class="ai-chat-ctl" title="Agent CLI">
                        <Icon Name="IconName.Robot" />
                        <select class="ai-chat-select"
                                value="@_cfgCli" @onchange="OnCfgCliChanged">
                            @foreach (var opt in _cliOptions)
                            {
                                // SPEC-20260929-ai-chat-view-first RF-002: em
                                // View=chat só entram CLIs com suporte ACP.
                                <option value="@opt.Value"
                                        disabled="@(!opt.Selectable || (_cfgView == "chat" && !opt.SupportsChat))">@opt.Label</option>
                            }
                        </select>
                    </label>
                    @if (_dockerContainers?.Count > 0)
                    {
                        <label class="ai-chat-ctl"
                               title="Run the CLI on this host or inside a running container">
                            <Icon Name="IconName.Box" />
                            <select class="ai-chat-select"
                                    value="@_cfgContext" @onchange="OnCfgContextChanged">
                                <option value="">host</option>
                                @foreach (var name in _dockerContainers.Select(container => container.Name))
                                {
                                    <option value="@name">⬢ @name</option>
                                }
                            </select>
                        </label>
                    }
                    <button type="button" class="ai-chat-ctl ai-chat-ctlbtn"
                            title="Repository (optional — resolves to ~/repos/<name>)"
                            @onclick="ShowRepoModalAsync">
                        <Icon Name="IconName.Folder" />
                        <span class="ms-1">@(string.IsNullOrWhiteSpace(_cfgRepo) ? "repo" : _cfgRepo)</span>
                    </button>
                    <button type="button" class="ai-chat-ctl ai-chat-ctlbtn"
                            title="Model"
                            @onclick="ShowModelModalAsync">
                        <Icon Name="IconName.Cpu" />
                        <span class="ms-1">@ConfigModelLabel</span>
                    </button>
                    @if (_cfgMode == "agent")
                    {
                        <button type="button" class="ai-chat-ctl ai-chat-ctlbtn"
                                title="Sandbox"
                                @onclick="ShowSandboxModalAsync">
                            <Icon Name="IconName.ShieldLock" />
                            <span class="ms-1">@_cfgSandbox</span>
                        </button>
                    }
                    @if (_chatUnavailableHint)
                    {
                        <span class="text-body-secondary small">
                            Chat indisponível — configure um provider ou CLI com chat em
                            <a href="/settings" class="alert-link">Settings → Chat</a>.
                        </span>
                    }
                    @if (_agents is not null && !_cliOptions.Any(o => o.Selectable))
                    {
                        <span class="text-warning">
                            No enabled CLI —
                            <a href="/settings" class="alert-link">Settings → Agents</a>
                        </span>
                    }
                }
                else
                {
                    <span class="ai-chat-chip"><Icon Name="IconName.Tag" /> @_activeThread.Mode</span>
                    @if (CliBadge(_activeThread) is { } cliName)
                    {
                        <span class="ai-chat-chip"><Icon Name="IconName.Robot" /> @cliName</span>
                    }
                    @if (_activeThread.Kind == "terminal")
                    {
                        <span class="ai-chat-chip"><Icon Name="IconName.Terminal" /> terminal</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.ContainerContext))
                    {
                        <span class="ai-chat-chip"><Icon Name="IconName.Box" /> @_activeThread.ContainerContext</span>
                    }
                    @if (_modes.Count > 0)
                    {
                        @* RF-006: Modo is a session control — it stays usable on a
                           live agent session even while the bar is locked. *@
                        <label class="ai-chat-ctl" title="Session mode">
                            <Icon Name="IconName.Toggles" />
                            <select class="ai-chat-select"
                                    value="@_currentMode"
                                    @onchange="OnModeSwitchAsync">
                                @foreach (var mode in _modes)
                                {
                                    <option value="@mode.Id" selected="@(mode.Id == _currentMode)">@mode.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.RepositoryFullName))
                    {
                        <span class="ai-chat-chip">
                            <Icon Name="IconName.Folder" /> @_activeThread.RepositoryFullName
                        </span>
                    }
                    <span class="text-body-secondary" title="Workspace">@(_activeThread.WorkspacePath ?? "~/repos")</span>
                    @if (_modelOptions.Count > 0)
                    {
                        <label class="ai-chat-ctl" title="Session model">
                            <Icon Name="IconName.Cpu" />
                            <select class="ai-chat-select"
                                    value="@_currentModel"
                                    @onchange="OnModelSwitchAsync">
                                @foreach (var option in _modelOptions)
                                {
                                    <option value="@option" selected="@(option == _currentModel)">@option</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <span class="ai-chat-chip">
                            <Icon Name="IconName.Cpu" /> @_activeThread.Model
                        </span>
                    }
                    @if (_activeThread.Mode == "agent")
                    {
                        <span class="ai-chat-chip">
                            <Icon Name="IconName.ShieldLock" /> @_activeThread.Sandbox
                        </span>
                    }
                    @if (_activeThread.Mode != "agent")
                    {
                        @* SPEC-20260928 RF-004: secondary actions live under ⋯ —
                           the composer keeps only Send/Retry/Stop. *@
                        <span class="ai-chat-overflow">
                            <button type="button" class="ai-chat-iconbtn"
                                    title="More actions" aria-label="More actions"
                                    @onclick="() => _overflowOpen = !_overflowOpen">
                                <Icon Name="IconName.ThreeDots" />
                            </button>
                            @if (_overflowOpen)
                            {
                                <div class="ai-chat-overflow-menu">
                                    <button type="button" class="ai-chat-overflow-item"
                                            disabled="@(_running || _sending)"
                                            @onclick="ShowRunAgentFromOverflowAsync">
                                        <Icon Name="IconName.Robot" class="me-1" /> Run agent on this thread
                                    </button>
                                </div>
                            }
                        </span>
                    }
                }
                <div class="ai-chat-toolbar-end">
                    @if (Usage is { } usage)
                    {
                        var percent = usage.Ratio is { } r ? (int)Math.Round(r * 100) : 0;
                        var meterClass = percent switch
                        {
                            >= 95 => "bg-danger",
                            >= 80 => "bg-warning",
                            _ => "bg-success",
                        };
                        <span class="ai-chat-ctl" title="@UsageTooltip(usage)">
                            <span class="progress ai-chat-meter" role="progressbar">
                                <span class="progress-bar @meterClass" style="width: @Math.Min(percent, 100)%"></span>
                            </span>
                            <span class="text-body-secondary">
                                @usage.Used.ToString("N0")@(usage.Size is { } s ? $" / {s:N0}" : "")
                            </span>
                        </span>
                    }
                    @* SPEC-20260928 RF-004: Send is the permanent primary action;
                       Stop/Retry surface only when they apply.
                       SPEC-20261003-ai-code-devin-layout RF-003: ações são
                       ícones circulares — sem texto. *@
                    @if (IsAgentMode && _activeThread is not null)
                    {
                        @if (_running)
                        {
                            <button type="button" class="ai-chat-sendbtn danger"
                                    title="Stop (Esc)" aria-label="Stop agent"
                                    @onclick="StopAgentAsync">
                                <Icon Name="IconName.StopFill" />
                            </button>
                        }
                        else
                        {
                            <button type="button" class="ai-chat-sendbtn secondary"
                                    disabled="@(_sending || !HasUserPrompt)"
                                    title="Resend the last user prompt"
                                    aria-label="Retry"
                                    @onclick="RetryAgentAsync">
                                <Icon Name="IconName.ArrowCounterclockwise" />
                            </button>
                        }
                    }
                    <button type="button" class="ai-chat-sendbtn primary"
                            disabled="@SendDisabled"
                            title="Send (Enter)" aria-label="Send"
                            @onclick="SendMessageAsync">
                        <Icon Name="IconName.SendFill" />
                    </button>
                </div>
                </div>
            </div>
        </div>
        }
        }
    </section>
</div>
}

@* RF-006: repo picker popup — free text or the shared repository combobox. *@
<Modal @ref="_repoModal" Title="Repository" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        <RepositoryCombobox Id="cmdbar-repo"
                            AriaLabel="Repository"
                            Placeholder="owner/repo (optional)"
                            Repositories="@_repoNames"
                            @bind-Value="_cfgRepo" />
        <p class="form-text mb-0 mt-2">
            Workspace resolves to <code>~/repos/&lt;name&gt;</code> server-side.
            @(_cfgMode == "agent" ? " Required in Agent mode." : " Optional in Assistant mode.")
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => HideModalAsync(_repoModal)">Done</Button>
    </FooterTemplate>
</Modal>

@* RF-006: model popup — tier + explicit model in config mode; the live
   session's advertised options in session mode. *@
<Modal @ref="_modelModal" Title="Model" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_activeThread is not null && _modelOptions.Count > 0)
        {
            <label class="form-label" for="cmdbar-session-model">Session model</label>
            <select id="cmdbar-session-model" class="form-select"
                    value="@_currentModel" @onchange="OnModelSwitchAsync">
                @foreach (var option in _modelOptions)
                {
                    <option value="@option" selected="@(option == _currentModel)">@option</option>
                }
            </select>
            <p class="form-text mb-0">Reported by the live agent session — applies via session/set_config.</p>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="cmdbar-tier">Model tier</label>
                <select id="cmdbar-tier" class="form-select" @bind="_cfgModelTier">
                    <option value="">Auto</option>
                    <option value="@AgentModelTier.Lite">Lite</option>
                    <option value="@AgentModelTier.Normal">Normal</option>
                    <option value="@AgentModelTier.Ultra">Ultra</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="cmdbar-model">Model</label>
                <select id="cmdbar-model" class="form-select" @bind="_cfgModelId">
                    <option value="">@(_cfgModelTier.Length == 0 ? "CLI default" : "Tier default")</option>
                    @foreach (var model in ConfigAgentModels())
                    {
                        <option value="@model.Name">@ModelOptionLabel(model)</option>
                    }
                </select>
                @if (ConfigAgentModels().Count == 0)
                {
                    <p class="form-text mb-0">No model list reported by this CLI — it runs with its own default.</p>
                }
                else
                {
