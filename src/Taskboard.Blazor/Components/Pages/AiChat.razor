    // SPEC-20260921-ai-code-chat-ux RF-001: o stream flat vira render items —
    // tool_call+updates fundem por toolCallId e edições consecutivas agregam.
    private IReadOnlyList<ChatRenderItem> AgentRenderItems => ToolCallGrouper.Build(_events);

    // RF-003: último usage_update do stream alimenta o medidor de contexto.
    private ContextUsage? Usage
    {
        get
        {
            for (var i = _events.Count - 1; i >= 0; i--)
            {
                if (_events[i].Kind == "metric")
                {
                    return ContextUsage.TryParse(_events[i].PayloadJson);
                }
            }

            return null;
        }
    }

    private static string UsageTooltip(ContextUsage usage)
    {
        var tip = $"context used: {usage.Used:N0}";
        if (usage.Size is { } size)
        {
            tip += $" of {size:N0} tokens";
        }

        if (usage.Cost is { } cost)
        {
            tip += $" · cost ${cost:F4}";
        }

        return tip;
    }

    // Consecutive user/assistant events render as one bubble — the server stores
    // one event per streamed delta, so grouping merges them into a growing
    // message. System-level roles (activity/error) render one line each.
    private IEnumerable<(string Role, string Text)> GroupedEvents
    {
        get
        {
            var groups = new List<(string Role, string Text)>();
            string? role = null;
            var buffer = new System.Text.StringBuilder();
            foreach (var ev in _events)
            {
                var normalized = ev.Role is "user" or "assistant" ? ev.Role : null;
                if (normalized is null)
                {
                    Flush();
                    groups.Add((ev.Role, ev.Content));
                    continue;
                }

                if (role is not null && normalized != role)
                {
                    Flush();
                }

                role = normalized;
                buffer.Append(normalized == "assistant" ? ev.Content : ev.Content + "\n");
            }

            Flush();
            return groups;

            void Flush()
            {
                if (role is not null)
                {
                    groups.Add((role, buffer.ToString()));
                    buffer.Clear();
                    role = null;
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            _threads = await Client.GetAiChatThreadsAsync();
        }
        catch (Exception ex)
        {
            await ToastService.NotifyAsync(new(ToastType.Danger, $"Failed to load threads: {ex.Message}"));
            _threads = [];
        }

        // Command-bar data — same sources the create dialog used. GitHub repo
        // list is best-effort (missing token must not break the page).
        // SPEC-20260928 RF-002: the one-click default prefers the last agent
        // used (localStorage) when still eligible, else the first eligible.
        try
        {
            string? lastAgent = null;
            try
            {
                lastAgent = await JS.InvokeAsync<string?>("taskboard.getAiChatLastAgent");
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
            {
                // JS interop unavailable (prerender) — defaults apply.
            }

            _agents = await OrchestrationService.GetAvailableAgentsAsync();
            _catalog = await Client.GetAiChatCatalogAsync();

            // SPEC-20260928-ai-code-generic-cli: the picker unifies eligible
            // builtins (chat), installed builtins (terminal) and custom defs;
            // docker containers are best-effort (503 → host only, no error).
            try { _cliStatuses = await Client.GetAgentClisAsync(); } catch { _cliStatuses = []; }
            try { _customDefs = await Client.GetCustomAgentClisAsync(); } catch { _customDefs = []; }
            try { _dockerContainers = await Client.GetDockerContainersAsync(); } catch { _dockerContainers = null; }
            BuildCliOptions();

            // lastAgent stores the option value ("agent:X"/"custom:y"); legacy
            // values are bare AgentType names → normalize to "agent:<name>".
            var lastOption = lastAgent is null
                ? null
                : lastAgent.Contains(':', StringComparison.Ordinal) ? lastAgent : $"agent:{lastAgent}";
            var first = (lastOption is null ? null : _cliOptions.FirstOrDefault(
                             o => o.Selectable && string.Equals(o.Value, lastOption, StringComparison.OrdinalIgnoreCase)))
                        ?? _cliOptions.FirstOrDefault(o => o.Selectable);
            if (first is not null)
            {
                _cfgCli = first.Value;
                _cfgView = first.SupportsChat ? "chat" : "terminal";
                // B-14/#387: persist the auto-selected CLI too — otherwise the
                // next load re-picks from scratch (and can land elsewhere when
                // eligibility changed between sessions).
                try
                {
                    await JS.InvokeVoidAsync("taskboard.setAiChatLastAgent", _cfgCli);
                }
                catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
                {
                    // Best-effort — failure here is non-fatal.
                }
            }

            // SPEC-20261001-chat-default-mode FR-001/003: resolve the default
            // mode once at init — provider chat when configured, else CLI chat,
            // else agent with a hint. Existing threads still override via
            // SelectThreadAsync (thread.Mode wins).
            try
            {
                var providers = await Client.GetChatProvidersAsync();
                var providerChatAvailable = providers.Any(p => p.Enabled);
                string? configuredMode = null;
                try
                {
                    var entries = await Client.GetConfigurationEntriesAsync();
                    configuredMode = entries.FirstOrDefault(
                        e => string.Equals(e.Key, "Taskboard:AiChat:DefaultMode", StringComparison.Ordinal))
                        ?.EffectiveValue;
                }
                catch
                {
                    // Config endpoint best-effort — default "auto" applies.
                }

                var resolution = Taskboard.Application.Contracts.AiChat.DefaultModePolicy.Resolve(
                    configuredMode, providerChatAvailable, AnyChatCapableCli);
                _cfgMode = resolution.Mode;
                _chatUnavailableHint = resolution.FellBack;
            }
            catch
            {
                // Provider list best-effort — keep the "assistant" default.
            }
        }
        catch
        {
            _agents ??= [];
            _catalog = [];
        }

        try
        {
            var repos = await GitHubService.GetRepositoriesAsync();
            _repoNames = repos.Select(r => r.FullName).ToList();
        }
        catch
        {
            _repoNames = [];
        }
    }

