@page "/ai-chat"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Text.Json
@inject TaskboardClient Client
@inject IAgentOrchestrationService OrchestrationService
@inject IGitHubService GitHubService
@inject IJSRuntime JS
@inject ToastService ToastService
@inject Taskboard.Blazor.Services.SelectedRepositoryService SelectedRepo

<PageTitle>AI Code - Harness</PageTitle>

<div class="d-flex align-items-center gap-2 mb-3">
    <h1 class="h4 fw-bold mb-0">AI Code</h1>
    <span class="small text-body-secondary ms-1">Chat threads and agent sub-tasks</span>
    @* SPEC-20260929-ai-chat-rail-overlay RF-002: histórico + new chat no
       topo-direito sobre o painel de chat — o rail fica oculto por padrão. *@
    <div class="ms-auto d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Threads history"
                aria-label="Open thread history"
                @onclick="OpenRailDrawerAsync">
            <Icon Name="IconName.ClockHistory" />
            <span class="ms-1 d-none d-sm-inline">History</span>
        </button>
        <button type="button" class="btn btn-sm btn-primary" title="New conversation"
                aria-label="New conversation"
                disabled="@(!HasEligibleAgent)"
                @onclick="NewConversationAsync">
            <Icon Name="IconName.PlusSquare" />
            <span class="ms-1 d-none d-sm-inline">New</span>
        </button>
    </div>
</div>

@if (_threads is null)
{
    <Loading Message="Loading threads..." />
}
else
{
<div class="ai-chat-layout @(_railDrawerOpen ? "rail-open" : "")" @onkeydown="OnPageKeyDown">
    @if (_railDrawerOpen)
    {
        <div class="ai-chat-rail-scrim" @onclick="() => _railDrawerOpen = false"></div>
    }
    <div class="ai-chat-rail-wrap @(_railDrawerOpen ? "drawer-open" : "")">
        <ThreadRail Threads="OrderedThreads"
                    ActiveThreadId="_activeThreadId"
                    Collapsed="false"
                    HasEligibleAgent="HasEligibleAgent"
                    OnNew="NewConversationAsync"
                    OnSelect="SelectThreadFromRailAsync"
                    OnDelete="DeleteThreadAsync" />
    </div>

    <section class="ai-chat-main card">
        @if (_cfgMode == "provider")
        {
            @* SPEC-20260929-ai-code-provider-chat RF-010: provider chat mode —
               replaces the agent-CLI UI with the open-webui-like layout. *@
            <div class="card-body p-2">
                <ProviderChat OnSwitchToAgent="SwitchToAgentMode" />
            </div>
        }
        else
        {
        @if (_activeThread is not null)
        {
            <div class="card-header d-flex align-items-center justify-content-between py-2">
                <div class="text-truncate">
                    <strong>@_activeThread.Title</strong>
                    <span class="text-body-secondary small ms-2">@_activeThread.Model</span>
                    @if (CliBadge(_activeThread) is { } cliName)
                    {
                        <span class="badge text-bg-primary ms-2">agent: @cliName</span>
                    }
                    @if (_activeThread.Kind == "terminal")
                    {
                        <span class="badge text-bg-dark ms-1">terminal</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.ContainerContext))
                    {
                        <span class="badge text-bg-info ms-1">⬢ @_activeThread.ContainerContext</span>
                    }
                </div>
                @if (_running)
                {
                    <span class="badge text-bg-warning ai-chat-badge-live">running</span>
                }
                else if (_activeThread.Status == "failed")
                {
                    <span class="badge text-bg-danger">failed</span>
                }
            </div>
        }

        @if (_sseError)
        {
            <div class="alert alert-warning small py-1 px-3 mb-0 rounded-0">
                Live stream interrupted — retrying automatically.
            </div>
        }

        @* SPEC-20260928-ai-code-ux-simplify RF-005: terminal-transport threads
           render the PTY pane instead of bubbles/composer (the pane owns its
           own input via xterm once SPEC-20260928-ai-code-generic-cli lands). *@
        @if (_activeThread?.Kind == "terminal")
        {
            @* @key forces a fresh pane per thread — without it Blazor reuses
               the instance and a second ConnectHubAsync stacks hub handlers
               and leaves the previous xterm undisposed
               (SPEC-20260929-pty-session-security RF-003). *@
            <PtyThreadPane Thread="_activeThread" @key="_activeThread.Id" />
        }
        else
        {
        <div class="ai-chat-messages card-body" @ref="_messagesRef">
            @if (_events.Count == 0 && !_running)
            {
                <div class="text-body-secondary small">
                    @(_activeThread is null
                        ? "Configure the bar below and send a message to start a conversation."
                        : "No messages yet — say something below.")
                </div>
            }
            @if (IsAgentMode)
            {
                @foreach (var item in AgentRenderItems)
                {
                    if (item.Tool is not null)
                    {
                        <ToolCallCard Model="item.Tool!" />
                        continue;
                    }

                    if (item.Group is not null)
                    {
                        <ToolCallChangesCard Items="item.Group!" />
                        continue;
                    }

                    var ev = item.Event!;
                    if (ev.Kind is "metric" or "permission")
                    {
                        // Metrics feed the composer meter; pending
                        // permissions render below the stream.
                        continue;
                    }

                    if (ev.Role is "queued")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble ai-chat-queued">
                                @ev.Content
                                <span class="badge text-bg-secondary ms-2">queued</span>
                                <button type="button" class="btn btn-sm btn-link text-danger py-0 ms-1"
                                        title="Cancel queued prompt"
                                        @onclick="() => CancelQueuedAsync(ev.Id)">
                                    <Icon Name="IconName.XCircle" />
                                </button>
                            </div>
                        </div>
                        continue;
                    }

                    if (ev.Role is "user")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble">
                                @ev.Content
                                <button type="button" class="btn btn-sm btn-link ai-chat-fork-btn"
                                        title="Fork thread from here"
                                        @onclick="() => ForkFromAsync(ev.Id)">
                                    <Icon Name="IconName.Diagram3" />
                                </button>
                            </div>
                        </div>
                    }
                    else if (ev.Role is "assistant" && ev.Kind is not "session")
                    {
                        <div class="ai-chat-msg ai-chat-msg-assistant">
                            <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(ev.Content))</div>
                        </div>
                    }
                    else
                    {
                        <div class="ai-chat-msg ai-chat-msg-system">
                            <span class="@(ev.Role == "error" ? "text-danger" : "text-body-secondary")">@ev.Content</span>
                        </div>
                    }
                }
                @foreach (var permission in _permissions)
                {
                    <PermissionPromptCard Request="permission" OnReply="OnPermissionReplyAsync" />
                }
            }
            else
            {
                @foreach (var group in GroupedEvents)
                {
                    @if (group.Role is "user")
                    {
                        <div class="ai-chat-msg ai-chat-msg-user">
                            <div class="ai-chat-bubble">@group.Text</div>
                        </div>
                    }
                    else if (group.Role is "assistant")
                    {
                        <div class="ai-chat-msg ai-chat-msg-assistant">
                            <div class="ai-chat-bubble ai-chat-md">@((MarkupString)MarkdownRenderer.ToSafeHtml(group.Text))</div>
                        </div>
                    }
                    else
                    {
                        <div class="ai-chat-msg ai-chat-msg-system">
                            <span class="@(group.Role == "error" ? "text-danger" : "text-body-secondary")">@group.Text</span>
                        </div>
                    }
                }
            }
            @if (_running)
            {
                <div class="ai-chat-msg ai-chat-msg-assistant">
                    <div class="ai-chat-bubble ai-chat-typing">
                        <Spinner Size="SpinnerSize.Small" /> thinking…
                    </div>
                </div>
            }
        </div>

        <div class="card-footer p-2">
            @* RF-005/RF-006: command bar — selects while unlocked, chips once
               the conversation is bound to a thread. *@
            <div class="ai-chat-commandbar d-flex gap-2 align-items-center mb-2 flex-wrap small">
                @if (_activeThread is null)
                {
                    <label class="d-flex align-items-center gap-1 mb-0">
                        <span class="text-body-secondary">Mode</span>
                        <select class="form-select form-select-sm ai-chat-quickselect"
                                @bind="_cfgMode" @bind:after="() => _chatUnavailableHint = false">
                            <option value="assistant">Assistant</option>
                            <option value="agent">Agent</option>
                            <option value="provider">Chat (Provider)</option>
                        </select>
                    </label>
                    @if (_chatUnavailableHint)
                    {
                        <span class="text-body-secondary small">
                            Chat indisponível — configure um provider ou CLI com chat em
                            <a href="/settings" class="alert-link">Settings → Chat</a>.
                        </span>
                    }
                    <label class="d-flex align-items-center gap-1 mb-0"
                           title="Structured chat (ACP) or raw terminal (PTY)">
                        <span class="text-body-secondary">View</span>
                        <select class="form-select form-select-sm ai-chat-quickselect"
                                value="@_cfgView" @onchange="OnCfgViewChanged">
                            <option value="chat" disabled="@(!AnyChatCapableCli)">Chat</option>
                            <option value="terminal">Terminal</option>
                        </select>
                    </label>
                    <label class="d-flex align-items-center gap-1 mb-0">
                        <span class="text-body-secondary">Agent CLI</span>
                        <select class="form-select form-select-sm ai-chat-quickselect"
                                value="@_cfgCli" @onchange="OnCfgCliChanged">
                            @foreach (var opt in _cliOptions)
                            {
                                // SPEC-20260929-ai-chat-view-first RF-002: em
                                // View=chat só entram CLIs com suporte ACP.
                                <option value="@opt.Value"
                                        disabled="@(!opt.Selectable || (_cfgView == "chat" && !opt.SupportsChat))">@opt.Label</option>
                            }
                        </select>
                    </label>
                    @if (_dockerContainers?.Count > 0)
                    {
                        <label class="d-flex align-items-center gap-1 mb-0"
                               title="Run the CLI on this host or inside a running container">
                            <span class="text-body-secondary">In</span>
                            <select class="form-select form-select-sm ai-chat-quickselect"
                                    value="@_cfgContext" @onchange="OnCfgContextChanged">
                                <option value="">host</option>
                                @foreach (var name in _dockerContainers.Select(container => container.Name))
                                {
                                    <option value="@name">⬢ @name</option>
                                }
                            </select>
                        </label>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            title="Repository (optional — resolves to ~/repos/<name>)"
                            @onclick="ShowRepoModalAsync">
                        <Icon Name="IconName.Folder" />
                        <span class="ms-1">@(string.IsNullOrWhiteSpace(_cfgRepo) ? "repo" : _cfgRepo)</span>
                    </button>
                    <span class="text-body-secondary" title="Workspace root (fixed)">~/repos</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            title="Model"
                            @onclick="ShowModelModalAsync">
                        <Icon Name="IconName.Cpu" />
                        <span class="ms-1">@ConfigModelLabel</span>
                    </button>
                    @if (_cfgMode == "agent")
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                title="Sandbox"
                                @onclick="ShowSandboxModalAsync">
                            <Icon Name="IconName.ShieldLock" />
                            <span class="ms-1">@_cfgSandbox</span>
                        </button>
                    }
                    @if (_agents is not null && !_cliOptions.Any(o => o.Selectable))
                    {
                        <span class="text-warning">
                            No enabled CLI —
                            <a href="/settings" class="alert-link">Settings → Agents</a>
                        </span>
                    }
                }
                else
                {
                    <span class="badge text-bg-secondary">@_activeThread.Mode</span>
                    @if (CliBadge(_activeThread) is { } cliName)
                    {
                        <span class="badge text-bg-primary">@cliName</span>
                    }
                    @if (_activeThread.Kind == "terminal")
                    {
                        <span class="badge text-bg-dark">terminal</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.ContainerContext))
                    {
                        <span class="badge text-bg-info">⬢ @_activeThread.ContainerContext</span>
                    }
                    @if (_modes.Count > 0)
                    {
                        @* RF-006: Modo is a session control — it stays usable on a
                           live agent session even while the bar is locked. *@
                        <label class="d-flex align-items-center gap-1 mb-0">
                            <span class="text-body-secondary">modo</span>
                            <select class="form-select form-select-sm ai-chat-quickselect"
                                    value="@_currentMode"
                                    @onchange="OnModeSwitchAsync">
                                @foreach (var mode in _modes)
                                {
                                    <option value="@mode.Id" selected="@(mode.Id == _currentMode)">@mode.Name</option>
                                }
                            </select>
                        </label>
                    }
                    @if (!string.IsNullOrWhiteSpace(_activeThread.RepositoryFullName))
                    {
                        <span class="badge text-bg-light border">
                            <Icon Name="IconName.Folder" /> @_activeThread.RepositoryFullName
                        </span>
                    }
                    <span class="text-body-secondary" title="Workspace">@(_activeThread.WorkspacePath ?? "~/repos")</span>
                    @if (_modelOptions.Count > 0)
                    {
                        <label class="d-flex align-items-center gap-1 mb-0">
                            <span class="text-body-secondary">model</span>
                            <select class="form-select form-select-sm ai-chat-quickselect"
                                    value="@_currentModel"
                                    @onchange="OnModelSwitchAsync">
                                @foreach (var option in _modelOptions)
                                {
                                    <option value="@option" selected="@(option == _currentModel)">@option</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <span class="badge text-bg-light border">
                            <Icon Name="IconName.Cpu" /> @_activeThread.Model
                        </span>
                    }
                    @if (_activeThread.Mode == "agent")
                    {
                        <span class="badge text-bg-light border">
                            <Icon Name="IconName.ShieldLock" /> @_activeThread.Sandbox
                        </span>
                    }
                    @if (_activeThread.Mode != "agent")
                    {
                        @* SPEC-20260928 RF-004: secondary actions live under ⋯ —
                           the composer keeps only Send/Retry/Stop. *@
                        <span class="ai-chat-overflow">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="More actions" aria-label="More actions"
                                    @onclick="() => _overflowOpen = !_overflowOpen">
                                <Icon Name="IconName.ThreeDots" />
                            </button>
                            @if (_overflowOpen)
                            {
                                <div class="ai-chat-overflow-menu">
                                    <button type="button" class="ai-chat-overflow-item"
                                            disabled="@(_running || _sending)"
                                            @onclick="ShowRunAgentFromOverflowAsync">
                                        <Icon Name="IconName.Robot" class="me-1" /> Run agent on this thread
                                    </button>
                                </div>
                            }
                        </span>
                    }
                }
                @if (Usage is { } usage)
                {
                    var percent = usage.Ratio is { } r ? (int)Math.Round(r * 100) : 0;
                    var meterClass = percent switch
    {
        >= 95 => "bg-danger",
        >= 80 => "bg-warning",
        _ => "bg-success",
    };
                    <div class="d-flex align-items-center gap-2 ms-auto" title="@UsageTooltip(usage)">
                        <div class="progress ai-chat-meter" role="progressbar">
                            <div class="progress-bar @meterClass" style="width: @Math.Min(percent, 100)%"></div>
                        </div>
                        <span class="text-body-secondary">
                            @usage.Used.ToString("N0")@(usage.Size is { } s ? $" / {s:N0}" : "") tokens
                        </span>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 align-items-end">
                <textarea class="form-control ai-chat-composer" rows="2"
                          enterkeyhint="send" autocomplete="off" data-shortcut-command
                          @ref="_composerRef"
                          placeholder="@ComposerPlaceholder"
                          disabled="@((_running && !IsAgentMode) || _sending)"
                          @bind="_composer"
                          @bind:event="oninput"
                          @onkeydown="OnComposerKeyDownAsync"></textarea>
                <div class="d-flex flex-column gap-2">
                    @* SPEC-20260928 RF-004: Send is the permanent primary action;
                       Stop/Retry surface only when they apply. *@
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                            Disabled="@((_running && !IsAgentMode) || _sending
                                || (string.IsNullOrWhiteSpace(_composer) && !(_activeThreadId is null && _cfgView == "terminal")))"
                            @onclick="SendMessageAsync">Send</Button>
                    @if (IsAgentMode && _activeThread is not null)
                    {
                        @if (_running)
                        {
                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="StopAgentAsync">Stop</Button>
                        }
                        else
                        {
                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                    Disabled="@(_sending || !HasUserPrompt)"
                                    title="Resend the last user prompt"
                                    @onclick="RetryAgentAsync">Retry</Button>
                        }
                    }
                </div>
            </div>
        </div>
        }
        }
    </section>
</div>
}

@* RF-006: repo picker popup — free text or the shared repository combobox. *@
<Modal @ref="_repoModal" Title="Repository" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        <RepositoryCombobox Id="cmdbar-repo"
                            AriaLabel="Repository"
                            Placeholder="owner/repo (optional)"
                            Repositories="@_repoNames"
                            @bind-Value="_cfgRepo" />
        <p class="form-text mb-0 mt-2">
            Workspace resolves to <code>~/repos/&lt;name&gt;</code> server-side.
            @(_cfgMode == "agent" ? " Required in Agent mode." : " Optional in Assistant mode.")
        </p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => HideModalAsync(_repoModal)">Done</Button>
    </FooterTemplate>
</Modal>

@* RF-006: model popup — tier + explicit model in config mode; the live
   session's advertised options in session mode. *@
<Modal @ref="_modelModal" Title="Model" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (_activeThread is not null && _modelOptions.Count > 0)
        {
            <label class="form-label" for="cmdbar-session-model">Session model</label>
            <select id="cmdbar-session-model" class="form-select"
                    value="@_currentModel" @onchange="OnModelSwitchAsync">
                @foreach (var option in _modelOptions)
                {
                    <option value="@option" selected="@(option == _currentModel)">@option</option>
                }
            </select>
            <p class="form-text mb-0">Reported by the live agent session — applies via session/set_config.</p>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="cmdbar-tier">Model tier</label>
                <select id="cmdbar-tier" class="form-select" @bind="_cfgModelTier">
                    <option value="">Auto</option>
                    <option value="@AgentModelTier.Lite">Lite</option>
                    <option value="@AgentModelTier.Normal">Normal</option>
                    <option value="@AgentModelTier.Ultra">Ultra</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="cmdbar-model">Model</label>
                <select id="cmdbar-model" class="form-select" @bind="_cfgModelId">
                    <option value="">@(_cfgModelTier.Length == 0 ? "CLI default" : "Tier default")</option>
                    @foreach (var model in ConfigAgentModels())
                    {
                        <option value="@model.Name">@ModelOptionLabel(model)</option>
                    }
                </select>
                @if (ConfigAgentModels().Count == 0)
                {
                    <p class="form-text mb-0">No model list reported by this CLI — it runs with its own default.</p>
                }
                else
                {
                    <p class="form-text mb-0">An explicit model overrides the tier.</p>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => HideModalAsync(_modelModal)">Done</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="_sandboxModal" Title="Sandbox" Size="ModalSize.Small" Fullscreen="ModalFullscreen.SmallDown" IsVerticallyCentered="true">
    <BodyTemplate>
        <select class="form-select" @bind="_cfgSandbox" aria-label="Sandbox">
            <option value="read-only">read-only</option>
            <option value="workspace-write">workspace-write</option>
            <option value="danger-full-access">danger-full-access</option>
        </select>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => HideModalAsync(_sandboxModal)">Done</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="_runAgentModal" Fullscreen="ModalFullscreen.SmallDown" />

@code {
    private static readonly JsonSerializerOptions SseJson = new(JsonSerializerDefaults.Web);

    private IReadOnlyCollection<AiChatThreadDto>? _threads;
    private string? _activeThreadId;
    private AiChatThreadDto? _activeThread;
    private readonly List<AiChatEventDto> _events = [];
    private readonly HashSet<string> _seenEventIds = new(StringComparer.Ordinal);
    private readonly List<PermissionRequestInfo> _permissions = [];
    private readonly List<string> _modelOptions = [];
    private readonly List<(string Id, string Name)> _modes = [];
    private string? _modelConfigId;
    private string? _currentModel;
    private string? _currentMode;
    private string _composer = string.Empty;
    private bool _running;
    private bool _sending;
    private bool _sseError;
    private bool _scrollPending;
    // SPEC-20260928: rail state — collapsed (desktop icon rail), drawer (mobile overlay).
    private bool _railDrawerOpen;
    private bool _overflowOpen;
    private ElementReference _messagesRef;
    private ElementReference _composerRef;
    private Modal _repoModal = default!;
    private Modal _modelModal = default!;
    private Modal _sandboxModal = default!;
    private Modal _runAgentModal = default!;
    private DotNetObjectReference<AiChat>? _dotNetRef;
    private readonly CancellationTokenSource _disposeCts = new();

    // RF-006: unlocked command-bar configuration — survives "New conversation"
    // so the next thread starts from the last-used selections.
    private IReadOnlyList<AgentInfo>? _agents;
    private IReadOnlyList<AiChatModelDto> _catalog = [];
    private IReadOnlyList<string> _repoNames = [];
    private string _cfgMode = "assistant";
    private string _cfgRepo = string.Empty;
    private string _cfgModelTier = string.Empty;
    private string _cfgModelId = string.Empty;
    private string _cfgSandbox = "read-only";

    // SPEC-20260928-ai-code-generic-cli: the CLI picker unifies eligible
    // builtins (chat), installed builtins (terminal — auth inside the PTY)
    // and persisted custom defs; _cfgCli is the option value ("agent:<type>"
    // or "custom:<id>"), _cfgView the thread kind, _cfgContext the docker
    // target ("" = host).
    private IReadOnlyList<AgentCliDefinitionDto> _customDefs = [];
    private IReadOnlyList<AgentCliStatus> _cliStatuses = [];
    private IReadOnlyList<DockerContainerDto>? _dockerContainers;
    private IReadOnlyList<CliOption> _cliOptions = [];
    private string _cfgCli = string.Empty;
    private string _cfgView = "chat";
    private string _cfgContext = string.Empty;

    // SPEC-20261001-chat-default-mode: resolved default-mode hint shown when
    // no chat surface is configured (Chat unavailable → Agent fallback).
    private bool _chatUnavailableHint;

    /// <summary>Uma entrada do seletor "Agent CLI" — builtin ou def customizada.</summary>
    private sealed record CliOption(
        string Value,
        string Label,
        AgentType? AgentType,
        string? AgentCliId,
        bool SupportsChat,
        bool Selectable)
    {
        public bool IsCustom => AgentCliId is not null;
    }

    private CliOption? SelectedCli =>
        _cliOptions.FirstOrDefault(o => o.Value == _cfgCli);

    /// <summary>Chat estruturado (ACP) exige CLI elegível/autenticada ou def acp resolvida.</summary>
    private bool SelectedCliSupportsChat => SelectedCli?.SupportsChat == true;

    private bool IsAgentMode =>
        (_activeThread?.Mode ?? _cfgMode) == "agent";

    /// <summary>SPEC-20260928 RF-002: gates the rail's one-click New button.</summary>
    private bool HasEligibleAgent =>
        _cliOptions.Any(o => o.Selectable);

    private string ComposerPlaceholder =>
        _running && !IsAgentMode ? "Waiting for the assistant…"
        : IsAgentMode && _running ? "Steer or queue instruction…"
        : "Message…";

    private string ConfigModelLabel =>
        _cfgModelId.Length > 0 ? _cfgModelId
        : _cfgModelTier.Length > 0 ? _cfgModelTier
        : "model";

    private IReadOnlyList<AiChatModelDto> ConfigAgentModels() =>
        _catalog.Where(m => string.Equals(
            m.AgentType, SelectedCli?.AgentType?.ToString(), StringComparison.OrdinalIgnoreCase)).ToList();

    /// <summary>
    /// Builds the unified CLI picker: eligible builtins (chat+terminal),
    /// installed-but-not-eligible builtins (terminal only) and enabled custom
    /// defs. Order: chat-capable first, then terminal-only, then custom.
    /// </summary>
    /// <summary>/agent builtin — chat hand-off to agent mode (SPEC-20261001-chat-skills-slash-commands).</summary>
    private void SwitchToAgentMode()
    {
        _cfgMode = "agent";
        _chatUnavailableHint = false;
    }

    private void OnCfgContextChanged(ChangeEventArgs e)
    {
        _cfgContext = e.Value?.ToString() ?? string.Empty;
        BuildCliOptions();
        if (!SelectedCliSupportsChat && _cfgView == "chat")
        {
            _cfgView = "terminal";
        }
    }

    private void BuildCliOptions()
    {
        var options = new List<CliOption>();
        var covered = new HashSet<AgentType>();

        // SPEC-20260929-docker-cli-context RF-002: with a container selected,
        // availability comes from the binaries discovered inside it — CLIs
        // that exist only in the container become selectable.
        var container = _dockerContainers?.FirstOrDefault(c => c.Name == _cfgContext);
        if (container is not null)
        {
            AddContainerOptions(options, covered, container);
        }
        else
        {
            AddHostOptions(options, covered);
        }

        AddCustomDefOptions(options);
        _cliOptions = options;
    }

    private static void AddContainerOptions(List<CliOption> options, HashSet<AgentType> covered, DockerContainerDto container)
    {
        foreach (var bin in container.AvailableClis)
        {
            var (type, display) = ResolveContainerBinary(bin);
            if (type is null || !covered.Add(type.Value))
            {
                continue;
            }

            options.Add(new CliOption(
                $"agent:{type.Value}", display ?? bin, type.Value, null,
                SupportsChat: AgentCliMap.SupportsAcp(type.Value), Selectable: true));
        }
    }

    private static (AgentType? Type, string? Display) ResolveContainerBinary(string bin)
    {
        var match = AgentCliMap.AllSpecs()
            .Where(kv => string.Equals(kv.Value.Binary, bin, StringComparison.Ordinal))
            .Select(kv => (Type: AgentCliMap.AgentTypeFor(kv.Key), Display: kv.Value.DisplayName))
            .FirstOrDefault();
        if (match.Type is not null)
        {
            return match;
        }

        return (bin == "openhands" ? AgentType.OpenHands : null, null);
    }

    private void AddHostOptions(List<CliOption> options, HashSet<AgentType> covered)
    {
        foreach (var agent in _agents ?? [])
        {
            if (agent.Status != AgentStatus.Available || !covered.Add(agent.Type))
            {
                continue;
            }

            options.Add(new CliOption(
                $"agent:{agent.Type}", agent.Name, agent.Type, null,
                SupportsChat: AgentCliMap.SupportsAcp(agent.Type), Selectable: true));
        }

        // Installed but not eligible (no auth / disabled) — terminal threads
        // still work: authentication happens inside the PTY.
        foreach (var status in _cliStatuses)
        {
            if (!status.Installed || AgentCliMap.AgentTypeFor(status.Agent) is not { } type
                || covered.Contains(type))
            {
                continue;
            }

            covered.Add(type);
            options.Add(new CliOption(
                $"agent:{type}", status.DisplayName, type, null,
                SupportsChat: false, Selectable: true));
        }
    }

    private void AddCustomDefOptions(List<CliOption> options)
    {
        foreach (var def in _customDefs.Where(d => d.Enabled))
        {
            var label = def.Resolved ? def.DisplayName : $"{def.DisplayName} (not on PATH)";
            options.Add(new CliOption(
                $"custom:{def.Id}", label, null, def.Id,
                // Custom defs spawn via argv (PTY) only — the server refuses
                // acp transport for them (SPEC-20260929-ai-chat-capabilities).
                SupportsChat: false,
                Selectable: def.Resolved));
        }
    }

