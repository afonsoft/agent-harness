    private async Task OnCfgCliChanged(ChangeEventArgs e)
    {
        _cfgCli = e.Value?.ToString() ?? string.Empty;
        _cfgModelId = string.Empty; // reset to CLI default when switching agents
        // A CLI without ACP forces the terminal view only inside a legacy
        // thread pane — the agent-chat surface works with any CLI.
        if (_activeThread is not null && !SelectedCliSupportsChat)
        {
            _cfgView = "terminal";
        }

        try
        {
            await JS.InvokeVoidAsync("taskboard.setAiChatLastAgent", _cfgCli);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // Storage/JS unavailable — session-only default.
        }
    }

    /// <summary>Alguma CLI oferece chat estruturado (ACP) no contexto atual.</summary>
    private bool AnyChatCapableCli =>
        _cliOptions.Any(o => o.Selectable && o.SupportsChat);

    private void OnCfgViewChanged(ChangeEventArgs e)
    {
        var view = e.Value?.ToString() ?? "chat";
        if (view == "chat")
        {
            // SPEC-20260929-ai-chat-view-first RF-002: View=chat exige CLI com
            // ACP — troca para a primeira compatível; sem nenhuma, terminal.
            // Gate applies only to the legacy thread pane: the agent-chat
            // footer view picker targets the provider-chat surface, which is
            // CLI-independent (SPEC-20261003-ai-code-agent-chat).
            if (_activeThread is not null && !SelectedCliSupportsChat)
            {
                var first = _cliOptions.FirstOrDefault(o => o.Selectable && o.SupportsChat);
                if (first is null)
                {
                    _cfgView = "terminal";
                    return;
                }

                _cfgCli = first.Value;
                _cfgModelId = string.Empty;
            }

            _cfgView = "chat";
        }
        else
        {
            _cfgView = "terminal";
        }
    }

