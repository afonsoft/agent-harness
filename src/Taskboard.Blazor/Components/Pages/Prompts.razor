@page "/prompts/{source}/{name}"
@attribute [Authorize]
@inject TaskboardClient Client
@inject ToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Prompt - @(_skill?.Name ?? "...") - Harness</PageTitle>

<h1 class="h4 fw-bold mb-1">Prompt library</h1>
<p class="small text-body-secondary mb-4">Copy a skill prompt to use in your agent.</p>

@if (_skill is null)
{
    if (_notFound)
    {
        <EmptyState Message="Skill not found." />
    }
    else
    {
        <Loading Message="Loading prompt..." />
    }
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="mb-4 d-flex align-items-start justify-content-between gap-3">
                <div>
                    <h2 class="h4 fw-bold">@_skill.Name</h2>
                    <p class="small text-body-secondary mb-0">@_skill.Description</p>
                </div>
                <Button Color="ButtonColor.Primary" Class="flex-shrink-0" @onclick="CopyToClipboardAsync">
                    <Icon Name="IconName.Clipboard" class="me-2" />Copy prompt
                </Button>
            </div>

            @if (_skill.Tools.Any())
            {
                <div class="mb-4 d-flex flex-wrap gap-2">
                    @foreach (var tool in _skill.Tools)
                    {
                        <span class="badge text-bg-secondary">@tool</span>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_skill.References))
            {
                <div class="mb-4">
                    <h3 class="h6 fw-semibold mb-2">References</h3>
                    <pre class="code-block">@_skill.References</pre>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_skill.Scripts))
            {
                <div class="mb-4">
                    <h3 class="h6 fw-semibold mb-2">Scripts</h3>
                    <pre class="code-block">@_skill.Scripts</pre>
                </div>
            }

            <div>
                <h3 class="h6 fw-semibold mb-2">Full content</h3>
                <pre class="code-block">@_skill.Content</pre>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Source { get; set; } = default!;
    [Parameter] public string Name { get; set; } = default!;

    private SkillDetailDto? _skill;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        _skill = await Client.GetSkillDetailAsync(Source, Name);
        _notFound = _skill is null;
    }

    private async Task CopyToClipboardAsync()
    {
        if (_skill is null)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _skill.Content);
        ToastService.Notify(new(ToastType.Success, "Prompt copied to clipboard"));
    }
}
