@using Taskboard.Agents
@using Taskboard.Application.Contracts.Agents
@inject IAgentModelConfigService ModelConfig
@inject IAgentModelCatalogService ModelCatalog
@inject ToastService ToastService

@*
    SPEC-20260918-agent-model-config RF-007: per-CLI tier model configuration.
    Each tier is an editable AutoComplete fed by the models the installed CLI
    reports itself (`opencode models`, `devin models list`, `agy models`)
    merged with the curated catalog — free text is still allowed, an empty
    field falls back to the curated default.
*@

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary small">
        <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" /> Carregando configuração…
    </div>
}
else if (_config is not null)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <strong>@DisplayName</strong>
        @if (_config.Source == "override")
        {
            <Badge Color="BadgeColor.Info">Override</Badge>
        }
        else
        {
            <Badge Color="BadgeColor.Secondary">Default</Badge>
        }
    </div>

    @foreach (var tier in _tiers)
    {
        <div class="mb-3" @key="tier.Tier">
            <label class="form-label small fw-semibold">
                @tier.Label
                <span class="text-body-secondary fw-normal">— default: <code>@tier.Default</code></span>
            </label>
            <AutoComplete @bind-Value="tier.Value"
                          TItem="ModelOption"
                          DataProvider="ModelsDataProvider"
                          PropertyName="@nameof(ModelOption.Name)"
                          Placeholder="@tier.Default"
                          EmptyText="Nenhum modelo encontrado"
                          StringFilterOperator="StringFilterOperator.Contains"
                          StringComparison="StringComparison.OrdinalIgnoreCase"
                          OnChanged="(ModelOption picked) => tier.Value = picked.Name"
                          Class="font-monospace" />
        </div>
    }

    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
        <p class="small text-body-secondary mb-0">
            <Icon Name="IconName.InfoCircle" class="me-1" />
            Deixe em branco para usar o default curado. O modelo é passado à CLI via argumento na execução.
            @if (_available is not null)
            {
                <span class="d-block mt-1">
                    @_available.Count modelo(s) reportado(s) pela CLI + catálogo curado.
                </span>
            }
        </p>
        <Tooltip Title="Re-executar o comando de listagem de modelos da CLI (ignora o cache de 5 min)">
            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                    @onclick="SyncAsync" Disabled="@(_syncing || _loading)">
                @if (_syncing)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                else
                {
                    <Icon Name="IconName.ArrowClockwise" class="me-1" />
                }
                Sync
            </Button>
        </Tooltip>
    </div>

    <div class="d-flex justify-content-between pt-2 border-top">
        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small" @onclick="ResetAsync"
                Disabled="@(_saving || _config.Source != "override")">
            Restaurar defaults
        </Button>
        <div class="d-flex gap-2">
            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="CloseAsync" Disabled="_saving">
                Cancelar
            </Button>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="SaveAsync" Disabled="_saving">
                @if (_saving)
                {
                    <Spinner Size="SpinnerSize.Small" Class="me-1" />
                }
                Salvar
            </Button>
        </div>
    </div>
}
else
{
    <div class="small text-danger">@_error</div>
}

@code {
    [Parameter, EditorRequired] public AgentType AgentType { get; set; }
    [Parameter] public string DisplayName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnFinished { get; set; }

    private sealed record ModelOption(string Name);

    private sealed class TierRow(AgentModelTier tier, string label)
    {
        public AgentModelTier Tier { get; } = tier;
        public string Label { get; } = label;
        public string Default { get; set; } = "—";
        public string Value { get; set; } = string.Empty;
    }

    private readonly TierRow[] _tiers =
    [
        new(AgentModelTier.Lite, "Lite (mais barato)"),
        new(AgentModelTier.Normal, "Normal (default)"),
        new(AgentModelTier.Ultra, "Ultra (mais caro)"),
    ];

    private AgentModelConfigDto? _config;
    private IReadOnlyList<string>? _available;
    private List<ModelOption> _suggestions = [];
    private bool _loading = true;
    private bool _saving;
    private bool _syncing;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _config = await ModelConfig.GetConfigAsync(AgentType);
            _tiers[0].Value = _config.Lite ?? string.Empty;
            _tiers[0].Default = _config.Defaults.Lite ?? "—";
            _tiers[1].Value = _config.Normal ?? string.Empty;
            _tiers[1].Default = _config.Defaults.Normal ?? "—";
            _tiers[2].Value = _config.Ultra ?? string.Empty;
            _tiers[2].Default = _config.Defaults.Ultra ?? "—";
            _suggestions = BuildSuggestions();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar a configuração: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        _ = RefreshAvailableAsync();
    }

    // Probing the CLI (`opencode models`, `devin models list`, `agy models`)
    // can take a few seconds — the dialog renders immediately with the
    // curated catalog and the dropdown gains the CLI-reported ids when the
    // probe returns (failures keep the curated list only).
    private async Task RefreshAvailableAsync(bool forceRefresh = false)
    {
        try
        {
            _available = await ModelCatalog.ListAvailableAsync(AgentType, forceRefresh);
            _suggestions = BuildSuggestions();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _available = [];
        }
    }

    // Sync button: forces a fresh probe server-side (bypasses the 5-min
    // cache) so newly installed/updated CLIs surface their models at once.
    private async Task SyncAsync()
    {
        _syncing = true;
        try
        {
            await RefreshAvailableAsync(forceRefresh: true);
            ToastService.Notify(new(ToastType.Info,
                $"Lista de modelos de {DisplayName} atualizada ({_available?.Count ?? 0} reportados pela CLI)."));
        }
        finally
        {
            _syncing = false;
        }
    }

    private List<ModelOption> BuildSuggestions() =>
        (_available ?? [])
            .Concat(_config?.Catalog ?? [])
            .Concat(_tiers.Select(t => t.Value).Where(v => !string.IsNullOrWhiteSpace(v)))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(name => new ModelOption(name))
            .ToList();

    private Task<AutoCompleteDataProviderResult<ModelOption>> ModelsDataProvider(
        AutoCompleteDataProviderRequest<ModelOption> request)
    {
        var filter = request.Filter?.Value;
        var matches = _suggestions
            .Where(m => string.IsNullOrEmpty(filter) || m.Name.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .Take(200)
            .ToList();
        return Task.FromResult(new AutoCompleteDataProviderResult<ModelOption>
        {
            Data = matches,
            TotalCount = matches.Count,
        });
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await ModelConfig.SetConfigAsync(AgentType,
                new SaveAgentModelConfigRequest(_tiers[0].Value, _tiers[1].Value, _tiers[2].Value));
            ToastService.Notify(new(ToastType.Success, $"Modelos de {DisplayName} salvos."));
            await OnFinished.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Falha ao salvar: {ex.Message}"));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync()
    {
        _saving = true;
        try
        {
            await ModelConfig.DeleteConfigAsync(AgentType);
            ToastService.Notify(new(ToastType.Success, $"Modelos de {DisplayName} restaurados para o default."));
            await OnFinished.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Falha ao restaurar: {ex.Message}"));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CloseAsync() => await OnFinished.InvokeAsync();
}
