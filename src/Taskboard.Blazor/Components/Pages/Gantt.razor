@page "/gantt"
@attribute [Authorize]
@implements IDisposable
@inject SelectedRepositoryService RepoService
@inject ITimelineMetricsService Timeline

<PageTitle>Gantt - Harness</PageTitle>

<h1 class="h4 fw-bold mb-1">Gantt</h1>
<p class="small text-body-secondary mb-4">Issue timeline and kanban flow metrics</p>

@if (_isLoading)
{
    <Loading Message="Loading repositories..." />
}
else
{
    @if (RepoService.Warning is not null)
    {
        <div class="alert alert-warning">@RepoService.Warning</div>
    }
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_isTimelineLoading)
    {
        <Loading Message="Loading timeline..." />
    }
    else if (_timeline is not null)
    {
        @if (_metrics is not null)
        {
            <div class="card mb-3">
                <div class="card-body py-3">
                    <div class="gantt-metrics">
                        <div>
                            <div class="gantt-metric-label">Lead time (avg)</div>
                            <div class="gantt-metric-value">@FormatDays(_metrics.LeadTimeAvgDays)</div>
                        </div>
                        <div>
                            <div class="gantt-metric-label">Lead time (median)</div>
                            <div class="gantt-metric-value">@FormatDays(_metrics.LeadTimeMedianDays)</div>
                        </div>
                        <div>
                            <div class="gantt-metric-label">Cycle time (avg)</div>
                            <div class="gantt-metric-value">@FormatDays(_metrics.CycleTimeAvgDays)</div>
                        </div>
                        <div>
                            <div class="gantt-metric-label">WIP</div>
                            <div class="gantt-metric-value">@_metrics.Wip</div>
                        </div>
                        <div>
                            <div class="gantt-metric-label">Aging (median)</div>
                            <div class="gantt-metric-value">@FormatDays(_metrics.OpenMedianAgeDays)</div>
                        </div>
                        <div>
                            <div class="gantt-metric-label">Throughput / week</div>
                            <div class="gantt-throughput" title="@ThroughputTitle()">
                                @foreach (var point in _metrics.ThroughputPerWeek)
                                {
                                    <div class="gantt-throughput-bar"
                                         style="height: @ThroughputHeight(point)%"
                                         title="@point.WeekStart.ToString("dd/MM") — @point.Closed closed"></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!_timeline.Issues.Any())
        {
            <EmptyState Message="No issues in this repository for the selected window." />
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <div class="gantt-chart" role="img" aria-label="Issue timeline">
                        <div class="gantt-header">
                            <span>@_rangeStart.ToString("dd/MM/yyyy")</span>
                            <span>@_rangeEnd.ToString("dd/MM/yyyy")</span>
                        </div>
                        @foreach (var issue in _timeline.Issues)
                        {
                            <div class="gantt-row" @key="issue.Id">
                                <div class="gantt-label" title="@issue.Title">#@issue.Number — @issue.Title</div>
                                <div class="gantt-track">
                                    <div class="gantt-bar @GetBarClass(issue)"
                                         style="@GetBarStyle(issue)"
                                         title="@GetBarTitle(issue)"></div>
                                    @if (GetMilestoneOffset(issue) is { } milestoneOffset)
                                    {
                                        <div class="gantt-milestone"
                                             style="left: @Percent(milestoneOffset)%"
                                             title="Milestone due @issue.MilestoneDueOn!.Value.ToString("dd/MM/yyyy")"></div>
                                    }
                                </div>
                                <div class="gantt-dates small text-body-secondary">@GetBarTitle(issue)</div>
                            </div>
                        }
                        @if (GetTodayOffset() is { } todayOffset)
                        {
                            <div class="gantt-row gantt-today-row" aria-hidden="true">
                                <div class="gantt-label"></div>
                                <div class="gantt-track">
                                    <div class="gantt-today" style="left: @Percent(todayOffset)%"
                                         title="Today"></div>
                                </div>
                                <div class="gantt-dates small text-body-secondary">Today</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (!RepoService.TokenMissing)
    {
        <EmptyState Message="Type or select a repository to load the timeline." />
    }
}

@code {
    private const int WindowDays = 90;

    private bool _isLoading = true;
    private bool _isTimelineLoading;
    private string? _errorMessage;
    private RepoTimelineDto? _timeline;
    private RepoMetricsDto? _metrics;
    private DateTime _rangeStart;
    private DateTime _rangeEnd;

    protected override async Task OnInitializedAsync()
    {
        RepoService.Changed += OnRepoChangedAsync;
        await RepoService.EnsureLoadedAsync();
        await LoadTimelineAsync();
        _isLoading = false;
    }

    private Task OnRepoChangedAsync() => InvokeAsync(async () =>
    {
        await LoadTimelineAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        RepoService.Changed -= OnRepoChangedAsync;
    }

    private async Task LoadTimelineAsync()
    {
        var repo = RepoService.Selected;
        if (repo is null)
        {
            _timeline = null;
            _metrics = null;
            return;
        }

        _isTimelineLoading = true;
        _errorMessage = null;
        try
        {
            var parts = repo.Split('/', 2);
            var timelineTask = Timeline.GetTimelineAsync(parts[0], parts[1], WindowDays);
            var metricsTask = Timeline.GetMetricsAsync(parts[0], parts[1], WindowDays);
            await Task.WhenAll(timelineTask, metricsTask);
            // Discard stale responses on rapid repo switches.
            if (!string.Equals(repo, RepoService.Selected, StringComparison.Ordinal))
            {
                return;
            }

            _timeline = timelineTask.Result;
            _metrics = metricsTask.Result;

            _rangeEnd = DateTime.UtcNow.Date;
            _rangeStart = _rangeEnd.AddDays(-WindowDays);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading timeline: {ex.Message}";
            _timeline = null;
            _metrics = null;
        }
        finally
        {
            _isTimelineLoading = false;
        }
    }

    private double GetBarLeft(IssueTimelineDto issue)
    {
        var total = (_rangeEnd - _rangeStart).TotalDays;
        var start = issue.CreatedAt.UtcDateTime.Date;
        var offset = (start < _rangeStart ? _rangeStart : start) - _rangeStart;
        return Math.Clamp(offset.TotalDays / total * 100, 0, 100);
    }

    private double GetBarWidth(IssueTimelineDto issue)
    {
        var total = (_rangeEnd - _rangeStart).TotalDays;
        var start = issue.CreatedAt.UtcDateTime.Date;
        var end = issue.ClosedAt?.UtcDateTime.Date ?? _rangeEnd;
        if (end > _rangeEnd)
        {
            end = _rangeEnd;
        }

        var days = Math.Max((end - (start < _rangeStart ? _rangeStart : start)).TotalDays, 1);
        return Math.Clamp(days / total * 100, 1, 100 - GetBarLeft(issue));
    }

    private string GetBarStyle(IssueTimelineDto issue) =>
        $"left: {Percent(GetBarLeft(issue))}%; width: {Percent(GetBarWidth(issue))}%";

    private string GetBarClass(IssueTimelineDto issue)
    {
        var open = issue.ClosedAt is null ? " gantt-bar-open" : string.Empty;
        return $"gantt-col-{issue.Column.ToLowerInvariant()}{open}";
    }

    private static string GetBarTitle(IssueTimelineDto issue)
    {
        var end = issue.ClosedAt?.UtcDateTime.ToString("dd/MM/yyyy") ?? "today";
        var lead = issue.ClosedAt is null
            ? $"{(int)(DateTime.UtcNow - issue.CreatedAt).TotalDays}d open"
            : $"{(int)(issue.ClosedAt.Value - issue.CreatedAt).TotalDays}d";
        var assignee = issue.AssigneeLogin is null ? string.Empty : $" • @{issue.AssigneeLogin}";
        return $"{issue.CreatedAt.UtcDateTime:dd/MM/yyyy} → {end} • {issue.Column}{assignee} • {lead}";
    }

    private double? GetMilestoneOffset(IssueTimelineDto issue)
    {
        if (issue.MilestoneDueOn is null)
        {
            return null;
        }

        var total = (_rangeEnd - _rangeStart).TotalDays;
        var offset = (issue.MilestoneDueOn.Value.UtcDateTime.Date - _rangeStart).TotalDays;
        return offset >= 0 && offset <= total ? offset / total * 100 : null;
    }

    private double? GetTodayOffset()
    {
        if (_timeline is null || !_timeline.Issues.Any())
        {
            return null;
        }

        var total = (_rangeEnd - _rangeStart).TotalDays;
        var offset = (DateTime.UtcNow.Date - _rangeStart).TotalDays;
        return offset >= 0 && offset <= total ? offset / total * 100 : null;
    }

    private int ThroughputHeight(ThroughputPointDto point)
    {
        var max = _metrics?.ThroughputPerWeek.Max(p => p.Closed) ?? 0;
        return max <= 0 ? 8 : Math.Max(8, point.Closed * 100 / max);
    }

    private string ThroughputTitle() =>
        _metrics is null
            ? string.Empty
            : string.Join(" · ", _metrics.ThroughputPerWeek.Select(p => $"{p.WeekStart:dd/MM}: {p.Closed}"));

    private static string FormatDays(double? days) =>
        days is null ? "—" : $"{days.Value:F1}d";

    private static string Percent(double value) =>
        value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}
