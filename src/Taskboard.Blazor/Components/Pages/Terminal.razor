@page "/terminal"
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject SelectedRepositoryService RepoService
@implements IAsyncDisposable

<PageTitle>Terminal - Harness</PageTitle>

<div class="terminal-page">
    <h1 class="h4 fw-bold mb-1">Terminal</h1>
    <p class="small text-body-secondary mb-2">Interactive shell sessions (bash), one per tab. Ctrl+C copies when text is selected and sends SIGINT otherwise; Ctrl+V / Shift+Insert paste.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <Alert Color="AlertColor.Danger" Dismissable="false">
            <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />@_error
        </Alert>
    }

    <ul class="nav nav-tabs terminal-tabstrip flex-nowrap" role="tablist">
        @foreach (var tab in _tabs)
        {
            <li class="nav-item" @key="tab">
                <div class="nav-link terminal-tab @(tab == _activeTab ? "active" : "") state-@tab.State.ToString().ToLowerInvariant()"
                     role="tab" aria-selected="@(tab == _activeTab)" @onclick="() => ActivateTabAsync(tab)">
                    <span class="terminal-tab-dot"></span>
                    <span class="terminal-tab-title">@tab.Title</span>
                    <button type="button" class="btn-close terminal-tab-close" title="Close tab" aria-label="Close tab"
                            @onclick="() => CloseTabAsync(tab)" @onclick:stopPropagation></button>
                </div>
            </li>
        }
        <li class="nav-item">
            <button type="button" class="nav-link terminal-tab-new" title="@(_tabs.Count >= MaxTabs ? $"Maximum of {MaxTabs} tabs" : "New terminal tab")"
                    disabled="@(_tabs.Count >= MaxTabs)" @onclick="() => OpenTabAsync(null)">
                <Icon Name="IconName.Plus" />
            </button>
        </li>
        <li class="nav-item ms-auto">
            <button type="button" class="nav-link terminal-tab-new" title="@(_focusMode ? "Restore terminal" : "Expand terminal")"
                    aria-pressed="@_focusMode" aria-label="@(_focusMode ? "Restore terminal" : "Expand terminal")"
                    @onclick="ToggleFocusModeAsync">
                <Icon Name="@(_focusMode ? IconName.FullscreenExit : IconName.Fullscreen)" />
            </button>
        </li>
    </ul>

    @if (_tabs.Count == 0)
    {
        <div class="terminal-empty text-body-secondary small">
            <p class="mb-2">No terminal sessions.</p>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => OpenTabAsync(null)">New terminal</Button>
        </div>
    }
    else
    {
        <div class="terminal-body">
            @foreach (var tab in _tabs)
            {
                <div class="terminal-pane @(tab == _activeTab ? "" : "d-none")" @key="tab">
                    @if (tab.State == TabState.Closed)
                    {
                        <Alert Color="AlertColor.Warning" Dismissable="false" class="py-1 mb-1 small">
                            <Icon Name="IconName.InfoCircleFill" class="me-1" />Session ended: @tab.CloseReason
                            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" class="ms-2" @onclick="() => ReopenTabAsync(tab)">Reopen</Button>
                        </Alert>
                    }
                    else if (tab.State == TabState.Connecting)
                    {
                        <div class="d-flex align-items-center gap-2 mb-1 text-body-secondary small">
                            <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" /> Connecting…
                        </div>
                    }
                    else if (tab.State == TabState.Error)
                    {
                        <Alert Color="AlertColor.Danger" Dismissable="false" class="py-1 mb-1 small">@tab.CloseReason</Alert>
                    }
                    <div id="@tab.ElementId" class="terminal-host" @onclick="() => FocusTabAsync(tab)"></div>
                </div>
            }
        </div>
    }

    @* SPEC-20260923-terminal-virtual-keybar: virtual keys for touch devices —
       visible only in focus mode + coarse pointer (pure CSS media query). *@
    <div class="terminal-keybar" role="toolbar" aria-label="Terminal virtual keys">
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b")'>Esc</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\t")'>Tab</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[Z")' aria-label="Shift Tab">⇧Tab</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[D")' aria-label="Arrow left">←</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[A")' aria-label="Arrow up">↑</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[B")' aria-label="Arrow down">↓</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[C")' aria-label="Arrow right">→</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[H")'>Home</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[F")'>End</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[5~")'>PgUp</button>
        <button type="button" class="keybar-key" disabled="@(!KeybarEnabled)" @onclick='() => SendVirtualKeyAsync("\x1b[6~")'>PgDn</button>
        <button type="button" class="keybar-key keybar-ctrl @(_ctrlArmed ? "armed" : "")" disabled="@(!KeybarEnabled)"
                aria-pressed="@_ctrlArmed" title="Sticky Ctrl — tap, then the next key" @onclick="ToggleCtrlAsync">Ctrl</button>
        <button type="button" class="keybar-key" disabled="@(_activeTab is null)" @onclick="PasteClipboardAsync">Paste</button>
    </div>

    @* SPEC-20260923-terminal-focus-mode RF-003: floating restore — the topbar
       (and the mobile hamburger) is hidden in focus mode, so the way out must
       live inside the overlay itself. *@
    <button type="button" class="terminal-focus-exit" title="Restore terminal" aria-label="Restore terminal"
            @onclick="ToggleFocusModeAsync">
        <Icon Name="IconName.FullscreenExit" />
    </button>
</div>

@code {
    private const int MaxTabs = 8; // mirrors TerminalSessionManager.MaxSessionsPerUser

    private enum TabState { Connecting, Open, Closed, Error }

    private sealed class TerminalTab
    {
        public required string Key { get; init; }
        public required string ElementId { get; init; }
        public required string Title { get; init; }
        public string? SessionId { get; set; }
        public TabState State { get; set; } = TabState.Connecting;
        public string? CloseReason { get; set; }
        public string? PendingCmd { get; set; }
        public bool JsReady { get; set; }
    }

    [SupplyParameterFromQuery(Name = "cmd")]
    public string? Cmd { get; set; }

    private readonly List<TerminalTab> _tabs = new();
    private TerminalTab? _activeTab;
    private HubConnection? _hub;
    private DotNetObjectReference<Terminal>? _selfRef;
    private string? _error;
    private int _tabCounter;
    private bool _cmdConsumed;
    private bool _focusMode;
    private bool _ctrlArmed;

    /// <summary>Virtual keys only make sense on a live session (SPEC-20260923-terminal-virtual-keybar RF-002).</summary>
    private bool KeybarEnabled => _activeTab is { State: TabState.Open, SessionId: not null };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        await RepoService.EnsureLoadedAsync();
        await ConnectHubAsync();
        await OpenTabAsync(_cmdConsumed ? null : Cmd);
        _cmdConsumed = true;
    }

    private async Task ConnectHubAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/terminal-hub"))
            // Long backoff: backgrounded tabs throttle keep-alive pings, so a
            // dropped connection should keep retrying instead of giving up
            // after the default ~42s and killing every tab.
            .WithAutomaticReconnect([TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30), TimeSpan.FromMinutes(1),
                TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(5)])
            .Build();

        _hub.On<string, string>("output", (sessionId, data) =>
        {
            var tab = _tabs.FirstOrDefault(t => t.SessionId == sessionId);
            if (tab is not null)
            {
                return JS.InvokeVoidAsync("taskboardTerminal.write", tab.ElementId, data).AsTask();
            }
            return Task.CompletedTask;
        });

        _hub.On<string, string>("closed", (sessionId, reason) =>
        {
            var tab = _tabs.FirstOrDefault(t => t.SessionId == sessionId);
            if (tab is not null)
            {
                tab.State = TabState.Closed;
                tab.CloseReason = reason;
            }
            return InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += async _ =>
        {
            // Sessions survive the disconnect server-side (orphans). Reattach
            // keeps the running shell AND the xterm buffer; only sessions that
            // were reaped fall back to a fresh open.
            foreach (var tab in _tabs.Where(t => t.State == TabState.Open && t.SessionId is not null).ToList())
            {
                var reattached = false;
                try
                {
                    reattached = await _hub.InvokeAsync<bool>("Reattach", tab.SessionId);
                }
                catch
                {
                    // Fall through — reopen below.
                }

                if (reattached)
                {
                    await JS.InvokeVoidAsync("taskboardTerminal.fitNow", tab.ElementId);
                    await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
                }
                else
                {
                    await InvokeAsync(() => ReopenTabAsync(tab));
                }
            }
        };

        _hub.Closed += _ =>
        {
            foreach (var tab in _tabs.Where(t => t.State == TabState.Open))
            {
                tab.State = TabState.Closed;
                tab.CloseReason = "connection lost";
            }
            return InvokeAsync(StateHasChanged);
        };

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not open a terminal session: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task OpenTabAsync(string? cmd)
    {
        if (_tabs.Count >= MaxTabs)
        {
            return;
        }

        var key = Guid.NewGuid().ToString("N")[..8];
        var tab = new TerminalTab
        {
            Key = key,
            ElementId = $"terminal-host-{key}",
            Title = $"Terminal {++_tabCounter}",
            PendingCmd = cmd
        };
        _tabs.Add(tab);
        _activeTab = tab;
        StateHasChanged();
        await Task.Yield(); // let the pane render before JS init

        var initialized = await JS.InvokeAsync<bool>(
            "taskboardTerminal.init", tab.ElementId, _selfRef, tab.Key);
        if (!initialized)
        {
            tab.State = TabState.Error;
            tab.CloseReason = "Terminal emulator failed to initialize.";
            StateHasChanged();
            return;
        }
        tab.JsReady = true;

        await OpenSessionAsync(tab);
    }

    private async Task OpenSessionAsync(TerminalTab tab)
    {
        if (_hub is not { State: HubConnectionState.Connected })
        {
            tab.State = TabState.Error;
            tab.CloseReason = "No connection to the server.";
            StateHasChanged();
            return;
        }

        try
        {
            tab.State = TabState.Connecting;
            StateHasChanged();
            tab.SessionId = await _hub.InvokeAsync<string>("Open", RepoService.Selected);
            tab.State = TabState.Open;
            tab.CloseReason = null;

            if (!string.IsNullOrWhiteSpace(tab.PendingCmd))
            {
                var cmd = tab.PendingCmd;
                tab.PendingCmd = null;
                await _hub.InvokeAsync("Input", tab.SessionId, cmd);
            }

            await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
        }
        catch (Exception ex)
        {
            tab.State = TabState.Error;
            tab.CloseReason = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ReopenTabAsync(TerminalTab tab)
    {
        await JS.InvokeVoidAsync("taskboardTerminal.reset", tab.ElementId);
        await OpenSessionAsync(tab);
    }

    private async Task ActivateTabAsync(TerminalTab tab)
    {
        _ctrlArmed = false; // sticky Ctrl never survives a tab switch
        _activeTab = tab;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("taskboardTerminal.fitNow", tab.ElementId);
        await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
    }

    private async Task CloseTabAsync(TerminalTab tab)
    {
        if (_hub is { State: HubConnectionState.Connected } && tab.SessionId is not null)
        {
            try
            {
                await _hub.InvokeAsync("Close", tab.SessionId);
            }
            catch
            {
                // Server already dropped it.
            }
        }

        await JS.InvokeVoidAsync("taskboardTerminal.dispose", tab.ElementId);
        var index = _tabs.IndexOf(tab);
        _tabs.Remove(tab);

        if (_activeTab == tab)
        {
            _activeTab = _tabs.ElementAtOrDefault(Math.Min(index, _tabs.Count - 1));
            if (_activeTab is not null)
            {
                StateHasChanged();
                await Task.Yield();
                await JS.InvokeVoidAsync("taskboardTerminal.fitNow", _activeTab.ElementId);
                await JS.InvokeVoidAsync("taskboardTerminal.focus", _activeTab.ElementId);
            }
        }

        StateHasChanged();
    }

    private async Task FocusTabAsync(TerminalTab tab)
    {
        await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
    }

    // SPEC-20260923-terminal-focus-mode RF-001/RF-004: CSS-driven overlay —
    // JS only flips html[data-terminal-focus]; after the transition the active
    // xterm refits so the ResizeObserver pushes real cols/rows to the PTY.
    private async Task ToggleFocusModeAsync()
    {
        _focusMode = !_focusMode;
        try
        {
            await JS.InvokeVoidAsync("taskboard.setTerminalFocus", _focusMode);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop unavailable — keep the flag in sync with the attribute.
            _focusMode = false;
            return;
        }

        StateHasChanged();
        await Task.Yield();
        if (_activeTab is not null)
        {
            await JS.InvokeVoidAsync("taskboardTerminal.fitNow", _activeTab.ElementId);
            await JS.InvokeVoidAsync("taskboardTerminal.focus", _activeTab.ElementId);
        }
    }

    // SPEC-20260923-terminal-virtual-keybar RF-002/RF-005: keybar sequences go
    // through the same hub Input path as real keystrokes; every tap refocuses
    // the xterm so the button doesn't keep the focus (and the OSK can reopen).
    private async Task SendVirtualKeyAsync(string data)
    {
        _ctrlArmed = false; // keybar keys never combine with Ctrl — tapping disarms
        await SendInputAsync(data);
    }

    private async Task SendInputAsync(string data)
    {
        var tab = _activeTab;
        if (tab?.SessionId is not null && _hub is { State: HubConnectionState.Connected })
        {
            await _hub.InvokeAsync("Input", tab.SessionId, data);
        }
        if (tab is not null)
        {
            await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
        }
    }

    // RF-003: one-shot Ctrl — arms for exactly the next key; a second tap
    // disarms without sending anything.
    private async Task ToggleCtrlAsync()
    {
        _ctrlArmed = !_ctrlArmed;
        if (_activeTab is not null)
        {
            await JS.InvokeVoidAsync("taskboardTerminal.focus", _activeTab.ElementId);
        }
    }

    // RF-004: dedicated Paste — the tap is the user gesture readText requires.
    private async Task PasteClipboardAsync()
    {
        _ctrlArmed = false;
        var tab = _activeTab;
        if (tab is null)
        {
            return;
        }
        await JS.InvokeVoidAsync("taskboardTerminal.pasteClipboard", tab.ElementId);
        await JS.InvokeVoidAsync("taskboardTerminal.focus", tab.ElementId);
    }

    [JSInvokable]
    public async Task OnTerminalData(string tabKey, string data)
    {
        var tab = _tabs.FirstOrDefault(t => t.Key == tabKey);
        if (tab?.SessionId is null || _hub is not { State: HubConnectionState.Connected })
        {
            return;
        }

        // SPEC-20260923-terminal-virtual-keybar RF-003: sticky Ctrl consumes
        // exactly one keystroke — a letter/digit becomes its control byte
        // (c → \x03), 'v' runs the paste path (Ctrl+V = paste per the page
        // hint), anything else goes through unmodified and still disarms.
        if (_ctrlArmed)
        {
            _ctrlArmed = false;
            _ = InvokeAsync(StateHasChanged);
            if (data.Length == 1)
            {
                var ch = data[0];
                if (ch is 'v' or 'V')
                {
                    await PasteClipboardAsync();
                    return;
                }
                if (ch is >= ' ' and <= '~')
                {
                    data = ((char)(ch & 0x1f)).ToString();
                }
            }
        }

        await _hub.InvokeAsync("Input", tab.SessionId, data);
    }

    [JSInvokable]
    public async Task OnTerminalResize(string tabKey, int cols, int rows)
    {
        var tab = _tabs.FirstOrDefault(t => t.Key == tabKey);
        if (tab?.SessionId is not null && _hub is { State: HubConnectionState.Connected })
        {
            await _hub.InvokeAsync("Resize", tab.SessionId, cols, rows);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch
            {
                // Ignore cleanup errors on disconnect.
            }
        }

        try
        {
            await JS.InvokeVoidAsync("taskboard.setTerminalFocus", false);
            await JS.InvokeVoidAsync("taskboardTerminal.disposeAll");
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop unavailable during teardown.
        }

        _selfRef?.Dispose();
    }
}
