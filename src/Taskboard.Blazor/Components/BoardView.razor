@page "/"
@inject IGitHubService GitHubService

<h1 class="h4 fw-bold mb-1">Board</h1>
<p class="small text-body-secondary mb-4">Drag or browse issues by status</p>

@if (_isLoading)
{
    <Loading Message="Loading repositories..." />
}
else
{
    @if (_repoWarning is not null)
    {
        <div class="alert alert-warning">@_repoWarning</div>
    }

    <div class="kanban-board-header">
        <div class="field">
            <label for="board-repo">Repository</label>
            <input id="board-repo" type="text" class="form-control form-control-sm" list="board-repo-options"
                   placeholder="owner/repo" aria-label="Repository"
                   @bind="_repoInput" @bind:after="OnRepoChanged" @onkeydown="OnRepoKeyDownAsync"
                   disabled="@_tokenMissing" />
            <datalist id="board-repo-options">
                @foreach (var repo in _repositories)
                {
                    <option value="@repo.FullName" />
                }
            </datalist>
        </div>
        <div class="field legend">
            <label>Priority Level</label>
            <div class="legend mt-1">
                @foreach (var priority in _priorities)
                {
                    <span class="small">
                        <span class="task-priority-swatch" style="@GetPrioritySwatchStyle(priority)"></span>
                        @priority
                    </span>
                }
            </div>
        </div>
    </div>

    @if (_selectedRepo is not null)
    {
        <KanbanBoard RepositoryFullName="@_selectedRepo" />
    }
    else if (!_tokenMissing)
    {
        <EmptyState Message="Type or select a repository to load the board." />
    }
}

@code {
    private bool _isLoading = true;
    private bool _tokenMissing;
    private string? _repoWarning;
    private List<RepositoryDto> _repositories = [];
    private string? _selectedRepo;
    private string _repoInput = string.Empty;
    private readonly string[] _priorities = ["Urgent", "High", "Medium", "Low", "None"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var repositories = await GitHubService.GetRepositoriesAsync();
            _repositories = repositories.OrderBy(r => r.FullName).ToList();
            if (_repositories.Count > 0)
            {
                _selectedRepo = _repositories[0].FullName;
                _repoInput = _selectedRepo;
            }
        }
        catch (InvalidOperationException)
        {
            _tokenMissing = true;
            _repoWarning = "GitHub token not configured. Set the GITHUB_TOKEN environment variable or configure it in Settings.";
        }
        catch (Exception ex)
        {
            _repoWarning = $"Could not load GitHub repositories: {ex.Message}. You can still type a repository name.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRepoKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Code is "Enter" or "NumpadEnter")
        {
            await OnRepoChanged();
        }
    }

    private Task OnRepoChanged()
    {
        var value = _repoInput.Trim();
        if (value == _selectedRepo)
        {
            return Task.CompletedTask;
        }

        var parts = value.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length != 2)
        {
            _repoWarning = $"Invalid repository '{value}'. Use the format owner/repo.";
            _repoInput = _selectedRepo ?? string.Empty;
            return Task.CompletedTask;
        }

        _repoWarning = null;
        _selectedRepo = value;
        return Task.CompletedTask;
    }

    private string GetPrioritySwatchStyle(string priority)
    {
        var key = priority.ToLowerInvariant();
        return $"background-color: var(--priority-{key}-border);";
    }
}
