@inject IJSRuntime JS
@inject SelectedRepositoryService RepoService
@inject ILocaleService L
@implements IDisposable

<nav class="nav nav-pills flex-column gap-1 p-3" role="navigation" aria-label="@L.T("nav.sidebarNav")">
    <div class="sidebar-repo-selector">
        <RepositoryCombobox Id="sidebar-repo"
                            AriaLabel="@L.T("nav.repository")"
                            Placeholder="owner/repo"
                            Repositories="@RepoService.Repositories"
                            IsLoading="@(!RepoService.IsLoaded)"
                            Disabled="@RepoService.TokenMissing"
                            @bind-Value="_repoInput"
                            OnCommit="OnRepoCommittedAsync" />
        @if (_repoWarning is not null)
        {
            <div class="small text-warning px-1 pt-1" role="alert">@_repoWarning</div>
        }
        else if (RepoService.Warning is not null)
        {
            <div class="small text-warning px-1 pt-1" role="alert">@RepoService.Warning</div>
        }
    </div>
    <button type="button" class="nav-link sidebar-repo-rail"
            data-label="@(RepoService.Selected ?? L.T("nav.repository"))"
            title="@(RepoService.Selected ?? L.T("nav.selectRepo"))"
            aria-label="@L.T("nav.selectRepo")"
            @onclick="ExpandSidebarAsync">
        <Icon Name="IconName.Folder2" />
        <span class="rail-label">@RepoShortName</span>
    </button>
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" aria-label="@L.T("nav.board")" data-label="@L.T("nav.board")" title='@RailTitle(L.T("nav.board"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Kanban" />
        <span class="nav-label">@L.T("nav.board")</span>
    </NavLink>
    <NavLink class="nav-link" href="ai-chat" aria-label="@L.T("nav.aicode")" data-label="@L.T("nav.aicode")" title='@RailTitle(L.T("nav.aicode"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.ChatDots" />
        <span class="nav-label">@L.T("nav.aicode")</span>
    </NavLink>
    <NavLink class="nav-link" href="terminal" aria-label="@L.T("nav.terminal")" data-label="@L.T("nav.terminal")" title='@RailTitle(L.T("nav.terminal"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Terminal" />
        <span class="nav-label">@L.T("nav.terminal")</span>
    </NavLink>
    <NavLink class="nav-link" href="gantt" aria-label="@L.T("nav.gantt")" data-label="@L.T("nav.gantt")" title='@RailTitle(L.T("nav.gantt"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.BarChart" />
        <span class="nav-label">@L.T("nav.gantt")</span>
    </NavLink>
    <NavLink class="nav-link" href="workflow" aria-label="@L.T("nav.workflow")" data-label="@L.T("nav.workflow")" title='@RailTitle(L.T("nav.workflow"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Diagram3" />
        <span class="nav-label">@L.T("nav.workflow")</span>
    </NavLink>
    <NavLink class="nav-link" href="specs" aria-label="@L.T("nav.specs")" data-label="@L.T("nav.specs")" title='@RailTitle(L.T("nav.specs"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.FileEarmarkText" />
        <span class="nav-label">@L.T("nav.specs")</span>
    </NavLink>
    <NavLink class="nav-link" href="editor" aria-label="@L.T("nav.editor")" data-label="@L.T("nav.editor")" title='@RailTitle(L.T("nav.editor"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.CodeSlash" />
        <span class="nav-label">@L.T("nav.editor")</span>
    </NavLink>
    <hr class="app-sidebar-divider" />
    <NavLink class="nav-link" href="cockpit" aria-label="@L.T("nav.cockpit")" data-label="@L.T("nav.cockpit")" title='@RailTitle(L.T("nav.cockpit"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Speedometer2" />
        <span class="nav-label">@L.T("nav.cockpit")</span>
    </NavLink>
    <NavLink class="nav-link" href="agents" aria-label="@L.T("nav.agents")" data-label="@L.T("nav.agents")" title='@RailTitle(L.T("nav.agents"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Robot" />
        <span class="nav-label">@L.T("nav.agents")</span>
    </NavLink>
    <NavLink class="nav-link" href="finops" aria-label="@L.T("nav.finops")" data-label="@L.T("nav.finops")" title='@RailTitle(L.T("nav.finops"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.CurrencyDollar" />
        <span class="nav-label">@L.T("nav.finops")</span>
    </NavLink>
    <NavLink class="nav-link" href="settings" aria-label="@L.T("nav.settings")" data-label="@L.T("nav.settings")" title='@RailTitle(L.T("nav.settings"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Gear" />
        <span class="nav-label">@L.T("nav.settings")</span>
    </NavLink>
    <NavLink class="nav-link" href="skills" aria-label="@L.T("nav.skills")" data-label="@L.T("nav.skills")" title='@RailTitle(L.T("nav.skills"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.Lightning" />
        <span class="nav-label">@L.T("nav.skills")</span>
    </NavLink>
    <NavLink class="nav-link" href="jobs" aria-label="@L.T("nav.jobs")" data-label="@L.T("nav.jobs")" title='@RailTitle(L.T("nav.jobs"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.ClockHistory" />
        <span class="nav-label">@L.T("nav.jobs")</span>
    </NavLink>
    <NavLink class="nav-link" href="prompts/taskboard/manage-taskboard" aria-label="@L.T("nav.prompts")" data-label="@L.T("nav.prompts")" title='@RailTitle(L.T("nav.prompts"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.FileText" />
        <span class="nav-label">@L.T("nav.prompts")</span>
    </NavLink>
    <a class="nav-link" href="https://github.com/afonsoft/agent-harness/issues" target="_blank" rel="noopener noreferrer" aria-label="@L.T("nav.issues")" data-label="@L.T("nav.issues")" title='@RailTitle(L.T("nav.issues"))' @onclick="CloseSidebarAsync">
        <Icon Name="IconName.RecordCircle" />
        <span class="nav-label">@L.T("nav.issues")</span>
    </a>
</nav>

@code {
    [CascadingParameter] private MainLayout? Layout { get; set; }

    private string _repoInput = string.Empty;
    private string? _repoWarning;

    /// <summary>Repo name without the owner prefix, shown under the rail icon.</summary>
    private string RepoShortName =>
        RepoService.Selected?.Split('/') is { Length: > 0 } parts
            ? parts[^1]
            : L.T("nav.repoShort");

    protected override async Task OnInitializedAsync()
    {
        RepoService.Changed += OnRepoChangedAsync;
        await RepoService.EnsureLoadedAsync();
        _repoInput = RepoService.Selected ?? string.Empty;
    }

    /// <summary>Native tooltip shown only while the icon rail is collapsed; the
    /// styled ::after tooltip was removed because the nav scroll container clips it.</summary>
    private string? RailTitle(string label) =>
        Layout?.IsSidebarCollapsed == true ? label : null;

    private async Task OnRepoCommittedAsync(string value)
    {
        if (!await RepoService.SelectAsync(value))
        {
            _repoWarning = L.T("nav.repoInvalid", value);
            _repoInput = RepoService.Selected ?? string.Empty;
            return;
        }

        _repoWarning = null;
        _repoInput = RepoService.Selected ?? string.Empty;
    }

    private async Task OnRepoChangedAsync()
    {
        _repoInput = RepoService.Selected ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExpandSidebarAsync()
    {
        if (Layout is not null)
        {
            await Layout.SetSidebarCollapsedAsync(false);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("taskboard.setSidebarCollapsed", false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available (e.g. prerender).
        }
    }

    private async Task CloseSidebarAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("taskboard.closeSidebar");
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available (e.g. prerender); navigation still works.
        }
    }

    public void Dispose()
    {
        RepoService.Changed -= OnRepoChangedAsync;
    }
}
