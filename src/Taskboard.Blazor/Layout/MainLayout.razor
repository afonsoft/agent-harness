@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<div class="app-shell">
    <div class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-label="Sidebar">
        <div class="app-sidebar-brand">
            <Icon Name="IconName.Kanban" class="me-2" />
            <span>Harness</span>
            <button type="button"
                    class="sidebar-collapse-btn ms-auto d-none d-lg-inline-flex"
                    title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    aria-expanded="@(!_sidebarCollapsed)"
                    @onclick="ToggleSidebarAsync">
                <Icon Name="@(_sidebarCollapsed ? IconName.ChevronBarRight : IconName.ChevronBarLeft)" />
            </button>
            <button type="button" class="btn-close ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close"></button>
        </div>
        <CascadingValue Value="this">
            <NavMenu />
        </CascadingValue>
    </div>
    <div class="app-content">
        <header class="app-topbar">
            <button type="button"
                    class="btn btn-outline-secondary d-lg-none"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#appSidebar"
                    aria-controls="appSidebar"
                    aria-label="Open navigation">
                <Icon Name="IconName.List" />
            </button>
            <span class="app-topbar-title me-auto">@_pageTitle</span>
            <a href="/settings" class="btn btn-outline-secondary" aria-label="Settings">
                <Icon Name="IconName.Gear" />
            </a>
            <AuthorizeView>
                <form method="post" action="/api/logout" class="m-0" aria-label="Logout">
                    <button type="submit" class="btn btn-outline-secondary">Log out</button>
                </form>
            </AuthorizeView>
        </header>
        <main class="app-main">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        An unexpected error occurred. Please refresh the page.
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private string _pageTitle = "Board";

    private static readonly (string Prefix, string Title)[] PageTitles =
    [
        ("prompts", "Prompts"),
        ("ai-chat", "AI Code"),
        ("gantt", "Gantt"),
        ("workflow", "Workflow"),
        ("agents", "CLI Agents"),
        ("editor", "VS Code"),
        ("terminal", "Terminal"),
        ("settings", "Settings"),
        ("skills", "Skills"),
    ];

    protected override void OnInitialized()
    {
        UpdateTitle(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _sidebarCollapsed = await JS.InvokeAsync<bool>("taskboard.getSidebarCollapsed");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available (e.g. prerender); sidebar stays expanded.
        }
    }

    /// <summary>
    /// SPEC-20260920-global-repo-selector RF-003: shared entry point so the
    /// rail repo icon (NavMenu) and the brand toggle stay in sync.
    /// </summary>
    public async Task SetSidebarCollapsedAsync(bool collapsed)
    {
        if (_sidebarCollapsed == collapsed)
        {
            return;
        }

        _sidebarCollapsed = collapsed;
        try
        {
            await JS.InvokeVoidAsync("taskboard.setSidebarCollapsed", collapsed);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available; the in-memory state still toggles.
        }

        StateHasChanged();
    }

    private Task ToggleSidebarAsync() => SetSidebarCollapsedAsync(!_sidebarCollapsed);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        StateHasChanged();
    }

    private void UpdateTitle(string uri)
    {
        var path = Nav.ToBaseRelativePath(uri).Split('?', '#')[0].TrimEnd('/');
        _pageTitle = PageTitles
            .FirstOrDefault(p => path.StartsWith(p.Prefix, StringComparison.OrdinalIgnoreCase))
            .Title ?? "Board";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
