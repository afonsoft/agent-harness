@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILocaleService L

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<a href="#app-main" class="skip-link" @onclick="FocusMainAsync" @onclick:preventDefault="true">@L.T("layout.skipToMain")</a>
<div class="app-shell">
    <div class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-label="Sidebar">
        <div class="app-sidebar-brand">
            <Icon Name="IconName.Kanban" class="me-2" />
            <span>Harness</span>
            <button type="button"
                    class="sidebar-collapse-btn ms-auto d-none d-lg-inline-flex"
                    title="@(_sidebarCollapsed ? L.T("layout.expandSidebar") : L.T("layout.collapseSidebar"))"
                    aria-label="@(_sidebarCollapsed ? L.T("layout.expandSidebar") : L.T("layout.collapseSidebar"))"
                    aria-expanded="@(_sidebarCollapsed ? "false" : "true")"
                    @onclick="ToggleSidebarAsync">
                <Icon Name="@(_sidebarCollapsed ? IconName.ChevronBarRight : IconName.ChevronBarLeft)" />
            </button>
            <button type="button" class="btn-close ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="@L.T("layout.close")"></button>
        </div>
        <CascadingValue Value="this">
            <NavMenu />
        </CascadingValue>
    </div>
    <div class="app-content">
        <header class="app-topbar">
            <button type="button"
                    class="btn btn-outline-secondary d-lg-none"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#appSidebar"
                    aria-controls="appSidebar"
                    aria-label="@L.T("layout.openNav")">
                <Icon Name="IconName.List" />
            </button>
            <span class="app-topbar-title me-auto">@_pageTitle</span>
            <LocalePicker />
            <a href="/settings" class="btn btn-outline-secondary" aria-label="@L.T("topbar.settings")">
                <Icon Name="IconName.Gear" />
            </a>
            <AuthorizeView>
                <form method="post" action="/api/logout" class="m-0" aria-label="@L.T("topbar.logout")">
                    <button type="submit" class="btn btn-outline-secondary">@L.T("topbar.logout")</button>
                </form>
            </AuthorizeView>
        </header>
        <main class="app-main" id="app-main" tabindex="-1" @ref="_mainElement">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        @L.T("layout.error")
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private string _pageTitle = "Board";
    private ElementReference _mainElement;

    private static readonly (string Prefix, string TitleKey)[] PageTitles =
    [
        ("prompts", "nav.prompts"),
        ("ai-chat", "nav.aicode"),
        ("gantt", "nav.gantt"),
        ("workflow", "nav.workflow"),
        ("agents", "nav.agents"),
        ("editor", "nav.editor"),
        ("terminal", "nav.terminal"),
        ("settings", "nav.settings"),
        ("skills", "nav.skills"),
        ("finops", "nav.finops"),
        ("cockpit", "nav.cockpit"),
        ("jobs", "nav.jobs"),
        ("specs", "nav.specs"),
    ];

    protected override void OnInitialized()
    {
        UpdateTitle(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        L.Changed += OnLocaleChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await L.InitializeAsync();
        try
        {
            _sidebarCollapsed = await JS.InvokeAsync<bool>("taskboard.getSidebarCollapsed");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available (e.g. prerender); sidebar stays expanded.
        }
    }

    /// <summary>True while the desktop icon rail is active (SPEC-20260918-sidebar-icon-rail).</summary>
    public bool IsSidebarCollapsed => _sidebarCollapsed;

    /// <summary>
    /// SPEC-20260920-global-repo-selector RF-003: shared entry point so the
    /// rail repo icon (NavMenu) and the brand toggle stay in sync.
    /// </summary>
    public async Task SetSidebarCollapsedAsync(bool collapsed)
    {
        if (_sidebarCollapsed == collapsed)
        {
            return;
        }

        _sidebarCollapsed = collapsed;
        try
        {
            await JS.InvokeVoidAsync("taskboard.setSidebarCollapsed", collapsed);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available; the in-memory state still toggles.
        }

        StateHasChanged();
    }

    private Task ToggleSidebarAsync() => SetSidebarCollapsedAsync(!_sidebarCollapsed);

    private async Task FocusMainAsync()
    {
        try
        {
            await _mainElement.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // JS interop not available; the href still lands on #app-main.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        StateHasChanged();
    }

    private void UpdateTitle(string uri)
    {
        var path = Nav.ToBaseRelativePath(uri).Split(['?', '#'])[0].TrimEnd('/');
        var key = PageTitles
            .FirstOrDefault(p => path.StartsWith(p.Prefix, StringComparison.OrdinalIgnoreCase))
            .TitleKey ?? "nav.board";
        _pageTitle = L.T(key);
    }

    private void OnLocaleChanged()
    {
        UpdateTitle(Nav.Uri);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        L.Changed -= OnLocaleChanged;
    }
}
