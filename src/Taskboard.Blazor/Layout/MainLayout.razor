@inherits LayoutComponentBase

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<div class="app-shell">
    <div class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-label="Sidebar">
        <div class="app-sidebar-brand">
            <Icon Name="IconName.Kanban" class="me-2" />
            <span>Taskboard</span>
            <button type="button" class="btn-close ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close"></button>
        </div>
        <NavMenu />
    </div>
    <div class="app-content">
        <header class="app-topbar">
            <button type="button"
                    class="btn btn-outline-secondary d-lg-none me-auto"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#appSidebar"
                    aria-controls="appSidebar"
                    aria-label="Open navigation">
                <Icon Name="IconName.List" />
            </button>
            <a href="/settings" class="btn btn-outline-secondary" aria-label="Settings">
                <Icon Name="IconName.Gear" />
            </a>
            <a href="https://github.com/afonsoft/taskboard-ai" target="_blank" class="btn btn-link text-decoration-none">About</a>
            <AuthorizeView>
                <form method="post" action="/api/logout" class="m-0" aria-label="Logout">
                    <button type="submit" class="btn btn-outline-secondary">Log out</button>
                </form>
            </AuthorizeView>
        </header>
        <main class="app-main">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        An unexpected error occurred. Please refresh the page.
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>
