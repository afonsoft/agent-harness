# Agent Harness docker-compose environment — copy to .env and adjust.

# Admin UI password. Empty = auto-generated (check `docker compose logs` or
# admin.json inside the taskboard-data volume).
ADMIN_PASSWORD=

# GitHub PAT with `repo` + `read:org` scopes — required for the Kanban board.
GITHUB_TOKEN=

# Host repos directory to expose to the container at /data/home/repos
# (the agent workspace ~/repos). Opt-in — also uncomment the matching volume
# line in docker-compose.yml.
# HARNESS_REPOS_DIR=/home/user/repos

# Container timezone.
TZ=UTC
